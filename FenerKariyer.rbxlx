<Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Crest</string><ProtectedString name="Source"><![CDATA[--[[
	Crest
	Kulüp arması: biçim + desen + iki renk + simge. Hem arayüzde hem forma göğsünde aynı kodla çizilir
	(ölçüler orantılıdır; içine konduğu kutuyu doldurur). Oyuncu kendi armasını tasarlar,
	rakip kulüplerin armaları hazırdır.

	spec = { shape, pattern, a, b, symbol }   a ve b: Crest.Colors içindeki sıra numaraları
	Crest.Fill(parent, spec, abbr)            armayı parent kutusuna çizer
	Crest.Build(spec, abbr, pixels) -> Frame  sabit ölçülü arma
	Crest.Clean(spec) -> spec | nil           sunucu doğrulaması
	Crest.FromClub(club) -> spec, abbr        hazır kulüp tanımından (Squads) arma
]]

local Crest = {}

local rgb = Color3.fromRGB
local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy)

Crest.Shapes = { "Kalkan", "Daire", "Altıgen", "Flama", "Elmas" }
Crest.Patterns = { "Düz", "Çapraz şerit", "Dikey çubuk", "Yatay kuşak", "Yarı yarıya", "Çerçeve" }
Crest.Symbols = { "Kısaltma", "Baş harf", "Yıldızlı", "Toplu" }
Crest.Colors = {
	rgb(255, 230, 0), -- sarı
	rgb(11, 23, 71), -- lacivert
	rgb(250, 250, 250), -- beyaz
	rgb(20, 20, 24), -- siyah
	rgb(200, 36, 44), -- kırmızı
	rgb(120, 20, 46), -- bordo
	rgb(232, 120, 24), -- turuncu
	rgb(28, 140, 84), -- yeşil
	rgb(18, 84, 60), -- koyu yeşil
	rgb(40, 110, 200), -- mavi
	rgb(96, 190, 235), -- açık mavi
	rgb(112, 60, 160), -- mor
	rgb(196, 160, 72), -- altın
	rgb(130, 136, 148), -- gri
}

function Crest.Default()
	return { shape = 1, pattern = 2, a = 2, b = 1, symbol = 1 }
end

local function isInt(v: any, min: number, max: number): boolean
	return type(v) == "number" and v == math.floor(v) and v >= min and v <= max
end

-- İstemciden gelen tasarımı doğrular; geçersizse nil
function Crest.Clean(spec: any)
	if type(spec) ~= "table" then
		return nil
	end
	if
		not isInt(spec.shape, 1, #Crest.Shapes)
		or not isInt(spec.pattern, 1, #Crest.Patterns)
		or not isInt(spec.a, 1, #Crest.Colors)
		or not isInt(spec.b, 1, #Crest.Colors)
		or not isInt(spec.symbol, 1, #Crest.Symbols)
	then
		return nil
	end
	if spec.a == spec.b then
		return nil -- iki renk aynı olursa desen ve yazı görünmez
	end
	return { shape = spec.shape, pattern = spec.pattern, a = spec.a, b = spec.b, symbol = spec.symbol }
end

local function hash(text: string): number
	local h = 7
	for i = 1, #text do
		h = (h * 31 + string.byte(text, i)) % 2147483647
	end
	return h
end

-- Hazır kulüp (Squads.Clubs) ya da oyuncunun kulübü için çizim bilgisi
function Crest.FromClub(club)
	if club.CrestSpec then
		local s = club.CrestSpec
		return { shape = s.shape, pattern = s.pattern, a = Crest.Colors[s.a], b = Crest.Colors[s.b], symbol = s.symbol }, club.Abbr
	end
	return {
		shape = club.Crest or 1,
		pattern = 1 + hash(club.Name or "") % #Crest.Patterns,
		a = club.A,
		b = club.B,
		symbol = 1 + hash(club.Abbr or "") % 2 * 2, -- kısaltma ya da yıldızlı
	},
		club.Abbr
end

local function color(v: any): Color3
	-- sayı: paletteki sıra; değilse doğrudan renk (hazır kulüpler)
	return if type(v) == "number" then (Crest.Colors[v] or Crest.Colors[1]) else v
end

local function frame(parent: Instance, size: UDim2, pos: UDim2, c: Color3, rot: number?): Frame
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = c
	f.BorderSizePixel = 0
	f.Rotation = rot or 0
	f.Parent = parent
	return f
end

local function round(o: Instance, r: number)
	local u = Instance.new("UICorner")
	u.CornerRadius = UDim.new(r, 0)
	u.Parent = o
end

-- Açık renk üstüne koyu, koyu renk üstüne açık yazı
local function ink(bg: Color3): Color3
	local lum = bg.R * 0.299 + bg.G * 0.587 + bg.B * 0.114
	return if lum > 0.6 then rgb(12, 16, 40) else rgb(255, 255, 255)
end

function Crest.Fill(parent: Instance, spec, abbr: string?)
	local a, b = color(spec.a), color(spec.b)
	local kind = spec.shape or 1
	-- gövde: köşeleri yuvarlatılmış ve içeriği kırpan tuval
	local body = Instance.new("CanvasGroup")
	body.Name = "CrestBody"
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.Position = UDim2.fromScale(0.5, 0.5)
	body.BackgroundColor3 = a
	body.BorderSizePixel = 0
	local diamond = kind == 5
	if kind == 2 then
		body.Size = UDim2.fromScale(0.92, 0.92)
		round(body, 0.5)
	elseif kind == 3 then
		body.Size = UDim2.fromScale(0.86, 0.94)
		round(body, 0.28)
	elseif kind == 4 then
		body.Size = UDim2.fromScale(0.72, 0.96)
		round(body, 0.1)
	elseif diamond then
		body.Size = UDim2.fromScale(0.68, 0.68)
		body.Rotation = 45
		round(body, 0.12)
	else
		body.Size = UDim2.fromScale(0.8, 0.94)
		round(body, 0.3)
	end
	local edge = Instance.new("UIStroke")
	edge.Color = b
	edge.Thickness = 2
	edge.Parent = body
	body.Parent = parent
	-- elmasta desen, döndürülmüş gövdenin içinde düz dursun diye ters çevrilir
	local back = if diamond then -45 else 0

	local p = spec.pattern or 1
	if p == 2 then
		frame(body, UDim2.fromScale(0.3, 2.2), UDim2.fromScale(0.5, 0.5), b, 28 + back)
	elseif p == 3 then
		for _, x in ipairs({ 0.22, 0.5, 0.78 }) do
			frame(body, UDim2.fromScale(0.13, 2.2), UDim2.fromScale(x, 0.5), b, back)
		end
	elseif p == 4 then
		frame(body, UDim2.fromScale(2.2, 0.3), UDim2.fromScale(0.5, 0.5), b, back)
	elseif p == 5 then
		frame(body, UDim2.fromScale(1.2, 2.4), UDim2.fromScale(1.1, 0.5), b, back)
	elseif p == 6 then
		local inner = frame(body, UDim2.fromScale(0.74, 0.74), UDim2.fromScale(0.5, 0.5), a)
		round(inner, if kind == 2 then 0.5 else 0.2)
		local st = Instance.new("UIStroke")
		st.Color = b
		st.Thickness = 3
		st.Parent = inner
	end

	-- simge: gövdenin üstünde, hep düz durur
	local sym = spec.symbol or 1
	local textValue = abbr or ""
	if sym == 2 then
		textValue = string.sub(textValue, 1, 1)
		-- Türkçe harfler iki bayt olabilir
		for _, code in utf8.codes(abbr or "") do
			textValue = utf8.char(code)
			break
		end
	end
	local onColor = if p == 1 or p == 6 then a else b:Lerp(a, 0.5)
	local label = Instance.new("TextLabel")
	label.Name = "CrestText"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, if sym >= 3 then 0.62 else 0.5)
	label.Size = if sym == 2 then UDim2.fromScale(0.5, 0.56) else UDim2.fromScale(0.62, if sym >= 3 then 0.26 else 0.34)
	label.FontFace = FONT
	label.Text = textValue
	label.TextScaled = true
	label.TextColor3 = ink(onColor)
	local ts = Instance.new("UIStroke")
	ts.Color = if ink(onColor).R > 0.5 then rgb(12, 16, 40) else rgb(255, 255, 255)
	ts.Thickness = 1.5
	ts.Parent = label
	label.Parent = parent
	if sym == 3 then
		-- yıldız: üst üste iki kare (sekiz köşeli)
		for _, rot in ipairs({ 0, 45 }) do
			local s = frame(parent, UDim2.fromScale(0.2, 0.2), UDim2.fromScale(0.5, 0.33), rgb(255, 214, 64), rot)
			local st = Instance.new("UIStroke")
			st.Color = rgb(12, 16, 40)
			st.Thickness = 1
			st.Parent = s
		end
		frame(parent, UDim2.fromScale(0.16, 0.16), UDim2.fromScale(0.5, 0.33), rgb(255, 214, 64), 22)
	elseif sym == 4 then
		-- top: beyaz daire, ortasında koyu beşgen yerine nokta
		local ball = frame(parent, UDim2.fromScale(0.24, 0.24), UDim2.fromScale(0.5, 0.33), rgb(250, 250, 250))
		round(ball, 0.5)
		local st = Instance.new("UIStroke")
		st.Color = rgb(12, 16, 40)
		st.Thickness = 1.5
		st.Parent = ball
		local dot = frame(ball, UDim2.fromScale(0.42, 0.42), UDim2.fromScale(0.5, 0.5), rgb(12, 16, 40), 45)
		round(dot, 0.2)
	end
	return body
end

function Crest.Build(spec, abbr: string?, pixels: number): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Crest"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(pixels, pixels)
	Crest.Fill(holder, spec, abbr)
	return holder
end

return Crest
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Kits</string><ProtectedString name="Source"><![CDATA[--[[
	Kits
	Forma tanımları. Bir oyuncunun verisinden hangi formayı giyeceğini hesaplar.
	Renkler sarı-lacivert ailesiyle sınırlıdır.
]]

local Config = require(script.Parent.Config)
local C = Config.Colors

local Kits = {}

Kits.Fenerbahce = {
	Pattern = "Cubuklu",
	Shirt = C.Yellow,
	Stripe = C.Navy,
	Sleeve = C.Navy,
	Trim = C.Yellow,
	Shorts = C.White,
	Sock = C.Navy,
	Ink = C.White,
	InkStroke = C.Navy,
}

-- Oyuncunun kendi kulübü: desene göre
Kits.Club = {
	Cubuklu = {
		Pattern = "Cubuklu",
		Shirt = C.Yellow,
		Stripe = C.Navy,
		Sleeve = C.Yellow,
		Trim = C.Navy,
		Shorts = C.Navy,
		Sock = C.Yellow,
		Ink = C.White,
		InkStroke = C.Navy,
	},
	Duz = {
		Pattern = "Duz",
		Shirt = C.Navy,
		Stripe = C.Yellow,
		Sleeve = C.Navy,
		Trim = C.Yellow,
		Shorts = C.Navy,
		Sock = C.Navy,
		Ink = C.Yellow,
		InkStroke = C.Navy,
	},
	Kusakli = {
		Pattern = "Kusakli",
		Shirt = C.White,
		Stripe = C.Navy,
		Sleeve = C.White,
		Trim = C.Yellow,
		Shorts = C.Navy,
		Sock = C.White,
		Ink = C.Navy,
		InkStroke = C.White,
	},
}

Kits.Keeper = {
	Pattern = "Duz",
	Shirt = Color3.fromRGB(25, 181, 106),
	Stripe = Color3.fromRGB(13, 122, 69),
	Sleeve = Color3.fromRGB(13, 122, 69),
	Trim = C.Navy,
	Shorts = Color3.fromRGB(13, 122, 69),
	Sock = Color3.fromRGB(25, 181, 106),
	Ink = C.White,
	InkStroke = C.Navy,
}
Kits.Rival = {
	Pattern = "Duz",
	Shirt = Color3.fromRGB(238, 243, 244),
	Stripe = Color3.fromRGB(15, 143, 128),
	Sleeve = Color3.fromRGB(15, 143, 128),
	Trim = C.White,
	Shorts = Color3.fromRGB(15, 143, 128),
	Sock = Color3.fromRGB(238, 243, 244),
	Ink = Color3.fromRGB(12, 90, 80),
	InkStroke = C.White,
}
Kits.Referee = {
	Pattern = "Duz",
	Shirt = Color3.fromRGB(22, 22, 26),
	Stripe = Color3.fromRGB(22, 22, 26),
	Sleeve = Color3.fromRGB(22, 22, 26),
	Trim = Color3.fromRGB(190, 255, 60),
	Shorts = Color3.fromRGB(22, 22, 26),
	Sock = Color3.fromRGB(22, 22, 26),
	Ink = C.White,
	InkStroke = Color3.fromRGB(22, 22, 26),
}
Kits.RivalKeeper = {
	Pattern = "Duz",
	Shirt = Color3.fromRGB(240, 138, 36),
	Stripe = Color3.fromRGB(184, 95, 16),
	Sleeve = Color3.fromRGB(184, 95, 16),
	Trim = Color3.fromRGB(34, 34, 34),
	Shorts = Color3.fromRGB(184, 95, 16),
	Sock = Color3.fromRGB(240, 138, 36),
	Ink = C.White,
	InkStroke = Color3.fromRGB(34, 34, 34),
}

function Kits.For(position: string, kitPattern: string, atFenerbahce: boolean?)
	if position == "Kaleci" then
		return Kits.Keeper
	end
	if atFenerbahce then
		return Kits.Fenerbahce
	end
	return Kits.Club[kitPattern] or Kits.Club.Cubuklu
end

return Kits
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--[[
	Remotes
	Bütün RemoteEvent ve RemoteFunction nesnelerini tek yerden oluşturur (sunucu) veya bulur (istemci).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"DataChanged",
	"Notify",
	"CreateCareer",
	"UpgradeStat",
	"UnlockSkill",
	"UpgradeFacility",
	"SetCrest",
	"PreviewAppearance",
	"Anim",
	"TrainingGoal",
	"MatchStart",
	"MatchEnd",
	"MatchResult",
}
local FUNCTIONS = { "GetData" }

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = folder
		end
	end
	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local f = Instance.new("RemoteFunction")
			f.Name = name
			f.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

function Remotes.Get(name: string): any
	if RunService:IsServer() then
		return folder:FindFirstChild(name)
	end
	return folder:WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Squads</string><ProtectedString name="Source"><![CDATA[--[[
	Squads
	Kulüpler, teknik direktörler ve kadrolar. Rakip kulüplerin adı, renkleri ve arması hazırdır;
	oyuncunun kulübü kendi adını ve renklerini kullanır. Her futbolcunun kendi özellikleri vardır.
	Bütün adlar kurgudur; aynı kulüp her zaman aynı kadroyu verir (tohumlu üretim).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Squads = {}

local rgb = Color3.fromRGB

-- Kademe başına 5 rakip kulüp (lig 6 takımlı). Crest: 1 kalkan, 2 daire, 3 altıgen, 4 flama, 5 elmas
Squads.Clubs = {
	{
		{ Name = "Yeldeğirmeni Spor", Abbr = "YLD", Coach = "Rıfat Karaduman", A = rgb(196, 48, 48), B = rgb(250, 250, 250), Crest = 2 },
		{ Name = "Kuşdili Gücü", Abbr = "KŞD", Coach = "Sabri Yılmazer", A = rgb(34, 139, 90), B = rgb(20, 20, 24), Crest = 1 },
		{ Name = "Hasanpaşa İdman", Abbr = "HSP", Coach = "Nevzat Oktay", A = rgb(240, 140, 30), B = rgb(30, 30, 80), Crest = 4 },
		{ Name = "Acıbadem Gençlik", Abbr = "ACB", Coach = "Cemil Aydoğdu", A = rgb(120, 60, 160), B = rgb(245, 245, 245), Crest = 3 },
		{ Name = "Rasimpaşa SK", Abbr = "RSM", Coach = "Halit Erçetin", A = rgb(60, 140, 210), B = rgb(250, 250, 250), Crest = 5 },
	},
	{
		{ Name = "Karşıyaka Yıldızı", Abbr = "KYY", Coach = "Orhan Denizli", A = rgb(200, 40, 60), B = rgb(20, 110, 60), Crest = 1 },
		{ Name = "Bozkır Belediye", Abbr = "BZK", Coach = "Mümtaz Akın", A = rgb(230, 190, 40), B = rgb(140, 30, 30), Crest = 3 },
		{ Name = "Kıyı Demirspor", Abbr = "KDS", Coach = "Selahattin Uçar", A = rgb(40, 60, 130), B = rgb(160, 200, 240), Crest = 2 },
		{ Name = "Yayla Kartalları", Abbr = "YYK", Coach = "Bekir Tunalı", A = rgb(20, 20, 24), B = rgb(250, 250, 250), Crest = 4 },
		{ Name = "Ova Şekerspor", Abbr = "OVŞ", Coach = "İlhami Sezgin", A = rgb(30, 150, 110), B = rgb(250, 250, 250), Crest = 5 },
	},
	{
		{ Name = "Ege Limanspor", Abbr = "EGL", Coach = "Tayfun Özbek", A = rgb(30, 110, 190), B = rgb(250, 220, 60), Crest = 1 },
		{ Name = "Toros Şimşekleri", Abbr = "TRŞ", Coach = "Kenan Bozdağ", A = rgb(230, 90, 30), B = rgb(20, 20, 24), Crest = 5 },
		{ Name = "Kapadokya FK", Abbr = "KPD", Coach = "Adnan Güleryüz", A = rgb(170, 60, 80), B = rgb(250, 240, 220), Crest = 3 },
		{ Name = "Marmara Atletik", Abbr = "MRM", Coach = "Levent Soylu", A = rgb(20, 130, 130), B = rgb(250, 250, 250), Crest = 2 },
		{ Name = "Trakya Rüzgarı", Abbr = "TRK", Coach = "Ziya Kocabaş", A = rgb(90, 50, 140), B = rgb(240, 200, 60), Crest = 4 },
	},
	{
		{ Name = "Anadolu Kaplanları", Abbr = "AKP", Coach = "Ferit Aksoylu", A = rgb(230, 120, 20), B = rgb(20, 20, 24), Crest = 1 },
		{ Name = "Karadeniz Fırtına", Abbr = "KRF", Coach = "Temel Hacıoğlu", A = rgb(120, 20, 50), B = rgb(100, 180, 230), Crest = 3 },
		{ Name = "Başkent Birliği", Abbr = "BŞB", Coach = "Ercüment Sayın", A = rgb(200, 30, 40), B = rgb(250, 250, 250), Crest = 2 },
		{ Name = "Akdeniz Yelkenspor", Abbr = "AKY", Coach = "Bülent Karaca", A = rgb(20, 150, 200), B = rgb(250, 250, 250), Crest = 5 },
		{
			Name = "Güney Yıldırım",
			Abbr = "GNY",
			Coach = "Şükrü Altıntaş",
			A = rgb(30, 120, 60),
			B = rgb(240, 210, 60),
			Crest = 4,
		},
	},
	{
		{ Name = "Boğaziçi Kartal", Abbr = "BĞK", Coach = "Tuncay Sarıoğlu", A = rgb(24, 24, 28), B = rgb(250, 250, 250), Crest = 1 },
		{ Name = "Haliç Aslanları", Abbr = "HLÇ", Coach = "Fikret Uzunoğlu", A = rgb(190, 30, 40), B = rgb(250, 190, 40), Crest = 2 },
		{ Name = "Kuzey Fırtınası", Abbr = "KZF", Coach = "Şenol Akçay", A = rgb(110, 20, 50), B = rgb(90, 170, 230), Crest = 3 },
		{ Name = "İpekyolu FK", Abbr = "İPK", Coach = "Aykut Demirel", A = rgb(230, 110, 30), B = rgb(30, 60, 140), Crest = 5 },
		{
			Name = "Başakşehir Yıldızı",
			Abbr = "BŞY",
			Coach = "Abdullah Turan",
			A = rgb(240, 120, 30),
			B = rgb(20, 30, 70),
			Crest = 4,
		},
	},
}
Squads.Clubs[6] = Squads.Clubs[5]

local FIRST = {
	"Ahmet",
	"Mehmet",
	"Emre",
	"Burak",
	"Can",
	"Deniz",
	"Efe",
	"Furkan",
	"Gökhan",
	"Hakan",
	"İsmail",
	"Kerem",
	"Levent",
	"Mert",
	"Onur",
	"Ozan",
	"Polat",
	"Rüzgar",
	"Serkan",
	"Tolga",
	"Umut",
	"Volkan",
	"Yiğit",
	"Zafer",
	"Barış",
	"Çağan",
	"Doruk",
	"Eren",
	"Kaan",
	"Tuna",
	"Alper",
	"Berk",
	"Sinan",
	"Taylan",
	"Koray",
	"Batuhan",
}
local LAST = {
	"Yıldırım",
	"Kaya",
	"Demirci",
	"Aslan",
	"Çelik",
	"Şahin",
	"Öztürk",
	"Aydın",
	"Arslan",
	"Doğan",
	"Kılıç",
	"Çetin",
	"Koç",
	"Kurt",
	"Özkan",
	"Şimşek",
	"Polat",
	"Korkmaz",
	"Erdem",
	"Güneş",
	"Aktaş",
	"Bulut",
	"Yavuz",
	"Tekin",
	"Bozkurt",
	"Karaca",
	"Uysal",
	"Sönmez",
	"Ateş",
	"Duman",
	"Tuncer",
	"Eroğlu",
	"Akgül",
	"Savaş",
	"Ünal",
	"Toprak",
}

Squads.Roles = { "KL", "SLB", "STP", "STP", "SĞB", "SLO", "MO", "MO", "SĞO", "SF", "SF" }
local NUMBERS = { 1, 2, 4, 5, 3, 7, 6, 8, 11, 9, 10 }
-- Mevkiye göre özellik eğilimi: Hız, Şut, Pas, Top, Defans, Fizik
local BIAS = {
	KL = { -8, -30, -6, -10, 6, 6 },
	SLB = { 6, -12, 2, 0, 4, 0 },
	["SĞB"] = { 6, -12, 2, 0, 4, 0 },
	STP = { -4, -16, -4, -6, 10, 8 },
	SLO = { 8, 0, 4, 6, -8, -4 },
	["SĞO"] = { 8, 0, 4, 6, -8, -4 },
	MO = { 0, -2, 8, 6, 0, 0 },
	SF = { 4, 10, -2, 4, -16, 2 },
}
Squads.StatOrder = { "Hız", "Şut", "Pas", "Top", "Def", "Fiz" }

local function rng(seed: number): () -> number
	local s = seed % 2147483647
	if s <= 0 then
		s += 2147483646
	end
	return function()
		s = (s * 16807) % 2147483647
		return (s - 1) / 2147483646
	end
end

local function hash(text: string): number
	local h = 7
	for i = 1, #text do
		h = (h * 31 + string.byte(text, i)) % 2147483647
	end
	return h
end

-- Adın baş harfi (Türkçe harfler birden çok bayt tutar; bayt olarak kesilmez)
local function initial(name: string): string
	for _, code in utf8.codes(name) do
		return utf8.char(code)
	end
	return ""
end

-- Kadroda aynı ad iki kez çıkmasın: kullanılan adlar tutulur, çakışırsa yeniden çekilir
local function uniqueName(R: () -> number, used: { [string]: boolean }): string
	local name = ""
	for _ = 1, 12 do
		name = initial(FIRST[1 + math.floor(R() * #FIRST)]) .. ". " .. LAST[1 + math.floor(R() * #LAST)]
		if not used[name] then
			break
		end
	end
	used[name] = true
	return name
end

-- Bir kulübün 11'i. avg: ortalama güç (0-99)
function Squads.Build(club, avg: number)
	local R = rng(hash(club.Name) + 17)
	local players = {}
	local used = {}
	for slot = 1, 11 do
		local role = Squads.Roles[slot]
		local rating = math.clamp(math.floor(avg + (R() - 0.5) * 12 + 0.5), 20, 99)
		local stats = {}
		local bias = BIAS[role]
		for i = 1, 6 do
			stats[i] = math.clamp(math.floor(rating + bias[i] + (R() - 0.5) * 10 + 0.5), 10, 99)
		end
		players[slot] = {
			slot = slot,
			number = NUMBERS[slot],
			name = uniqueName(R, used),
			full = "",
			role = role,
			rating = rating,
			stats = stats,
			pace = math.clamp(1 + (stats[1] - avg) / 120, 0.9, 1.1), -- takım ortalamasına göre hız çarpanı
		}
	end
	return players
end

-- Yedek kulübesi: 5 oyuncu (kaleci, stoper, orta saha, kanat, forvet), forma 12-16
local BENCH_ROLES = { "KL", "STP", "MO", "SLO", "SF" }
function Squads.Bench(club, avg: number, taken: { any }?)
	local R = rng(hash(club.Name) + 4001)
	local players = {}
	local used = {}
	for _, p in ipairs(taken or {}) do
		used[p.name] = true
	end
	for i, role in ipairs(BENCH_ROLES) do
		local rating = math.clamp(math.floor(avg - 2 + (R() - 0.5) * 12 + 0.5), 20, 99)
		local stats = {}
		for k = 1, 6 do
			stats[k] = math.clamp(math.floor(rating + BIAS[role][k] + (R() - 0.5) * 10 + 0.5), 10, 99)
		end
		players[i] = {
			number = 11 + i,
			name = uniqueName(R, used),
			role = role,
			rating = rating,
			stats = stats,
			pace = math.clamp(1 + (stats[1] - avg) / 120, 0.9, 1.1),
		}
	end
	return players
end

-- Sıradaki rakip: sezon içindeki maç sırasına göre döner
function Squads.Opponent(tier: number, seasonNumber: number, played: number)
	local list = Squads.Clubs[math.clamp(tier, 1, #Squads.Clubs)]
	return list[1 + (played + seasonNumber * 2) % #list]
end

--[[ Puan durumu. Oyuncunun kulübünün puanı gerçek sonuçlardan gelir; diğer kulüplerin sonuçları
	sezona ve kulübe bağlı tohumla üretilir (aynı sezon hep aynı tabloyu verir).
	Döner: { { club, played, won, drawn, lost, points, mine }, ... } puana göre sıralı ]]
function Squads.Table(data)
	local tierId = if data.career and data.career.atFenerbahce then 6 else data.club.tier
	local season = data.club.season or { number = 1, played = 0, points = 0 }
	local rows = {}
	for _, club in ipairs(Squads.Clubs[math.clamp(tierId, 1, #Squads.Clubs)]) do
		local R = rng(hash(club.Name) + season.number * 131)
		local strength = 0.3 + R() * 0.3 -- kulübün o sezonki formu
		local won, drawn, lost = 0, 0, 0
		for _ = 1, season.played do
			local x = R()
			if x < strength then
				won += 1
			elseif x < strength + 0.26 then
				drawn += 1
			else
				lost += 1
			end
		end
		table.insert(rows, { club = club, played = season.played, won = won, drawn = drawn, lost = lost, points = won * 3 + drawn })
	end
	local homeName = if tierId == 6 then "Fenerbahçe" elseif data.club.name ~= "" then data.club.name else "Kulübüm"
	table.insert(rows, {
		club = {
			Name = homeName,
			Abbr = if tierId == 6 then "FB" elseif data.club.abbr ~= "" then data.club.abbr else "EV",
			A = Config.Colors.Yellow,
			B = Config.Colors.Navy,
			Crest = data.club.crestShape or 1,
			CrestSpec = if tierId == 6 then nil else data.club.crest,
		},
		played = season.played,
		points = season.points or 0,
		mine = true,
	})
	table.sort(rows, function(x, y)
		if x.points ~= y.points then
			return x.points > y.points
		end
		if x.mine ~= y.mine then
			return x.mine == true -- eşitlikte oyuncunun kulübü üstte
		end
		return x.club.Name < y.club.Name
	end)
	return rows, Config.Tiers[tierId].League, season.number
end

-- Maç eşleşmesi: iki kulüp, kadrolar ve teknik direktörler
function Squads.Fixture(data)
	local tierId = if data.career and data.career.atFenerbahce then 6 else data.club.tier
	local tier = Config.Tiers[tierId]
	local avg = (tier.BotPower[1] + tier.BotPower[2]) / 2
	local season = data.club.season or { number = 1, played = 0 }
	local oppDef = Squads.Opponent(tierId, season.number, season.played)
	local homeName = if tierId == 6 then "Fenerbahçe" elseif data.club.name ~= "" then data.club.name else "Kulübüm"
	local homeDef = {
		Name = homeName,
		Abbr = if tierId == 6 then "FB" elseif data.club.abbr ~= "" then data.club.abbr else "EV",
		Coach = "",
		A = Config.Colors.Yellow,
		B = Config.Colors.Navy,
		Crest = data.club.crestShape or 1,
		CrestSpec = if tierId == 6 then nil else data.club.crest, -- oyuncunun tasarladığı arma
	}
	local R = rng(hash(homeName) + 99)
	homeDef.Coach = FIRST[1 + math.floor(R() * #FIRST)] .. " " .. LAST[1 + math.floor(R() * #LAST)]
	local home = Squads.Build(homeDef, avg + 1)
	local slot = Config.FormationSlot[data.position] or 11
	local me = home[slot]
	me.name = data.name
	me.number = data.number or me.number
	me.rating = math.clamp(data.power or 30, 1, 99)
	me.human = true
	local s = data.stats or {}
	local function pct(key: string): number
		return math.clamp(math.floor(25 + (s[key] or 1) / Config.StatMax * 70 + 0.5), 1, 99)
	end
	me.stats = { pct("Hiz"), pct("Sut"), pct("Pas"), pct("TopKontrolu"), pct("Defans"), pct("Fizik") }
	-- aynı forma numarası iki kişide olmasın
	for _, p in ipairs(home) do
		if p ~= me and p.number == me.number then
			p.number = NUMBERS[slot]
		end
	end
	return {
		tier = tierId,
		league = tier.League,
		stadium = tier.Stadium,
		avg = avg,
		matchNo = (season.played or 0) + 1,
		home = { club = homeDef, players = home, bench = Squads.Bench(homeDef, avg + 1, home) },
		away = (function()
			local eleven = Squads.Build(oppDef, avg)
			return { club = oppDef, players = eleven, bench = Squads.Bench(oppDef, avg, eleven) }
		end)(),
	}
end

return Squads
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Stadium</string><ProtectedString name="Source"><![CDATA[--[[
	Stadium
	Kulübün kademesine göre maç sahasının çevresini kurar: tribünler, seyirci, çatı,
	projektörler, LED panolar, dev ekran, şehir ve ağaçlar. Işık ve atmosfer de buradan ayarlanır.

	Her şey istemcide kurulur (tek kişilik maç): her oyuncu kendi kulübünün stadını görür.
	Model yüklemeden, yalnızca parçalarla ve yüzey arayüzleriyle çalışır.

	Stadium.Build(tier, info)   -> stadı kurar, ışığı ayarlar
	Stadium.Clear()             -> stadı kaldırır, lobi ışığına döner
	Stadium.Lobby()             -> lobi/deneme sahası ışığı ve çevresi
	Stadium.Cheer()             -> seyirci zıplar
	Stadium.Screen(title, text, color, hold) -> dev ekranda olay gösterir (ekranı olan statlarda)
	Stadium.Score(home, away, homeGoals, awayGoals, minute) -> skor tabelası / dev ekran
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Theme = require(ReplicatedStorage.UI.Theme)

local Stadium = {}

local C = Config.Colors
local rgb = Color3.fromRGB
local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy)
local MONO = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)

local CONCRETE = rgb(150, 154, 162)
local DARK = rgb(52, 57, 72)
local SKIN = rgb(226, 184, 150)

local current: Model? = nil
local crowdLayers: { Frame } = {}
local screens: { { title: TextLabel, text: TextLabel, score: TextLabel, bar: Frame } } = {}
local boards: { TextLabel } = {}
local screenToken = 0

--------------------------------------------------------------------------------
-- Işık ve atmosfer
--------------------------------------------------------------------------------
local MOODS = {
	Lobi = {
		Clock = 14.2,
		Brightness = 3,
		Ambient = rgb(120, 126, 150),
		Outdoor = rgb(150, 155, 170),
		Top = rgb(255, 244, 220),
		Exposure = 0.15,
		Density = 0.28,
		Haze = 1.2,
		Air = rgb(205, 220, 245),
		Decay = rgb(120, 150, 200),
		Bloom = 0.35,
		Saturation = 0.12,
		Contrast = 0.06,
		Tint = rgb(255, 255, 255),
		Rays = 0.08,
	},
	BulutluGunduz = {
		Clock = 13,
		Brightness = 2.2,
		Ambient = rgb(140, 144, 150),
		Outdoor = rgb(165, 168, 172),
		Top = rgb(235, 238, 245),
		Exposure = 0.1,
		Density = 0.42,
		Haze = 2.4,
		Air = rgb(200, 205, 212),
		Decay = rgb(150, 156, 165),
		Bloom = 0.2,
		Saturation = -0.04,
		Contrast = 0.04,
		Tint = rgb(246, 248, 255),
		Rays = 0.02,
	},
	OgledenSonra = {
		Clock = 15.4,
		Brightness = 3.2,
		Ambient = rgb(118, 122, 140),
		Outdoor = rgb(150, 152, 160),
		Top = rgb(255, 238, 205),
		Exposure = 0.12,
		Density = 0.3,
		Haze = 1.4,
		Air = rgb(210, 222, 240),
		Decay = rgb(140, 160, 200),
		Bloom = 0.3,
		Saturation = 0.14,
		Contrast = 0.07,
		Tint = rgb(255, 252, 244),
		Rays = 0.1,
	},
	GunBatimi = {
		Clock = 17.55,
		Brightness = 2.8,
		Ambient = rgb(128, 112, 120),
		Outdoor = rgb(160, 138, 130),
		Top = rgb(255, 196, 130),
		Exposure = 0.2,
		Density = 0.34,
		Haze = 2,
		Air = rgb(255, 205, 160),
		Decay = rgb(240, 130, 70),
		Bloom = 0.5,
		Saturation = 0.18,
		Contrast = 0.08,
		Tint = rgb(255, 244, 232),
		Rays = 0.18,
	},
	Alacakaranlik = {
		Clock = 18.25,
		Brightness = 2.2,
		Ambient = rgb(128, 128, 150),
		Outdoor = rgb(150, 150, 172),
		Top = rgb(255, 214, 180),
		Exposure = 0.35,
		Density = 0.32,
		Haze = 1.8,
		Air = rgb(170, 170, 215),
		Decay = rgb(200, 110, 110),
		Bloom = 0.65,
		Saturation = 0.16,
		Contrast = 0.08,
		Tint = rgb(246, 244, 255),
		Rays = 0.06,
	},
	-- Gece: ay tepeye yakın tutulur ve güçlendirilir; saha projektör altındaymış gibi aydınlık kalır
	Gece = {
		Clock = 0.4,
		Brightness = 3.4,
		Ambient = rgb(118, 124, 150),
		Outdoor = rgb(132, 138, 165),
		Top = rgb(232, 240, 255),
		Exposure = 0.45,
		Density = 0.3,
		Haze = 1.6,
		Air = rgb(70, 84, 130),
		Decay = rgb(30, 40, 80),
		Bloom = 0.8,
		Saturation = 0.2,
		Contrast = 0.1,
		Tint = rgb(244, 247, 255),
		Rays = 0,
	},
	GeceMaci = {
		Clock = 0.2,
		Brightness = 3.8,
		Ambient = rgb(124, 130, 158),
		Outdoor = rgb(140, 146, 176),
		Top = rgb(238, 244, 255),
		Exposure = 0.5,
		Density = 0.33,
		Haze = 1.9,
		Air = rgb(60, 76, 140),
		Decay = rgb(24, 34, 86),
		Bloom = 0.95,
		Saturation = 0.24,
		Contrast = 0.12,
		Tint = rgb(246, 248, 255),
		Rays = 0,
	},
}

local function effect(class: string): Instance
	local name = "FK_" .. class
	local e = Lighting:FindFirstChild(name)
	if not e then
		e = Instance.new(class)
		e.Name = name
		e.Parent = Lighting
	end
	return e
end

local function mood(name: string)
	local m = MOODS[name] or MOODS.Lobi
	Lighting.ClockTime = m.Clock
	Lighting.GeographicLatitude = 28
	Lighting.Brightness = m.Brightness
	Lighting.Ambient = m.Ambient
	Lighting.OutdoorAmbient = m.Outdoor
	Lighting.ColorShift_Top = m.Top
	Lighting.ColorShift_Bottom = rgb(40, 60, 40)
	Lighting.ExposureCompensation = m.Exposure
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.FogEnd = 100000

	local a = effect("Atmosphere") :: any
	a.Density = m.Density
	a.Offset = 0.1
	a.Haze = m.Haze
	a.Glare = 0.2
	a.Color = m.Air
	a.Decay = m.Decay

	local b = effect("BloomEffect") :: any
	b.Intensity = m.Bloom
	b.Size = 28
	b.Threshold = 1.6

	local cc = effect("ColorCorrectionEffect") :: any
	cc.Saturation = m.Saturation
	cc.Contrast = m.Contrast
	cc.Brightness = 0.02
	cc.TintColor = m.Tint

	local r = effect("SunRaysEffect") :: any
	r.Intensity = m.Rays
	r.Spread = 0.6
end

--------------------------------------------------------------------------------
-- Yardımcılar
--------------------------------------------------------------------------------
-- Aynı kademe her zaman aynı stadı versin diye kendi sayı üretecimiz
local function rng(seed: number): () -> number
	local s = seed % 2147483647
	if s <= 0 then
		s += 2147483646
	end
	return function()
		s = (s * 16807) % 2147483647
		return (s - 1) / 2147483646
	end
end

local function builder(model: Model)
	return function(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shadow: boolean?): Part
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = shadow == true
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
end

local function surface(part: BasePart, pps: number, bright: number?): SurfaceGui
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pps
	g.LightInfluence = if bright then 0 else 1
	g.Brightness = bright or 1
	g.ResetOnSpawn = false
	g.Parent = part
	return g
end

local function label(parent: Instance, text: string, color: Color3, size: UDim2?, pos: UDim2?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size or UDim2.fromScale(1, 1)
	t.Position = pos or UDim2.fromScale(0, 0)
	t.FontFace = FONT
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Parent = parent
	return t
end

--------------------------------------------------------------------------------
-- Stat kurucu
--------------------------------------------------------------------------------
type Info = { club: string?, abbr: string?, facilities: { [string]: number }?, stadium: string? }

local function build(model: Model, tier: number, info: Info, pitch, withMood: boolean)
	local part = builder(model)
	local R = rng(tier * 7919 + 13)
	local night = tier >= 5
	local dusk = tier == 4
	local midZ = (pitch.MinZ + pitch.MaxZ) / 2
	local hx, hz = (pitch.MaxX - pitch.MinX) / 2, (pitch.MaxZ - pitch.MinZ) / 2
	local gy = pitch.GroundY
	local fac = info.facilities or {}
	local clubName = if info.club and info.club ~= "" then Theme.Upper(info.club) else "FENER KARİYER"

	-- Tribün çerçeveleri: yerel +Z sahadan dışarı bakar, başlangıç noktası çizginin ortasıdır
	local FR = {
		N = CFrame.new(0, gy, midZ + hz),
		S = CFrame.new(0, gy, midZ - hz) * CFrame.Angles(0, math.pi, 0),
		E = CFrame.new(hx, gy, midZ) * CFrame.Angles(0, math.pi / 2, 0),
		W = CFrame.new(-hx, gy, midZ) * CFrame.Angles(0, -math.pi / 2, 0),
	}
	local HALF = { N = hx, S = hx, E = hz, W = hz }
	local function corner(sx: number, sz: number): CFrame
		return CFrame.new(sx * hx, gy, midZ + sz * hz) * CFrame.Angles(0, math.atan2(sx, sz), 0)
	end

	local seatA = if tier >= 6 then C.Navy elseif tier >= 4 then rgb(24, 40, 110) else rgb(70, 82, 110)
	local seatB = if tier >= 6 then C.Yellow elseif tier >= 4 then rgb(230, 205, 30) else rgb(96, 104, 124)
	local wallC = if tier >= 6 then rgb(22, 30, 78) elseif tier >= 4 then rgb(70, 76, 96) else CONCRETE
	local shirts = { C.Yellow, C.Navy, rgb(245, 245, 245) }

	-- Seyirci: eğimli koltuk yüzeyine noktalarla çizilir (gövde + baş), iki katman şaşırtmalı
	local function crowd(slab: Part, lenPx: number, heightPx: number, density: number)
		local g = surface(slab, 10)
		local ts = 38
		local cols = math.max(4, math.floor(lenPx / (ts * 0.6)))
		local rows = math.max(1, math.floor(heightPx / (ts * 1.32)))
		for layer = 0, 1 do
			local holder = Instance.new("Frame")
			holder.BackgroundTransparency = 1
			holder.Size = UDim2.fromScale(1, 1)
			holder.Position = UDim2.fromOffset(layer * ts * 0.3, layer * ts * 0.66)
			holder.Parent = g
			local body = { {}, {}, {} }
			local head = {}
			for _ = 1, rows do
				local line = { {}, {}, {} }
				local hl = {}
				for c = 1, cols do
					local who = 0
					if R() < density then
						local r = R()
						who = if r < 0.5 then 1 elseif r < 0.82 then 2 else 3
					end
					for k = 1, 3 do
						line[k][c] = if who == k then "•" else " "
					end
					hl[c] = if who > 0 then "•" else " "
				end
				for k = 1, 3 do
					table.insert(body[k], table.concat(line[k]))
				end
				table.insert(head, table.concat(hl))
			end
			local function dots(lines: { string }, color: Color3, dy: number)
				local t = Instance.new("TextLabel")
				t.BackgroundTransparency = 1
				t.Size = UDim2.fromScale(1, 1)
				t.Position = UDim2.fromOffset(0, dy)
				t.FontFace = MONO
				t.TextSize = ts
				t.TextColor3 = color
				t.TextXAlignment = Enum.TextXAlignment.Left
				t.TextYAlignment = Enum.TextYAlignment.Top
				t.Text = table.concat(lines, "\n")
				t.Parent = holder
			end
			for k = 1, 3 do
				dots(body[k], shirts[k], 0)
			end
			dots(head, SKIN, -ts * 0.24)
			table.insert(crowdLayers, holder)
		end
	end

	--[[ Bir tribün bloğu.
		len: uzunluk, margin: çizgiden uzaklık, depth: derinlik, y0: ön yükseklik, rise: yükselme,
		density: doluluk (0-1), solid: altı dolu mu, offset: uzunluk ekseninde kaydırma ]]
	local function stand(frame: CFrame, o)
		local len, margin, depth, y0, rise = o.len, o.margin, o.depth, o.y0, o.rise
		local off = o.offset or 0
		local a = math.atan2(rise, depth)
		local slope = math.sqrt(depth * depth + rise * rise)
		local segs = math.max(1, math.ceil(len / 100))
		local segLen = len / segs
		for i = 1, segs do
			local x = off - len / 2 + (i - 0.5) * segLen
			local slab = part(
				Vector3.new(segLen, slope, 0.6),
				frame * CFrame.new(x, y0 + rise / 2, margin + depth / 2) * CFrame.Angles(math.pi / 2 - a, 0, 0),
				if (i + (o.flip or 0)) % 2 == 0 then seatA else seatB,
				Enum.Material.SmoothPlastic,
				true
			)
			slab.Name = "Seats"
			if o.density and o.density > 0 then
				crowd(slab, segLen * 10, slope * 10, o.density)
			end
		end
		-- ön duvar
		part(Vector3.new(len, y0 + 1.2, 1), frame * CFrame.new(off, (y0 + 1.2) / 2, margin - 0.5), wallC, Enum.Material.Concrete, true)
		if o.solid ~= false then
			-- altını dolduran basamaklı gövde
			for k = 1, 3 do
				local h = y0 + rise * k / 4 - 0.8
				if h > 0.5 then
					part(
						Vector3.new(len, h, depth / 4),
						frame * CFrame.new(off, h / 2, margin + depth * (k + 0.5) / 4),
						wallC,
						Enum.Material.Concrete,
						false
					)
				end
			end
		else
			-- üst kat: alt yüzey ve kirişler
			part(
				Vector3.new(len, slope, 1.6),
				frame * CFrame.new(off, y0 + rise / 2 - 1.3, margin + depth / 2 + 0.6) * CFrame.Angles(math.pi / 2 - a, 0, 0),
				DARK,
				Enum.Material.Concrete,
				true
			)
			part(Vector3.new(len, 2.6, 1.2), frame * CFrame.new(off, y0 - 0.2, margin - 0.4), if tier >= 6 then C.Yellow else wallC)
		end
		-- arka duvar
		local top = y0 + rise
		part(
			Vector3.new(len, top + 4, 1.4),
			frame * CFrame.new(off, (top + 4) / 2, margin + depth + 0.7),
			wallC,
			Enum.Material.Concrete,
			true
		)
		return top, margin + depth
	end

	-- Çatı: arkadan öne uzanan konsol, ön kenarında sarı şerit
	local function roof(frame: CFrame, len: number, zFront: number, zBack: number, y: number, glow: boolean)
		local span = zBack - zFront + 4
		local tilt = math.rad(5)
		local cf = frame * CFrame.new(0, y, (zFront + zBack) / 2 + 2) * CFrame.Angles(-tilt, 0, 0)
		part(Vector3.new(len, 1.2, span), cf, if tier >= 5 then rgb(176, 184, 204) else rgb(140, 146, 158), Enum.Material.Metal, true)
		local edge = part(
			Vector3.new(len, 2.2, 0.8),
			cf * CFrame.new(0, -0.5, -span / 2),
			C.Yellow,
			if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
		)
		edge.Name = "RoofEdge"
		if glow then
			-- çatı altı ışık hattı
			part(Vector3.new(len * 0.96, 0.5, 1.6), cf * CFrame.new(0, -1, -span / 2 + 3), rgb(255, 250, 235), Enum.Material.Neon)
		end
		local n = math.max(2, math.floor(len / 60))
		for i = 0, n do
			local x = -len / 2 + 3 + (len - 6) * i / n
			part(Vector3.new(1.6, y, 1.6), frame * CFrame.new(x, y / 2, zBack + 3), DARK, Enum.Material.Metal, true)
			-- çapraz kiriş
			part(Vector3.new(0.8, 0.8, span * 0.7), cf * CFrame.new(x, -1.2, span * 0.12), DARK, Enum.Material.Metal)
		end
	end

	-- Projektör direği
	local function tower(x: number, z: number, h: number, head: number, on: boolean)
		local pos = Vector3.new(x, gy, midZ + z)
		local look = CFrame.lookAt(pos + Vector3.new(0, h, 0), Vector3.new(0, gy + h * 0.2, midZ))
		local pole = part(
			Vector3.new(h, 2.2, 2.2),
			CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			DARK,
			Enum.Material.Metal,
			true
		)
		pole.Shape = Enum.PartType.Cylinder
		part(Vector3.new(head * 1.5, head, 1.2), look, rgb(40, 44, 54), Enum.Material.Metal, true)
		local lamp = part(
			Vector3.new(head * 1.5 - 1, head - 1, 0.4),
			look * CFrame.new(0, 0, -0.7),
			if on then rgb(255, 250, 232) else rgb(200, 205, 212),
			if on then Enum.Material.Neon else Enum.Material.Glass
		)
		if on then
			local l = Instance.new("SpotLight")
			l.Face = Enum.NormalId.Front
			l.Angle = 70
			l.Range = 60
			l.Brightness = 3
			l.Color = rgb(255, 248, 230)
			l.Parent = lamp
		end
	end

	-- Sahaya bakan tabela (yazı önden okunur)
	local function sign(cf: CFrame, w: number, h: number, text: string, fg: Color3, bg: Color3, glow: boolean?): TextLabel
		local p = part(Vector3.new(w, h, 0.5), cf, bg, if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic)
		local g = surface(p, math.clamp(1200 / w, 4, 30), if glow then 1.6 else nil)
		return label(g, text, fg, UDim2.fromScale(0.94, 0.8), UDim2.fromScale(0.03, 0.1))
	end

	-- Dev ekran / skor tabelası
	local function screen(cf: CFrame, w: number, h: number, big: boolean)
		part(Vector3.new(w + 3, h + 3, 1.4), cf * CFrame.new(0, 0, 0.9), rgb(18, 20, 28), Enum.Material.Metal, true)
		local p = part(Vector3.new(w, h, 0.4), cf, rgb(6, 10, 30), Enum.Material.SmoothPlastic)
		local g = surface(p, math.clamp(1100 / w, 5, 24), 1.8)
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = rgb(8, 14, 46)
		bg.BorderSizePixel = 0
		bg.Parent = g
		local grad = Instance.new("UIGradient")
		grad.Rotation = 90
		grad.Color = ColorSequence.new(rgb(20, 34, 104), rgb(5, 9, 30))
		grad.Parent = bg
		local bar = Instance.new("Frame")
		bar.Size = UDim2.fromScale(1, 0.05)
		bar.BackgroundColor3 = C.Yellow
		bar.BorderSizePixel = 0
		bar.Parent = bg
		local title = label(bg, if big then clubName else "SKOR", C.Yellow, UDim2.fromScale(0.9, 0.2), UDim2.fromScale(0.05, 0.08))
		local score = label(bg, "0 - 0", C.White, UDim2.fromScale(0.9, 0.42), UDim2.fromScale(0.05, 0.3))
		local text = label(bg, "", rgb(200, 210, 245), UDim2.fromScale(0.9, 0.18), UDim2.fromScale(0.05, 0.76))
		if big then
			table.insert(screens, { title = title, text = text, score = score, bar = bar })
		else
			table.insert(boards, score)
			title.Text = clubName
			text.Text = info.stadium or ""
		end
	end

	-- Çevre: bina, ağaç, çit
	local function city(n: number, rmin: number, rmax: number, hmin: number, hmax: number)
		local tones = { rgb(196, 188, 172), rgb(168, 172, 180), rgb(206, 196, 178), rgb(150, 156, 170), rgb(182, 164, 150) }
		for _ = 1, n do
			local a = R() * math.pi * 2
			local r = rmin + R() * (rmax - rmin)
			local w, d, h = 26 + R() * 34, 26 + R() * 30, hmin + R() * (hmax - hmin)
			local cf = CFrame.new(math.cos(a) * r, gy, midZ + math.sin(a) * r * 1.15)
				* CFrame.Angles(0, math.floor(R() * 4) * math.pi / 2 + (R() - 0.5) * 0.3, 0)
			local tone = tones[1 + math.floor(R() * #tones)]
			part(
				Vector3.new(w, h, d),
				cf * CFrame.new(0, h / 2, 0),
				if night then tone:Lerp(rgb(30, 36, 60), 0.55) else tone,
				Enum.Material.Concrete,
				not night
			)
			part(Vector3.new(w + 1.5, 1.2, d + 1.5), cf * CFrame.new(0, h + 0.6, 0), DARK, Enum.Material.Concrete)
			-- pencere şeritleri
			local floors = math.min(5, math.floor(h / 14))
			for f = 1, floors do
				local lit = (night or dusk) and R() < 0.7
				local wc = if lit then rgb(255, 214, 140) else rgb(70, 88, 120)
				local y = h * f / (floors + 1)
				local s = part(
					Vector3.new(w + 0.3, 3.2, d + 0.3),
					cf * CFrame.new(0, y, 0),
					wc,
					if lit then Enum.Material.Neon else Enum.Material.Glass
				)
				s.Transparency = if lit then 0.15 else 0
			end
		end
	end

	local function trees(n: number, rmin: number, rmax: number)
		for _ = 1, n do
			local a = R() * math.pi * 2
			local r = rmin + R() * (rmax - rmin)
			local x, z = math.cos(a) * r, midZ + math.sin(a) * r * 1.2
			local h = 16 + R() * 12
			local trunk = part(
				Vector3.new(h, 2.4, 2.4),
				CFrame.new(x, gy + h / 2, z) * CFrame.Angles(0, 0, math.pi / 2),
				rgb(92, 66, 44),
				Enum.Material.Wood,
				true
			)
			trunk.Shape = Enum.PartType.Cylinder
			local g = if night then rgb(28, 62, 44) else rgb(52 + R() * 24, 122 + R() * 30, 58)
			for k = 0, 2 do
				local s = (15 - k * 3) + R() * 4
				local leaf = part(
					Vector3.new(s, s, s),
					CFrame.new(x + (R() - 0.5) * 5, gy + h + k * 5 - 2, z + (R() - 0.5) * 5),
					g,
					Enum.Material.Grass,
					true
				)
				leaf.Shape = Enum.PartType.Ball
			end
		end
	end

	local function fence(mx: number, mz: number, h: number)
		local c = rgb(120, 126, 132)
		for _, sx in ipairs({ -1, 1 }) do
			local f = part(Vector3.new(0.3, h, (hz + mz) * 2), CFrame.new(sx * (hx + mx), gy + h / 2, midZ), c, Enum.Material.DiamondPlate)
			f.Transparency = 0.55
		end
		for _, sz in ipairs({ -1, 1 }) do
			local f =
				part(Vector3.new((hx + mx) * 2, h, 0.3), CFrame.new(0, gy + h / 2, midZ + sz * (hz + mz)), c, Enum.Material.DiamondPlate)
			f.Transparency = 0.55
		end
		local n = 14
		for i = 0, n do
			for _, sx in ipairs({ -1, 1 }) do
				part(
					Vector3.new(0.6, h + 1, 0.6),
					CFrame.new(sx * (hx + mx), gy + (h + 1) / 2, midZ - hz - mz + (hz + mz) * 2 * i / n),
					DARK,
					Enum.Material.Metal
				)
			end
		end
	end

	-- LED pano hattı (kademe 3 ve üstü): parlayan şeritler ve kayan yazı
	local function led(frame: CFrame, len: number, margin: number)
		local words = { clubName, "FENER KARİYER", "SARI LACİVERT", Theme.Upper(info.stadium or "STADYUM"), "1907" }
		local n = math.max(2, math.floor(len / 52))
		local w = len / n
		for i = 1, n do
			local x = -len / 2 + (i - 0.5) * w
			local yellow = i % 2 == 0
			sign(
				frame * CFrame.new(x, 2, margin),
				w - 0.6,
				3.4,
				words[1 + (i % #words)],
				if yellow then C.Navy else C.Yellow,
				if yellow then C.Yellow else rgb(14, 26, 92),
				true
			)
		end
	end

	------------------------------------------------------------------ zemin
	local groundC = if tier == 1 then rgb(122, 116, 96) elseif tier <= 3 then rgb(92, 122, 78) else rgb(56, 60, 70)
	part(
		Vector3.new(2400, 1, 2400),
		CFrame.new(0, gy - 1.2, midZ),
		groundC,
		if tier <= 3 then Enum.Material.Grass else Enum.Material.Asphalt
	)
	if tier >= 2 then
		-- saha çevresi koşu yolu / beton
		part(
			Vector3.new(hx * 2 + 56, 0.2, hz * 2 + 66),
			CFrame.new(0, gy - 0.12, midZ),
			if tier >= 4 then rgb(64, 70, 84) else rgb(150, 92, 74),
			Enum.Material.Concrete
		)
	end

	if tier == 1 then
		-- yıpranmış çim: kale önleri ve orta saha toprak
		local dirt = rgb(132, 110, 76)
		for _, s in ipairs({ { 0, -hz + 14, 34, 22 }, { 0, hz - 14, 34, 22 }, { 0, 0, 22, 22 }, { -50, 60, 26, 16 }, { 56, -70, 30, 18 } }) do
			local d = part(
				Vector3.new(0.05, s[4] * 2, s[3] * 2),
				CFrame.new(s[1], gy + 0.02, midZ + s[2]) * CFrame.Angles(0, 0, math.pi / 2),
				dirt,
				Enum.Material.Ground
			)
			d.Shape = Enum.PartType.Cylinder
			d.Transparency = 0.35
		end
	end

	------------------------------------------------------------------ kademeler
	local ext = 60 -- stadın en dış yarıçapı için pay
	local glow = night
	if tier == 1 then
		-- Mahalle sahası: tek küçük tribün, tel örgü, kulüp binası
		stand(FR.W, { len = 110, margin = 22, depth = 12, y0 = 2, rise = 6, density = 0.22 })
		if (fac.TribunEki or 0) >= 1 then
			stand(FR.E, { len = 80 + 40 * fac.TribunEki, margin = 22, depth = 10, y0 = 2, rise = 5, density = 0.2 })
		end
		fence(18, 20, 9)
		-- kulüp binası
		local hut = CFrame.new(-hx - 52, gy, midZ - 96)
		part(Vector3.new(36, 13, 50), hut * CFrame.new(0, 6.5, 0), rgb(214, 206, 188), Enum.Material.Concrete, true)
		part(Vector3.new(40, 1.4, 54), hut * CFrame.new(0, 13.7, 0), rgb(140, 62, 50), Enum.Material.Slate, true)
		sign(hut * CFrame.new(18.4, 9, 0) * CFrame.Angles(0, -math.pi / 2, 0), 40, 5, clubName, C.Yellow, C.Navy)
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
			tower(c[1] * (hx + 26), c[2] * (hz + 6), 42, 5, (fac.Aydinlatma or 0) >= 1)
		end
		screen(FR.N * CFrame.new(60, 13, 26), 26, 12, false)
		ext = 60
	elseif tier == 2 then
		local top, back = stand(FR.W, { len = 230, margin = 22, depth = 26, y0 = 3, rise = 13, density = 0.5 })
		roof(FR.W, 230, 26, back, top + 13, false)
		stand(FR.E, { len = 150 + 40 * (fac.TribunEki or 0), margin = 22, depth = 14, y0 = 3, rise = 7, density = 0.4 })
		fence(20, 24, 8)
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
			tower(c[1] * (hx + 46), c[2] * (hz + 10), 62, 8, false)
		end
		screen(FR.N * CFrame.new(0, 16, 30), 40, 16, false)
		ext = 80
	elseif tier == 3 then
		for _, s in ipairs({ "W", "E" }) do
			local top, back =
				stand(FR[s], { len = 300, margin = 22, depth = 34, y0 = 3, rise = 18, density = 0.68, flip = if s == "E" then 1 else 0 })
			roof(FR[s], 300, 30, back, top + 14, false)
		end
		stand(FR.N, { len = 190, margin = 26, depth = 22, y0 = 3, rise = 11, density = 0.6 })
		stand(FR.S, { len = 190, margin = 26, depth = 22, y0 = 3, rise = 11, density = 0.55 })
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
			tower(c[1] * (hx + 64), c[2] * (hz + 44), 96, 12, false)
		end
		screen(FR.N * CFrame.new(0, 26, 52), 56, 22, false)
		ext = 110
	else
		-- Kapalı çanak: dört tribün + köşeler; 5 ve 6'da çift kat
		local depth = if tier == 4 then 44 else 40
		local rise = if tier == 4 then 26 else 20
		local dens = if tier == 4 then 0.8 elseif tier == 5 then 0.9 else 0.97
		local margin = 22
		local upperD, upperR = if tier == 6 then 44 else 38, if tier == 6 then 34 else 28
		local outer = margin + depth
		local roofY = 0
		local i = 0
		for name, frame in pairs(FR) do
			i += 1
			local len = HALF[name] * 2 + margin * 2
			local top, back = stand(frame, { len = len, margin = margin, depth = depth, y0 = 3.5, rise = rise, density = dens, flip = i })
			if tier >= 5 then
				local um = margin + depth * 0.72
				top, back = stand(frame, {
					len = len + (um - margin) * 2,
					margin = um,
					depth = upperD,
					y0 = top + 7,
					rise = upperR,
					density = dens,
					solid = false,
					flip = i + 1,
				})
				part(
					Vector3.new(len + 40, top + 4, 3),
					frame * CFrame.new(0, (top + 4) / 2, back + 2.5),
					wallC,
					Enum.Material.Concrete,
					true
				)
			end
			roofY = top + 16
			outer = back
			roof(frame, len + (back - margin - depth) * 2, back - (if tier >= 5 then 46 else 30), back, roofY, glow)
		end
		for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
			local frame = corner(c[1], c[2])
			local m = margin * 1.42
			local top, back =
				stand(frame, { len = depth * 1.5, margin = m, depth = depth * 1.05, y0 = 3.5, rise = rise, density = dens, flip = 1 })
			if tier >= 5 then
				top, back = stand(frame, {
					len = (depth + upperD) * 1.55,
					margin = m + depth * 0.8,
					depth = upperD * 1.05,
					y0 = top + 7,
					rise = upperR,
					density = dens,
					solid = false,
				})
			end
			-- köşe çatısı ve dış kule
			part(
				Vector3.new((back - m) * 1.9, 1.2, back - m + 10),
				frame * CFrame.new(0, roofY - 1.5, (m + back) / 2 + 12),
				if tier >= 5 then rgb(176, 184, 204) else rgb(140, 146, 158),
				Enum.Material.Metal,
				true
			)
			part(Vector3.new(16, roofY + 6, 16), frame * CFrame.new(0, (roofY + 6) / 2, back + 16), wallC, Enum.Material.Concrete, true)
			if tier == 4 then
				tower(c[1] * (hx + outer + 26), c[2] * (hz + outer + 26), roofY + 60, 16, true)
			end
		end
		-- dış cephe: sarı-lacivert dikmeler ve stat adı
		for name, frame in pairs(FR) do
			local len = HALF[name] * 2 + (outer + 4) * 2
			local n = math.floor(len / 22)
			for k = 0, n do
				local x = -len / 2 + len * k / n
				part(
					Vector3.new(2.4, roofY + 2, 2.4),
					frame * CFrame.new(x, (roofY + 2) / 2, outer + 6),
					if tier >= 6 then (if k % 2 == 0 then C.Yellow else C.Navy) else rgb(110, 118, 140),
					Enum.Material.Metal,
					true
				)
			end
			sign(
				frame * CFrame.new(0, roofY * 0.62, outer + 7.6) * CFrame.Angles(0, math.pi, 0),
				math.min(len * 0.6, 260),
				roofY * 0.2,
				if tier >= 6 then "FENERBAHÇE" else Theme.Upper(info.stadium or "STADYUM"),
				C.Yellow,
				C.Navy,
				night
			)
		end
		-- dev ekranlar: kale arkası üst köşelerde
		local sw, sh = if tier == 6 then 84 else 66, if tier == 6 then 34 else 27
		local sy = roofY - sh / 2 - 6
		screen(FR.N * CFrame.new(0, sy, outer - 8), sw, sh, true)
		screen(FR.S * CFrame.new(0, sy, outer - 8), sw, sh, true)
		ext = outer + 40
	end

	if tier >= 3 then
		led(FR.N, hx * 2 - 20, 15)
		led(FR.S, hx * 2 - 20, 15)
		led(FR.E, hz * 2 - 10, 17)
		led(FR.W, hz * 2 - 10, 17)
	end
	-- yedek kulübeleri
	if tier >= 2 then
		for _, z in ipairs({ -44, 44 }) do
			local f = FR.W * CFrame.new(z, 0, 9)
			part(Vector3.new(30, 0.8, 5), f * CFrame.new(0, 0.4, 0), DARK, Enum.Material.Concrete)
			part(Vector3.new(28, 1.6, 2), f * CFrame.new(0, 1.6, 1), C.Navy)
			local glass = part(Vector3.new(30, 6, 0.4), f * CFrame.new(0, 3.6, 2.8), rgb(160, 200, 235), Enum.Material.Glass)
			glass.Transparency = 0.55
			local top = part(Vector3.new(30, 0.4, 5.6), f * CFrame.new(0, 6.6, 0.4), rgb(160, 200, 235), Enum.Material.Glass, true)
			top.Transparency = 0.45
		end
	end

	------------------------------------------------------------------ çevre
	local r0 = math.sqrt((hx + ext) ^ 2 + (hz + ext) ^ 2) * 0.86
	if tier == 1 then
		trees(34, r0 + 10, r0 + 170)
		city(16, r0 + 70, r0 + 330, 28, 56)
	elseif tier == 2 then
		trees(40, r0 + 20, r0 + 200)
		city(20, r0 + 90, r0 + 380, 30, 70)
	elseif tier == 3 then
		trees(34, r0 + 20, r0 + 190)
		city(26, r0 + 90, r0 + 420, 36, 96)
	else
		trees(22, r0 + 30, r0 + 150)
		city(if tier == 6 then 44 else 34, r0 + 80, r0 + 520, 50, if tier == 6 then 190 else 140)
	end

	if withMood then
		mood(Config.Tiers[tier].Light)
	end
end

--------------------------------------------------------------------------------
-- Dış arayüz
--------------------------------------------------------------------------------
function Stadium.Clear()
	if current then
		current:Destroy()
		current = nil
	end
	crowdLayers = {}
	screens = {}
	boards = {}
	screenToken += 1
	mood("Lobi")
end

-- info: { club, abbr, facilities, atFenerbahce }
function Stadium.Build(tier: number, info: Info?)
	Stadium.Clear()
	tier = math.clamp(tier, 1, #Config.Tiers)
	local model = Instance.new("Model")
	model.Name = "FK_Stadium"
	local i: Info = info or {}
	i.stadium = i.stadium or Config.Tiers[tier].Stadium
	build(model, tier, i, Config.MatchPitch, true)
	model.Parent = Workspace
	current = model
	return model
end

-- Lobi ve deneme sahası: ışık + çevre (bir kez kurulur)
local lobbyBuilt = false
function Stadium.Lobby()
	mood("Lobi")
	if lobbyBuilt then
		return
	end
	lobbyBuilt = true
	local model = Instance.new("Model")
	model.Name = "FK_LobbyWorld"
	local part = builder(model)
	local R = rng(4242)
	local T = Config.TestPitch
	local cz = (T.MinZ + T.MaxZ) / 2
	part(Vector3.new(2000, 1, 2000), CFrame.new(0, T.GroundY - 1.3, cz), rgb(96, 128, 82), Enum.Material.Grass)
	-- antrenman tesisi: çit, küçük tribün, binalar, ağaçlar
	for _, sx in ipairs({ -1, 1 }) do
		local f = part(Vector3.new(0.3, 10, 200), CFrame.new(sx * 128, 5, cz), rgb(120, 126, 132), Enum.Material.DiamondPlate)
		f.Transparency = 0.55
		for i = 0, 8 do
			part(Vector3.new(0.7, 11, 0.7), CFrame.new(sx * 128, 5.5, cz - 100 + i * 25), DARK, Enum.Material.Metal)
		end
	end
	local back = part(Vector3.new(256, 10, 0.3), CFrame.new(0, 5, T.MaxZ + 22), rgb(120, 126, 132), Enum.Material.DiamondPlate)
	back.Transparency = 0.55
	for i = 0, 5 do
		local a = R() * 0.2
		local x = -330 + i * 132
		local h = 40 + R() * 50
		local cf = CFrame.new(x, 0, T.MaxZ + 190 + R() * 80) * CFrame.Angles(0, a, 0)
		part(Vector3.new(60, h, 44), cf * CFrame.new(0, h / 2, 0), rgb(200, 192, 176), Enum.Material.Concrete, true)
		for f = 1, 3 do
			part(Vector3.new(60.4, 3.4, 44.4), cf * CFrame.new(0, h * f / 4, 0), rgb(70, 88, 120), Enum.Material.Glass)
		end
	end
	for _ = 1, 46 do
		local a = R() * math.pi * 2
		local r = 190 + R() * 240
		local x, z = math.cos(a) * r, cz + math.sin(a) * r
		if z > 30 or math.abs(x) > 70 then
			local h = 16 + R() * 12
			local trunk = part(
				Vector3.new(h, 2.4, 2.4),
				CFrame.new(x, h / 2, z) * CFrame.Angles(0, 0, math.pi / 2),
				rgb(92, 66, 44),
				Enum.Material.Wood,
				true
			)
			trunk.Shape = Enum.PartType.Cylinder
			for k = 0, 2 do
				local s = (15 - k * 3) + R() * 4
				local leaf = part(
					Vector3.new(s, s, s),
					CFrame.new(x + (R() - 0.5) * 5, h + k * 5 - 2, z + (R() - 0.5) * 5),
					rgb(52 + R() * 24, 122 + R() * 30, 58),
					Enum.Material.Grass,
					true
				)
				leaf.Shape = Enum.PartType.Ball
			end
		end
	end
	-- tesis tabelası
	local p = part(Vector3.new(120, 14, 1), CFrame.new(0, 16, T.MaxZ + 24), C.Navy)
	local g = surface(p, 10)
	label(g, "FENER KARİYER  •  ANTRENMAN TESİSİ", C.Yellow, UDim2.fromScale(0.94, 0.7), UDim2.fromScale(0.03, 0.15))
	for _, x in ipairs({ -58, 58 }) do
		part(Vector3.new(2, 24, 2), CFrame.new(x, 12, T.MaxZ + 24.5), DARK, Enum.Material.Metal, true)
	end
	model.Parent = Workspace
end

-- Seyirci zıplaması (golde)
function Stadium.Cheer()
	for i, holder in ipairs(crowdLayers) do
		local base = holder.Position
		local up = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset - 9)
		local tw = TweenService:Create(
			holder,
			TweenInfo.new(0.16 + (i % 3) * 0.02, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 7, true),
			{ Position = up }
		)
		tw:Play()
	end
end

-- Dev ekranda olay: başlık + açıklama; süre bitince skora döner
function Stadium.Screen(title: string, text: string, color: Color3?, hold: number?)
	screenToken += 1
	local token = screenToken
	for _, s in ipairs(screens) do
		s.title.Text = title
		s.title.TextColor3 = color or C.Yellow
		s.bar.BackgroundColor3 = color or C.Yellow
		s.text.Text = text
	end
	task.delay(hold or 5, function()
		if token ~= screenToken then
			return
		end
		for _, s in ipairs(screens) do
			s.title.TextColor3 = C.Yellow
			s.bar.BackgroundColor3 = C.Yellow
			s.text.Text = ""
		end
	end)
end

function Stadium.HasScreen(): boolean
	return #screens > 0
end

function Stadium.Score(home: string, away: string, hg: number, ag: number, minute: number?)
	local line = string.format("%s  %d - %d  %s", home, hg, ag, away)
	for _, s in ipairs(screens) do
		s.score.Text = line
		if s.text.Text == "" or string.sub(s.text.Text, -1) == "'" then
			s.text.Text = if minute then tostring(minute) .. "'" else ""
		end
	end
	for _, b in ipairs(boards) do
		b.Text = string.format("%d - %d", hg, ag)
	end
end

return Stadium
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX12"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Components</string><ProtectedString name="Source"><![CDATA[--[[
	Components
	Ortak arayüz parçaları: Panel, Button, Bar, Badge, Label, Stripes, Toast.
	Hepsi Theme ve UIMotion kullanır. Ekranlar bu parçalardan kurulur.
]]

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local UIMotion = require(script.Parent.UIMotion)

local C = Theme.Color
local Components = {}

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function stroke(parent: Instance, color: Color3, thickness: number?, transparency: number?)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or Theme.Stroke
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function padding(parent: Instance, px: number, py: number?)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, py or px)
	p.PaddingBottom = UDim.new(0, py or px)
	p.Parent = parent
	return p
end
Components.Corner = corner
Components.Stroke = stroke
Components.Padding = padding

-- Metin. props: Text, Size (TextSize), Color, Font, Upper, Align
function Components.Label(props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.FontFace = props.Font or Theme.Font.Body
	l.TextSize = props.Size or 16
	l.TextColor3 = props.Color or C.Text
	l.Text = if props.Upper then Theme.Upper(props.Text or "") else (props.Text or "")
	l.TextXAlignment = props.Align or Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.TextWrapped = props.Wrap == true
	l.TextTruncate = if props.Wrap then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd
	l.AutomaticSize = props.Auto or Enum.AutomaticSize.None
	l.Size = props.Frame or UDim2.new(1, 0, 0, (props.Size or 16) + 6)
	l.LayoutOrder = props.Order or 0
	return l
end

--[[ Kabartmalı (3B gölgeli) yazı: arkasında tabela olmadan, sahnenin üstünde okunur.
	Altında koyu katmanlar (kalınlık), çevresinde koyu kontur, yüzünde hafif ışık geçişi vardır.
	props: Label ile aynı + Depth (kalınlık, piksel; varsayılan boyuta göre)
	Döner: holder (yerleştirilecek kutu), label (Text / TextColor3 buradan değiştirilir) ]]
function Components.Label3D(props)
	local size = props.Size or 16
	local depth = props.Depth or math.clamp(math.floor(size / 9 + 0.5), 1, 5)
	local holder = Instance.new("Frame")
	holder.Name = props.Name or "Label3D"
	holder.BackgroundTransparency = 1
	holder.Size = props.Frame or UDim2.new(1, 0, 0, size + 6 + depth)
	holder.LayoutOrder = props.Order or 0
	local inner = table.clone(props)
	inner.Frame = UDim2.new(1, 0, 1, -depth)
	inner.Font = props.Font or Theme.Font.Display
	local layers = {}
	-- kalınlık: aşağı doğru kayan koyu kopyalar
	for i = depth, 1, -1 do
		local s = Components.Label(inner)
		s.Name = "Depth"
		s.TextColor3 = Color3.fromRGB(4, 8, 28)
		s.TextTransparency = if i == depth then 0.45 else 0.1
		s.Position = UDim2.fromOffset(0, i)
		stroke(s, Color3.fromRGB(4, 8, 28), math.max(1.5, size / 14), if i == depth then 0.45 else 0.1).ApplyStrokeMode =
			Enum.ApplyStrokeMode.Contextual
		s.Parent = holder
		table.insert(layers, s)
	end
	local label = Components.Label(inner)
	label.Name = "Face"
	stroke(label, Color3.fromRGB(4, 8, 28), math.max(1.5, size / 14), 0).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local shade = Instance.new("UIGradient")
	shade.Rotation = 90
	shade.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 200, 214))
	shade.Parent = label
	label.Parent = holder
	label:GetPropertyChangedSignal("Text"):Connect(function()
		for _, s in ipairs(layers) do
			s.Text = label.Text
		end
	end)
	return holder, label
end

-- Eğik sarı-lacivert çubuk şeridi (panel köşesi süsü). Üst öğe CanvasGroup olmalı ki kırpılsın.
function Components.Stripes(count: number?, width: number?)
	local holder = Instance.new("Frame")
	holder.Name = "Stripes"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset((count or 5) * (width or 10) * 1.6, 60)
	for i = 1, count or 5 do
		local b = Instance.new("Frame")
		b.BorderSizePixel = 0
		b.BackgroundColor3 = if i % 2 == 0 then C.Blue else C.Yellow
		b.BackgroundTransparency = if i % 2 == 0 then 0.2 else 0.05
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Size = UDim2.new(0, width or 10, 2, 0)
		b.Position = UDim2.new(0, (i - 0.5) * (width or 10) * 1.6, 0.5, 0)
		b.Rotation = Theme.Skew
		b.Parent = holder
	end
	return holder
end

-- Cam panel. props: Size, Position, AnchorPoint, Title, Accent (köşe çubukları), Gold
-- Dönen: panel (CanvasGroup), içerik (Frame)
function Components.Panel(props)
	local p = Instance.new("CanvasGroup")
	p.Name = props.Name or "Panel"
	p.Size = props.Size or UDim2.fromOffset(320, 200)
	p.Position = props.Position or UDim2.new()
	p.AnchorPoint = props.AnchorPoint or Vector2.zero
	p.BackgroundColor3 = C.Navy
	p.BackgroundTransparency = Theme.PanelTransparency
	p.BorderSizePixel = 0
	corner(p, Theme.Corner.Medium)

	-- Dikey renk geçişi: üstte açık, altta koyu (cam hissi)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(Color3.fromRGB(215, 225, 255), Color3.fromRGB(150, 160, 215))
	g.Parent = p

	-- Çerçeve: üstte sarı, alta doğru sönen çizgi
	local s = stroke(p, if props.Gold then C.Gold else C.Yellow, Theme.Stroke, 0.15)
	local sg = Instance.new("UIGradient")
	sg.Rotation = 90
	sg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.35, 0.75),
		NumberSequenceKeypoint.new(1, 0.9),
	})
	sg.Parent = s

	-- Üst parlak kenar
	local hi = Instance.new("Frame")
	hi.Name = "Highlight"
	hi.BorderSizePixel = 0
	hi.BackgroundColor3 = C.White
	hi.BackgroundTransparency = 0.82
	hi.Size = UDim2.new(1, 0, 0, 1)
	hi.Parent = p

	if props.Accent ~= false then
		local st = Components.Stripes(6, 8)
		st.AnchorPoint = Vector2.new(1, 0)
		st.Position = UDim2.new(1, 6, 0, -14)
		st.Parent = p
		-- çubuklar yavaşça kayar (panel canlı dursun)
		local drift = game:GetService("TweenService"):Create(
			st,
			TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Position = UDim2.new(1, 30, 0, -14) }
		)
		if not UIMotion.Reduced then
			drift:Play()
		end
	end

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Size = UDim2.fromScale(1, 1)
	content.Parent = p
	padding(content, 16, 14)

	if props.Title then
		local t = Components.Label({ Text = props.Title, Size = 18, Font = Theme.Font.Display, Color = C.Yellow, Upper = true })
		t.Parent = content
		local line = Instance.new("Frame")
		line.BorderSizePixel = 0
		line.BackgroundColor3 = C.Yellow
		line.Size = UDim2.fromOffset(0, 3)
		line.Position = UDim2.fromOffset(0, 26)
		line.Parent = content
		task.delay(0.25, function()
			UIMotion.Tween(line, 0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { Size = UDim2.fromOffset(46, 3) })
		end)
	end
	return p, content
end

-- Buton. props: Text, Style ("Primary" | "Secondary" | "Ghost"), Size, Locked (neden kilitli metni), OnClick
function Components.Button(props)
	local style = props.Style or "Primary"
	local locked = props.Locked ~= nil
	local b = Instance.new("TextButton")
	b.Name = props.Name or "Button"
	b.AutoButtonColor = false
	b.Text = ""
	b.Size = props.Size or UDim2.new(1, 0, 0, 52)
	b.BorderSizePixel = 0
	b.ClipsDescendants = true
	b.LayoutOrder = props.Order or 0
	b.BackgroundColor3 = if locked
		then Color3.fromRGB(42, 52, 112)
		elseif style == "Primary" then C.Yellow
		elseif style == "Secondary" then C.Blue
		else C.Navy
	b.BackgroundTransparency = if style == "Ghost" and not locked then 0.6 else 0
	corner(b, Theme.Corner.Small)
	if style == "Ghost" then
		stroke(b, C.Yellow, Theme.Stroke, 0.1)
	elseif style == "Secondary" then
		stroke(b, C.White, 1, 0.85)
	end
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(C.White, Color3.fromRGB(205, 205, 215))
	grad.Parent = b

	local scale = Instance.new("UIScale")
	scale.Parent = b

	local textColor = if locked then C.Muted elseif style == "Primary" then C.Navy elseif style == "Ghost" then C.Yellow else C.Text
	local hasSub = props.Sub ~= nil
	local label = Components.Label({
		Text = props.Text,
		Size = props.TextSize or 19,
		Font = Theme.Font.Display,
		Color = textColor,
		Upper = true,
		Align = if hasSub then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center,
		Frame = if hasSub then UDim2.new(1, -70, 0, 24) else UDim2.fromScale(1, 1),
	})
	if hasSub then
		label.Position = UDim2.fromOffset(30, 9)
		local sub = Components.Label({
			Text = props.Sub,
			Size = 12,
			Font = Theme.Font.Body,
			Color = if style == "Primary" and not locked then C.Navy else C.Muted,
			Frame = UDim2.new(1, -70, 0, 16),
		})
		sub.Position = UDim2.fromOffset(30, 34)
		sub.Parent = b
	end
	label.Parent = b

	-- sağda ok: üzerine gelince ileri kayar
	local arrow = Components.Label({
		Text = if locked then "×" else "›",
		Size = 30,
		Font = Theme.Font.Display,
		Color = textColor,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(0, 30, 1, 0),
	})
	arrow.AnchorPoint = Vector2.new(1, 0)
	arrow.Position = UDim2.new(1, -10, 0, -2)
	arrow.Visible = hasSub or props.Arrow == true
	arrow.Parent = b

	-- parlayan çerçeve ve aralıklı ışık süpürmesi (yalnız birincil buton)
	if style == "Primary" and not locked then
		local glow = stroke(b, C.White, 2, 0.75)
		UIMotion.Glow(glow, 0.85, 0.3, 1.2)
		UIMotion.ShineLoop(b, 3.4)
	end

	-- Sol kenarda eğik vurgu çizgisi (birincil butonda lacivert, diğerlerinde sarı)
	if not locked then
		local slash = Instance.new("Frame")
		slash.BorderSizePixel = 0
		slash.BackgroundColor3 = if style == "Primary" then C.Navy else C.Yellow
		slash.BackgroundTransparency = if style == "Primary" then 0.8 else 0.25
		slash.AnchorPoint = Vector2.new(0.5, 0.5)
		slash.Size = UDim2.new(0, 6, 2, 0)
		slash.Position = UDim2.new(0, 14, 0.5, 0)
		slash.Rotation = Theme.Skew
		slash.Parent = b
	end

	local hover = false
	b.MouseEnter:Connect(function()
		hover = true
		UIMotion.Tween(scale, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Scale = 1.04 })
		UIMotion.Tween(arrow, 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Position = UDim2.new(1, -4, 0, -2) })
		if not locked then
			UIMotion.Shine(b)
		end
	end)
	b.MouseLeave:Connect(function()
		hover = false
		UIMotion.Tween(scale, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Scale = 1 })
		UIMotion.Tween(arrow, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Position = UDim2.new(1, -10, 0, -2) })
	end)
	b.MouseButton1Down:Connect(function()
		UIMotion.Tween(scale, 0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Scale = 0.96 })
	end)
	b.MouseButton1Up:Connect(function()
		UIMotion.Tween(scale, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = if hover then 1.04 else 1 })
	end)
	b.Activated:Connect(function(input)
		if locked then
			UIMotion.Sound("ErrorSound")
			UIMotion.Shake(b)
			Components.Toast("error", props.Locked)
			return
		end
		UIMotion.Sound("ClickSound")
		local pos
		if input and input.Position then
			pos = Vector2.new(input.Position.X, input.Position.Y)
		else
			local m = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
			pos = m
		end
		UIMotion.Ripple(b, pos)
		UIMotion.Flash(b)
		if props.OnClick then
			props.OnClick(b)
		end
	end)
	return b, label
end

-- İlerleme çubuğu. Dönen nesne: { Frame, Set(oran, anında?) }
function Components.Bar(props)
	local track = Instance.new("Frame")
	track.Name = "Bar"
	track.BorderSizePixel = 0
	track.BackgroundColor3 = C.Ground
	track.Size = props.Size or UDim2.new(1, 0, 0, 10)
	track.LayoutOrder = props.Order or 0
	track.ClipsDescendants = true
	corner(track, 5)
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = props.Color or C.Yellow
	fill.Size = UDim2.fromScale(0, 1)
	corner(fill, 5)
	fill.Parent = track
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.fromRGB(190, 190, 190), C.White)
	g.Parent = fill
	-- Uçta parlama
	local tip = Instance.new("Frame")
	tip.BorderSizePixel = 0
	tip.BackgroundColor3 = C.White
	tip.BackgroundTransparency = 0.35
	tip.AnchorPoint = Vector2.new(1, 0)
	tip.Position = UDim2.fromScale(1, 0)
	tip.Size = UDim2.new(0, 6, 1, 0)
	tip.Parent = fill
	local api = { Frame = track, Value = 0 }
	function api.Set(ratio: number, instant: boolean?)
		ratio = math.clamp(ratio, 0, 1)
		api.Value = ratio
		if instant then
			fill.Size = UDim2.fromScale(ratio, 1)
		else
			UIMotion.Tween(fill, 0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { Size = UDim2.fromScale(ratio, 1) })
		end
	end
	api.Set(props.Value or 0, true)
	return api
end

-- Kalkan rozet. props: Text, Size (piksel), Color, Image (arma)
function Components.Badge(props)
	local size = props.Size or 56
	local g = Instance.new("CanvasGroup")
	g.Name = "Badge"
	g.BackgroundTransparency = 1
	g.Size = UDim2.fromOffset(size, size * 1.16)
	g.LayoutOrder = props.Order or 0
	if props.Image and props.Image ~= "" then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Image = props.Image
		img.Size = UDim2.fromScale(1, 1)
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = g
		return g
	end
	local color = props.Color or C.Yellow
	local top = Instance.new("Frame")
	top.BorderSizePixel = 0
	top.BackgroundColor3 = color
	top.Size = UDim2.fromScale(1, 0.62)
	top.Parent = g
	local tipHolder = Instance.new("Frame")
	tipHolder.BorderSizePixel = 0
	tipHolder.BackgroundColor3 = color
	tipHolder.AnchorPoint = Vector2.new(0.5, 0.5)
	tipHolder.Position = UDim2.fromScale(0.5, 0.62)
	tipHolder.Size = UDim2.fromOffset(size * 0.7072, size * 0.7072)
	tipHolder.Rotation = 45
	tipHolder.Parent = g
	local l = Components.Label({
		Text = props.Text or "F",
		Size = size * 0.44,
		Font = Theme.Font.Display,
		Color = props.TextColor or C.Navy,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.fromScale(1, 0.72),
	})
	l.ZIndex = 2
	l.Parent = g
	return g
end

-- Bildirimler: sağ üstten kayar. kind: success | error | unlock | level | info
local toastHolder: Frame? = nil
function Components.SetToastHolder(holder: Frame)
	toastHolder = holder
end

function Components.Toast(kind: string, text: string)
	if not toastHolder then
		return
	end
	local color = if kind == "error"
		then C.Bad
		elseif kind == "success" then C.Good
		elseif kind == "unlock" or kind == "level" then C.Gold
		else C.Yellow
	local card = Instance.new("CanvasGroup")
	card.Name = "Toast"
	card.Size = UDim2.new(1, 0, 0, 54)
	card.BackgroundColor3 = C.Navy
	card.BackgroundTransparency = 0.05
	card.BorderSizePixel = 0
	corner(card, Theme.Corner.Small)
	stroke(card, color, Theme.Stroke, 0.2)
	local bar = Instance.new("Frame")
	bar.BorderSizePixel = 0
	bar.BackgroundColor3 = color
	bar.AnchorPoint = Vector2.new(0.5, 0.5)
	bar.Position = UDim2.new(0, 10, 0.5, 0)
	bar.Size = UDim2.new(0, 7, 2, 0)
	bar.Rotation = Theme.Skew
	bar.Parent = card
	local l = Components.Label({ Text = text, Size = 15, Wrap = true, Frame = UDim2.new(1, -40, 1, 0) })
	l.Position = UDim2.fromOffset(30, 0)
	l.Parent = card
	local timer = Instance.new("Frame")
	timer.BorderSizePixel = 0
	timer.BackgroundColor3 = color
	timer.BackgroundTransparency = 0.2
	timer.AnchorPoint = Vector2.new(0, 1)
	timer.Position = UDim2.fromScale(0, 1)
	timer.Size = UDim2.new(1, 0, 0, 3)
	timer.Parent = card
	UIMotion.Tween(timer, 3.2, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, { Size = UDim2.new(0, 0, 0, 3) })
	card.Parent = toastHolder
	UIMotion.Sound(if kind == "error" then "ErrorSound" elseif kind == "unlock" or kind == "level" then "RewardSound" else "ConfirmSound")
	-- Liste düzeni konumu yönettiği için giriş saydamlık + ölçekle yapılır
	card.GroupTransparency = 1
	UIMotion.Tween(card, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { GroupTransparency = 0 })
	UIMotion.Pop(card, 0.85)
	task.delay(3.2, function()
		local tw = UIMotion.Tween(card, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { GroupTransparency = 1 })
		tw.Completed:Once(function()
			card:Destroy()
		end)
	end)
end

return Components
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Forms</string><ProtectedString name="Source"><![CDATA[--[[
	Forms
	Girdi bileşenleri: TextInput, Chips (tekli/çoklu seçim), Slider, Stepper, Swatches, Tabs, Modal.
	Hepsi Theme ve UIMotion kullanır; her değişiklikte küçük bir tepki animasyonu oynar.
]]

local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local UIMotion = require(script.Parent.UIMotion)
local Components = require(script.Parent.Components)

local C = Theme.Color
local Forms = {}

local Q, OUT = Enum.EasingStyle.Quad, Enum.EasingDirection.Out

local function row(gap: number, height: number?, order: number?)
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.Size = UDim2.new(1, 0, 0, height or 40)
	f.LayoutOrder = order or 0
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.Padding = UDim.new(0, gap)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.Wraps = true
	l.Parent = f
	f.AutomaticSize = Enum.AutomaticSize.Y
	return f
end
Forms.Row = row

-- Küçük başlık etiketi
function Forms.Caption(text: string, order: number?)
	return Components.Label({
		Text = text,
		Size = 12,
		Color = C.Muted,
		Font = Theme.Font.Title,
		Upper = true,
		Order = order,
		Frame = UDim2.new(1, 0, 0, 16),
	})
end

-- Metin kutusu. props: Text, Placeholder, MaxLength, Width, Upper, OnChange(text)
function Forms.TextInput(props)
	local holder = Instance.new("Frame")
	holder.Name = "TextInput"
	holder.BackgroundColor3 = C.Ground
	holder.BorderSizePixel = 0
	holder.Size = props.Size or UDim2.new(1, 0, 0, 40)
	holder.LayoutOrder = props.Order or 0
	Components.Corner(holder, Theme.Corner.Small)
	local st = Components.Stroke(holder, C.White, 1.5, 0.84)
	local box = Instance.new("TextBox")
	box.BackgroundTransparency = 1
	box.Size = UDim2.new(1, -24, 1, 0)
	box.Position = UDim2.fromOffset(12, 0)
	box.ClearTextOnFocus = false
	box.FontFace = Theme.Font.Body
	box.TextSize = 17
	box.TextColor3 = C.Text
	box.PlaceholderColor3 = C.Muted
	box.PlaceholderText = props.Placeholder or ""
	box.Text = props.Text or ""
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.Parent = holder
	local max = props.MaxLength or 16
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local t = box.Text
		if props.Upper then
			t = string.upper(t)
		end
		if props.Pattern then
			t = string.gsub(t, props.Pattern, "")
		end
		if utf8.len(t) and utf8.len(t) > max then
			t = string.sub(t, 1, utf8.offset(t, max + 1) - 1)
		end
		if t ~= box.Text then
			box.Text = t
			return
		end
		if props.OnChange then
			props.OnChange(t)
		end
	end)
	box.Focused:Connect(function()
		UIMotion.Tween(st, 0.15, Q, OUT, { Color = C.Yellow, Transparency = 0 })
	end)
	box.FocusLost:Connect(function()
		UIMotion.Tween(st, 0.15, Q, OUT, { Color = C.White, Transparency = 0.84 })
	end)
	return holder, box
end

-- Seçim çipleri. props: Options = { {Id, Text, Locked?} }, Value (tekli) veya Values (çoklu tablo), Multi, OnChange
function Forms.Chips(props)
	local holder = row(6, 34, props.Order)
	holder.Name = "Chips"
	local chips = {}
	local api = { Frame = holder, Value = props.Value, Values = props.Values or {} }
	local function paint()
		for id, chip in pairs(chips) do
			local on = if props.Multi then api.Values[id] == true else api.Value == id
			UIMotion.Tween(chip, 0.12, Q, OUT, { BackgroundColor3 = if on then C.Yellow else C.Ground })
			chip.Label.TextColor3 = if on then C.Navy else (if chip:GetAttribute("Locked") then C.Muted else C.Text)
			chip.Stroke.Transparency = if on then 1 else 0.8
		end
	end
	for i, opt in ipairs(props.Options) do
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.Text = ""
		b.BackgroundColor3 = C.Ground
		b.BorderSizePixel = 0
		b.Size = UDim2.fromOffset(props.ChipWidth or 0, 34)
		b.AutomaticSize = if props.ChipWidth then Enum.AutomaticSize.None else Enum.AutomaticSize.X
		b.LayoutOrder = i
		Components.Corner(b, Theme.Corner.Small)
		local st = Components.Stroke(b, C.White, 1, 0.8)
		st.Name = "Stroke"
		local l = Components.Label({
			Text = opt.Text,
			Size = 14,
			Font = Theme.Font.Title,
			Upper = true,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.new(0, 0, 1, 0),
			Auto = Enum.AutomaticSize.X,
		})
		l.Name = "Label"
		if props.ChipWidth then
			l.Size = UDim2.fromScale(1, 1)
			l.AutomaticSize = Enum.AutomaticSize.None
		end
		l.Parent = b
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, if props.ChipWidth then 0 else 12)
		pad.PaddingRight = UDim.new(0, if props.ChipWidth then 0 else 12)
		pad.Parent = b
		local sc = Instance.new("UIScale")
		sc.Parent = b
		b:SetAttribute("Locked", opt.Locked ~= nil)
		b.Activated:Connect(function()
			if opt.Locked then
				UIMotion.Sound("ErrorSound")
				UIMotion.Shake(b)
				Components.Toast("error", opt.Locked)
				return
			end
			UIMotion.Sound("ClickSound")
			if props.Multi then
				api.Values[opt.Id] = not api.Values[opt.Id]
			else
				api.Value = opt.Id
			end
			sc.Scale = 0.9
			UIMotion.Tween(sc, 0.25, Enum.EasingStyle.Back, OUT, { Scale = 1 })
			paint()
			if props.OnChange then
				props.OnChange(if props.Multi then api.Values else api.Value)
			end
		end)
		b.Parent = holder
		chips[opt.Id] = b
	end
	paint()
	return api
end

-- Renk daireleri. props: Colors = { Color3 }, Value (indeks), OnChange(indeks)
function Forms.Swatches(props)
	local holder = row(8, 36, props.Order)
	holder.Name = "Swatches"
	local api = { Frame = holder, Value = props.Value or 1 }
	local rings = {}
	local function paint()
		for i, ring in ipairs(rings) do
			ring.Transparency = if i == api.Value then 0 else 1
		end
	end
	for i, col in ipairs(props.Colors) do
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.Text = ""
		b.BackgroundColor3 = col
		b.BorderSizePixel = 0
		b.Size = UDim2.fromOffset(34, 34)
		b.LayoutOrder = i
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = b
		local ring = Components.Stroke(b, C.Yellow, 3, 1)
		rings[i] = ring
		local sc = Instance.new("UIScale")
		sc.Parent = b
		b.Activated:Connect(function()
			UIMotion.Sound("ClickSound")
			api.Value = i
			sc.Scale = 0.8
			UIMotion.Tween(sc, 0.25, Enum.EasingStyle.Back, OUT, { Scale = 1 })
			paint()
			if props.OnChange then
				props.OnChange(i)
			end
		end)
		b.Parent = holder
	end
	paint()
	return api
end

-- Kaydırıcı. props: Min, Max, Value, Format(value) -> string, OnChange(value)
function Forms.Slider(props)
	local holder = Instance.new("Frame")
	holder.Name = "Slider"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, 0, 0, 40)
	holder.LayoutOrder = props.Order or 0
	local track = Instance.new("TextButton")
	track.AutoButtonColor = false
	track.Text = ""
	track.BackgroundColor3 = C.Ground
	track.BorderSizePixel = 0
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.new(0, 0, 0.5, 0)
	track.Size = UDim2.new(1, -86, 0, 10)
	Components.Corner(track, 5)
	track.Parent = holder
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = C.Yellow
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	Components.Corner(fill, 5)
	fill.Parent = track
	local knob = Instance.new("Frame")
	knob.BackgroundColor3 = C.White
	knob.BorderSizePixel = 0
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(22, 22)
	knob.Position = UDim2.fromScale(0, 0.5)
	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(1, 0)
	kc.Parent = knob
	Components.Stroke(knob, C.Yellow, 3, 0)
	local ks = Instance.new("UIScale")
	ks.Parent = knob
	knob.Parent = track
	local value = Components.Label({
		Text = "",
		Size = 18,
		Font = Theme.Font.Number,
		Color = C.Yellow,
		Align = Enum.TextXAlignment.Right,
		Frame = UDim2.new(0, 80, 1, 0),
	})
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.fromScale(1, 0)
	value.Parent = holder

	local api = { Frame = holder, Value = props.Value or props.Min }
	local function set(v: number, fire: boolean)
		v = math.clamp(math.floor(v + 0.5), props.Min, props.Max)
		local changed = v ~= api.Value
		api.Value = v
		local r = (v - props.Min) / (props.Max - props.Min)
		fill.Size = UDim2.fromScale(r, 1)
		knob.Position = UDim2.fromScale(r, 0.5)
		value.Text = if props.Format then props.Format(v) else tostring(v)
		if fire and changed and props.OnChange then
			props.OnChange(v)
		end
	end
	local dragging = false
	local function fromX(x: number)
		local r = (x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X)
		set(props.Min + r * (props.Max - props.Min), true)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			UIMotion.Tween(ks, 0.1, Q, OUT, { Scale = 1.25 })
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			UIMotion.Tween(ks, 0.2, Enum.EasingStyle.Back, OUT, { Scale = 1 })
		end
	end)
	set(api.Value, false)
	return api
end

-- Artı/eksi sayacı. props: Min, Max, Value, OnChange
function Forms.Stepper(props)
	local holder = Instance.new("Frame")
	holder.Name = "Stepper"
	holder.BackgroundColor3 = C.Ground
	holder.BorderSizePixel = 0
	holder.Size = props.Size or UDim2.fromOffset(130, 40)
	holder.LayoutOrder = props.Order or 0
	Components.Corner(holder, Theme.Corner.Small)
	Components.Stroke(holder, C.White, 1.5, 0.84)
	local api = { Frame = holder, Value = props.Value or props.Min }
	local value = Components.Label({
		Text = tostring(api.Value),
		Size = 20,
		Font = Theme.Font.Number,
		Color = C.Yellow,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.fromScale(1, 1),
	})
	value.Parent = holder
	local function side(text: string, x: number, delta: number)
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.BackgroundTransparency = 1
		b.Text = text
		b.FontFace = Theme.Font.Display
		b.TextSize = 24
		b.TextColor3 = C.Text
		b.Size = UDim2.new(0, 40, 1, 0)
		b.AnchorPoint = Vector2.new(x, 0)
		b.Position = UDim2.fromScale(x, 0)
		b.Parent = holder
		local holding = false
		local function step()
			local v = api.Value + delta
			if v > props.Max then
				v = props.Min
			elseif v < props.Min then
				v = props.Max
			end
			api.Value = v
			value.Text = tostring(v)
			UIMotion.Pop(value, 1.2)
			if props.OnChange then
				props.OnChange(v)
			end
		end
		b.MouseButton1Down:Connect(function()
			holding = true
			UIMotion.Sound("ClickSound")
			step()
			task.delay(0.4, function()
				while holding do
					step()
					task.wait(0.06)
				end
			end)
		end)
		b.MouseButton1Up:Connect(function()
			holding = false
		end)
		b.MouseLeave:Connect(function()
			holding = false
		end)
	end
	side("−", 0, -1)
	side("+", 1, 1)
	return api
end

-- Sekmeler. props: Tabs = { {Id, Text} }, Value, OnChange(id)
function Forms.Tabs(props)
	local holder = Instance.new("Frame")
	holder.Name = "Tabs"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, 0, 0, 38)
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.Padding = UDim.new(0, 4)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = holder
	local api = { Frame = holder, Value = props.Value or props.Tabs[1].Id }
	local items = {}
	local function paint()
		for id, it in pairs(items) do
			local on = id == api.Value
			it.Label.TextColor3 = if on then C.Yellow else C.Muted
			UIMotion.Tween(it.Line, 0.2, Enum.EasingStyle.Quint, OUT, { Size = UDim2.new(if on then 1 else 0, 0, 0, 3) })
		end
	end
	for i, tab in ipairs(props.Tabs) do
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.BackgroundTransparency = 1
		b.Text = ""
		b.Size = UDim2.new(1 / #props.Tabs, -4, 1, 0)
		b.LayoutOrder = i
		local label = Components.Label({
			Text = tab.Text,
			Size = 15,
			Font = Theme.Font.Display,
			Upper = true,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.new(1, 0, 1, -4),
		})
		label.Name = "Label"
		label.Parent = b
		local line = Instance.new("Frame")
		line.Name = "Line"
		line.BackgroundColor3 = C.Yellow
		line.BorderSizePixel = 0
		line.AnchorPoint = Vector2.new(0.5, 1)
		line.Position = UDim2.fromScale(0.5, 1)
		line.Size = UDim2.new(0, 0, 0, 3)
		line.Parent = b
		b.Activated:Connect(function()
			if api.Value == tab.Id then
				return
			end
			UIMotion.Sound("ClickSound")
			api.Value = tab.Id
			paint()
			if props.OnChange then
				props.OnChange(tab.Id)
			end
		end)
		b.Parent = holder
		items[tab.Id] = b
	end
	paint()
	return api
end

-- Onay penceresi. props: Parent (ScreenGui), Title, Text, Confirm, Cancel, OnConfirm, Gold
function Forms.Modal(props)
	local dim = Instance.new("TextButton")
	dim.Name = "Modal"
	dim.AutoButtonColor = false
	dim.Text = ""
	dim.BackgroundColor3 = C.Ground
	dim.BackgroundTransparency = 1
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.ZIndex = 200
	dim.Parent = props.Parent
	UIMotion.Tween(dim, 0.2, Q, OUT, { BackgroundTransparency = 0.35 })
	local panel, content = Components.Panel({
		Size = UDim2.fromOffset(460, 250),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Title = props.Title,
		Gold = props.Gold,
	})
	panel.ZIndex = 201
	panel.Parent = dim
	local body = Components.Label({ Text = props.Text, Size = 16, Wrap = true, Frame = UDim2.new(1, 0, 0, 100) })
	body.Position = UDim2.fromOffset(0, 44)
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.Parent = content
	local function close()
		UIMotion.Tween(dim, 0.15, Q, Enum.EasingDirection.In, { BackgroundTransparency = 1 })
		UIMotion.Out(panel, Vector2.new(0, 20), false)
		task.delay(0.25, function()
			dim:Destroy()
		end)
	end
	local ok = Components.Button({
		Text = props.Confirm or "Onayla",
		Style = "Primary",
		Size = UDim2.new(0.5, -6, 0, 52),
		OnClick = function()
			close()
			if props.OnConfirm then
				props.OnConfirm()
			end
		end,
	})
	ok.AnchorPoint = Vector2.new(1, 1)
	ok.Position = UDim2.fromScale(1, 1)
	ok.Parent = content
	local cancel =
		Components.Button({ Text = props.Cancel or "Vazgeç", Style = "Ghost", Size = UDim2.new(0.5, -6, 0, 52), OnClick = close })
	cancel.AnchorPoint = Vector2.new(0, 1)
	cancel.Position = UDim2.fromScale(0, 1)
	cancel.Parent = content
	UIMotion.In(panel, Vector2.new(0, 30))
	UIMotion.Pop(panel, 0.9)
	return close
end

return Forms
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--[[
	Theme
	Arayüzün tasarım dili: renkler, yazı tipleri, köşe ve çizgi ölçüleri.
	Bütün bileşenler buradan okur; ekranlarda sabit renk yazılmaz.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Theme = {}

Theme.Color = Config.Colors

local FAMILY = "rbxasset://fonts/families/GothamSSm.json"
Theme.Font = {
	Display = Font.new(FAMILY, Enum.FontWeight.Heavy),
	Title = Font.new(FAMILY, Enum.FontWeight.Bold),
	Body = Font.new(FAMILY, Enum.FontWeight.Medium),
	Number = Font.new(FAMILY, Enum.FontWeight.Heavy), -- sayılar da aynı aileden: oyunda tek yazı tipi
}

Theme.Corner = { Small = 6, Medium = 10, Large = 14 }
Theme.Stroke = 1.5
Theme.PanelTransparency = 0.12
Theme.Skew = 12 -- eğik kesim açısı (derece)
Theme.MinTouch = 76 -- mobilde en küçük dokunma hedefi (piksel)

-- Büyük harf (Türkçe i/ı dahil)
local MAP = { ["i"] = "İ", ["ı"] = "I", ["ş"] = "Ş", ["ğ"] = "Ğ", ["ü"] = "Ü", ["ö"] = "Ö", ["ç"] = "Ç" }
function Theme.Upper(text: string): string
	local out = {}
	for _, code in utf8.codes(text) do
		local ch = utf8.char(code)
		table.insert(out, MAP[ch] or string.upper(ch))
	end
	return table.concat(out)
end

-- 1234567 -> "1.234.567"
function Theme.FormatNumber(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local out = string.reverse(string.gsub(string.reverse(s), "(%d%d%d)", "%1."))
	if string.sub(out, 1, 1) == "." then
		out = string.sub(out, 2)
	end
	return out
end

return Theme
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">UIMotion</string><ProtectedString name="Source"><![CDATA[--[[
	UIMotion
	Arayüzdeki bütün hareketlerin tek kaynağı. Kural: hiçbir şey aniden belirmez.
	FadeSlide (giriş/çıkış), Stagger (sıralı giriş), Pop, CountUp, Shine, Shake, Pulse, Wipe, Ripple.
	"Hareket azaltma" ayarı açıksa süreler sıfıra yakın olur.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Theme = require(script.Parent.Theme)

local M = Config.Motion
local UIMotion = {}

UIMotion.Reduced = false

local function dur(t: number): number
	return if UIMotion.Reduced then 0.01 else t
end

local function tween(obj: Instance, t: number, style: Enum.EasingStyle, dir: Enum.EasingDirection, props)
	local tw = TweenService:Create(obj, TweenInfo.new(dur(t), style, dir), props)
	tw:Play()
	return tw
end
UIMotion.Tween = tween

local function scaleOf(gui: GuiObject): UIScale
	local s = gui:FindFirstChildOfClass("UIScale")
	if not s then
		s = Instance.new("UIScale")
		s.Parent = gui
	end
	return s
end

function UIMotion.Sound(key: string)
	local id = Config.Assets[key]
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 0.5
	SoundService:PlayLocalSound(s)
	s:Destroy()
end

-- Giriş: kayarak ve saydamlıktan gelerek. offset: başlangıç kayması (piksel).
function UIMotion.In(gui: GuiObject, offset: Vector2?, delay: number?)
	local target = gui:GetAttribute("RestPos") or gui.Position
	gui:SetAttribute("RestPos", target)
	local o = offset or Vector2.new(0, 24)
	gui.Position = target + UDim2.fromOffset(o.X, o.Y)
	gui.Visible = true
	if gui:IsA("CanvasGroup") then
		gui.GroupTransparency = 1
	end
	task.delay(dur(delay or 0), function()
		tween(gui, M.In, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { Position = target })
		if gui:IsA("CanvasGroup") then
			tween(gui, M.In * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { GroupTransparency = 0 })
		end
	end)
end

-- Çıkış: kısa ve hızlı. Bitince gizler (destroy = true ise siler).
function UIMotion.Out(gui: GuiObject, offset: Vector2?, destroy: boolean?)
	local rest = gui:GetAttribute("RestPos") or gui.Position
	local o = offset or Vector2.new(0, 16)
	local tw = tween(gui, M.Out, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Position = rest + UDim2.fromOffset(o.X, o.Y) })
	if gui:IsA("CanvasGroup") then
		tween(gui, M.Out, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { GroupTransparency = 1 })
	end
	tw.Completed:Once(function()
		if destroy then
			gui:Destroy()
		else
			gui.Visible = false
			gui.Position = rest
		end
	end)
end

-- Öğeleri sırayla getirir.
function UIMotion.Stagger(list: { GuiObject }, offset: Vector2?, startDelay: number?)
	for i, gui in ipairs(list) do
		local delay = (startDelay or 0) + (i - 1) * M.Stagger
		if gui.Parent and gui.Parent:FindFirstChildOfClass("UIListLayout") then
			-- Liste düzeni konumu yönetir; burada kayma yerine sırayla yaylanarak belirir
			gui.Visible = false
			task.delay(dur(delay), function()
				gui.Visible = true
				UIMotion.Pop(gui, 0.8)
			end)
		else
			UIMotion.In(gui, offset, delay)
		end
	end
end

-- Küçükten yaylanarak büyür (vurgu).
function UIMotion.Pop(gui: GuiObject, from: number?)
	local s = scaleOf(gui)
	s.Scale = from or 0.7
	tween(s, M.In, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })
end

-- Sayı sayarak artar. format: sayıyı metne çeviren işlev.
function UIMotion.CountUp(label: TextLabel, from: number, to: number, format: ((number) -> string)?)
	local fmt = format or Theme.FormatNumber
	local v = Instance.new("NumberValue")
	v.Value = from
	local conn = v.Changed:Connect(function(n)
		label.Text = fmt(n)
	end)
	local tw = tween(v, M.CountUp, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, { Value = to })
	tw.Completed:Once(function()
		conn:Disconnect()
		label.Text = fmt(to)
		v:Destroy()
	end)
	UIMotion.Pop(label, 1.18)
end

-- Üzerinden parlaklık süpürmesi geçer. gui ClipsDescendants = true olmalı.
function UIMotion.Shine(gui: GuiObject)
	local f = Instance.new("Frame")
	f.Name = "Shine"
	f.BackgroundColor3 = Theme.Color.White
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(0.45, 1)
	f.Position = UDim2.fromScale(-0.5, 0)
	f.ZIndex = gui.ZIndex + 5
	local g = Instance.new("UIGradient")
	g.Rotation = 20
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.65),
		NumberSequenceKeypoint.new(1, 1),
	})
	g.Parent = f
	f.Parent = gui
	local tw = tween(f, 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Position = UDim2.fromScale(1.05, 0) })
	tw.Completed:Once(function()
		f:Destroy()
	end)
end

-- Sağa sola sallanır (kilitli öğe, hata).
function UIMotion.Shake(gui: GuiObject)
	local rest = gui:GetAttribute("RestPos") or gui.Position
	gui:SetAttribute("RestPos", rest)
	task.spawn(function()
		for _, dx in ipairs({ -8, 7, -5, 4, -2, 0 }) do
			tween(gui, 0.045, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, { Position = rest + UDim2.fromOffset(dx, 0) })
			task.wait(dur(0.045))
		end
		gui.Position = rest
	end)
end

-- Nabız gibi sürekli büyüyüp küçülür. Durdurmak için dönen işlevi çağır.
function UIMotion.Pulse(gui: GuiObject, amount: number?, period: number?)
	local s = scaleOf(gui)
	local tw = TweenService:Create(
		s,
		TweenInfo.new(period or 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Scale = 1 + (amount or 0.05) }
	)
	if not UIMotion.Reduced then
		tw:Play()
	end
	return function()
		tw:Cancel()
		s.Scale = 1
	end
end

-- Tıklama noktasından yayılan dalga halkası. gui ClipsDescendants = true olmalı.
function UIMotion.Ripple(gui: GuiObject, screenPos: Vector2?)
	local abs, size = gui.AbsolutePosition, gui.AbsoluteSize
	local p = screenPos and (screenPos - abs) or size / 2
	local c = Instance.new("Frame")
	c.Name = "Ripple"
	c.AnchorPoint = Vector2.new(0.5, 0.5)
	c.Position = UDim2.fromOffset(p.X, p.Y)
	c.Size = UDim2.fromOffset(0, 0)
	c.BackgroundColor3 = Theme.Color.White
	c.BackgroundTransparency = 0.7
	c.BorderSizePixel = 0
	c.ZIndex = gui.ZIndex + 4
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = c
	c.Parent = gui
	local d = math.max(size.X, size.Y) * 2.2
	local tw =
		tween(c, 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 })
	tw.Completed:Once(function()
		c:Destroy()
	end)
end

-- Çubuklu perde: sarı-lacivert çubuklar ekranı kapatır, onCovered çalışır, sonra açılır.
function UIMotion.Wipe(onCovered: (() -> ())?)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local sg = Instance.new("ScreenGui")
	sg.Name = "Wipe"
	sg.IgnoreGuiInset = true
	sg.DisplayOrder = 1000
	sg.ResetOnSpawn = false
	sg.Parent = playerGui
	local n = 10
	local bars = {}
	for i = 1, n do
		local b = Instance.new("Frame")
		b.BorderSizePixel = 0
		b.BackgroundColor3 = if i % 2 == 0 then Theme.Color.Navy else Theme.Color.Yellow
		b.AnchorPoint = Vector2.new(0, if i % 2 == 0 then 0 else 1)
		b.Position = UDim2.fromScale((i - 1) / n, if i % 2 == 0 then 0 else 1)
		b.Size = UDim2.new(1 / n, 2, 0, 0)
		b.Parent = sg
		bars[i] = b
	end
	UIMotion.Sound("WhooshSound")
	for i, b in ipairs(bars) do
		task.delay(dur((i - 1) * 0.025), function()
			tween(b, M.Wipe * 0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { Size = UDim2.new(1 / n, 2, 1, 0) })
		end)
	end
	task.delay(dur(M.Wipe * 0.6 + n * 0.025), function()
		if onCovered then
			onCovered()
		end
		task.wait(dur(0.08))
		for i, b in ipairs(bars) do
			task.delay(dur((i - 1) * 0.025), function()
				tween(b, M.Wipe * 0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.In, { Size = UDim2.new(1 / n, 2, 0, 0) })
			end)
		end
		task.delay(dur(M.Wipe * 0.6 + n * 0.025 + 0.1), function()
			sg:Destroy()
		end)
	end)
end

-- Sürekli parlayan çerçeve: UIStroke saydamlığı nabız gibi gider gelir. Durdurmak için dönen işlevi çağır.
function UIMotion.Glow(stroke: UIStroke, from: number, to: number, period: number?)
	stroke.Transparency = from
	local tw = TweenService:Create(
		stroke,
		TweenInfo.new(period or 1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Transparency = to }
	)
	if not UIMotion.Reduced then
		tw:Play()
	end
	return function()
		tw:Cancel()
	end
end

-- Belirli aralıkla tekrarlanan parlaklık süpürmesi (dikkat çekmesi gereken butonlar için)
function UIMotion.ShineLoop(gui: GuiObject, every: number?)
	local alive = true
	task.spawn(function()
		while alive and gui.Parent do
			task.wait(every or 3.6)
			if alive and gui.Parent and gui.Visible and not UIMotion.Reduced then
				UIMotion.Shine(gui)
			end
		end
	end)
	return function()
		alive = false
	end
end

-- Tıklamada kısa beyaz parlama
function UIMotion.Flash(gui: GuiObject)
	local f = Instance.new("Frame")
	f.Name = "Flash"
	f.BackgroundColor3 = Theme.Color.White
	f.BackgroundTransparency = 0.45
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = gui.ZIndex + 6
	f.Parent = gui
	local tw = tween(f, 0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { BackgroundTransparency = 1 })
	tw.Completed:Once(function()
		f:Destroy()
	end)
end

-- Ekran ortasında patlayan kutlama: büyük yazı + genişleyen halkalar (seviye atlama, lig atlama)
function UIMotion.Burst(parent: Instance, text: string, sub: string?, color: Color3?)
	local col = color or Theme.Color.Gold
	local root = Instance.new("Frame")
	root.Name = "Burst"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = 300
	root.Parent = parent
	for i = 1, 3 do
		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.42)
		ring.Size = UDim2.fromOffset(40, 40)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 300
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = ring
		local st = Instance.new("UIStroke")
		st.Color = col
		st.Thickness = 6
		st.Parent = ring
		ring.Parent = root
		task.delay(dur((i - 1) * 0.12), function()
			tween(ring, 0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { Size = UDim2.fromOffset(900, 900) })
			tween(st, 0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Transparency = 1, Thickness = 1 })
		end)
	end
	local function label(str: string, size: number, y: number, font)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.new(0.5, 0, 0.42, y)
		l.Size = UDim2.new(1, 0, 0, size + 10)
		l.FontFace = font
		l.TextSize = size
		l.TextColor3 = col
		l.Text = Theme.Upper(str)
		l.ZIndex = 301
		local st = Instance.new("UIStroke")
		st.Color = Theme.Color.Navy
		st.Thickness = 5
		st.Parent = l
		l.Parent = root
		UIMotion.Pop(l, 0.3)
		return l, st
	end
	local parts = { { label(text, 96, 0, Theme.Font.Display) } }
	if sub then
		table.insert(parts, { label(sub, 28, 70, Theme.Font.Title) })
	end
	UIMotion.Sound("RewardSound")
	task.delay(1.8, function()
		for _, p in ipairs(parts) do
			tween(p[1], 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { TextTransparency = 1 })
			tween(p[2], 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Transparency = 1 })
		end
		task.delay(0.5, function()
			root:Destroy()
		end)
	end)
end

return UIMotion
]]></ProtectedString></Properties></Item>
