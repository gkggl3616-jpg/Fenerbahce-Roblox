-- Genel güç (sıralama ve teklif şartı için)
function Config.Power(stats: { [string]: number }, level: number): number
	local sum = 0
	for _, key in ipairs(Config.Stats) do
		sum += stats[key] or 1
	end
	return math.floor(20 + sum * 1.0 + level * 1.2 + 0.5)
end

return Config
