<Item class="Folder" referent="RBX24"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">PlayerController</string><ProtectedString name="Source"><![CDATA[--[[
	PlayerController
	Oyuncunun hareketi, dayanıklılığı, eylem girdileri, efektleri ve saha içi arayüzü.
	- Hareket: ivmelenme, yavaşlama, ani dönüşte hız kaybı ve fren animasyonu, sprint ve yorgunluk.
	- Eylemler: şut türleri, pas, çalımlar, kafa, röveşata, müdahaleler, plonjon, sevinç. Klavye ve dokunmatik.
	- Efektler: ayak tozu, vuruş halkası, kamera sarsıntısı, hıza göre görüş açısı.
	Top henüz yok (5. adım); bu adım hareket hissini ve animasyonları sınamak içindir.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)
local Components = require(ReplicatedStorage.UI.Components)
local Animator = require(script.Parent.Parent.Anim.Animator)
local Poses = require(script.Parent.Parent.Anim.Poses)
local Ball = require(script.Parent.Parent.Match.Ball)
local TimeScale = require(script.Parent.Parent.Match.TimeScale)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Bots = require(script.Parent.Parent.Match.Bots)
local Forms = require(ReplicatedStorage.UI.Forms)

local C = Theme.Color
local M = Config.Movement
local player = Players.LocalPlayer

local Controller = {}

local SHOTS = { "Shoot", "Plase", "Fuze", "Asirtma", "Vole", "Rovesata" }
-- Eylemin hangi yetenekle açıldığı: { zincir, sıra }

local state = {
	animator = nil :: any,
	hum = nil :: Humanoid?,
	hrp = nil :: BasePart?,
	speed = 0,
	stamina = M.StaminaMax,
	tired = false,
	sprintHeld = false,
	lastDir = Vector3.zero,
	shot = 1,
	hud = false,
	getData = nil :: any,
	charging = false,
	charge = 0,
	pending = nil :: any, -- bırakılan şutun gücü ve nişanı; vuruş anında kullanılır
	passPower = 0,
	goals = 0,
	combo = 0,
	turboUntil = 0,
	yellow = false,
	lastMirror = false,
}
local SH = Config.Shooting
local TP: any = Config.TestPitch
local matchApi: any = nil -- maç sürerken MatchController kancaları
local DU = Config.Duel
local ui: { [string]: any } = {}

--------------------------------------------------------------------------------
-- Efektler
--------------------------------------------------------------------------------
local fxPart: Part? = nil
local dust: ParticleEmitter? = nil
local function ensureFx()
	if fxPart and fxPart.Parent then
		return
	end
	local p = Instance.new("Part")
	p.Name = "FK_Fx"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(190, 200, 150), Color3.fromRGB(120, 150, 90))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 2.2) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.35, 0.7)
	e.Speed = NumberRange.new(2, 6)
	e.SpreadAngle = Vector2.new(60, 60)
	e.Acceleration = Vector3.new(0, 4, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = p
	fxPart, dust = p, e
end

local function puff(pos: Vector3, count: number)
	ensureFx()
	if fxPart and dust then
		fxPart.CFrame = CFrame.new(pos)
		dust:Emit(count)
	end
end

local function ring(pos: Vector3, color: Color3, size: number)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.25
	p.Size = Vector3.new(0.08, 1, 1)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = Workspace
	local tw = TweenService:Create(
		p,
		TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.08, size, size), Transparency = 1 }
	)
	tw:Play()
	tw.Completed:Once(function()
		p:Destroy()
	end)
end

local function shake(amount: number)
	local hum = state.hum
	if not hum or UIMotion.Reduced then
		return
	end
	task.spawn(function()
		for i = 1, 5 do
			local k = amount * (1 - i / 6)
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
			task.wait(0.03)
		end
		hum.CameraOffset = Vector3.zero
	end)
end

local function footPos(side: string): Vector3
	local char = player.Character
	local foot = char and char:FindFirstChild(side .. "Foot")
	if foot and foot:IsA("BasePart") then
		return foot.Position - Vector3.new(0, foot.Size.Y / 2, 0)
	end
	return if state.hrp then state.hrp.Position - Vector3.new(0, 3, 0) else Vector3.zero
end

--------------------------------------------------------------------------------
-- Saha içi arayüz
--------------------------------------------------------------------------------
local function banner(text: string, color: Color3?)
	local l = ui.banner
	if not l then
		return
	end
	l.Text = Theme.Upper(text)
	l.TextColor3 = color or C.Yellow
	l.TextTransparency = 0
	ui.bannerStroke.Transparency = 0
	UIMotion.Pop(l, 0.6)
	ui.bannerToken = (ui.bannerToken or 0) + 1
	local token = ui.bannerToken
	task.delay(0.9, function()
		if ui.bannerToken == token then
			UIMotion.Tween(l, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { TextTransparency = 1 })
			UIMotion.Tween(ui.bannerStroke, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Transparency = 1 })
		end
	end)
end

-- Hakem kartı: ekranın ortasında dönerek belirir
local function showCard(color: Color3, text: string)
	if not ui.root then
		return
	end
	local card = Instance.new("Frame")
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.42)
	card.Size = UDim2.fromOffset(110, 160)
	card.BackgroundColor3 = color
	card.BorderSizePixel = 0
	card.Rotation = -200
	card.ZIndex = 40
	Components.Corner(card, 10)
	Components.Stroke(card, C.White, 3, 0.2)
	card.Parent = ui.root
	UIMotion.Pop(card, 0.2)
	UIMotion.Tween(card, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Rotation = 8 })
	banner(text, color)
	task.delay(1.4, function()
		local tw = UIMotion.Tween(
			card,
			0.25,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In,
			{ Position = UDim2.fromScale(0.5, -0.3), Rotation = 60 }
		)
		tw.Completed:Once(function()
			card:Destroy()
		end)
	end)
end

local function setCombo(n: number)
	state.combo = n
	if ui.combo then
		ui.combo.Text = if n > 0 then "KOMBO x" .. n else ""
		if n > 0 then
			UIMotion.Pop(ui.combo, 1.5)
		end
	end
end

local function unlocked(action: string): boolean
	if Config.Debug.UnlockAllActionsInStudio and RunService:IsStudio() then
		return true
	end
	local data = state.getData and state.getData()
	if not data then
		return true
	end
	return Config.ActionUnlocked(data.skills, action)
end

-- Bir zincirde verilen hareketlerden açık olan en üsttekini seçer (liste alttan üste sıralıdır)
local function best(list: { string }): string
	local pick = list[1]
	for _, a in ipairs(list) do
		if unlocked(a) then
			pick = a
		end
	end
	return pick
end

local function paintShots()
	for i, slot in ipairs(ui.slots or {}) do
		local on = i == state.shot
		local open = unlocked(SHOTS[i])
		UIMotion.Tween(slot, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { BackgroundColor3 = if on then C.Yellow else C.Navy })
		slot.Name_.TextColor3 = if on then C.Navy elseif open then C.Text else C.Muted
		slot.Key.TextColor3 = if on then C.Navy else C.Muted
	end
end

local function selectShot(i: number)
	if not SHOTS[i] then
		return
	end
	if not unlocked(SHOTS[i]) then
		UIMotion.Shake(ui.slots[i])
		return Components.Toast("error", Poses.Names[SHOTS[i]] .. " henüz açılmadı.")
	end
	state.shot = i
	UIMotion.Pop(ui.slots[i], 0.85)
	paintShots()
end

--------------------------------------------------------------------------------
-- Eylemler
--------------------------------------------------------------------------------
local function play(action: string, opts: any?)
	local an = state.animator
	if not an or not state.hud then
		return
	end
	if not unlocked(action) then
		return Components.Toast("error", (Poses.Names[action] or action) .. " henüz açılmadı. Yetenek ağacından aç.")
	end
	local def = Poses.Actions[action]
	if def.Mask == "Full" and state.hum and state.hum.FloorMaterial == Enum.Material.Air and action ~= "Vole" and action ~= "Rovesata" then
		return -- havadayken yeni yer hareketi başlamaz
	end
	an:Play(action, opts)
end

local function stat(name: string): number
	local data = state.getData and state.getData()
	return (data and data.stats and data.stats[name]) or 1
end

local function aimInput(): number
	local hum = state.hum
	return if hum then math.clamp(hum.MoveDirection.X * 1.4, -1, 1) else 0
end

-- Şut: basılı tut (güç dolar), bırak (vuruş başlar)
local function shootDown()
	if not state.hud or state.charging then
		return
	end
	if not unlocked(SHOTS[state.shot]) then
		return Components.Toast("error", Poses.Names[SHOTS[state.shot]] .. " henüz açılmadı.")
	end
	state.charging = true
	state.charge = 0
end
local function shootUp()
	if not state.charging then
		return
	end
	state.charging = false
	local p = state.charge
	state.pending = { power = p, perfect = p >= SH.PerfectFrom and p <= SH.PerfectTo, over = p > SH.OverFrom, aimX = aimInput() }
	play(SHOTS[state.shot])
end
local passAt = 0
local function passDown()
	passAt = os.clock()
end
local function passUp()
	if passAt > 0 then
		state.passPower = math.clamp((os.clock() - passAt) / 0.5, 0, 1)
		passAt = 0
		play("Pass")
	end
end
local function cross()
	local hrp = state.hrp
	if not hrp or not state.hud then
		return
	end
	local side = if math.random() < 0.5 then -1 else 1
	local target = hrp.Position + hrp.CFrame.LookVector * 5 + Vector3.new(0, 3, 0)
	Ball.Cross(Vector3.new(side * 100, 0, math.min(TP.GoalZ - 14, target.Z + 30)), target, 1.75)
end
local function fetchBall()
	local hrp = state.hrp
	if hrp and state.hud then
		Ball.Reset(hrp.Position + hrp.CFrame.LookVector * 5)
	end
end
-- Tek tuş, açılan en üst hareket: yetenek ağacında ilerledikçe aynı tuş daha gösterişli hareketi yapar
local function doTackle()
	if state.speed > M.Run + 2 and unlocked("Kayma") then
		play("Kayma")
	else
		play(best({ "AyaktaMudahale", "Omuz" }))
	end
end
local function doDribble()
	play(best({ "VucutCalimi", "Bisiklet", "Marsilya", "Elastico", "Gokkusagi" }), { Mirror = math.random() < 0.5 })
end
local function doBlock()
	play(best({ "AyaktaMudahale", "Blok", "UcanBlok" }))
end
local function doCelebrate()
	play(if state.speed > 8 then "DizKaymasi" else "Sevinc")
end
local function doJump()
	if state.speed > M.Run + 2 and unlocked("UcanKafa") then
		play(best({ "UcanKafa", "Makas" }))
	else
		play(best({ "Jump", "Header", "GucluKafa" }))
	end
end

--------------------------------------------------------------------------------
-- Basit kontrol: fare + boşluk. Aynı tuş, topun sende olup olmamasına göre iş değiştirir.
--   Sol tık  : top sendeyse şut (basılı tut, bırak) · değilse müdahale · kaleciysen plonjon
--   Sağ tık  : top sendeyse pas · değilse top iste
--   Boşluk   : top sendeyse çalım · değilse zıpla / kafa
--------------------------------------------------------------------------------
local function ballInfo(): (number, number)
	local hrp = state.hrp
	if not hrp then
		return math.huge, 0
	end
	local bp = Ball.Position()
	local feet = hrp.Position - Vector3.new(0, 3, 0)
	return Vector3.new(bp.X - feet.X, 0, bp.Z - feet.Z).Magnitude, bp.Y - feet.Y
end
local function hasBall(): boolean
	local dist, height = ballInfo()
	return dist < SH.Reach + 1.5 and height < 3
end
local function isKeeper(): boolean
	local data = state.getData and state.getData()
	return matchApi ~= nil and data ~= nil and data.position == "Kaleci"
end
local primaryShooting = false
local function primaryDown()
	if not state.hud then
		return
	end
	local dist, height = ballInfo()
	if isKeeper() and not hasBall() then
		-- topun geldiği yana uzan
		local hrp = state.hrp
		if hrp then
			state.lastMirror = (Ball.Position() - hrp.Position):Dot(hrp.CFrame.RightVector) < 0
			play("Plonjon", { Mirror = state.lastMirror })
		end
	elseif hasBall() then
		primaryShooting = true
		shootDown()
	elseif dist < 9 and height >= 3 then
		-- havadaki top: açıksa gelişine vur, değilse kafa
		if unlocked("Vole") then
			play(best({ "Vole", "Rovesata" }))
		else
			doJump()
		end
	else
		doTackle()
	end
end
local function primaryUp()
	if primaryShooting then
		primaryShooting = false
		shootUp()
	end
end
local function secondary()
	if not state.hud then
		return
	end
	if hasBall() then
		state.passPower = 0.4
		play("Pass")
	else
		-- "Pas ver!": top takım arkadaşındaysa sana atar
		play("TopIste")
		local hrp = state.hrp
		if hrp and matchApi and matchApi.CallPass then
			matchApi.CallPass(hrp.Position - Vector3.new(0, 3, 0))
		end
	end
end
local function contextSpace()
	if hasBall() then
		doDribble()
	else
		doJump()
	end
end

local KEYMAP: { [Enum.KeyCode]: () -> () } = {
	[Config.Keys.Shoot] = shootDown,
	[Config.Keys.Pass] = passDown,
	[Enum.KeyCode.B] = cross,
	[Enum.KeyCode.N] = fetchBall,
	[Config.Keys.Dribble] = doDribble,
	[Config.Keys.Special] = function()
		play("VucutCalimi", { Mirror = math.random() < 0.5 }) -- hızlı, sade çalım her zaman elde
	end,
	[Config.Keys.Jump] = contextSpace,
	[Enum.KeyCode.T] = function()
		if matchApi and matchApi.CycleOrder then
			matchApi.CycleOrder() -- takım emri: Dengeli > Atak > Defans > Pres
		end
	end,
	[Config.Keys.Tackle] = doTackle,
	[Enum.KeyCode.V] = doBlock,
	[Config.Keys.Celebrate] = doCelebrate,
	[Enum.KeyCode.H] = function()
		if not hasBall() then
			secondary()
		end
	end,
	[Enum.KeyCode.Z] = function()
		play("Plonjon", { Mirror = true })
	end,
	[Enum.KeyCode.X] = function()
		play("Plonjon")
	end,
}
local NUMBER_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six }

local function onEvent(event: string, action: string)
	local hrp, hum = state.hrp, state.hum
	if not hrp or not hum then
		return
	end
	local look = hrp.CFrame.LookVector
	if event == "start" then
		if action ~= "Fren" then
			banner(Poses.Names[action] or action)
		end
		Remotes.Get("Anim"):FireServer(action, state.lastMirror) -- diğer oyuncular da görsün
	elseif event == "strike" then
		local feet = hrp.Position - Vector3.new(0, 3, 0)
		local near = (Ball.Position() - hrp.Position).Magnitude < 9
		if action == "Pass" then
			local targets = {}
			local studio = Workspace:FindFirstChild("FK_Studio")
			if studio then
				for _, d in ipairs(studio:GetChildren()) do
					if d.Name == "PassTarget" then
						table.insert(targets, (d :: BasePart).Position)
					end
				end
			end
			if Ball.Pass(feet, look, state.passPower or 0, stat("Pas"), targets) then
				ring(Ball.Position(), C.White, 4)
				shake(0.2)
			end
			return
		end
		-- zamanlamaya dayalı vuruşlar: { en alçak, en yüksek, erişim, ideal yükseklik }
		local WINDOW = {
			Header = { 3.6, 9.5, 4.2, 6.2 },
			UcanKafa = { 1.6, 6.8, 5.4, 4 },
			Vole = { 1.3, 5.2, 4, 3 },
			Rovesata = { 2.4, 9.5, 4.4, 6 },
			GucluKafa = { 3.4, 10, 4.8, 6.4 },
			Makas = { 1.6, 7.2, 5.2, 3.6 },
		}
		local win = WINDOW[action]
		local pending = state.pending or { power = 0.7, perfect = false, aimX = aimInput() }
		state.pending = nil
		local opts: any = {
			kind = action,
			from = feet,
			facing = look,
			aimX = pending.aimX,
			power = pending.power,
			perfect = pending.perfect,
			stat = stat("Sut"),
		}
		if win then
			local h = Ball.Position().Y - TP.GroundY
			opts.minY, opts.maxY, opts.reach = win[1], win[2], win[3]
			opts.power = 0.85
			opts.aimX = aimInput()
			opts.perfect = math.abs(h - win[4]) < 1.3 -- top tam ideal yükseklikteyken vurulduysa
			if action == "Header" or action == "UcanKafa" or action == "GucluKafa" then
				opts.stat = stat("Fizik")
			end
		end
		local quality, target = Ball.Strike(opts)
		if quality ~= "miss" and matchApi then
			matchApi.OnHumanKick()
		end
		if quality == "miss" then
			if near then
				banner("Iska", C.Bad)
				UIMotion.Sound("ErrorSound")
			end
			return
		end
		local strength = if action == "Fuze" then 1 elseif win then 0.8 else 0.5
		local color = if action == "Fuze" then Color3.fromRGB(255, 120, 60) elseif quality == "perfect" then C.Gold else C.Yellow
		ring(Ball.Position(), color, 5 + strength * 6)
		UIMotion.Sound("ConfirmSound")
		if quality == "perfect" then
			banner("Mükemmel!", C.Gold)
			TimeScale.Set(0.05, SH.HitStop) -- vuruş anında kısa duraksama
			shake(0.9)
			ring(Ball.Position(), C.White, 12)
		else
			shake(0.3 + strength * 0.5)
			if pending.over and not win then
				banner("Fazla tuttun", C.Bad)
			end
		end
		if action == "Rovesata" or action == "UcanKafa" or action == "Makas" then
			task.delay(SH.HitStop + 0.02, function()
				TimeScale.Set(SH.SlowMo, SH.SlowMoTime) -- yavaş çekim
			end)
			banner((Poses.Names[action] or action) .. "!", C.Gold)
		end
		if target and ui.aim then
			ui.aimHold = os.clock() + 0.8
		end
	elseif event == "jump" then
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(v.X, math.sqrt(2 * Workspace.Gravity * M.JumpHeight), v.Z)
	elseif event == "slide" then
		hrp.AssemblyLinearVelocity = look * (if action == "DizKaymasi" then 26 else 34) + Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
		puff(footPos("Right"), 14)
	elseif event == "tackle" then
		ring(footPos("Right") + look * 1.5, C.White, 4)
		if matchApi or Bots.Mode() == "Savunma" then
			local tackle = if matchApi then matchApi.Tackle else Bots.Tackle
			local result = tackle(hrp.Position - Vector3.new(0, 3, 0), look, action == "Kayma")
			if result == "win" then
				banner("Top sende!", C.Good)
				shake(0.6)
				ring(Ball.Position(), C.Good, 9)
				UIMotion.Sound("ConfirmSound")
				if not matchApi then
					Remotes.Get("TrainingGoal"):FireServer("Tackle")
				end
			elseif result == "foul" then
				if not matchApi then
					banner("Faul!", C.Bad)
				end
				UIMotion.Sound("ErrorSound")
				shake(0.5)
			elseif result == "card" then
				UIMotion.Sound("ErrorSound")
				shake(0.7)
				if matchApi then
					-- maçta kararı hakem verir (MatchController)
				elseif state.yellow then
					state.yellow = false
					showCard(C.Bad, "Kırmızı kart!")
					if matchApi then
						task.delay(1.6, matchApi.Forfeit) -- kırmızı kart: maç senin için biter
					end
				else
					state.yellow = true
					showCard(C.Yellow, "Sarı kart")
				end
			end
		end
	elseif event == "flick" then
		-- Gökkuşağı: top ayaktaysa topukla öne ve yukarı aşırılır
		local feet = hrp.Position - Vector3.new(0, 3, 0)
		if (Ball.Position() - feet).Magnitude < SH.Reach + 1.5 then
			Ball.Kick(look * 34 + Vector3.new(0, 44, 0))
			ring(Ball.Position(), C.Gold, 7)
			UIMotion.Sound("ConfirmSound")
		end
	elseif event == "block" or event == "save" then
		ring(footPos("Right") + look * 1.5, C.White, 4)
		if event == "block" then
			-- önümüzden hızlı geçen top gövdeye çarpar
			local bp, bv = Ball.Position(), Ball.Velocity()
			local reach = if action == "UcanBlok" then 7 else 4.5
			if (bp - hrp.Position).Magnitude < reach and bv.Magnitude > 30 and bv:Dot(look) < 0 then
				Ball.Deflect(-bv * 0.35 + Vector3.new(0, 12, 0))
				banner("Blok!", C.Good)
				shake(0.6)
				UIMotion.Sound("ConfirmSound")
			end
		end
		if event == "save" and matchApi then
			-- oyuncu kaleciyse: plonjon yönündeki el hizasında top varsa çeler
			local side = if state.lastMirror then -1 else 1
			local hand = hrp.Position + hrp.CFrame.RightVector * side * 3.6 + Vector3.new(0, 0.6, 0)
			if matchApi.HumanSave(hand) then
				banner("Kurtardın!", C.Gold)
				shake(0.9)
				TimeScale.Set(0.05, SH.HitStop)
				UIMotion.Sound("RewardSound")
			end
		end
	elseif event == "feint" then
		ring(hrp.Position - Vector3.new(0, 2.8, 0), C.Yellow, 6)
		local feint = if matchApi then matchApi.Feint else Bots.Feint
		if feint(hrp.Position - Vector3.new(0, 3, 0)) then
			setCombo(state.combo + 1)
			banner("Çalım!", C.Gold)
			ring(hrp.Position - Vector3.new(0, 2.8, 0), C.Gold, 12)
			shake(0.4)
			UIMotion.Sound("ConfirmSound")
			if not matchApi then
				Remotes.Get("TrainingGoal"):FireServer("Feint")
			end
			if state.combo >= DU.ComboForTurbo then
				setCombo(0)
				state.turboUntil = os.clock() + DU.TurboTime
				banner("Turbo!", C.Gold)
				UIMotion.Sound("RewardSound")
			end
		end
	elseif event == "land" then
		puff(hrp.Position - Vector3.new(0, 2.8, 0), 10)
		shake(0.2)
	elseif event == "skid" then
		puff(footPos("Left"), 8)
	elseif event == "footL" or event == "footR" then
		if action == "sprint" then
			puff(footPos(if event == "footL" then "Left" else "Right"), 2)
		end
		-- sürme: her adımda top öne itilir
		if state.hud and hum.MoveDirection.Magnitude > 0.1 then
			Ball.Touch({
				pos = hrp.Position - Vector3.new(0, 3, 0),
				dir = hum.MoveDirection,
				speed = state.speed,
				sprinting = action == "sprint",
				control = stat("TopKontrolu"),
			})
		end
	elseif event == "end" then
		local def = Poses.Actions[action]
		if def and def.EndShift then
			local s = def.EndShift
			local mirror = action == "Plonjon" and state.lastMirror
			hrp.CFrame = hrp.CFrame * CFrame.new(if mirror then -s.X else s.X, s.Y, s.Z)
		end
	end
end

--------------------------------------------------------------------------------
-- Her karede: hareket + animasyon
--------------------------------------------------------------------------------
local function step(dt: number)
	local hum, hrp, an = state.hum, state.hrp, state.animator
	if not hum or not hrp or not an or hum.Health <= 0 then
		return
	end
	-- Görünüm yenilenince eklemler değişir; eski eklemlere yazmamak için yeniden bağlan
	local waist = an.Motors.Waist
	if (not waist or not waist:IsDescendantOf(an.Character)) and os.clock() - (ui.lastRebind or 0) > 1 then
		ui.lastRebind = os.clock()
		Controller.Rebind()
		return
	end
	-- Roblox'un kendi animasyonları eklemleri ezmesin
	if os.clock() - (ui.lastTrackSweep or 0) > 0.5 then
		ui.lastTrackSweep = os.clock()
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				if not track:GetAttribute("FK") then
					track:Stop(0)
				end
			end
		end
	end
	local dir = hum.MoveDirection
	local moving = dir.Magnitude > 0.1
	local wantSprint = state.sprintHeld and moving and not state.tired and state.stamina > 0

	-- dayanıklılık
	if wantSprint then
		-- Fizik özelliği dayanıklılığı artırır (her seviye %5 daha az harcar)
		state.stamina = math.max(0, state.stamina - M.SprintDrain * (1 - (stat("Fizik") - 1) * 0.05) * dt)
		if state.stamina <= 0 then
			state.tired = true
			banner("Yoruldun", C.Bad)
		end
	else
		state.stamina = math.min(M.StaminaMax, state.stamina + M.Regen * dt * (if moving then 0.6 else 1))
		-- Yorgunluk, sprint tuşu bırakılmadan geçmez: tuş basılıyken hız gidip gelmesin
		if state.tired and state.stamina >= M.TiredUntil and not state.sprintHeld then
			state.tired = false
		end
	end

	-- hedef hız ve ivme
	local target = 0
	if moving then
		-- Hız özelliği koşu ve sprint hızını artırır (her seviye %2)
		target = (if wantSprint then M.Sprint else M.Run) * (1 + (stat("Hiz") - 1) * 0.02)
		if state.tired then
			target *= M.TiredFactor
		end
		if os.clock() < state.turboUntil then
			target *= DU.TurboBoost -- kombo ödülü: kısa süreli hız
		end
	end
	if moving and state.lastDir.Magnitude > 0.1 and state.lastDir:Dot(dir) < M.TurnDot and state.speed > M.Run * 0.7 then
		state.speed *= M.TurnLoss
		an:Play("Fren")
	end
	if moving then
		state.lastDir = dir
	end
	local rate = if target > state.speed then M.Sprint / M.AccelTime else M.Sprint / M.DecelTime
	state.speed += math.clamp(target - state.speed, -rate * dt, rate * dt)
	local factor = an:SpeedFactor()
	local ts = TimeScale.Value
	local sdt = dt * ts
	hum.WalkSpeed = math.max(state.speed, if moving then 3 else 0) * factor * ts
	hum.JumpHeight = 0 -- zıplama eylemle yapılır

	-- görüş açısı hıza göre genişler
	local cam = Workspace.CurrentCamera
	if cam.CameraType == Enum.CameraType.Custom then
		local k = math.clamp((state.speed - M.Run) / (M.Sprint - M.Run), 0, 1)
		cam.FieldOfView += ((M.FovBase + (M.FovSprint - M.FovBase) * k) - cam.FieldOfView) * math.min(1, dt * 5)
	end

	-- dönüş yönü (yana yatma için)
	local turn = 0
	if moving then
		turn = math.clamp(hrp.CFrame.RightVector:Dot(dir) * 2, -1, 1)
	end
	local vel = hrp.AssemblyLinearVelocity
	an:Update(sdt, {
		speed = Vector3.new(vel.X, 0, vel.Z).Magnitude,
		sprinting = wantSprint,
		tired = state.tired,
		grounded = hum.FloorMaterial ~= Enum.Material.Air,
		turn = turn,
		vy = vel.Y,
	})

	-- turbo parlaması
	local turbo = os.clock() < state.turboUntil
	if ui.aura and ui.aura.Parent ~= (if turbo then an.Character else nil) then
		ui.aura.Parent = if turbo then an.Character else nil
	end

	-- top
	if state.hud then
		local ctx = { playerPos = hrp.Position - Vector3.new(0, 3, 0) }
		if matchApi then
			matchApi.Update(sdt, ctx)
		else
			Bots.Update(sdt, ctx)
		end
		Ball.Carry(sdt, {
			pos = hrp.Position - Vector3.new(0, 3, 0),
			dir = if moving then dir else Vector3.zero,
			speed = state.speed,
			control = stat("TopKontrolu"),
		})
		Ball.Step(sdt)
		-- düşüş halkası: havadan gelen topun ineceği yer; halka daraldıkça zıplama zamanı yaklaşır
		local land, t = Ball.Predict()
		if ui.landRing then
			if land and t and t > 0.05 then
				local sz = 2.5 + t * 7
				ui.landRing.Size = Vector3.new(0.06, sz, sz)
				ui.landRing.CFrame = CFrame.new(land.X, TP.GroundY + 0.05, land.Z) * CFrame.Angles(0, 0, math.rad(90))
				ui.landRing.Color = if t < 0.5 then C.Good else C.Yellow
				ui.landRing.Transparency = 0.35
			else
				ui.landRing.Transparency = 1
			end
		end
		-- şut gücü
		if state.charging then
			state.charge = math.min(SH.MaxCharge, state.charge + dt / SH.ChargeTime)
			if state.charge >= SH.MaxCharge then
				shootUp()
			end
		end
		if ui.powerHolder then
			ui.powerHolder.Visible = state.charging
			if state.charging then
				ui.powerFill.Size = UDim2.fromScale(state.charge / SH.MaxCharge, 1)
				local perfect = state.charge >= SH.PerfectFrom and state.charge <= SH.PerfectTo
				ui.powerFill.BackgroundColor3 = if state.charge > SH.OverFrom then C.Bad elseif perfect then C.Good else C.Yellow
			end
		end
		if ui.aim then
			if state.charging then
				local shot = Config.Shots[SHOTS[state.shot]]
				local ap = Ball.AimPoint(aimInput(), state.charge, shot.Lift)
				local spread = 1.2 + (11 - stat("Sut")) * 0.28 * shot.Error
				ui.aim.Size = Vector3.new(0.06, spread * 2, spread * 2)
				ui.aim.CFrame = CFrame.new(ap.X, math.min(ap.Y, TP.GoalHeight + 6), TP.GoalZ - 0.3) * CFrame.Angles(0, math.rad(90), 0)
				ui.aim.Transparency = 0.3
			elseif os.clock() > (ui.aimHold or 0) then
				ui.aim.Transparency = 1
			end
		end
	end

	-- arayüz
	if ui.stamina then
		local r = state.stamina / M.StaminaMax
		if math.abs(r - ui.stamina.Value) > 0.004 then
			ui.stamina.Set(r, true)
		end
		ui.staminaFill.BackgroundColor3 = if state.tired then C.Bad elseif r < 0.3 then C.Gold else C.Good
		ui.speed.Text = string.format("%d", math.floor(state.speed + 0.5))
	end
end

local function bindCharacter(character: Model)
	local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local hrp = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not hum or not hrp then
		return
	end
	task.wait(0.3) -- görünüm uygulanırken parçalar yenilenebilir
	if state.animator then
		state.animator:Destroy()
	end
	state.hum, state.hrp = hum, hrp
	state.animator = Animator.new(character)
	state.animator:OnEvent(onEvent)
	state.speed = 0
end

-- Görünüm değişince (ApplyDescription) eklemler yenilenir; animatörü yeniden kur
function Controller.Rebind()
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
end

--------------------------------------------------------------------------------
-- Arayüz kurulumu
--------------------------------------------------------------------------------
local function roundButton(text: string, size: number, primary: boolean, onDown: () -> (), onUp: (() -> ())?)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Text = ""
	b.Size = UDim2.fromOffset(size, size)
	b.BackgroundColor3 = if primary then C.Yellow else C.Navy
	b.BackgroundTransparency = if primary then 0 else 0.15
	b.BorderSizePixel = 0
	local cr = Instance.new("UICorner")
	cr.CornerRadius = UDim.new(1, 0)
	cr.Parent = b
	Components.Stroke(b, if primary then C.White else C.Yellow, 2.5, if primary then 0.6 else 0.1)
	local l = Components.Label({
		Text = text,
		Size = if size > 100 then 22 else 16,
		Font = Theme.Font.Display,
		Color = if primary then C.Navy else C.Text,
		Upper = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.fromScale(1, 1),
	})
	l.Parent = b
	local sc = Instance.new("UIScale")
	sc.Parent = b
	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			UIMotion.Tween(sc, 0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Scale = 0.9 })
			onDown()
		end
	end)
	b.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			UIMotion.Tween(sc, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })
			if onUp then
				onUp()
			end
		end
	end)
	return b
end

local function buildHud(gui: ScreenGui, onExit: () -> ())
	local root = Instance.new("Frame")
	root.Name = "PitchHud"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Visible = false
	root.Parent = gui
	ui.root = root

	-- Dayanıklılık (sol alt): tabela yok; kabartmalı yazı ve konturlu çubuk doğrudan sahnenin üstünde
	local sc = Instance.new("Frame")
	sc.Name = "Stamina"
	sc.BackgroundTransparency = 1
	sc.Size = UDim2.fromOffset(330, 70)
	sc.AnchorPoint = Vector2.new(0, 1)
	sc.Position = UDim2.new(0, 24, 1, -24)
	sc.Parent = root
	local cap =
		Components.Label3D({ Text = "Dayanıklılık", Size = 17, Upper = true, Color = C.White, Frame = UDim2.fromOffset(230, 26) })
	cap.Parent = sc
	ui.stamina = Components.Bar({ Size = UDim2.fromOffset(236, 14), Color = C.Good, Value = 1 })
	ui.stamina.Frame.Position = UDim2.fromOffset(0, 34)
	ui.stamina.Frame.BackgroundColor3 = Color3.fromRGB(4, 8, 28)
	Components.Stroke(ui.stamina.Frame, Color3.fromRGB(4, 8, 28), 3, 0)
	-- çubuğun altındaki gölge (kalınlık hissi)
	local barShadow = Instance.new("Frame")
	barShadow.Name = "BarShadow"
	barShadow.BackgroundColor3 = Color3.fromRGB(4, 8, 28)
	barShadow.BackgroundTransparency = 0.45
	barShadow.BorderSizePixel = 0
	barShadow.Size = UDim2.fromOffset(242, 14)
	barShadow.Position = UDim2.fromOffset(-3, 41)
	local bsc = Instance.new("UICorner")
	bsc.CornerRadius = UDim.new(0, 6)
	bsc.Parent = barShadow
	barShadow.Parent = sc
	ui.stamina.Frame.Parent = sc
	ui.staminaFill = ui.stamina.Frame:FindFirstChildOfClass("Frame")
	local speedHolder, speedLabel = Components.Label3D({
		Text = "0",
		Size = 36,
		Color = C.Yellow,
		Align = Enum.TextXAlignment.Right,
		Frame = UDim2.fromOffset(78, 46),
	})
	speedHolder.AnchorPoint = Vector2.new(1, 0)
	speedHolder.Position = UDim2.new(1, 0, 0, -2)
	speedHolder.Parent = sc
	ui.speed = speedLabel
	local unit = Components.Label3D({
		Text = "hız",
		Size = 13,
		Color = C.White,
		Upper = true,
		Align = Enum.TextXAlignment.Right,
		Frame = UDim2.fromOffset(78, 20),
	})
	unit.AnchorPoint = Vector2.new(1, 0)
	unit.Position = UDim2.new(1, 0, 0, 44)
	unit.Parent = sc

	-- Şut yuvaları (alt orta)
	local slots = Instance.new("Frame")
	slots.BackgroundTransparency = 1
	slots.AnchorPoint = Vector2.new(0.5, 1)
	slots.Position = UDim2.new(0.5, 0, 1, -20)
	slots.Size = UDim2.fromOffset(#SHOTS * 108 - 8, 62)
	slots.Parent = root
	ui.slots = {}
	for i, id in ipairs(SHOTS) do
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.Text = ""
		b.BackgroundColor3 = C.Navy
		b.BackgroundTransparency = 0.08
		b.BorderSizePixel = 0
		b.Size = UDim2.fromOffset(100, 62)
		b.Position = UDim2.fromOffset((i - 1) * 108, 0)
		Components.Corner(b, Theme.Corner.Small)
		Components.Stroke(b, C.Yellow, 1.5, 0.55)
		local key =
			Components.Label({ Text = tostring(i), Size = 12, Font = Theme.Font.Number, Color = C.Muted, Frame = UDim2.fromOffset(20, 16) })
		key.Name = "Key"
		key.Position = UDim2.fromOffset(8, 4)
		key.Parent = b
		local nm = Components.Label({
			Text = Poses.Names[id],
			Size = 15,
			Font = Theme.Font.Display,
			Upper = true,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.new(1, 0, 0, 20),
		})
		nm.Name = "Name_"
		nm.Position = UDim2.fromOffset(0, 26)
		nm.Parent = b
		b.Activated:Connect(function()
			selectShot(i)
		end)
		b.Parent = slots
		ui.slots[i] = b
	end

	-- Eylem adı (orta üst)
	local bn = Components.Label({
		Text = "",
		Size = 54,
		Font = Theme.Font.Display,
		Color = C.Yellow,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 64),
	})
	bn.Position = UDim2.fromScale(0, 0.2)
	bn.TextTransparency = 1
	ui.bannerStroke = Components.Stroke(bn, C.Navy, 4, 1)
	ui.bannerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	bn.Parent = root
	ui.banner = bn

	-- Çıkış (sağ üst, bakiyenin altında)
	local exit = Components.Button({
		Text = "Lobiye dön",
		Style = "Ghost",
		Size = UDim2.fromOffset(180, 44),
		TextSize = 16,
		OnClick = function()
			if matchApi then
				matchApi.Forfeit()
			else
				onExit()
			end
		end,
	})
	exit.AnchorPoint = Vector2.new(1, 0)
	exit.Position = UDim2.new(1, -20, 0, 96)
	exit.Parent = root

	if UserInputService.TouchEnabled then
		-- Dokunmatik butonlar (sağ alt)
		local pad = Instance.new("Frame")
		pad.BackgroundTransparency = 1
		pad.AnchorPoint = Vector2.new(1, 1)
		pad.Position = UDim2.new(1, -24, 1, -100)
		pad.Size = UDim2.fromOffset(380, 300)
		pad.Parent = root
		local function place(b: GuiObject, x: number, y: number)
			b.AnchorPoint = Vector2.new(1, 1)
			b.Position = UDim2.new(1, -x, 1, -y)
			b.Parent = pad
		end
		place(roundButton("Şut", 120, true, shootDown, shootUp), 0, 0)
		place(roundButton("Pas", 88, false, passDown, passUp), 132, 0)
		place(roundButton("Orta", 76, false, cross), 250, 220)
		place(roundButton("Top", 76, false, fetchBall), 340, 220)
		place(
			roundButton("Sprint", 88, false, function()
				state.sprintHeld = true
			end, function()
				state.sprintHeld = false
			end),
			232,
			0
		)
		place(roundButton("Çalım", 88, false, doDribble), 16, 132)
		place(roundButton("Zıpla", 88, false, doJump), 116, 104)
		place(roundButton("Müdahale", 88, false, doTackle), 216, 104)
		place(roundButton("Sevinç", 76, false, doCelebrate), 60, 232)
		place(roundButton("Blok", 76, false, doBlock), 150, 208)
	else
		-- Tuş ipuçları (sağ alt)
		local hp, hc = Components.Panel({
			Name = "Keys",
			Size = UDim2.fromOffset(340, 274),
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -20, 1, -20),
			Title = "Tuşlar",
		})
		hp.Parent = root
		ui.keysPanel = hp
		local lines = {
			{ "WASD", "Koş  ·  Shift: sprint" },
			{ "Sol tık", "Şut: basılı tut, yeşilde bırak" },
			{ "", "Top sende değilse: müdahale" },
			{ "Sağ tık", 'Pas  ·  topsuzken: "pas ver!"' },
			{ "Boşluk", "Çalım  ·  topsuzken: kafa" },
			{ "T", "Takım emri: atak / defans / pres" },
			{ "1 - 6", "Şut türü" },
			{ "B / G", "Orta aç  /  sevinç" },
			{ "N", "Topu getir (deneme sahası)" },
		}
		for i, ln in ipairs(lines) do
			local k =
				Components.Label({ Text = ln[1], Size = 13, Font = Theme.Font.Number, Color = C.Yellow, Frame = UDim2.fromOffset(84, 20) })
			k.Position = UDim2.fromOffset(0, 36 + (i - 1) * 23)
			k.Parent = hc
			local t = Components.Label({ Text = ln[2], Size = 13, Frame = UDim2.new(1, -90, 0, 20) })
			t.Position = UDim2.fromOffset(90, 36 + (i - 1) * 23)
			t.Parent = hc
		end
	end
	-- Şut gücü barı (şut yuvalarının üstünde): sarı dolar, yeşil pencere mükemmel, kırmızı fazla
	local ph = Instance.new("Frame")
	ph.Name = "Power"
	ph.AnchorPoint = Vector2.new(0.5, 1)
	ph.Position = UDim2.new(0.5, 0, 1, -96)
	ph.Size = UDim2.fromOffset(460, 22)
	ph.BackgroundColor3 = C.Ground
	ph.BackgroundTransparency = 0.15
	ph.BorderSizePixel = 0
	ph.Visible = false
	ph.ClipsDescendants = true
	Components.Corner(ph, 6)
	Components.Stroke(ph, C.Yellow, 1.5, 0.3)
	ph.Parent = root
	local function zone(from: number, to: number, color: Color3, tr: number)
		local z = Instance.new("Frame")
		z.BorderSizePixel = 0
		z.BackgroundColor3 = color
		z.BackgroundTransparency = tr
		z.Position = UDim2.fromScale(from / SH.MaxCharge, 0)
		z.Size = UDim2.fromScale((to - from) / SH.MaxCharge, 1)
		z.Parent = ph
	end
	zone(SH.PerfectFrom, SH.PerfectTo, C.Good, 0.45)
	zone(SH.OverFrom, SH.MaxCharge, C.Bad, 0.6)
	local pf = Instance.new("Frame")
	pf.BorderSizePixel = 0
	pf.BackgroundColor3 = C.Yellow
	pf.BackgroundTransparency = 0.1
	pf.Size = UDim2.fromScale(0, 1)
	pf.Parent = ph
	ui.powerHolder, ui.powerFill = ph, pf

	-- Gol sayacı (üst orta)
	local gp, gc = Components.Panel({
		Name = "Goals",
		Size = UDim2.fromOffset(200, 60),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 20),
		Accent = false,
	})
	gp.Parent = root
	ui.goalsPanel = gp
	local gl = Components.Label({
		Text = "Gol",
		Size = 12,
		Color = C.Muted,
		Font = Theme.Font.Title,
		Upper = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 14),
	})
	gl.Parent = gc
	ui.goals = Components.Label({
		Text = "0",
		Size = 26,
		Font = Theme.Font.Number,
		Color = C.Yellow,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 28),
	})
	ui.goals.Position = UDim2.fromOffset(0, 12)
	ui.goals.Parent = gc

	-- Sahadaki işaretler: nişan halkası ve düşüş halkası
	local function marker(color: Color3)
		local m = Instance.new("Part")
		m.Shape = Enum.PartType.Cylinder
		m.Anchored = true
		m.CanCollide = false
		m.CanQuery = false
		m.Material = Enum.Material.Neon
		m.Color = color
		m.Transparency = 1
		m.Size = Vector3.new(0.06, 3, 3)
		m.Parent = Workspace
		return m
	end
	ui.aim = marker(C.Yellow)
	ui.landRing = marker(C.Yellow)

	-- Kombo sayacı (gol sayacının sağında)
	ui.combo = Components.Label({ Text = "", Size = 26, Font = Theme.Font.Display, Color = C.Gold, Frame = UDim2.fromOffset(220, 32) })
	ui.combo.Position = UDim2.new(0.5, 116, 0, 34)
	Components.Stroke(ui.combo, C.Navy, 3, 0).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	ui.combo.Parent = root

	-- Çalışma modu (gol sayacının altında)
	local modes = Forms.Chips({
		Options = { { Id = "Hucum", Text = "Hücum çalışması" }, { Id = "Savunma", Text = "Savunma çalışması" } },
		Value = "Hucum",
		OnChange = function(id)
			state.yellow = false
			setCombo(0)
			Bots.Start(id)
			if id == "Hucum" and state.hrp then
				Ball.Reset(state.hrp.Position + state.hrp.CFrame.LookVector * 6)
			end
			banner(if id == "Hucum" then "Savunmayı geç, gol at" else "Rakibi durdur, topu al")
		end,
	})
	modes.Frame.AnchorPoint = Vector2.new(0.5, 0)
	modes.Frame.Position = UDim2.new(0.5, 0, 0, 88)
	modes.Frame.Size = UDim2.fromOffset(400, 34)
	modes.Frame.Parent = root
	ui.modesFrame = modes.Frame
	local ml = modes.Frame:FindFirstChildOfClass("UIListLayout")
	if ml then
		ml.HorizontalAlignment = Enum.HorizontalAlignment.Center
	end

	-- Turbo parlaması
	local aura = Instance.new("Highlight")
	aura.FillColor = C.Yellow
	aura.FillTransparency = 0.75
	aura.OutlineColor = C.Yellow
	aura.OutlineTransparency = 0
	ui.aura = aura
	paintShots()
end

-- Gol, direk ve aut tepkileri
local function bindBall()
	local function back(delay: number)
		task.delay(delay, function()
			local hrp = state.hrp
			if hrp and state.hud then
				Ball.Reset(hrp.Position + hrp.CFrame.LookVector * 5)
			end
		end)
	end
	Ball.On("goal", function(kind)
		if matchApi then
			return -- maçta golü MatchController yönetir
		end
		state.goals += 1
		if ui.goals then
			ui.goals.Text = tostring(state.goals)
			UIMotion.Pop(ui.goals, 1.6)
		end
		local head = kind == "Header" or kind == "UcanKafa"
		banner(if head then "Kafa golü!" elseif kind == "Rovesata" then "Röveşata golü!" else "Gol!", C.Gold)
		shake(1.2)
		UIMotion.Sound("RewardSound")
		-- konfeti
		local burst = Instance.new("Part")
		burst.Anchored = true
		burst.CanCollide = false
		burst.Transparency = 1
		burst.Size = Vector3.new(TP.GoalHalfWidth * 2, 1, 1)
		burst.CFrame = CFrame.new(0, TP.GoalHeight + 2, TP.GoalZ - 2)
		burst.Parent = Workspace
		for _, col in ipairs({ C.Yellow, C.Navy, C.White }) do
			local e = Instance.new("ParticleEmitter")
			e.Enabled = false
			e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			e.Color = ColorSequence.new(col)
			e.Size = NumberSequence.new(0.6)
			e.Lifetime = NumberRange.new(1.2, 2.2)
			e.Speed = NumberRange.new(14, 30)
			e.SpreadAngle = Vector2.new(70, 70)
			e.Acceleration = Vector3.new(0, -26, 0)
			e.Rotation = NumberRange.new(0, 360)
			e.RotSpeed = NumberRange.new(-200, 200)
			e.EmissionDirection = Enum.NormalId.Top
			e.Parent = burst
			e:Emit(40)
		end
		task.delay(3, function()
			burst:Destroy()
		end)
		-- file dalgalanması
		local studio = Workspace:FindFirstChild("FK_Studio")
		if studio then
			for _, d in ipairs(studio:GetChildren()) do
				if d.Name == "Net" and d:IsA("BasePart") then
					d.Transparency = 0.15
					TweenService:Create(d, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0.6 })
						:Play()
				end
			end
		end
		Remotes.Get("TrainingGoal"):FireServer(kind)
		if state.animator and not state.animator:IsBusy() then
			state.animator:Play("Sevinc")
		end
		back(2.4)
	end)
	Ball.On("post", function()
		banner("Direk!", C.White)
		shake(0.8)
		UIMotion.Sound("ErrorSound")
	end)
	Ball.On("out", function()
		if matchApi then
			return
		end
		banner("Aut", C.Muted)
		if Bots.Mode() == "Hucum" then
			back(1.4)
		end
	end)
	Bots.On("steal", function()
		setCombo(0)
		banner("Top kaptırdın", C.Bad)
		UIMotion.Sound("ErrorSound")
		back(2.2)
	end)
	Bots.On("save", function(kind)
		banner(
			if kind == "fumble" then "Kaleci elinden kaçırdı!" elseif kind == "catch" then "Kaleci tuttu" else "Kaleci çeldi!",
			C.White
		)
		shake(0.5)
	end)
	Bots.On("escape", function()
		banner("Rakip kaçtı", C.Bad)
		UIMotion.Sound("ErrorSound")
	end)
	Bots.On("telegraph", function()
		UIMotion.Sound("ClickSound") -- müdahale geliyor: şimdi çalım at
	end)
end

-- Telefonda Roblox'un kendi zıplama butonunu gizle (zıplama "Zıpla" butonuyla yapılır)
local function hideDefaultJump()
	task.spawn(function()
		local pg = player:WaitForChild("PlayerGui")
		local touch = pg:WaitForChild("TouchGui", 15)
		local frame = touch and touch:WaitForChild("TouchControlFrame", 10)
		local jump = frame and frame:WaitForChild("JumpButton", 10)
		if jump and jump:IsA("GuiObject") then
			jump.Visible = false
			jump:GetPropertyChangedSignal("Visible"):Connect(function()
				if jump.Visible then
					jump.Visible = false
				end
			end)
		end
	end)
end

function Controller.SetHud(visible: boolean)
	state.hud = visible
	if ui.root then
		ui.root.Visible = visible
		if visible then
			for _, child in ipairs(ui.root:GetChildren()) do
				if child:IsA("CanvasGroup") then
					UIMotion.In(child, Vector2.new(0, 30), 0.05)
				end
			end
			Ball.Init()
			if not matchApi then
				banner("Deneme sahası")
				Bots.Start("Hucum")
			end
			local hrp = state.hrp
			if hrp and not matchApi then
				Ball.Reset(hrp.Position + hrp.CFrame.LookVector * 6)
			end
			-- yalnızca deneme sahasına ait parçalar maçta gizlenir
			for _, key in ipairs({ "goalsPanel", "modesFrame", "keysPanel" }) do
				if ui[key] then
					ui[key].Visible = matchApi == nil
				end
			end
		end
		if not visible then
			Bots.Clear()
		end
		for _, key in ipairs({ "aim", "landRing" }) do
			if ui[key] and not visible then
				ui[key].Transparency = 1
			end
		end
		local ballPart = Workspace:FindFirstChild("FK_Ball")
		if ballPart and ballPart:IsA("BasePart") then
			ballPart.Transparency = if visible then 0 else 1
		end
	end
end

-- Maç kancaları: api = { Update, Feint, Tackle, HumanSave, OnHumanKick, Forfeit } ya da nil (deneme sahası)
function Controller.SetMatch(api: any, pitch: any)
	matchApi = api
	TP = pitch or Config.TestPitch
	setCombo(0)
	state.yellow = false
	if api then
		Bots.Clear()
	end
end

-- Anlık durum (sınama ve kayıt araçları için)
function Controller.Debug()
	return {
		action = state.animator and state.animator:Current() or "",
		speed = state.speed,
		stamina = state.stamina,
		charge = if state.charging then state.charge else 0,
	}
end

-- Dışarıdan eylem oynatma (gol sevinci, üzülme)
function Controller.PlayAction(name: string)
	if state.animator then
		state.animator:Play(name)
	end
end

function Controller.Start(gui: ScreenGui, getData: () -> any, onExit: () -> ())
	state.getData = getData
	buildHud(gui, onExit)
	bindBall()
	if UserInputService.TouchEnabled then
		hideDefaultJump()
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Config.Keys.Sprint or input.KeyCode == Enum.KeyCode.ButtonR2 then
			state.sprintHeld = true
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			return primaryDown()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			-- sağ tık: kısa dokunuş pas sayılır; basılı sürükleme kamerayı çevirmeye devam eder
			state.rmb = { at = os.clock(), pos = input.Position }
			return
		end
		local idx = table.find(NUMBER_KEYS, input.KeyCode)
		if idx and state.hud then
			return selectShot(idx)
		end
		if input.KeyCode == Enum.KeyCode.Z then
			state.lastMirror = true
		elseif input.KeyCode == Enum.KeyCode.X then
			state.lastMirror = false
		end
		local fn = KEYMAP[input.KeyCode]
		if fn then
			fn()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Config.Keys.Sprint or input.KeyCode == Enum.KeyCode.ButtonR2 then
			state.sprintHeld = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			primaryUp()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			local r = state.rmb
			state.rmb = nil
			if r and os.clock() - r.at < 0.3 then
				local moved = if r.pos and input.Position then (input.Position - r.pos).Magnitude else 0
				if moved < 12 then
					secondary()
				end
			end
		elseif input.KeyCode == Config.Keys.Shoot then
			shootUp()
		elseif input.KeyCode == Config.Keys.Pass then
			passUp()
		end
	end)

	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
	-- Eklemler her fizik adımından önce yazılır
	RunService.Stepped:Connect(function(_, dt)
		step(dt)
	end)
end

return Controller
]]></ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX25"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	Main (istemci)
	Adım 1-2 vitrini: yükleme ekranı, çubuklu perde geçişi ve bileşen kütüphanesini kullanan
	lobi katmanı (oyuncu kartı, bakiye, menü, görevler, bildirimler). Sunucu verisiyle canlı çalışır.
	Sonraki adımlarda bu dosya ekran yöneticisine dönüşecek.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)
local Components = require(ReplicatedStorage.UI.Components)

local C = Theme.Color
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "FenerUI"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local function list(parent: Instance, gap: number, horizontal: boolean?)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, gap)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.VerticalAlignment = if horizontal then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top
	l.Parent = parent
	return l
end

-- Bildirim alanı (sağ üst)
local toasts = Instance.new("Frame")
toasts.Name = "Toasts"
toasts.BackgroundTransparency = 1
toasts.AnchorPoint = Vector2.new(1, 0)
toasts.Position = UDim2.new(1, -20, 0, 96)
toasts.Size = UDim2.fromOffset(320, 400)
toasts.ZIndex = 50
toasts.Parent = gui
list(toasts, 8)
Components.SetToastHolder(toasts)

--------------------------------------------------------------------------------
-- YÜKLEME EKRANI
--------------------------------------------------------------------------------
local TIPS = {
	"Mevkin kariyer boyunca değişmez. İyi seç.",
	"Şut barını yeşil pencerede bırakırsan mükemmel vuruş olur.",
	"Rakip müdahaleye girdiği anda çalım at, dengesini kaybeder.",
	"Sezonu ilk ikide bitir, stadyumun büyüsün.",
	"Havadan gelen topta halka en dar olduğunda zıpla.",
}

local function showLoading(onDone: () -> ())
	local bg = Instance.new("Frame")
	bg.Name = "Loading"
	bg.BorderSizePixel = 0
	bg.BackgroundColor3 = C.Ground
	bg.Size = UDim2.fromScale(1, 1)
	bg.ZIndex = 100
	bg.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(120, 130, 190))
	grad.Parent = bg

	-- Arka planda yavaşça kayan eğik çubuklar
	local stripes = Instance.new("CanvasGroup")
	stripes.BackgroundTransparency = 1
	stripes.GroupTransparency = 0.9
	stripes.Size = UDim2.fromScale(1, 1)
	stripes.ZIndex = 100
	stripes.Parent = bg
	for i = 0, 15 do
		local b = Instance.new("Frame")
		b.BorderSizePixel = 0
		b.BackgroundColor3 = if i % 2 == 0 then C.Yellow else C.Blue
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Size = UDim2.new(0.035, 0, 2, 0)
		b.Position = UDim2.fromScale(i / 14, 0.5)
		b.Rotation = Theme.Skew
		b.Parent = stripes
		UIMotion.Tween(b, 6, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, { Position = UDim2.fromScale(i / 14 + 0.07, 0.5) })
	end

	local badge = Components.Badge({ Text = "F", Size = 120, Image = Config.Assets.Crest })
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.Position = UDim2.fromScale(0.5, 0.38)
	badge.ZIndex = 101
	badge.Parent = bg
	UIMotion.Pop(badge, 0.5)
	local stopPulse = UIMotion.Pulse(badge, 0.06, 0.9)

	local title = Components.Label({
		Text = "Fener Kariyer",
		Size = 44,
		Font = Theme.Font.Display,
		Color = C.Yellow,
		Upper = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 50),
	})
	title.Position = UDim2.fromScale(0, 0.56)
	title.ZIndex = 101
	title.Parent = bg
	local sub = Components.Label({
		Text = "1907'den beri · Kadıköy",
		Size = 16,
		Color = C.Muted,
		Upper = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 22),
	})
	sub.Position = UDim2.new(0, 0, 0.56, 52)
	sub.ZIndex = 101
	sub.Parent = bg

	local bar = Components.Bar({ Size = UDim2.new(0.36, 0, 0, 10) })
	bar.Frame.AnchorPoint = Vector2.new(0.5, 0)
	bar.Frame.Position = UDim2.fromScale(0.5, 0.74)
	bar.Frame.ZIndex = 101
	bar.Frame.Parent = bg

	local tip =
		Components.Label({ Text = TIPS[1], Size = 15, Color = C.Text, Align = Enum.TextXAlignment.Center, Frame = UDim2.new(1, 0, 0, 22) })
	tip.Position = UDim2.new(0, 0, 0.74, 24)
	tip.ZIndex = 101
	tip.Parent = bg

	task.spawn(function()
		for step = 1, 4 do
			bar.Set(step / 4)
			tip.Text = TIPS[(step % #TIPS) + 1]
			UIMotion.Pop(tip, 0.92)
			task.wait(0.55)
		end
		stopPulse()
		UIMotion.Wipe(function()
			bg:Destroy()
			onDone()
		end)
	end)
end

--------------------------------------------------------------------------------
-- LOBİ KATMANI (bileşen vitrini)
--------------------------------------------------------------------------------
local SkillTree = require(script.Parent.Screens.SkillTree)
local CrestDesigner = require(script.Parent.Screens.CrestDesigner)
local League = require(script.Parent.Screens.League)
local state = { data = nil :: any, coinsShown = 0, rendered = false }
local refs: { [string]: any } = {}

local enterPitch: () -> ()
local enterMatch: () -> ()

local function buildLobby()
	-- Oyuncu kartı (sol üst)
	local card, cc = Components.Panel({ Name = "PlayerCard", Size = UDim2.fromOffset(340, 104), Position = UDim2.fromOffset(20, 60) })
	card.Parent = gui
	local badge = Components.Badge({ Text = "F", Size = 54, Image = Config.Assets.Crest })
	badge.Parent = cc
	refs.name = Components.Label({ Text = "...", Size = 20, Font = Theme.Font.Display, Upper = true, Frame = UDim2.new(1, -70, 0, 24) })
	refs.name.Position = UDim2.fromOffset(68, 0)
	refs.name.Parent = cc
	refs.sub = Components.Label({ Text = "", Size = 13, Color = C.Muted, Frame = UDim2.new(1, -70, 0, 18) })
	refs.sub.Position = UDim2.fromOffset(68, 24)
	refs.sub.Parent = cc
	refs.level = Components.Label({
		Text = "Seviye 1",
		Size = 13,
		Font = Theme.Font.Title,
		Color = C.Yellow,
		Upper = true,
		Frame = UDim2.fromOffset(90, 18),
	})
	refs.level.Position = UDim2.fromOffset(68, 48)
	refs.level.Parent = cc
	refs.xp = Components.Bar({ Size = UDim2.new(1, -164, 0, 8) })
	refs.xp.Frame.Position = UDim2.fromOffset(160, 53)
	refs.xp.Frame.Parent = cc

	-- Bakiye (sağ üst)
	local coin, coinC = Components.Panel({
		Name = "Coins",
		Size = UDim2.fromOffset(220, 64),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 20),
		Accent = false,
	})
	coin.Parent = gui
	local coinLabel = Components.Label({ Text = "Bakiye", Size = 12, Color = C.Muted, Upper = true, Frame = UDim2.new(1, 0, 0, 14) })
	coinLabel.Parent = coinC
	refs.coins = Components.Label({ Text = "0", Size = 26, Font = Theme.Font.Number, Color = C.Yellow, Frame = UDim2.new(1, 0, 0, 28) })
	refs.coins.Position = UDim2.fromOffset(0, 14)
	refs.coins.Parent = coinC

	-- Menü (sol)
	local menu, mc = Components.Panel({
		Name = "Menu",
		Size = UDim2.fromOffset(310, 478),
		Position = UDim2.fromOffset(20, 178),
		Title = "Kariyer Merkezi",
	})
	menu.Parent = gui
	refs.menu = menu
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Position = UDim2.fromOffset(0, 40)
	holder.Size = UDim2.new(1, 0, 1, -40)
	holder.Parent = mc
	list(holder, 8)
	local buttons = {}
	local function add(text: string, style: string, locked: string?, onClick: (() -> ())?, sub: string?)
		local b = Components.Button({
			Text = text,
			Style = style,
			Locked = locked,
			Order = #buttons + 1,
			OnClick = onClick,
			Sub = sub,
			Size = UDim2.new(1, 0, 0, 58),
		})
		b.Parent = holder
		table.insert(buttons, b)
	end
	add("Maça çık", "Primary", nil, function()
		enterMatch()
	end, "Lig maçı · 11'e 11")
	add("Deneme sahası", "Secondary", nil, function()
		enterPitch()
	end, "Şut, çalım ve savunma çalış")
	add("Yetenek ağacı", "Ghost", nil, function()
		SkillTree.Open(gui, function()
			return state.data
		end)
	end, "Hareket aç, özellik yükselt")
	add("Kulüp arması", "Secondary", nil, function()
		CrestDesigner.Open(gui, function()
			return state.data
		end)
	end, "Biçim, desen, renk, simge")
	add("Puan durumu", "Ghost", nil, function()
		League.Open(gui, function()
			return state.data
		end)
	end, "Lig tablosu ve lig atlama çizgisi")

	-- Görevler (sağ)
	local tasks, tc = Components.Panel({
		Name = "Tasks",
		Size = UDim2.fromOffset(300, 214),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 500),
		Title = "Günlük görevler",
	})
	tasks.Position = UDim2.new(1, -20, 1, -234)
	tasks.Parent = gui
	refs.tasks = tasks
	local th = Instance.new("Frame")
	th.BackgroundTransparency = 1
	th.Position = UDim2.fromOffset(0, 40)
	th.Size = UDim2.new(1, 0, 1, -40)
	th.Parent = tc
	list(th, 6)
	local bars = {}
	for i, t in ipairs({ { "2 gol at", 0.5, C.Yellow }, { "1 antrenman yap", 1, C.Good }, { "Kafayla gol at", 0, C.Yellow } }) do
		local l = Components.Label({ Text = t[1], Size = 14, Order = i * 2 - 1 })
		l.Parent = th
		local b = Components.Bar({ Color = t[3], Order = i * 2, Value = 0 })
		b.Frame.Parent = th
		bars[i] = { b, t[2] }
	end

	-- Sahneye giriş: paneller farklı yönlerden, butonlar sırayla
	UIMotion.In(card, Vector2.new(-40, 0), 0.05)
	UIMotion.In(coin, Vector2.new(40, 0), 0.1)
	UIMotion.In(menu, Vector2.new(-40, 0), 0.15)
	UIMotion.In(tasks, Vector2.new(40, 0), 0.2)
	UIMotion.Stagger(buttons, Vector2.new(-24, 0), 0.3)
	task.delay(0.6, function()
		for _, b in ipairs(bars) do
			b[1].Set(b[2])
		end
	end)
end

local function render(data)
	local first = state.data == nil or not state.rendered
	state.data = data
	SkillTree.Refresh()
	if not refs.name then
		return
	end
	state.rendered = true
	if data.created then
		refs.name.Text = Theme.Upper(data.name)
		refs.sub.Text = Config.PositionNames[data.position] .. " · " .. data.number .. " · " .. data.club.name
	else
		refs.name.Text = "YENİ FUTBOLCU"
		refs.sub.Text = "Kariyer henüz oluşturulmadı"
	end
	refs.level.Text = "SEVİYE " .. data.level
	refs.xp.Set(data.xp / Config.XpForLevel(data.level), first)
	if data.coins ~= state.coinsShown then
		UIMotion.CountUp(refs.coins, state.coinsShown, data.coins)
		state.coinsShown = data.coins
	end
end

Remotes.Get("DataChanged").OnClientEvent:Connect(render)
Remotes.Get("Notify").OnClientEvent:Connect(function(kind, text)
	if kind == "level" then
		UIMotion.Burst(gui, text, "Yeni ödüller açıldı") -- seviye atlama kutlaması
	end
	Components.Toast(kind, text)
end)

local Creator = require(script.Parent.Screens.Creator)
local PlayerController = require(script.Parent.Controllers.PlayerController)

local RemoteAnim = require(script.Parent.Match.RemoteAnim)
RemoteAnim.Start()

local controllerStarted = false
local function exitPitch()
	UIMotion.Wipe(function()
		PlayerController.SetHud(false)
		refs.menu.Visible = true
		refs.tasks.Visible = true
		UIMotion.In(refs.menu, Vector2.new(-40, 0), 0.1)
		UIMotion.In(refs.tasks, Vector2.new(40, 0), 0.15)
	end)
end

-- Deneme sahası: menüler kapanır, saha içi arayüz açılır, oyuncu çime ışınlanır
enterPitch = function()
	UIMotion.Wipe(function()
		refs.menu.Visible = false
		refs.tasks.Visible = false
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = CFrame.lookAt(Vector3.new(0, 4, 70), Vector3.new(0, 4, 140))
		end
		PlayerController.SetHud(true)
	end)
end

-- Maç: lobi menüleri kapanır, maç bitince geri gelir
local MatchController = require(script.Parent.Match.MatchController)
local Lineup = require(script.Parent.Screens.Lineup)

-- Stat modülü varsa lobi çevresini ve ışığını o kurar
do
	local stadiumModule = ReplicatedStorage.Shared:FindFirstChild("Stadium")
	if stadiumModule then
		task.defer(function()
			(require(stadiumModule) :: any).Lobby()
		end)
	end
end

-- Lobi ışığı: aydınlık gündüz (varsayılan ışık sahneyi karanlık bırakıyordu)
do
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = 14.2
	Lighting.GeographicLatitude = 28
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(120, 126, 150)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 155, 170)
	Lighting.ExposureCompensation = 0.15
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
end
local Squads = require(ReplicatedStorage.Shared.Squads)
enterMatch = function()
	if not state.data or not state.data.created then
		return
	end
	SkillTree.Close()
	CrestDesigner.Close()
	League.Close()
	-- Önce kadrolar ve teknik direktörler tanıtılır; "Maça çık" ile santraya geçilir
	local fixture = Squads.Fixture(state.data)
	local function back()
		refs.menu.Visible = true
		refs.tasks.Visible = true
		UIMotion.In(refs.menu, Vector2.new(-40, 0), 0.1)
		UIMotion.In(refs.tasks, Vector2.new(40, 0), 0.15)
	end
	UIMotion.Wipe(function()
		refs.menu.Visible = false
		refs.tasks.Visible = false
		Lineup.Show(gui, fixture, function()
			MatchController.Start(gui, state.data, back, fixture)
		end, back)
	end)
end

local function startController()
	if controllerStarted then
		PlayerController.Rebind()
		return
	end
	controllerStarted = true
	PlayerController.Start(gui, function()
		return state.data
	end, exitPitch)
end

-- Ekran ölçeği: 1600x900 tasarım ölçüsüne göre küçük ekranlarda arayüz orantılı küçülür
local uiScale = Instance.new("UIScale")
uiScale.Parent = gui
local function fit()
	local v = workspace.CurrentCamera.ViewportSize
	uiScale.Scale = math.clamp(math.min(v.X / 1600, v.Y / 900), 0.45, 1.25)
end
fit()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

showLoading(function()
	local data = Remotes.Get("GetData"):InvokeServer()
	if not data then
		Components.Toast("error", "Veri alınamadı. Oyundan çıkıp tekrar gir.")
		return
	end
	if data.created then
		buildLobby()
		render(data)
		startController()
	else
		Creator.Open(gui, function()
			buildLobby()
			if state.data then
				local d = state.data
				state.data = nil
				render(d)
			end
			Components.Toast("success", "Kariyerin başladı. Deneme sahasında hareketleri dene.")
			task.delay(1, startController) -- görünüm sunucuda uygulandıktan sonra eklemlere bağlan
		end)
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX33"><Properties><string name="Name">Match</string></Properties><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Ball</string><ProtectedString name="Source"><![CDATA[--[[
	Ball
	Top fiziği ve topla oynama. Top ayrı bir nesnedir; oyuncuya yapışmaz, her dokunuşla itilir.
	- Fizik: yerçekimi, hava direnci, yuvarlanma sürtünmesi, sekme, falso, saha sınırları, kale ve direk.
	- Sürme: her adımda (ayak yere basınca) top öne itilir; sprintte daha uzağa gider.
	- İlk dokunuş, durdurma, şut (hedef + hata payı + falso), pas, kafa, vole, röveşata.
	- Düşüş tahmini: havadan gelen topun ineceği yer ve süre (zamanlama halkası için).
	Maç tek oyunculu olduğu için top istemcide benzetilir; ödüller sunucuda doğrulanır.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local B = Config.Ball
local T: any = Config.TestPitch
local S = Config.Shooting
local C = Config.Colors

local Ball = {}

local part: Part? = nil
local trail: Trail? = nil
local pos = Vector3.new(0, 1, 80)
local vel = Vector3.zero
local curve = 0
local inNet = false
local lastKick = -10
local lastKind = "Shoot"
local clock = 0
local listeners = { goal = {}, post = {}, out = {}, kick = {}, dead = {} }

-- Topa en son dokunan takım: "home" (oyuncunun takımı) ya da "away"
Ball.LastTeam = "home"

local function fire(name: string, ...)
	for _, fn in ipairs(listeners[name]) do
		task.spawn(fn, ...)
	end
end

function Ball.On(name: string, fn)
	table.insert(listeners[name], fn)
end

-- Saha değiştirir (deneme sahası ya da maç sahası)
function Ball.SetPitch(def)
	T = def
end
function Ball.Pitch()
	return T
end

function Ball.Init()
	if part and part.Parent then
		return
	end
	local p = Instance.new("Part")
	p.Name = "FK_Ball"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(B.Radius * 2, B.Radius * 2, B.Radius * 2)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Color = Color3.fromRGB(250, 250, 250)
	p.Material = Enum.Material.SmoothPlastic
	p.CastShadow = true
	p.Parent = Workspace
	-- top deseni: klasik futbol topundaki 12 koyu beşgenin yerine, yüzeye yapışık 12 koyu yama
	-- (yirmi yüzlünün köşelerine dizilir; düz çıkartma gibi havada durmaz, topla birlikte döner)
	local phi = (1 + math.sqrt(5)) / 2
	local patch = B.Radius * 0.78
	for _, v in ipairs({
		Vector3.new(0, 1, phi),
		Vector3.new(0, 1, -phi),
		Vector3.new(0, -1, phi),
		Vector3.new(0, -1, -phi),
		Vector3.new(1, phi, 0),
		Vector3.new(1, -phi, 0),
		Vector3.new(-1, phi, 0),
		Vector3.new(-1, -phi, 0),
		Vector3.new(phi, 0, 1),
		Vector3.new(phi, 0, -1),
		Vector3.new(-phi, 0, 1),
		Vector3.new(-phi, 0, -1),
	}) do
		local n = v.Unit
		local d = Instance.new("Part")
		d.Name = "Patch"
		d.Size = Vector3.new(patch, B.Radius * 0.16, patch)
		d.Color = C.Navy
		d.Material = Enum.Material.SmoothPlastic
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
		d.Massless = true
		d.CastShadow = false
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = d
		local at = p.Position + n * (B.Radius * 0.94)
		d.CFrame = CFrame.lookAt(at, at + n) * CFrame.Angles(-math.pi / 2, 0, 0)
		local w = Instance.new("WeldConstraint")
		w.Part0 = p
		w.Part1 = d
		w.Parent = d
		d.Parent = p
	end
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, B.Radius * 0.8, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -B.Radius * 0.8, 0)
	a1.Parent = p
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.28
	tr.LightEmission = 0.6
	tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) })
	tr.Enabled = false
	tr.Parent = p
	p.Parent = Workspace
	part, trail = p, tr
end

function Ball.Position(): Vector3
	return pos
end
function Ball.Velocity(): Vector3
	return vel
end
function Ball.Speed(): number
	return vel.Magnitude
end
function Ball.InNet(): boolean
	return inNet
end
function Ball.SinceKick(): number
	return clock - lastKick
end

function Ball.Reset(at: Vector3)
	pos = Vector3.new(at.X, T.GroundY + B.Radius, at.Z)
	vel = Vector3.zero
	curve = 0
	inNet = false
	lastKick = -10 -- yeni top: dokunma beklemesi yok
	if trail then
		trail.Enabled = false
	end
end

local TRAIL_COLORS = {
	Fuze = ColorSequence.new(Color3.fromRGB(255, 90, 40), Color3.fromRGB(255, 200, 80)),
	Plase = ColorSequence.new(C.Yellow, C.White),
	Rovesata = ColorSequence.new(C.Gold, C.Yellow),
}

-- Topa hız verir. kind: iz rengi ve gol türü için
function Ball.Kick(v: Vector3, spin: number?, kind: string?)
	vel = v
	curve = spin or 0
	lastKick = clock
	lastKind = kind or "Shoot"
	inNet = false
	if trail then
		trail.Color = TRAIL_COLORS[lastKind] or ColorSequence.new(C.White)
	end
	fire("kick", lastKind, v)
	-- vuruşta sıkışma
	if part then
		part.Size = Vector3.new(B.Radius * 2.5, B.Radius * 1.5, B.Radius * 2.5)
		TweenService:Create(
			part,
			TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Size = Vector3.new(B.Radius * 2, B.Radius * 2, B.Radius * 2) }
		):Play()
	end
end

-- Tek fizik adımı (durum değiştirmeden de kullanılabilsin diye değerleri alır ve döndürür)
local function integrate(p: Vector3, v: Vector3, cv: number, h: number, events: boolean)
	local ground = T.GroundY + B.Radius
	local onGround = p.Y <= ground + 0.02 and math.abs(v.Y) < 2
	if not onGround then
		v += Vector3.new(0, -B.Gravity * h, 0)
	end
	local flat = Vector3.new(v.X, 0, v.Z)
	local sp = flat.Magnitude
	if cv ~= 0 and sp > 5 and not onGround then
		local side = Vector3.new(-flat.Z, 0, flat.X) / sp
		v += side * cv * B.CurveAccel * h
	end
	local drag = if onGround then B.RollFriction else B.AirDrag
	v *= math.exp(-drag * h)
	if onGround and sp < 0.6 then
		v = Vector3.zero
	end
	local np = p + v * h
	-- zemin
	if np.Y < ground then
		np = Vector3.new(np.X, ground, np.Z)
		if v.Y < -6 then
			v = Vector3.new(v.X * 0.86, -v.Y * B.Bounce, v.Z * 0.86)
			cv *= 0.4
		else
			v = Vector3.new(v.X, 0, v.Z)
		end
	end
	local result: string? = nil
	-- kale çizgisi
	if p.Z < T.GoalZ and np.Z >= T.GoalZ and not inNet then
		local ax, w, hgt = math.abs(np.X), T.GoalHalfWidth, T.GoalHeight
		if ax < w - B.Radius and np.Y < hgt - B.Radius then
			result = "goal"
		elseif (math.abs(ax - w) < B.Radius + 0.35 and np.Y < hgt + 0.6) or (ax < w + 0.6 and math.abs(np.Y - hgt) < B.Radius + 0.35) then
			result = "post"
			np = Vector3.new(np.X, np.Y, T.GoalZ - 0.05)
			v = Vector3.new(v.X * 0.6 + (if np.X > 0 then 1 else -1) * (ax - w) * 30, v.Y * 0.6, -math.abs(v.Z) * 0.55)
		end
	end
	-- kendi kalemiz (yalnız maç sahasında)
	if T.GoalZBack and p.Z > T.GoalZBack and np.Z <= T.GoalZBack and not inNet then
		local ax, w, hgt = math.abs(np.X), T.GoalHalfWidth, T.GoalHeight
		if ax < w - B.Radius and np.Y < hgt - B.Radius then
			result = "goalBack"
		elseif (math.abs(ax - w) < B.Radius + 0.35 and np.Y < hgt + 0.6) or (ax < w + 0.6 and math.abs(np.Y - hgt) < B.Radius + 0.35) then
			result = "post"
			np = Vector3.new(np.X, np.Y, T.GoalZBack + 0.05)
			v = Vector3.new(v.X * 0.6, v.Y * 0.6, math.abs(v.Z) * 0.55)
		end
	end
	-- saha sınırları
	if T.Walls == false then
		-- duvar yok: top çizgiyi geçerse oyun durur
		if events and result == nil and not inNet then
			if np.X < T.MinX or np.X > T.MaxX then
				result = "side"
			elseif np.Z > T.MaxZ then
				result = "endFront"
			elseif np.Z < T.MinZ then
				result = "endBack"
			end
		end
		return np, v, cv, result
	end
	if np.X < T.MinX or np.X > T.MaxX then
		np = Vector3.new(math.clamp(np.X, T.MinX, T.MaxX), np.Y, np.Z)
		v = Vector3.new(-v.X * B.WallBounce, v.Y, v.Z)
	end
	if np.Z < T.MinZ then
		np = Vector3.new(np.X, np.Y, T.MinZ)
		v = Vector3.new(v.X, v.Y, math.abs(v.Z) * B.WallBounce)
	elseif np.Z > T.MaxZ then
		np = Vector3.new(np.X, np.Y, T.MaxZ)
		v = Vector3.new(v.X * 0.5, v.Y * 0.5, -math.abs(v.Z) * 0.12)
		if events and result == nil and not inNet then
			result = "out"
		end
	end
	return np, v, cv, result
end

function Ball.Step(dt: number)
	if not part then
		return
	end
	clock += dt
	local steps = math.clamp(math.ceil(dt / (1 / 120)), 1, 8)
	local h = dt / steps
	for _ = 1, steps do
		local np, nv, ncv, result = integrate(pos, vel, curve, h, true)
		pos, vel, curve = np, nv, ncv
		if result == "goal" or result == "goalBack" then
			inNet = true
			vel *= 0.18
			fire("goal", lastKind, if result == "goal" then "front" else "back")
		elseif result == "side" or result == "endFront" or result == "endBack" then
			inNet = true -- ölü top: yeniden başlatılana kadar kimse oynayamaz
			vel *= 0.3
			fire("dead", result, pos)
		elseif result == "post" then
			fire("post")
		elseif result == "out" then
			inNet = true
			fire("out")
		end
		if inNet and T.GoalZBack then
			-- maç sahası: top filenin arkasına geçmesin
			if pos.Z > T.GoalZ + 4.4 then
				pos = Vector3.new(pos.X, pos.Y, T.GoalZ + 4.4)
				vel = Vector3.new(vel.X * 0.3, vel.Y, 0)
			elseif pos.Z < T.GoalZBack - 4.4 then
				pos = Vector3.new(pos.X, pos.Y, T.GoalZBack - 4.4)
				vel = Vector3.new(vel.X * 0.3, vel.Y, 0)
			end
		end
		if inNet then
			-- filenin içinde kalsın
			local w = T.GoalHalfWidth - B.Radius
			if math.abs(pos.X) > w and pos.Z > T.GoalZ and pos.Y < T.GoalHeight then
				pos = Vector3.new(math.clamp(pos.X, -w, w), pos.Y, pos.Z)
				vel = Vector3.new(-vel.X * 0.2, vel.Y, vel.Z)
			end
		end
	end
	local sp = vel.Magnitude
	-- yuvarlanma dönüşü
	local rot = part.CFrame - part.CFrame.Position
	if sp > 0.5 then
		local axis = Vector3.new(vel.Z, 0, -vel.X)
		if axis.Magnitude > 0.01 then
			rot = CFrame.fromAxisAngle(axis.Unit, sp * dt / B.Radius) * rot
		end
	end
	part.CFrame = CFrame.new(pos) * rot
	if trail then
		trail.Enabled = sp > B.TrailSpeed
	end
end

-- Top şu anki hızıyla nereye ve kaç saniyede iner? Havada değilse nil.
function Ball.Predict(): (Vector3?, number?)
	local ground = T.GroundY + B.Radius
	if pos.Y < ground + 1.5 and vel.Y < 8 then
		return nil, nil
	end
	local p, v, cv, t = pos, vel, curve, 0
	local h = 1 / 60
	for _ = 1, 360 do
		local result
		p, v, cv, result = integrate(p, v, cv, h, false)
		t += h
		if p.Y <= ground + 0.05 or result then
			return p, t
		end
	end
	return nil, nil
end

-- Top z düzlemini nerede ve kaç saniyede geçer? (kalecinin kurtarış kararı için)
function Ball.PredictCross(z: number): (Vector3?, number?)
	local sign = if z > pos.Z then 1 else -1
	if vel.Z * sign <= 1 then
		return nil, nil
	end
	local p, v, cv, t = pos, vel, curve, 0
	local h = 1 / 90
	for _ = 1, 400 do
		p, v, cv = integrate(p, v, cv, h, false)
		t += h
		if (p.Z - z) * sign >= 0 then
			return p, t
		end
		if v.Z * sign <= 0.5 then
			return nil, nil
		end
	end
	return nil, nil
end

-- Topun hızını olay tetiklemeden değiştirir (sekme, çelme)
function Ball.Deflect(v: Vector3)
	vel = v
	curve = 0
	lastKick = clock
end

--------------------------------------------------------------------------------
-- Oyuncunun topla etkileşimi
--------------------------------------------------------------------------------
local function flatDist(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Her karede: durdurma, ilk dokunuş, topun üstüne basmama
-- ctx = { pos (ayak hizası), dir (hareket yönü), speed, control (1-10) }
function Ball.Carry(dt: number, ctx)
	if inNet then
		return
	end
	local d = flatDist(pos, ctx.pos)
	local low = pos.Y < T.GroundY + 2.6
	if not low or d > 3.2 or clock - lastKick < 0.3 then
		return
	end
	local sp = vel.Magnitude
	local moving = ctx.dir.Magnitude > 0.1
	if sp > 34 then
		Ball.LastTeam = "home"
		-- ilk dokunuş: Top Kontrolü yüksekse top ayağa yakın kalır
		local keep = math.clamp(0.42 - ctx.control * 0.035, 0.06, 0.42)
		vel = vel * keep + (if moving then ctx.dir * ctx.speed * 0.6 else Vector3.zero)
		lastKick = clock - 0.15
		return "first"
	end
	if not moving then
		if d < 2.6 then
			vel *= math.exp(-9 * dt) -- ayağının dibinde durdur
		end
		return
	end
	-- topun üstüne basma: çok yakındaysa ve geride kaldıysa hafifçe öne it
	local toBall = Vector3.new(pos.X - ctx.pos.X, 0, pos.Z - ctx.pos.Z)
	if d < 1.3 or (d < 2.6 and toBall:Dot(ctx.dir) < 0.2) then
		Ball.LastTeam = "home"
		local want = ctx.dir * math.max(ctx.speed * 1.05, 8)
		vel = Vector3.new(want.X, vel.Y, want.Z)
	end
	return
end

-- Ayak yere basınca: sürme dokunuşu. Sprintte top daha uzağa gider.
function Ball.Touch(ctx): boolean
	if inNet or clock - lastKick < 0.2 then
		return false
	end
	if flatDist(pos, ctx.pos) > 3.4 or pos.Y > T.GroundY + 2.4 or ctx.dir.Magnitude < 0.1 then
		return false
	end
	local push = ctx.speed * (if ctx.sprinting then 1.24 else 1.1) + 3
	local err = math.rad((11 - ctx.control) * (if ctx.sprinting then 1.6 else 0.8)) * (math.random() - 0.5) * 2
	local dir = CFrame.Angles(0, err, 0):VectorToWorldSpace(ctx.dir)
	vel = Vector3.new(dir.X * push, 0, dir.Z * push)
	curve = 0
	Ball.LastTeam = "home"
	return true
end

-- Şut hedefi: kale içinde bir nokta. aimX: -1..1 (yön girdisi), power: 0..MaxCharge
function Ball.AimPoint(aimX: number, power: number, lift: number): Vector3
	local w = T.GoalHalfWidth - 1.4
	local y
	if power > S.OverFrom then
		y = T.GoalHeight + 2 + (power - S.OverFrom) * 60 -- fazla tutuldu: üstten gider
	else
		y = (1 + power * power * 4.6) * lift
	end
	return Vector3.new(math.clamp(aimX, -1, 1) * w, math.max(0.8, y), T.GoalZ + 1)
end

--[[
	Vuruş. opts = {
		kind, from (oyuncu konumu), facing (bakış yönü), aimX, power, perfect, stat (Şut 1-10),
		minY, maxY (topun olması gereken yükseklik aralığı), reach
	}
	Dönüş: "perfect" | "good" | "miss", hedef nokta
]]
function Ball.Strike(opts): (string, Vector3?)
	local shot = Config.Shots[opts.kind] or Config.Shots.Shoot
	local d = flatDist(pos, opts.from)
	local h = pos.Y - T.GroundY
	if inNet or d > (opts.reach or S.Reach) or h < (opts.minY or 0) or h > (opts.maxY or 2.6) then
		return "miss", nil
	end
	local toGoal = Vector3.new(0, 0, T.GoalZ) - Vector3.new(pos.X, 0, pos.Z)
	local goalDist = toGoal.Magnitude
	local target: Vector3
	if goalDist < 190 and opts.facing:Dot(toGoal.Unit) > -0.2 then
		local aimX = opts.aimX
		if shot.Curve ~= 0 and math.abs(aimX) > 0.2 then
			aimX *= 1.25 -- falsolu şut direğin dışına nişan alır, içe kıvrılır
		end
		target = Ball.AimPoint(aimX, opts.power, shot.Lift)
		if opts.kind == "Asirtma" then
			target = Vector3.new(target.X, T.GoalHeight * 0.55, target.Z)
		end
	else
		target = pos + opts.facing * 80 + Vector3.new(0, 3 + opts.power * 6, 0)
		goalDist = 80
	end
	local speed = shot.Speed
		* (0.72 + math.min(opts.power, 1) * 0.28)
		* (if opts.perfect then S.PerfectSpeedBonus else 1)
		* (1 + (opts.stat - 1) * 0.022)
	local delta = target - pos
	local t = math.max(0.12, Vector3.new(delta.X, 0, delta.Z).Magnitude / speed)
	if opts.kind == "Asirtma" then
		t *= 1.9 -- yüksek yay
	end
	local v = Vector3.new(delta.X / t, delta.Y / t + 0.5 * B.Gravity * t, delta.Z / t)
	-- hata payı: Şut özelliği ve mükemmel vuruş daraltır
	local err = math.max(0.012, S.BaseError - opts.stat * S.ErrorPerStat) * shot.Error * (if opts.perfect then S.PerfectErrorFactor else 1)
	v = CFrame.Angles(0, (math.random() - 0.5) * 2 * err, 0):VectorToWorldSpace(v)
	v += Vector3.new(0, (math.random() - 0.5) * err * speed * 0.8, 0)
	local spin = 0
	if shot.Curve ~= 0 and math.abs(opts.aimX) > 0.2 then
		spin = (if opts.aimX > 0 then 1 else -1) * shot.Curve * 0.55
	end
	Ball.LastTeam = "home"
	Ball.Kick(v, spin, opts.kind)
	return if opts.perfect then "perfect" else "good", target
end

-- Pas: bakış yönüne, yakındaki pas hedefine hafifçe yönelir. power: 0..1
function Ball.Pass(from: Vector3, facing: Vector3, power: number, stat: number, targets: { Vector3 }): boolean
	if inNet or flatDist(pos, from) > S.Reach or pos.Y > T.GroundY + 2.6 then
		return false
	end
	local dir = Vector3.new(facing.X, 0, facing.Z).Unit
	local best, bestDot = nil, 0.9
	for _, tp in ipairs(targets) do
		local to = Vector3.new(tp.X - pos.X, 0, tp.Z - pos.Z)
		if to.Magnitude > 6 then
			local dot = to.Unit:Dot(dir)
			if dot > bestDot then
				best, bestDot = to, dot
			end
		end
	end
	local speed = S.PassSpeed[1] + (S.PassSpeed[2] - S.PassSpeed[1]) * math.clamp(power, 0, 1)
	if best then
		dir = best.Unit
		speed = math.clamp(best.Magnitude * 1.5 + 18, S.PassSpeed[1] * 0.8, S.PassSpeed[2])
	end
	local err = math.rad(math.max(0.5, 7 - stat * 0.65)) * (math.random() - 0.5) * 2
	dir = CFrame.Angles(0, err, 0):VectorToWorldSpace(dir)
	Ball.LastTeam = "home"
	Ball.Kick(dir * speed + Vector3.new(0, if power > 0.75 then 14 else 0, 0), 0, "Pass")
	return true
end

-- Kanattan orta: topu from noktasından target'a yaklaşık time saniyede düşecek şekilde atar
function Ball.Cross(from: Vector3, target: Vector3, time: number)
	Ball.Reset(from)
	local delta = target - pos
	local v = Vector3.new(delta.X / time, delta.Y / time + 0.5 * B.Gravity * time, delta.Z / time)
	-- hava direncini kabaca telafi et
	Ball.Kick(Vector3.new(v.X, 0, v.Z) * (1 + B.AirDrag * time * 0.55) + Vector3.new(0, v.Y, 0), 0, "Cross")
end

return Ball
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">Bots</string><ProtectedString name="Source"><![CDATA[--[[
	Bots
	Deneme sahasındaki yapay zekalı oyuncular. Maç tek oyunculu olduğu için istemcide çalışır.
	- Savunmacı: topun önünü keser (kademe), yaklaşınca müdahale hazırlığı yapar. Hazırlık sırasında
	  çalım yerse sendeler; yemezse topu kapar ve uzaklaştırır.
	- Kaleci: çizgide topu izler; şutta topun kaleye gireceği noktayı hesaplar, tepki süresi ve
	  plonjon hızına göre yetişir ya da yetişemez. Füze şutunda topu elinden kaçırabilir.
	- Hücumcu (savunma çalışması): topu sürerek kaçmaya çalışır; oyuncu müdahaleyle topu almalıdır.
	Botlar kodla canlandırılır (Animator) ve gövdeleriyle topu keser.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Animator = require(script.Parent.Parent.Anim.Animator)
local Ball = require(script.Parent.Ball)

local D = Config.Duel
local K = Config.Keeper
local T = Config.TestPitch
local C = Config.Colors

local Bots = {}

local list: { any } = {}
local mode = "Hucum"
local listeners = { steal = {}, save = {}, escape = {}, telegraph = {} }
local keeperPlan: any = nil
local respawnAt = 0
local clock = 0

local function fire(name: string, ...)
	for _, fn in ipairs(listeners[name]) do
		task.spawn(fn, ...)
	end
end
function Bots.On(name: string, fn)
	table.insert(listeners[name], fn)
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function spawn(kind: string, role: string, home: Vector3, facing: Vector3)
	local folder = ReplicatedStorage:WaitForChild("FK_BotTemplates", 30)
	local tpl = folder and folder:FindFirstChild(kind)
	if not tpl then
		warn("[Bots] şablon yok: " .. kind)
		return nil
	end
	local model = tpl:Clone()
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local hum = model:FindFirstChildOfClass("Humanoid")
	hrp.Anchored = true
	local offsetY = 3
	if hum then
		offsetY = hum.HipHeight + hrp.Size.Y / 2
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		pcall(function()
			hum.EvaluateStateMachine = false -- gövdeyi biz taşıyoruz
		end)
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
		end
	end
	model.Parent = Workspace
	-- müdahale habercisi: botun altında beliren kırmızı halka
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = C.Bad
	ring.Transparency = 1
	ring.Size = Vector3.new(0.06, 6, 6)
	ring.Parent = model
	local bot = {
		kind = kind,
		role = role,
		model = model,
		hrp = hrp,
		animator = Animator.new(model),
		pos = Vector3.new(home.X, T.GroundY, home.Z),
		home = Vector3.new(home.X, T.GroundY, home.Z),
		dir = flat(facing).Unit,
		speed = 0,
		offsetY = offsetY,
		state = "hold",
		t = 0,
		cd = 0,
		ring = ring,
		touch = 0,
		fouled = false,
	}
	table.insert(list, bot)
	return bot
end

local function place(bot)
	bot.hrp.CFrame = CFrame.lookAt(bot.pos + Vector3.new(0, bot.offsetY, 0), bot.pos + Vector3.new(0, bot.offsetY, 0) + bot.dir)
	bot.ring.CFrame = CFrame.new(bot.pos + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90))
end

local function moveTo(bot, target: Vector3, speed: number, dt: number, faceTo: Vector3?)
	local to = flat(target - bot.pos)
	local dist = to.Magnitude
	local want = if dist > 0.4 then math.min(speed, dist / math.max(dt, 0.001)) else 0
	bot.speed += (want - bot.speed) * math.min(1, dt * 8)
	if dist > 0.05 then
		bot.pos += to.Unit * bot.speed * dt
	end
	local look = if faceTo then flat(faceTo - bot.pos) else to
	if look.Magnitude > 0.2 then
		bot.dir = bot.dir:Lerp(look.Unit, math.min(1, dt * 10))
		if bot.dir.Magnitude < 0.01 then
			bot.dir = look.Unit
		else
			bot.dir = bot.dir.Unit
		end
	end
end

function Bots.Clear()
	for _, bot in ipairs(list) do
		bot.animator:Destroy()
		bot.model:Destroy()
	end
	list = {}
	keeperPlan = nil
end

function Bots.Mode(): string
	return mode
end

-- "Hucum": iki savunmacı ve kaleciye karşı gol at. "Savunma": top süren hücumcuyu durdur.
function Bots.Start(newMode: string)
	Bots.Clear()
	mode = newMode
	if mode == "Hucum" then
		spawn("Rival", "defender", Vector3.new(-14, 0, T.GoalZ - 58), Vector3.new(0, 0, -1))
		spawn("Rival2", "defender", Vector3.new(16, 0, T.GoalZ - 40), Vector3.new(0, 0, -1))
		spawn("RivalKeeper", "keeper", Vector3.new(0, 0, T.GoalZ - 1.6), Vector3.new(0, 0, -1))
	else
		local a = spawn("RivalAttacker", "attacker", Vector3.new(math.random(-30, 30), 0, T.GoalZ - 40), Vector3.new(0, 0, -1))
		if a then
			Ball.Reset(a.pos + Vector3.new(0, 0, -3))
		end
	end
	for _, bot in ipairs(list) do
		place(bot)
	end
end

--------------------------------------------------------------------------------
-- Oyuncunun eylemleri
--------------------------------------------------------------------------------
-- Çalım: müdahale hazırlığındaki savunmacı menzildeyse sendeler. Dönüş: başarılı mı
function Bots.Feint(playerPos: Vector3): boolean
	local won = false
	for _, bot in ipairs(list) do
		if bot.role == "defender" and bot.state == "windup" and flat(bot.pos - playerPos).Magnitude < D.FeintRange then
			bot.state = "stagger"
			bot.t = D.StaggerTime
			bot.cd = D.TackleCooldown
			bot.ring.Transparency = 1
			bot.animator:Stop()
			bot.animator:Play("Stagger")
			won = true
		end
	end
	return won
end

-- Müdahale (savunma çalışması). Dönüş: "win" | "foul" | "card" | "miss"
function Bots.Tackle(playerPos: Vector3, look: Vector3, sliding: boolean): string
	local reach = if sliding then D.SlideReach else D.StandReach
	local ballPos = Ball.Position()
	local ballNear = flat(ballPos - playerPos).Magnitude <= reach and ballPos.Y < T.GroundY + 2.6
	for _, bot in ipairs(list) do
		if bot.role == "attacker" and bot.state ~= "down" then
			local toBot = flat(bot.pos - playerPos)
			if ballNear then
				Ball.Kick(flat(look).Unit * 20, 0, "Tackle")
				bot.state = "down"
				bot.t = 1.2
				bot.animator:Play("Stagger")
				respawnAt = clock + 2.6
				return "win"
			elseif toBot.Magnitude < (if sliding then D.FoulRange + 1.4 else D.FoulRange) then
				local fromBehind = bot.dir:Dot(flat(look).Unit) > 0.45
				bot.state = "down"
				bot.t = 1.4
				bot.animator:Play("Stagger")
				respawnAt = clock + 3
				return if fromBehind or sliding then "card" else "foul"
			end
		end
	end
	return "miss"
end

--------------------------------------------------------------------------------
-- Kaleci
--------------------------------------------------------------------------------
local function keeper()
	for _, bot in ipairs(list) do
		if bot.role == "keeper" then
			return bot
		end
	end
	return nil
end

-- Şut atıldığında kaleci kararını verir
Ball.On("kick", function(kind, v)
	local k = keeper()
	if not k or v.Z < K.MinShotSpeed * 0.6 or v.Magnitude < K.MinShotSpeed then
		return
	end
	local line = T.GoalZ - 1.2
	local p, t = Ball.PredictCross(line)
	if not p or not t then
		return
	end
	local w, h = T.GoalHalfWidth, T.GoalHeight
	if math.abs(p.X) > w + 1.5 or p.Y > h + 1.5 then
		keeperPlan = nil -- kaleyi bulmuyor, kıpırdamaz
		return
	end
	local hands = Vector3.new(k.pos.X, T.GroundY + 3.4, line)
	local need = (Vector3.new(p.X, p.Y, line) - hands).Magnitude
	local can = K.BaseReach + math.max(0, t - K.Reaction) * K.DiveSpeed
	local reach = need <= can and math.random() > K.ErrorChance
	keeperPlan = {
		point = p,
		time = t,
		at = clock + t,
		save = reach,
		fumble = reach and kind == "Fuze" and math.random() < K.FumbleChance,
		side = if p.X >= k.pos.X then 1 else -1,
		dive = need > 2.6,
		started = false,
		done = false,
		kind = kind,
	}
end)

local function updateKeeper(k, dt: number)
	local plan = keeperPlan
	local ballPos = Ball.Position()
	if plan and not plan.done then
		local remain = plan.at - clock
		-- plonjon, topun gelişine yetişecek şekilde başlar (animasyonun kurtarış anı 0,30 sn)
		if not plan.started and remain <= math.max(0.3, plan.time - K.Reaction) and remain <= 0.34 + 0.2 then
			plan.started = true
			if plan.dive then
				-- kaleci -Z'ye bakar; sağı dünya +X yönüdür
				k.animator:Play("Plonjon", { Mirror = plan.side < 0 })
			else
				k.animator:Play("Blok")
			end
		end
		if ballPos.Z >= T.GoalZ - 1.5 or remain <= 0 then
			plan.done = true
			if plan.save and not Ball.InNet() then
				local v = Ball.Velocity()
				if plan.fumble then
					-- elinden kaçırdı: top yavaşlayıp önüne düşer
					Ball.Deflect(Vector3.new((math.random() - 0.5) * 20, 10, -math.abs(v.Z) * 0.18))
					fire("save", "fumble")
				elseif plan.dive then
					Ball.Deflect(Vector3.new(plan.side * (18 + math.random() * 14), 10 + math.random() * 8, -math.abs(v.Z) * 0.28))
					fire("save", "parry")
				else
					Ball.Deflect(Vector3.new(0, 4, -math.abs(v.Z) * 0.08))
					fire("save", "catch")
					-- topu tutar, kısa süre sonra oyuna sokar
					local kb = k
					task.delay(1.2, function()
						if kb.model.Parent and not Ball.InNet() then
							Ball.Reset(kb.pos + Vector3.new(0, 0, -4))
							Ball.Kick(Vector3.new((math.random() - 0.5) * 30, 16, -52), 0, "Clear")
						end
					end)
				end
			end
			-- plonjondan sonra yerine döner
			if plan.dive then
				task.delay(1.1, function()
					if k.model.Parent then
						k.pos =
							Vector3.new(math.clamp(k.pos.X + plan.side * 5.4, -T.GoalHalfWidth + 1, T.GoalHalfWidth - 1), k.pos.Y, k.pos.Z)
					end
				end)
			end
		end
		k.speed = 0
	else
		-- çizgi üzerinde topu izler
		local tx = math.clamp(ballPos.X * 0.32, -T.GoalHalfWidth + 3, T.GoalHalfWidth - 3)
		if not k.animator:IsBusy() then
			moveTo(k, Vector3.new(tx, 0, k.home.Z), K.ShuffleSpeed, dt, Vector3.new(k.pos.X, 0, k.pos.Z - 10))
		end
	end
end

--------------------------------------------------------------------------------
-- Her karede
--------------------------------------------------------------------------------
-- ctx = { playerPos }
function Bots.Update(dt: number, ctx)
	clock += dt
	local ballPos = Ball.Position()
	local ballFlat = flat(ballPos)
	local low = ballPos.Y < T.GroundY + 3
	local goalPoint = Vector3.new(0, 0, T.GoalZ)

	for _, bot in ipairs(list) do
		bot.cd = math.max(0, bot.cd - dt)
		if bot.role == "keeper" then
			updateKeeper(bot, dt)
		elseif bot.role == "defender" then
			if bot.state == "stagger" then
				bot.t -= dt
				bot.speed = 0
				if bot.t <= 0 then
					bot.state = "hold"
				end
			elseif bot.state == "windup" then
				bot.t -= dt
				-- hazırlık sırasında topa doğru hamle yapar
				moveTo(bot, ballFlat, D.DefenderSpeed * 0.7, dt, ballFlat)
				bot.ring.Transparency = 0.25 + 0.5 * math.abs(math.sin(clock * 22))
				if bot.t <= 0 then
					bot.ring.Transparency = 1
					bot.state = "hold"
					bot.cd = D.TackleCooldown
					if low and flat(ballPos - bot.pos).Magnitude < D.StealRange and not Ball.InNet() then
						-- topu kaptı: kaleden uzağa vurur
						Ball.Kick(Vector3.new((math.random() - 0.5) * 40, 12, -(55 + math.random() * 20)), 0, "Clear")
						fire("steal")
					end
				end
			else
				-- kademe: topla kale arasına girer
				local near = flat(ballPos - bot.home).Magnitude < 60 and not Ball.InNet()
				local target = bot.home
				if near then
					local toGoal = flat(goalPoint - ballFlat)
					local gdir = if toGoal.Magnitude > 0.1 then toGoal.Unit else Vector3.new(0, 0, 1)
					target = ballFlat + gdir * D.JockeyDistance
				end
				moveTo(bot, target, D.DefenderSpeed, dt, if near then ballFlat else nil)
				local dBall = flat(ballPos - bot.pos).Magnitude
				local carried = flat(ballPos - ctx.playerPos).Magnitude < 6
				if near and low and carried and dBall < D.TackleRange and bot.cd <= 0 and Ball.Speed() < 45 then
					bot.state = "windup"
					bot.t = D.TackleWindup
					fire("telegraph", bot.pos)
					-- animasyonun müdahale anı (0,18 sn) hazırlığın sonuna denk gelsin
					local b = bot
					task.delay(math.max(0, D.TackleWindup - 0.18), function()
						if b.state == "windup" and b.model.Parent then
							b.animator:Play("AyaktaMudahale")
						end
					end)
				end
			end
		elseif bot.role == "attacker" then
			if bot.state == "down" then
				bot.t -= dt
				bot.speed = 0
			else
				-- hafif zikzakla kaçış çizgisine koşar, topu her 0,28 sn'de iter
				local weave = math.sin(clock * 1.6) * 0.45
				local dir = Vector3.new(weave, 0, -1).Unit
				moveTo(bot, bot.pos + dir * 10, D.AttackerSpeed, dt)
				bot.touch -= dt
				if bot.touch <= 0 and low and flat(ballPos - bot.pos).Magnitude < 3.4 then
					bot.touch = 0.28
					Ball.Deflect(dir * (D.AttackerSpeed * 1.16 + 3))
				end
				if bot.pos.Z < D.EscapeZ then
					bot.state = "down"
					bot.t = 0.1
					respawnAt = clock + 1.6
					fire("escape")
				end
			end
		end

		-- gövdeyle top kesme
		if bot.role ~= "keeper" and bot.state ~= "down" and low and Ball.Speed() > 22 and Ball.SinceKick() > 0.06 then
			local off = ballFlat - flat(bot.pos)
			if off.Magnitude < 1.5 then
				local v = Ball.Velocity()
				local n = if off.Magnitude > 0.05 then off.Unit else -flat(v).Unit
				local reflected = v - 2 * v:Dot(n) * n
				Ball.Deflect(reflected * 0.4 + Vector3.new(0, 6, 0))
			end
		end

		place(bot)
		bot.animator:Update(dt, { speed = bot.speed, grounded = true, tired = false, turn = 0, vy = 0 })
	end

	if mode == "Savunma" and respawnAt > 0 and clock >= respawnAt then
		respawnAt = 0
		Bots.Start("Savunma")
	end
end

return Bots
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">MatchAI</string><ProtectedString name="Source"><![CDATA[--[[
	MatchAI
	11'e 11 maçtaki 21 botun yapay zekası (oyuncu dışındaki herkes). İstemcide çalışır.
	Her bot bir rol oynar:
	- Dizilişteki yerini korur; top ilerledikçe takım birlikte kayar.
	- Topa en yakın oyuncu topa gider (pres / top kapma).
	- Topa sahip olan oyuncu sürer, baskı altındaysa pas verir, menzildeyse şut çeker.
	- Kaleci çizgide topu izler, şutta plonjon yapar, tuttuğu topu oyuna sokar.
	Rakip savunmacı oyuncuya müdahale etmeden önce kırmızı halkayla haber verir (çalım penceresi).
	Beceri (0-1) kademeden gelir: hız, pas ve şut isabeti, top kapma ve kaleci hatası buna bağlıdır.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Animator = require(script.Parent.Parent.Anim.Animator)
local Crest = require(ReplicatedStorage.Shared.Crest)
local Ball = require(script.Parent.Ball)

local P = Config.MatchPitch
local MC = Config.Match
local D = Config.Duel
local K = Config.Keeper
local B = Config.Ball
local C = Config.Colors

local MatchAI = {}

local bots: { any } = {}
local clock = 0
local frozenUntil = 0
local skill = { home = 0.4, away = 0.4 }
local humanSlot = 11
local humanKeeper = false
-- Topu hedefe gönderen yardımcı; aşağıda tanımlanır, yukarıdaki işlevler de kullanır
local kickTo: (Vector3, number, string, string, number?) -> ()

-- Takım emri (kaptanın verdiği): "Dengeli" | "Atak" | "Defans" | "Pres"; strength 0-1 (kaptansa 1)
local order = { name = "Dengeli", strength = 1 }
local lastCarrier: any = nil
local listeners = { steal = {}, save = {}, shot = {}, telegraph = {}, foul = {}, offside = {} }
-- Oyuncu başına maç istatistiği (maç sonu puanları için)
local function newStats()
	return { goals = 0, assists = 0, shots = 0, passes = 0, tackles = 0, saves = 0, fouls = 0 }
end
local humanSt = newStats()
local humanInfo: any = nil
local gone: { any } = {} -- sahadan çıkanlar (değişiklik, kırmızı kart): { team, info, st }
local pendingKicker: any = nil -- vuruşu yapan bot (vuruş olayından hemen önce yazılır)
local lastKicker: { [string]: any } = {} -- takım -> son vuran (bot ya da "human")
local prevKicker: { [string]: any } = {} -- takım -> ondan önce vuran (asist)
local offsideSnap: any = nil -- son pas anında ofsayt konumunda olanlar
local offsideGraceUntil = 0 -- duran toplardan sonra ofsayt aranmayan süre
local offLine = { home = math.huge, away = math.huge } -- takımın geçmemesi gereken çizgi (hücum yönünde)
local lastCtx: any = nil
local minuteNow = 0
local plans: { [any]: any } = {} -- kaleci -> kurtarış planı
local stats = { shots = { home = 0, away = 0 }, possession = { home = 0, away = 0 } }

local function fire(name: string, ...)
	for _, fn in ipairs(listeners[name]) do
		task.spawn(fn, ...)
	end
end
function MatchAI.On(name: string, fn)
	table.insert(listeners[name], fn)
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end
local MID_Z = (P.MinZ + P.MaxZ) / 2
local LEN = P.MaxZ - P.MinZ

-- Takımın hücum yönü: home +Z, away -Z
local function dirOf(team: string): number
	return if team == "home" then 1 else -1
end
local function goalOf(team: string): Vector3 -- takımın gol atacağı kale
	return Vector3.new(0, 0, if team == "home" then P.GoalZ else P.GoalZBack)
end

local function slotPos(team: string, slot: number): Vector3
	local f = Config.Formation[slot]
	local d = dirOf(team)
	local z = if team == "home" then P.MinZ + f[2] * LEN else P.MaxZ - f[2] * LEN
	return Vector3.new(f[1] * 92 * d, P.GroundY, z)
end

local NUMBERS = { 1, 2, 4, 5, 3, 7, 6, 8, 11, 9, 10 }

local function spawn(kind: string, team: string, slot: number, info: any?, club: any?)
	local folder = ReplicatedStorage:WaitForChild("FK_BotTemplates", 30)
	local tpl = folder and folder:FindFirstChild(kind)
	if not tpl then
		warn("[MatchAI] şablon yok: " .. kind)
		return
	end
	local model = tpl:Clone()
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local hum = model:FindFirstChildOfClass("Humanoid")
	hrp.Anchored = true
	local offsetY = 3
	if hum then
		offsetY = hum.HipHeight + hrp.Size.Y / 2
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		pcall(function()
			hum.EvaluateStateMachine = false
		end)
	end
	-- forma numarasını dizilişe göre yaz
	local number = tostring(if info then info.number else NUMBERS[slot])
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
		elseif d:IsA("TextLabel") and tonumber(d.Text) then
			d.Text = number
		end
	end
	-- rakip kulübün renkleri (kaleci kendi formasında kalır)
	if club and team == "away" and slot ~= 1 then
		local function paint(names: { string }, c: Color3)
			for _, n in ipairs(names) do
				local p = model:FindFirstChild(n)
				if p and p:IsA("BasePart") then
					p.Color = c
				end
			end
		end
		paint({ "UpperTorso", "LeftUpperArm", "RightUpperArm" }, club.A)
		paint({ "LowerTorso", "LeftUpperLeg", "RightUpperLeg" }, club.B)
		paint({ "LeftLowerLeg", "RightLowerLeg" }, club.A)
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Frame") and d.Name == "Stripe" then
				d.BackgroundColor3 = club.B
			end
		end
	end
	if club then
		local spec, abbr = Crest.FromClub(club)
		for _, dsc in ipairs(model:GetDescendants()) do
			if dsc.Name == "FK_Crest" then
				for _, child in ipairs(dsc:GetChildren()) do
					child:Destroy()
				end
				Crest.Fill(dsc, spec, abbr)
			end
		end
	end
	model.Parent = Workspace
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = C.Bad
	ring.Transparency = 1
	ring.Size = Vector3.new(0.06, 6, 6)
	ring.Parent = model
	local home = slotPos(team, slot)
	local bot = {
		team = team,
		slot = slot,
		-- kadro verilmediyse (deneme) sade bir kimlik kullanılır
		info = info or {
			name = (if team == "home" then "Takım " else "Rakip ") .. tostring(NUMBERS[slot]),
			number = NUMBERS[slot],
			role = "",
			rating = 50,
		},
		pace = if info then info.pace or 1 else 1,
		keeper = slot == 1,
		model = model,
		hrp = hrp,
		animator = Animator.new(model),
		pos = home,
		home = home,
		dir = Vector3.new(0, 0, dirOf(team)),
		speed = 0,
		offsetY = offsetY,
		state = "play",
		t = 0,
		cd = 0,
		touch = 0,
		decideAt = 0,
		st = newStats(),
		freshAt = 0,
		ring = ring,
		receiveUntil = 0,
	}
	table.insert(bots, bot)
end

local function place(bot)
	local base = bot.pos + Vector3.new(0, bot.offsetY, 0)
	bot.hrp.CFrame = CFrame.lookAt(base, base + bot.dir)
	bot.ring.CFrame = CFrame.new(bot.pos + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90))
end

local function moveTo(bot, target: Vector3, speed: number, dt: number, faceTo: Vector3?)
	local to = flat(target - bot.pos)
	local dist = to.Magnitude
	local want = if dist > 0.5 then math.min(speed, dist / math.max(dt, 0.001)) else 0
	bot.speed += (want - bot.speed) * math.min(1, dt * 7)
	if dist > 0.05 then
		bot.pos += to.Unit * bot.speed * dt
	end
	bot.pos = Vector3.new(math.clamp(bot.pos.X, P.MinX - 4, P.MaxX + 4), P.GroundY, math.clamp(bot.pos.Z, P.MinZ - 3, P.MaxZ + 3))
	local look = if faceTo then flat(faceTo - bot.pos) else to
	if look.Magnitude > 0.3 then
		local nd = bot.dir:Lerp(look.Unit, math.min(1, dt * 9))
		bot.dir = if nd.Magnitude > 0.01 then nd.Unit else look.Unit
	end
end

-- Her oyuncunun kendi hızı vardır (kadrodaki Hız özelliğinden gelir)
local function runSpeed(team: string, bot: any?): number
	local pace = 1
	if bot then
		-- yorgunluk: sahada kaldıkça hız düşer (90 dakikada %9); yeni giren oyuncu dinçtir
		local tired = math.clamp((minuteNow - (bot.freshAt or 0)) / 90, 0, 1)
		pace = (bot.pace or 1) * (1 - 0.09 * tired)
	end
	return (MC.BotSpeed[1] + (MC.BotSpeed[2] - MC.BotSpeed[1]) * skill[team]) * pace
end

function MatchAI.Clear()
	for _, bot in ipairs(bots) do
		bot.animator:Destroy()
		bot.model:Destroy()
	end
	bots = {}
	plans = {}
end

-- opts = { position (oyuncunun mevkisi), awaySkill, homeSkill }
function MatchAI.Start(opts)
	MatchAI.Clear()
	skill.away = math.clamp(opts.awaySkill, 0.05, 1)
	skill.home = math.clamp(opts.homeSkill, 0.05, 1)
	humanSlot = Config.FormationSlot[opts.position] or 11
	order = { name = "Dengeli", strength = 1 }
	lastCarrier = nil
	mentality = { home = 0, away = 0 }
	local fx = opts.fixture -- Squads.Fixture: kadrolar ve oyuncu özellikleri
	humanInfo = (fx and fx.home.players[humanSlot]) or { name = "Sen", number = 9, role = "SF", rating = 50, human = true }
	humanKeeper = humanSlot == 1
	stats = { shots = { home = 0, away = 0 }, possession = { home = 0, away = 0 }, offsides = { home = 0, away = 0 } }
	humanSt = newStats()
	gone = {}
	lastKicker, prevKicker = {}, {}
	offsideSnap = nil
	offsideGraceUntil = 0
	minuteNow = 0
	for slot = 1, 11 do
		if slot ~= humanSlot then
			spawn(
				if slot == 1 then "MateKeeper" elseif slot % 2 == 0 then "Mate" else "Mate2",
				"home",
				slot,
				fx and fx.home.players[slot],
				fx and fx.home.club
			)
		end
		spawn(
			if slot == 1
				then "RivalKeeper"
				elseif slot == 10 or slot == 11 then "RivalAttacker"
				elseif slot % 2 == 0 then "Rival"
				else "Rival2",
			"away",
			slot,
			fx and fx.away.players[slot],
			fx and fx.away.club
		)
	end
	MatchAI.ResetPositions()
end

function MatchAI.HumanStart(): Vector3
	return slotPos("home", humanSlot)
end

function MatchAI.ResetPositions()
	for _, bot in ipairs(bots) do
		bot.pos = bot.home
		bot.dir = Vector3.new(0, 0, dirOf(bot.team))
		bot.speed = 0
		bot.state = "play"
		bot.cd = 0.6
		bot.ring.Transparency = 1
		bot.animator:Stop()
		place(bot)
	end
	plans = {}
end

function MatchAI.SetOrder(name: string, strength: number?)
	order = { name = name, strength = math.clamp(strength or 1, 0, 1) }
end

-- Emrin takım hattına etkisi (stud): atakta öne, defansta geriye, preste biraz öne
function MatchAI.OrderPush(): number
	local o = order.name
	return (if o == "Atak" then 30 elseif o == "Defans" then -30 elseif o == "Pres" then 12 else 0) * order.strength
end

function MatchAI.Order(): string
	return order.name
end

-- "Pas ver!": top bir takım arkadaşındaysa oyuncuya pas atar. Atıldıysa true döner.
function MatchAI.CallPass(playerPos: Vector3): boolean
	local c = lastCarrier
	if not c or c.team ~= "home" or c.state == "down" or not c.model.Parent then
		return false
	end
	if flat(c.pos - Ball.Position()).Magnitude > 4.5 or clock < frozenUntil then
		return false
	end
	local dist = flat(playerPos - c.pos).Magnitude
	if dist < 6 or dist > 190 then
		return false
	end
	c.animator:Play("Pass")
	c.cd = 0.7
	pendingKicker = c
	c.st.passes += 1
	kickTo(playerPos + Vector3.new(0, 0.6, 0), math.clamp(42 + dist * 0.5, 48, 92), "Pass", "home", if dist > 90 then 1.25 else 1)
	return true
end

-- Kırmızı kart: oyuncu sahadan çıkar
function MatchAI.SendOff(bot)
	local i = table.find(bots, bot)
	if i then
		table.remove(bots, i)
		table.insert(gone, { team = bot.team, info = bot.info, st = bot.st, slot = bot.slot, reason = "red" })
		bot.animator:Destroy()
		bot.model:Destroy()
	end
end

--[[ Duran top düzeni. spot: topun yeri, team: vuruşu kullanan takım.
	Rakipler 9,15 m (28 stud) açılır; penaltıda kaleciler dışında herkes ceza sahasının dışına çıkar.
	humanTakes: vuruşu oyuncu kullanacaksa yapay zeka topun başına geçmez. ]]
function MatchAI.SetPiece(spot: Vector3, team: string, penalty: boolean, humanTakes: boolean)
	local d = dirOf(team)
	local taker, best = nil, math.huge
	for _, bot in ipairs(bots) do
		if not bot.keeper then
			if penalty then
				-- ceza sahası dışı: topun en az 30 stud gerisi, yanlara dağılmış
				local x = (bot.slot - 6) * 16
				bot.pos = Vector3.new(x, P.GroundY, spot.Z - d * (30 + (bot.slot % 3) * 6))
			elseif bot.team ~= team then
				local away = flat(bot.pos - spot)
				if away.Magnitude < 28 then
					local dir = if away.Magnitude > 0.5 then away.Unit else Vector3.new(0, 0, d)
					bot.pos = Vector3.new(spot.X + dir.X * 28, P.GroundY, spot.Z + dir.Z * 28)
				end
			end
			bot.pos = Vector3.new(math.clamp(bot.pos.X, P.MinX + 2, P.MaxX - 2), P.GroundY, math.clamp(bot.pos.Z, P.MinZ + 2, P.MaxZ - 2))
			bot.state = "play"
			bot.speed = 0
			bot.cd = 1
			bot.ring.Transparency = 1
			if bot.team == team then
				local dist = flat(bot.pos - spot).Magnitude
				if dist < best then
					taker, best = bot, dist
				end
			end
		end
		place(bot)
	end
	if taker and not humanTakes then
		taker.pos = Vector3.new(spot.X, P.GroundY, spot.Z - d * 3)
		taker.dir = Vector3.new(0, 0, d)
		place(taker)
	end
	plans = {}
end

function MatchAI.Freeze(seconds: number)
	frozenUntil = clock + seconds
	-- duran toplardan (santra, taç, korner, aut, serbest vuruş) sonraki ilk paslarda ofsayt aranmaz
	offsideGraceUntil = math.max(offsideGraceUntil, clock + math.min(seconds, 6) + 3)
	offsideSnap = nil
end

-- Bir takımın ofsayt çizgisi (hücum yönünde): son ikinci savunmacı, top ve orta sahadan en ilerideki
local function offsideLimit(team: string, ballPos: Vector3, ctx): number
	local d = dirOf(team)
	local opp = if team == "home" then "away" else "home"
	local first, second = -math.huge, -math.huge
	local function add(z: number)
		if z > first then
			first, second = z, first
		elseif z > second then
			second = z
		end
	end
	for _, bot in ipairs(bots) do
		if bot.team == opp then
			add(bot.pos.Z * d)
		end
	end
	if opp == "home" and ctx then
		add(ctx.playerPos.Z * d)
	end
	if second == -math.huge then
		second = first
	end
	return math.max(second, ballPos.Z * d, MID_Z * d)
end
MatchAI.OffsideLimit = offsideLimit

--[[ Oyuncu değişikliği: dizilişteki yere yeni oyuncu girer (dinç gelir).
	Çıkan oyuncunun istatistikleri maç sonu puanları için saklanır. ]]
function MatchAI.Substitute(team: string, slot: number, info): boolean
	for _, bot in ipairs(bots) do
		if bot.team == team and bot.slot == slot then
			table.insert(gone, { team = team, info = bot.info, st = bot.st, slot = slot, reason = "sub" })
			bot.info = info
			bot.st = newStats()
			bot.pace = (info.pace or 1) * 1.02
			bot.freshAt = minuteNow
			for _, dsc in ipairs(bot.model:GetDescendants()) do
				if dsc:IsA("TextLabel") and tonumber(dsc.Text) then
					dsc.Text = tostring(info.number)
				end
			end
			return true
		end
	end
	return false
end

-- Sahadaki 11 (insan oyuncu dahil değil): { slot, info, tired (0-1) }
function MatchAI.Squad(team: string)
	local out = {}
	for _, bot in ipairs(bots) do
		if bot.team == team then
			table.insert(out, { slot = bot.slot, info = bot.info, tired = math.clamp((minuteNow - (bot.freshAt or 0)) / 90, 0, 1) })
		end
	end
	table.sort(out, function(x, y)
		return x.slot < y.slot
	end)
	return out
end

-- Gol kimin? Son vuran ve ondan önce vuran (asist) oyuncuya yazılır. Döner: golcü bilgisi, asist bilgisi
function MatchAI.CreditGoal(team: string)
	local function info(who: any)
		if who == "human" then
			return humanInfo, humanSt
		elseif who then
			return who.info, who.st
		end
		return nil, nil
	end
	local sInfo, sSt = info(lastKicker[team])
	local aInfo, aSt = info(prevKicker[team])
	if sSt then
		sSt.goals += 1
	end
	if aSt and aSt ~= sSt then
		aSt.assists += 1
	else
		aInfo = nil
	end
	lastKicker, prevKicker = {}, {}
	return sInfo, aInfo
end

--[[ Maç sonu oyuncu puanları. cards["home:9"] = "yellow" | "red"
	Döner: { { team, name, number, role, human, rating, goals, assists, saves, subbed, sentOff }, ... } ]]
function MatchAI.Report(homeGoals: number, awayGoals: number, cards: { [string]: string }?)
	local out = {}
	local function rate(team: string, info, st, slot: number, human: boolean, flag: string?)
		if not info then
			return
		end
		local mine = if team == "home" then homeGoals else awayGoals
		local theirs = if team == "home" then awayGoals else homeGoals
		local r = 6
			+ st.goals * 1.1
			+ st.assists * 0.6
			+ math.min(st.shots * 0.08, 0.5)
			+ math.min(st.passes * 0.03, 0.8)
			+ math.min(st.tackles * 0.2, 1)
			- st.fouls * 0.25
			+ (if mine > theirs then 0.3 elseif mine < theirs then -0.3 else 0)
		if slot == 1 then
			r += st.saves * 0.35 - theirs * 0.25 + (if theirs == 0 then 0.8 else 0)
		elseif slot <= 5 then
			r += (if theirs == 0 then 0.4 else -0.1 * theirs)
		end
		local card = cards and cards[team .. ":" .. tostring(info.number)]
		if card == "yellow" then
			r -= 0.4
		elseif card == "red" then
			r -= 1.5
		end
		-- küçük, oyuncuya özgü fark (herkes aynı puanı almasın)
		r += (((info.rating or 50) * 7 + (info.number or 0) * 13) % 10 - 5) * 0.03
		table.insert(out, {
			team = team,
			name = info.name,
			number = info.number,
			role = info.role,
			human = human,
			rating = math.floor(math.clamp(r, 3.5, 10) * 10 + 0.5) / 10,
			goals = st.goals,
			assists = st.assists,
			saves = st.saves,
			subbed = flag == "sub",
			sentOff = flag == "red",
			slot = slot,
		})
	end
	for _, bot in ipairs(bots) do
		rate(bot.team, bot.info, bot.st, bot.slot, false, nil)
	end
	rate("home", humanInfo, humanSt, humanSlot, true, nil)
	for _, g in ipairs(gone) do
		rate(g.team, g.info, g.st, g.slot, false, g.reason)
	end
	return out
end

function MatchAI.Stats()
	return stats
end

-- Radar için: { {x, z, team}, ... }
function MatchAI.Positions()
	local out = {}
	for i, bot in ipairs(bots) do
		out[i] = { bot.pos.X, bot.pos.Z, bot.team, bot.dir.X, bot.dir.Z, bot.speed, bot.animator:Current() or "", bot.keeper }
	end
	return out
end

local function nearest(team: string?, point: Vector3, exclude: any?, noKeeper: boolean?)
	local best, bd = nil, math.huge
	for _, bot in ipairs(bots) do
		if (team == nil or bot.team == team) and bot ~= exclude and not (noKeeper and bot.keeper) and bot.state ~= "down" then
			local d = flat(bot.pos - point).Magnitude
			if d < bd then
				best, bd = bot, d
			end
		end
	end
	return best, bd
end

-- Rakipler (insan oyuncu dahil) bir doğru parçasına ne kadar yakın? Pas ve şut yolunun açık olup olmadığını söyler.
local function laneGap(from: Vector3, to: Vector3, oppTeam: string, ctx, skip: any?): number
	local a, b = flat(from), flat(to)
	local ab = b - a
	local len2 = math.max(ab:Dot(ab), 0.01)
	local gap = math.huge
	local function test(p: Vector3)
		local t = math.clamp((flat(p) - a):Dot(ab) / len2, 0.08, 1)
		local dist = (flat(p) - (a + ab * t)).Magnitude
		if dist < gap then
			gap = dist
		end
	end
	for _, bot in ipairs(bots) do
		if bot.team == oppTeam and bot ~= skip and bot.state ~= "down" then
			test(bot.pos)
		end
	end
	if oppTeam == "home" and ctx and not humanKeeper then
		test(ctx.playerPos)
	end
	return gap
end

local function keeperOf(team: string): any?
	for _, bot in ipairs(bots) do
		if bot.team == team and bot.keeper then
			return bot
		end
	end
	return nil
end

-- Skor ve dakikaya göre rakip takımın oyun anlayışı: gerideyse öne çıkar, öndeyse geri yaslanır
local mentality = { home = 0, away = 0 }
local botShot = false
function MatchAI.SetScore(homeGoals: number, awayGoals: number, minute: number)
	minuteNow = minute
	local diff = awayGoals - homeGoals
	local late = math.clamp((minute - 45) / 45, 0, 1)
	mentality.away = if diff < 0 then 8 + 16 * late elseif diff > 0 then -6 - 12 * late else 0
end

-- Topu hedefe yaklaşık hızla gönderir (yerçekimi telafili)
kickTo = function(target: Vector3, speed: number, kind: string, team: string, loft: number?)
	local pos = Ball.Position()
	local delta = target - pos
	local t = math.max(0.15, flat(delta).Magnitude / speed) * (loft or 1)
	Ball.LastTeam = team
	Ball.Kick(Vector3.new(delta.X / t, delta.Y / t + 0.5 * B.Gravity * t, delta.Z / t), 0, kind)
end

--------------------------------------------------------------------------------
-- Oyuncunun eylemleri
--------------------------------------------------------------------------------
function MatchAI.Feint(playerPos: Vector3): boolean
	local won = false
	for _, bot in ipairs(bots) do
		if bot.team == "away" and bot.state == "windup" and flat(bot.pos - playerPos).Magnitude < D.FeintRange then
			bot.state = "down"
			bot.t = D.StaggerTime
			bot.cd = D.TackleCooldown
			bot.ring.Transparency = 1
			bot.animator:Stop()
			bot.animator:Play("Stagger")
			won = true
		end
	end
	return won
end

-- Dönüş: "win" | "foul" | "card" | "miss"
function MatchAI.Tackle(playerPos: Vector3, look: Vector3, sliding: boolean): string
	local reach = if sliding then D.SlideReach else D.StandReach
	local ballPos = Ball.Position()
	local ballNear = flat(ballPos - playerPos).Magnitude <= reach and ballPos.Y < P.GroundY + 2.6 and not Ball.InNet()
	local bot, d = nearest("away", playerPos, nil, true)
	if ballNear then
		Ball.LastTeam = "home"
		Ball.Deflect(flat(look).Unit * 16)
		if bot and d < 6 then
			bot.state = "down"
			bot.t = 0.9
			bot.animator:Play("Stagger")
		end
		humanSt.tackles += 1
		return "win"
	end
	if bot and d < (if sliding then D.FoulRange + 1.4 else D.FoulRange) then
		local fromBehind = bot.dir:Dot(flat(look).Unit) > 0.45
		MatchAI.LastFoul = { bot = bot, fromBehind = fromBehind, sliding = sliding, pos = bot.pos }
		humanSt.fouls += 1
		bot.state = "down"
		bot.t = 1.4
		bot.animator:Play("Stagger")
		return if fromBehind or sliding then "card" else "foul"
	end
	return "miss"
end

-- Oyuncu kaleciyse: plonjon anında el hizasında top var mı? Varsa çeler.
function MatchAI.HumanSave(handPos: Vector3): boolean
	local bp = Ball.Position()
	if Ball.InNet() or (bp - handPos).Magnitude > 5.2 then
		return false
	end
	local v = Ball.Velocity()
	Ball.LastTeam = "home"
	Ball.Deflect(Vector3.new((if bp.X > handPos.X then 1 else -1) * 20, 12, math.abs(v.Z) * 0.3 + 12))
	humanSt.saves += 1
	return true
end

--------------------------------------------------------------------------------
-- Kaleci
--------------------------------------------------------------------------------
Ball.On("kick", function(kind, v)
	if #bots == 0 or Ball.Pitch() ~= P then
		pendingKicker = nil
		return
	end
	do
		-- kim vurdu? bot (vuruştan hemen önce yazılır) ya da topun yanındaki insan oyuncu
		local team = Ball.LastTeam
		local bp = Ball.Position()
		local who: any = pendingKicker
		pendingKicker = nil
		if not who and team == "home" and lastCtx and flat(lastCtx.playerPos - bp).Magnitude < 9 then
			who = "human"
		end
		local other = if team == "home" then "away" else "home"
		lastKicker[other], prevKicker[other] = nil, nil
		if who then
			if lastKicker[team] ~= who then
				prevKicker[team] = lastKicker[team]
			end
			lastKicker[team] = who
			if who == "human" then
				if kind == "Pass" then
					humanSt.passes += 1
				elseif v.Z * dirOf(team) > K.MinShotSpeed * 0.6 then
					humanSt.shots += 1
				end
			end
		else
			lastKicker[team], prevKicker[team] = nil, nil -- duran top: gol kimseye yazılmaz
		end
		-- ofsayt: pas anında çizginin ilerisindeki takım arkadaşları işaretlenir
		offsideSnap = nil
		if who and kind ~= "Clear" and clock >= offsideGraceUntil then
			local d = dirOf(team)
			local limit = offsideLimit(team, bp, lastCtx) + 1.2
			local set, any = {}, false
			for _, bot in ipairs(bots) do
				if bot.team == team and not bot.keeper and bot ~= who and bot.pos.Z * d > limit then
					set[bot] = true
					any = true
				end
			end
			local human = team == "home" and who ~= "human" and not humanKeeper and lastCtx ~= nil and lastCtx.playerPos.Z * d > limit
			if any or human then
				offsideSnap = { team = team, set = set, human = human, at = clock }
			end
		end
	end
	if v.Magnitude >= K.MinShotSpeed then
		-- şut istatistiği: kaleye doğru giden sert vuruş
		local team = Ball.LastTeam
		if
			v.Z * dirOf(team) > K.MinShotSpeed * 0.6
			and math.abs(Ball.Position().Z - goalOf(team).Z) < MC.ShootRange + 30
			and kind ~= "Clear"
			and kind ~= "Pass"
		then
			stats.shots[team] += 1
		end
	end
	for _, k in ipairs(bots) do
		if k.keeper then
			local goalZ = if k.team == "home" then P.GoalZBack else P.GoalZ
			local sign = if k.team == "home" then -1 else 1 -- topun kaleye giderken Z yönü
			if v.Z * sign >= K.MinShotSpeed * 0.6 and v.Magnitude >= K.MinShotSpeed then
				local line = goalZ - sign * 1.2
				local p, t = Ball.PredictCross(line)
				if p and t and math.abs(p.X) <= P.GoalHalfWidth + 1.5 and p.Y <= P.GoalHeight + 1.5 then
					local hands = Vector3.new(k.pos.X, P.GroundY + 3.4, line)
					local need = (Vector3.new(p.X, p.Y, line) - hands).Magnitude
					local sk = skill[k.team]
					local can = K.BaseReach + math.max(0, t - K.Reaction * (1.4 - sk * 0.6)) * K.DiveSpeed * (0.75 + sk * 0.4)
					if botShot then
						can = can * 1.7 + 1.5
					end
					local ok = need <= can and math.random() > K.ErrorChance * (1.6 - sk)
					local side = if p.X >= k.pos.X then 1 else -1
					plans[k] = {
						at = clock + t,
						time = t,
						save = ok,
						fumble = ok and kind == "Fuze" and math.random() < K.FumbleChance,
						side = side,
						dive = need > 2.6,
						sign = sign,
						started = false,
						done = false,
					}
				else
					plans[k] = nil
				end
			end
		end
	end
end)

local function updateKeeper(k, dt: number)
	local plan = plans[k]
	local ballPos = Ball.Position()
	local goalZ = if k.team == "home" then P.GoalZBack else P.GoalZ
	if plan and not plan.done then
		local remain = plan.at - clock
		if not plan.started and remain <= 0.5 then
			plan.started = true
			if plan.dive then
				k.animator:Play("Plonjon", { Mirror = plan.side * plan.sign < 0 })
			else
				k.animator:Play("Blok")
			end
		end
		if (ballPos.Z - (goalZ - plan.sign * 1.5)) * plan.sign >= 0 or remain <= 0 then
			plan.done = true
			if plan.save and not Ball.InNet() then
				local v = Ball.Velocity()
				local out = -plan.sign
				Ball.LastTeam = k.team
				k.st.saves += 1
				if plan.fumble then
					Ball.Deflect(Vector3.new((math.random() - 0.5) * 20, 10, out * math.abs(v.Z) * 0.18))
					fire("save", k.team, "fumble")
				elseif plan.dive then
					Ball.Deflect(Vector3.new(plan.side * (18 + math.random() * 14), 10 + math.random() * 8, out * math.abs(v.Z) * 0.28))
					fire("save", k.team, "parry")
				else
					Ball.Deflect(Vector3.new(0, 4, out * math.abs(v.Z) * 0.08))
					fire("save", k.team, "catch")
					local kb = k
					task.delay(1.2, function()
						if kb.model.Parent and not Ball.InNet() and Ball.Speed() < 30 then
							Ball.Reset(kb.pos + Vector3.new(0, 0, out * 4))
							kickTo(Vector3.new((math.random() - 0.5) * 120, 0, MID_Z + out * 10), 78, "Clear", kb.team, 1.5)
						end
					end)
				end
			end
			if plan.dive then
				local kb, shift = k, plan.side * 5.4
				task.delay(1.1, function()
					if kb.model.Parent then
						kb.pos = Vector3.new(math.clamp(kb.pos.X + shift, -P.GoalHalfWidth + 1, P.GoalHalfWidth - 1), kb.pos.Y, kb.pos.Z)
					end
				end)
			end
		end
		k.speed = 0
		return
	end
	local tx = math.clamp(ballPos.X * 0.32, -P.GoalHalfWidth + 3, P.GoalHalfWidth - 3)
	if not k.animator:IsBusy() then
		moveTo(k, Vector3.new(tx, 0, k.home.Z), K.ShuffleSpeed, dt, Vector3.new(k.pos.X, 0, MID_Z))
	end
end

--------------------------------------------------------------------------------
-- Topa sahip botun kararı
--------------------------------------------------------------------------------
local function carrierThink(bot, dt: number, ctx)
	local team = bot.team
	local d = dirOf(team)
	local goal = goalOf(team)
	local ballPos = Ball.Position()
	local toGoal = flat(goal - bot.pos)
	local sk = skill[team]
	local opp = if team == "home" then "away" else "home"
	local _, pressure = nearest(opp, bot.pos, nil, true)
	if opp == "home" then
		pressure = math.min(pressure, flat(ctx.playerPos - bot.pos).Magnitude)
	end

	-- sürme yönü: kaleye doğru, yakındaki rakipten kaçarak
	local drib = toGoal.Unit
	local threat, td = nearest(opp, bot.pos + drib * 6, nil, true)
	if threat and td < 9 then
		local away = flat(bot.pos - threat.pos)
		if away.Magnitude > 0.1 then
			-- rakibin boş tarafına kır; kenar çizgisine sıkışma
			local side = away.Unit.X
			if math.abs(bot.pos.X) > P.MaxX - 14 then
				side = if bot.pos.X > 0 then -1 else 1
			end
			drib = (drib + Vector3.new(side * (0.6 + sk * 0.5), 0, 0)).Unit
		end
	end
	local spd = runSpeed(team, bot) * 0.92
	moveTo(bot, bot.pos + drib * 10, spd, dt)
	bot.touch -= dt
	if bot.touch <= 0 and flat(ballPos - bot.pos).Magnitude < 3.6 then
		bot.touch = 0.28
		Ball.LastTeam = team
		Ball.Deflect(drib * (spd * 1.16 + 3))
	end

	if clock < bot.decideAt then
		return
	end
	bot.decideAt = clock + MC.DecideEvery * (1.3 - sk * 0.6) -- becerikli oyuncu daha hızlı karar verir
	local distGoal = toGoal.Magnitude

	-- şut: açı, şut yolu ve kalecinin yeri hesaba katılır; hedef kalecinin uzak köşesidir
	if distGoal < MC.ShootRange and math.abs(bot.pos.X) < 75 then
		local keeper = keeperOf(opp)
		local kx = if keeper then keeper.pos.X elseif opp == "home" and humanKeeper then ctx.playerPos.X else 0
		local side = if kx > 0.5 then -1 elseif kx < -0.5 then 1 else (if math.random() < 0.5 then -1 else 1)
		if math.random() > 0.25 + sk * 0.75 then
			side = if math.random() < 0.5 then -1 else 1 -- az becerikli oyuncu köşe seçemez
		end
		local aimX = side * (P.GoalHalfWidth - 2.6 - (1 - sk) * 4) -- az becerikli oyuncu köşeyi tam bulamaz
		local gap = laneGap(bot.pos, Vector3.new(aimX, 0, goal.Z), opp, ctx, keeper)
		local wideAngle = math.abs(bot.pos.X) < 22 + distGoal * 0.85
		local chance = if distGoal < 40 then 0.75 elseif distGoal < 60 then 0.28 else 0.06
		if gap < 3.2 then
			chance *= 0.3 -- önü kapalı
		end
		if not wideAngle then
			chance *= 0.3 -- dar açı: pas ara
		end
		if pressure < 6 and distGoal < 65 then
			chance += 0.15 -- sıkıştı: beklemeden vur
		end
		if math.random() < chance then
			-- en iyi oyuncu bile her şutu köşeye koyamaz; uzaktan şut daha çok sapar
			local err = 3 + (1 - sk) * 6 + distGoal * 0.06
			local target = Vector3.new(
				math.clamp(aimX + (math.random() - 0.5) * err * 2, -P.GoalHalfWidth - err, P.GoalHalfWidth + err),
				1 + math.random() * 4.5 + math.random() * err * 0.6,
				goal.Z + d
			)
			bot.animator:Play("Shoot")
			local b = bot
			task.delay(0.3, function()
				if b.model.Parent and flat(Ball.Position() - b.pos).Magnitude < 5 and not Ball.InNet() then
					botShot = true -- kaleci, botların şutuna karşı daha hazırlıklıdır (maç skoru makul kalsın)
					pendingKicker = b
					b.st.shots += 1
					kickTo(target, 72 + sk * 30, "Shoot", team)
					botShot = false
					fire("shot", team)
				end
			end)
			bot.decideAt = clock + 0.9
			return
		end
	end

	-- pas: baskı altındaysa ya da iyi bir fırsat varsa. Pas yolu kapalıysa o pas seçilmez;
	-- koşan arkadaşa topu önüne, forvete ara pası atılır.
	local pressured = pressure < 8
	if pressured or math.random() < 0.22 + sk * 0.2 then
		local best, bestScore, bestPos = nil, -math.huge, nil
		local function consider(target: any, pos: Vector3, vel: Vector3?, runner: boolean)
			local dist = flat(pos - bot.pos).Magnitude
			if dist < MC.PassMin or dist > MC.PassMax then
				return
			end
			-- top varana kadar arkadaşın gideceği yer; forvete biraz daha öne (ara pası)
			local lead = pos + (vel or Vector3.zero) * (dist / 75) * sk
			if runner then
				lead += Vector3.new(0, 0, d * (4 + 10 * sk))
			end
			lead = Vector3.new(math.clamp(lead.X, P.MinX + 4, P.MaxX - 4), pos.Y, math.clamp(lead.Z, P.MinZ + 6, P.MaxZ - 6))
			local forward = (lead.Z - bot.pos.Z) * d
			local _, open = nearest(opp, lead, nil, true)
			if opp == "home" then
				open = math.min(open, flat(ctx.playerPos - lead).Magnitude)
			end
			local gap = laneGap(ballPos, lead, opp, ctx, nil)
			local score = forward * 0.9 + math.min(open, 20) * 1.6 - dist * 0.25 + math.random() * 14 * (1.3 - sk)
			if gap < 3 + dist * 0.04 then
				score -= 70 * (0.3 + sk) -- pas yolu kapalı: becerikli oyuncu bunu görür
			end
			if pos.Z * d > offLine[team] + 1.2 then
				score -= 5 + 90 * sk * sk -- arkadaşı ofsaytta (becerikli oyuncu görür, acemi çoğu zaman görmez)
			end
			if score > bestScore then
				best, bestScore, bestPos = target, score, lead
			end
		end
		for _, mate in ipairs(bots) do
			if mate.team == team and mate ~= bot and not mate.keeper and mate.state ~= "down" then
				consider(mate, mate.pos, mate.dir * mate.speed, mate.slot >= 10)
			end
		end
		if team == "home" and not humanKeeper then
			consider("human", ctx.playerPos, nil, false)
		end
		-- baskı yokken yalnızca gerçekten iyi pas atılır; yoksa top sürmeye devam
		if best and bestPos and (pressured or bestScore > 18) then
			local ownThird = (bot.pos.Z - (if team == "home" then P.MinZ else P.MaxZ)) * d < LEN * 0.3
			if pressured and bestScore < -25 and ownThird then
				-- güvenli pas yok ve kendi sahamızdayız: topu uzaklaştır
				bot.animator:Play("Shoot")
				kickTo(Vector3.new((if bot.pos.X > 0 then 1 else -1) * (P.MaxX - 20), 0, bot.pos.Z + d * 150), 78, "Clear", team, 1.5)
				bot.decideAt = clock + 0.9
				bot.cd = 0.6
				return
			end
			local dist = flat(bestPos - bot.pos).Magnitude
			local err = (1 - sk) * 0.12
			local dir = CFrame.Angles(0, (math.random() - 0.5) * 2 * err, 0):VectorToWorldSpace(flat(bestPos - ballPos).Unit)
			local speed = math.clamp(dist * 1.25 + 26, 46, 96)
			bot.animator:Play("Pass")
			Ball.LastTeam = team
			pendingKicker = bot
			bot.st.passes += 1
			Ball.Kick(dir * speed + Vector3.new(0, if dist > 75 then 20 else 0, 0), 0, "Pass")
			if best ~= "human" then
				best.receiveUntil = clock + 2.2
			end
			bot.decideAt = clock + 0.8
			bot.cd = 0.5
		end
	end
end

--------------------------------------------------------------------------------
-- Her karede
--------------------------------------------------------------------------------
-- ctx = { playerPos }
function MatchAI.Update(dt: number, ctx)
	clock += dt
	local ballPos = Ball.Position()
	local ballFlat = flat(ballPos)
	local low = ballPos.Y < P.GroundY + 3
	local live = not Ball.InNet() and clock >= frozenUntil

	-- topa kim sahip?
	local carrier, cd = nil, 3.4
	if live and low and Ball.Speed() < 60 then
		for _, bot in ipairs(bots) do
			if bot.state ~= "down" then
				local d = flat(bot.pos - ballFlat).Magnitude
				if d < cd then
					carrier, cd = bot, d
				end
			end
		end
	end
	lastCarrier = carrier
	lastCtx = ctx
	offLine.home = offsideLimit("home", ballPos, ctx)
	offLine.away = offsideLimit("away", ballPos, ctx)
	local humanDist = flat(ctx.playerPos - ballFlat).Magnitude
	local humanHas = live and low and humanDist < 4 and (not carrier or humanDist < cd)
	if humanHas then
		carrier = nil
	end
	-- ofsayt: pas anında ofsayt konumunda olan oyuncu topla buluşursa düdük çalar
	if offsideSnap then
		local snap = offsideSnap
		if clock - snap.at > 7 then
			offsideSnap = nil
		elseif humanHas then
			offsideSnap = nil
			if snap.team == "home" and snap.human then
				stats.offsides.home += 1
				fire("offside", "human", ctx.playerPos)
			end
		elseif carrier then
			offsideSnap = nil
			if carrier.team == snap.team and snap.set[carrier] then
				stats.offsides[carrier.team] += 1
				fire("offside", carrier, carrier.pos)
			end
		end
	end
	local possession = if humanHas then "home" elseif carrier then carrier.team else Ball.LastTeam
	stats.possession[possession] += dt

	-- her takımdan topa giden oyuncu (kaleci hariç); takım arkadaşı topa sahipse gitmez
	local chaser = {}
	for _, team in ipairs({ "home", "away" }) do
		local mateHas = (carrier and carrier.team == team) or (team == "home" and humanHas)
		if not mateHas then
			local best, bd = nil, math.huge
			for _, bot in ipairs(bots) do
				if bot.team == team and not bot.keeper and bot.state ~= "down" then
					local d = flat(bot.pos - ballFlat).Magnitude - (if clock < bot.receiveUntil then 30 else 0)
					if d < bd then
						best, bd = bot, d
					end
				end
			end
			-- oyuncu topa bottan daha yakınsa ev sahibi botu geride kalır (oyuncunun topu)
			if team == "home" and humanDist < bd - 4 and not humanKeeper then
				best = nil
			end
			chaser[team] = best
		end
	end

	for _, bot in ipairs(bots) do
		bot.cd = math.max(0, bot.cd - dt)
		local team = bot.team
		local d = dirOf(team)
		if clock < frozenUntil then
			bot.speed = 0
		elseif bot.keeper then
			updateKeeper(bot, dt)
		elseif bot.state == "down" then
			bot.t -= dt
			bot.speed = 0
			if bot.t <= 0 then
				bot.state = "play"
			end
		elseif bot.state == "windup" then
			-- oyuncuya müdahale hazırlığı (kırmızı halka = çalım penceresi)
			bot.t -= dt
			moveTo(bot, ballFlat, runSpeed(team, bot) * 0.7, dt, ballFlat) -- topa doğru hamle
			bot.ring.Transparency = 0.25 + 0.5 * math.abs(math.sin(clock * 22))
			if bot.t <= 0 then
				bot.ring.Transparency = 1
				bot.state = "play"
				bot.cd = D.TackleCooldown
				if low and flat(ballPos - bot.pos).Magnitude < D.StealRange and live then
					Ball.LastTeam = team
					Ball.Deflect(Vector3.new(bot.dir.X * 14, 0, d * 20))
					bot.st.tackles += 1
					fire("steal")
				elseif live and flat(ctx.playerPos - bot.pos).Magnitude < 4.2 and math.random() < 0.4 then
					-- topu kaçırıp oyuncuya girdi: faul
					local r = math.random()
					bot.st.fouls += 1
					fire("foul", bot, if r < 0.05 then "violent" elseif r < 0.3 then "reckless" else "careless", "home", ctx.playerPos)
				end
			end
		elseif bot == carrier and live then
			carrierThink(bot, dt, ctx)
		elseif bot == chaser[team] and live then
			-- topa git; top hızlıysa önünü kes
			local lead = ballFlat + flat(Ball.Velocity()) * math.clamp(flat(bot.pos - ballFlat).Magnitude / 60, 0, 0.6)
			moveTo(bot, lead, runSpeed(team, bot), dt, ballFlat)
			local dBall = flat(ballPos - bot.pos).Magnitude
			if team == "away" and humanHas then
				if dBall < D.TackleRange and bot.cd <= 0 then
					bot.state = "windup"
					bot.t = D.TackleWindup * (1.25 - skill.away * 0.4)
					fire("telegraph")
					local b, wait = bot, math.max(0, bot.t - 0.18)
					task.delay(wait, function()
						if b.state == "windup" and b.model.Parent then
							b.animator:Play("AyaktaMudahale")
						end
					end)
				end
			elseif carrier and carrier.team ~= team and dBall < 3.4 and bot.cd <= 0 then
				-- bota karşı top kapma: beceri farkına bağlı şans
				bot.cd = 0.7
				local chance = 0.3 + (skill[team] - skill[carrier.team]) * 0.35
				if team == "home" then
					-- pres ve defans emirleri top kapma şansını artırır
					chance += (if order.name == "Pres" then 0.2 elseif order.name == "Defans" then 0.1 else 0) * order.strength
				end
				if math.random() < chance then
					bot.animator:Play("AyaktaMudahale")
					carrier.state = "down"
					carrier.t = 0.6
					carrier.animator:Play("Stagger")
					Ball.LastTeam = team
					bot.st.tackles += 1
					Ball.Deflect(Vector3.new(0, 0, d * 12))
				elseif math.random() < 0.12 then
					-- botlar arası faul
					carrier.state = "down"
					carrier.t = 1.2
					carrier.animator:Play("Stagger")
					bot.st.fouls += 1
					fire("foul", bot, if math.random() < 0.22 then "reckless" else "careless", carrier.team, carrier.pos)
				end
			elseif low and dBall < 2.8 and live and Ball.Speed() >= 60 and Ball.SinceKick() > 0.2 then
				-- hızlı gelen topu kontrol et
				Ball.LastTeam = team
				Ball.Deflect(Ball.Velocity() * 0.2)
			end
		else
			-- dizilişteki yer: top ilerledikçe takım kayar
			local shift = math.clamp((ballPos.Z - MID_Z) * 0.55, -110, 110)
			local push = if possession == team then 14 * d else -10 * d
			push += mentality[team] * d
			if team == "home" then
				push += MatchAI.OrderPush() * d
			end
			local depth = Config.Formation[bot.slot][2] -- geridekiler daha az kayar
			local target = Vector3.new(bot.home.X + ballPos.X * 0.22, 0, bot.home.Z + shift * (0.55 + depth * 0.7) + push)
			-- hücumda forvetler boşa kaçar
			if possession == team and bot.slot >= (if team == "home" and order.name == "Atak" then 6 else 10) then
				target += Vector3.new(math.sin(clock * 0.9 + bot.slot) * 10, 0, d * 12)
			end
			local sk = skill[team]
			local oppTeam = if team == "home" then "away" else "home"
			if possession ~= team and bot.slot <= 9 then
				-- adam tutma: bölgesine giren rakibi, kale ile rakip arasında kalarak karşılar
				local mark, md = nearest(oppTeam, target, nil, true)
				local markPos = mark and mark.pos
				if oppTeam == "home" and not humanKeeper then
					local hd = flat(ctx.playerPos - target).Magnitude
					if hd < md then
						markPos, md = ctx.playerPos, hd
					end
				end
				if markPos and md < (if bot.slot <= 5 then 46 else 30) then
					local goalSide = Vector3.new(markPos.X * 0.92, 0, markPos.Z - d * 5)
					target = target:Lerp(goalSide, 0.3 + 0.5 * sk)
				end
			elseif possession == team then
				-- destek: yakındaki rakipten uzaklaşıp pas açısı ver
				local near, nd = nearest(oppTeam, bot.pos, nil, true)
				if near and nd < 10 then
					local away = flat(bot.pos - near.pos)
					if away.Magnitude > 0.1 then
						target += away.Unit * (4 + 6 * sk)
					end
				end
			end
			if possession == team then
				-- ofsayta düşmemek: çizginin biraz gerisinde bekle (az becerikli oyuncu ara sıra kaçırır)
				local lapse = (math.sin(clock * 0.4 + bot.slot * 1.7) + 1) / 2
				local maxZ = offLine[team] - 2 + (1 - sk * 0.8) * 8 * lapse
				if target.Z * d > maxZ then
					target = Vector3.new(target.X, 0, maxZ * d)
				end
			end
			target = Vector3.new(math.clamp(target.X, P.MinX + 4, P.MaxX - 4), 0, math.clamp(target.Z, P.MinZ + 6, P.MaxZ - 6))
			local jog = runSpeed(team, bot) * (if flat(target - bot.pos).Magnitude > 18 then 1 else 0.7)
			moveTo(bot, target, jog, dt, ballFlat)
			-- pas isteme: top oyuncudayken boştaki forvet el kaldırır
			if team == "home" and humanHas and bot.slot >= 9 and not bot.animator:IsBusy() and math.random() < dt * 0.25 then
				bot.animator:Play("TopIste")
			end
		end

		-- gövdeyle top kesme (rakibin vuruşlarına karşı)
		if
			not bot.keeper
			and bot.state ~= "down"
			and low
			and live
			and Ball.Speed() > 30
			and Ball.SinceKick() > 0.08
			and Ball.LastTeam ~= team
		then
			local off = ballFlat - flat(bot.pos)
			if off.Magnitude < 1.5 then
				local v = Ball.Velocity()
				local n = if off.Magnitude > 0.05 then off.Unit else -flat(v).Unit
				Ball.LastTeam = team
				Ball.Deflect((v - 2 * v:Dot(n) * n) * 0.4 + Vector3.new(0, 6, 0))
			end
		end

		place(bot)
		bot.animator:Update(dt, { speed = bot.speed, grounded = true, tired = false, turn = 0, vy = 0 })
	end
end

return MatchAI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">MatchController</string><ProtectedString name="Source"><![CDATA[--[[
	MatchController
	Maçın akışı ve arayüzü:
	VS ekranı > başlama vuruşu > ilk yarı > devre arası > ikinci yarı > maç sonu > ödüller.
	- Skor tabelası, dakika, radar, olay bildirimleri.
	- Gol: kutlama, konfeti, santra. Taç, korner ve aut kısa bir duraklamayla yeniden başlar.
	- Maç sonunda sonuç sunucuya gönderilir; ödül, kulüp kasası ve lig puanı oradan gelir.
	Oyuncunun kendi kontrolü PlayerController'dadır; bu modül ona maç kancalarını verir.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
-- Stat modülü isteğe bağlıdır: yoksa maç sade sahada oynanır
local stadiumModule = ReplicatedStorage.Shared:FindFirstChild("Stadium")
local Stadium = if stadiumModule
	then require(stadiumModule) :: any
	else { Build = function() end, Clear = function() end, Cheer = function() end, Score = function() end, Screen = function() end }
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)
local Components = require(ReplicatedStorage.UI.Components)
local Ball = require(script.Parent.Ball)
local MatchAI = require(script.Parent.MatchAI)
local Referee = require(script.Parent.Referee)
local Halftime = require(script.Parent.Parent.Screens.Halftime)
local PlayerController = require(script.Parent.Parent.Controllers.PlayerController)

local P = Config.MatchPitch
local MC = Config.Match
local C = Theme.Color
local player = Players.LocalPlayer

local MatchController = {}

local M: any = nil -- süren maçın durumu
local ui: { [string]: any } = {}
local MID_Z = (P.MinZ + P.MaxZ) / 2

local function hrp(): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function teleport(pos: Vector3, lookAt: Vector3)
	local h = hrp()
	if h then
		h.AssemblyLinearVelocity = Vector3.zero
		h.CFrame = CFrame.lookAt(pos + Vector3.new(0, 4, 0), Vector3.new(lookAt.X, pos.Y + 4, lookAt.Z))
	end
end

--------------------------------------------------------------------------------
-- Arayüz
--------------------------------------------------------------------------------
local function big(text: string, color: Color3, hold: number?)
	local l = ui.big
	if not l then
		return
	end
	l.Text = Theme.Upper(text)
	l.TextColor3 = color
	l.TextTransparency = 0
	ui.bigStroke.Transparency = 0
	UIMotion.Pop(l, 0.4)
	ui.bigToken = (ui.bigToken or 0) + 1
	local token = ui.bigToken
	task.delay(hold or 1.6, function()
		if ui.bigToken == token then
			UIMotion.Tween(l, 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { TextTransparency = 1 })
			UIMotion.Tween(ui.bigStroke, 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Transparency = 1 })
		end
	end)
end

local function setScore(pulse: boolean?)
	if ui.score then
		ui.score.Text = M.home .. " - " .. M.away
		if pulse then
			UIMotion.Pop(ui.score, 1.8)
			UIMotion.Shine(ui.board)
		end
	end
end

local function buildHud(gui: ScreenGui)
	local root = Instance.new("Frame")
	root.Name = "MatchHud"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui
	ui.root = root

	-- Skor tabelası (üst orta)
	local board = Instance.new("CanvasGroup")
	board.Name = "Scoreboard"
	board.AnchorPoint = Vector2.new(0.5, 0)
	board.Position = UDim2.new(0.5, 0, 0, 18)
	board.Size = UDim2.fromOffset(520, 58)
	board.BackgroundColor3 = C.Navy
	board.BackgroundTransparency = 0.06
	board.BorderSizePixel = 0
	Components.Corner(board, Theme.Corner.Medium)
	Components.Stroke(board, C.Yellow, Theme.Stroke, 0.35)
	board.Parent = root
	ui.board = board
	local homeBg = Instance.new("Frame")
	homeBg.BackgroundColor3 = C.Yellow
	homeBg.BorderSizePixel = 0
	homeBg.Size = UDim2.new(0, 170, 1, 0)
	homeBg.Parent = board
	local homeName = Components.Label({
		Text = M.homeName,
		Size = 20,
		Font = Theme.Font.Display,
		Color = C.Navy,
		Upper = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(0, 170, 1, 0),
	})
	homeName.Parent = board
	ui.score = Components.Label({
		Text = "0 - 0",
		Size = 32,
		Font = Theme.Font.Number,
		Color = C.White,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(0, 110, 1, 0),
	})
	ui.score.Position = UDim2.fromOffset(170, 0)
	ui.score.Parent = board
	local awayName = Components.Label({
		Text = M.awayName,
		Size = 20,
		Font = Theme.Font.Display,
		Upper = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(0, 150, 1, 0),
	})
	awayName.Position = UDim2.fromOffset(280, 0)
	awayName.Parent = board
	local sep = Instance.new("Frame")
	sep.BackgroundColor3 = C.White
	sep.BackgroundTransparency = 0.8
	sep.BorderSizePixel = 0
	sep.Position = UDim2.fromOffset(430, 10)
	sep.Size = UDim2.new(0, 1, 1, -20)
	sep.Parent = board
	ui.clock = Components.Label({
		Text = "0'",
		Size = 22,
		Font = Theme.Font.Number,
		Color = C.Yellow,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(0, 88, 1, 0),
	})
	ui.clock.Position = UDim2.fromOffset(432, 0)
	ui.clock.Parent = board

	-- Radar (sol üst, oyuncu kartının altında)
	local radar = Instance.new("CanvasGroup")
	radar.Name = "Radar"
	radar.Position = UDim2.fromOffset(20, 140)
	radar.Size = UDim2.fromOffset(150, 228)
	radar.BackgroundColor3 = Color3.fromRGB(31, 110, 56)
	radar.BackgroundTransparency = 0.15
	radar.BorderSizePixel = 0
	Components.Corner(radar, Theme.Corner.Small)
	Components.Stroke(radar, C.White, 1.5, 0.4)
	radar.Parent = root
	local half = Instance.new("Frame")
	half.BackgroundColor3 = C.White
	half.BackgroundTransparency = 0.5
	half.BorderSizePixel = 0
	half.Position = UDim2.fromScale(0, 0.5)
	half.Size = UDim2.new(1, 0, 0, 1)
	half.Parent = radar
	ui.radar = radar
	ui.dots = {}
	local function dot(color: Color3, size: number)
		local d = Instance.new("Frame")
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.Size = UDim2.fromOffset(size, size)
		d.BackgroundColor3 = color
		d.BorderSizePixel = 0
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = d
		d.Parent = radar
		return d
	end
	for i = 1, 21 do
		ui.dots[i] = dot(C.White, 7)
	end
	ui.meDot = dot(C.Yellow, 10)
	Components.Stroke(ui.meDot, C.White, 2, 0)
	ui.ballDot = dot(C.White, 5)

	-- Büyük yazı (gol, devre arası)
	local l = Components.Label({
		Text = "",
		Size = 84,
		Font = Theme.Font.Display,
		Color = C.Gold,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 96),
	})
	l.Position = UDim2.fromScale(0, 0.3)
	l.TextTransparency = 1
	ui.bigStroke = Components.Stroke(l, C.Navy, 5, 1)
	ui.bigStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	l.ZIndex = 30
	l.Parent = root
	ui.big = l

	UIMotion.In(board, Vector2.new(0, -40), 0.1)
	UIMotion.In(radar, Vector2.new(-40, 0), 0.2)
end

-- Radar: saha kuşbakışı; yukarısı rakip kale
local function radarPos(x: number, z: number): UDim2
	return UDim2.fromScale(math.clamp((P.MaxX - x) / (P.MaxX - P.MinX), 0, 1), math.clamp((P.MaxZ - z) / (P.MaxZ - P.MinZ), 0, 1))
end

local function updateRadar()
	if not ui.dots then
		return
	end
	local list = MatchAI.Positions()
	for i, d in ipairs(ui.dots) do
		local b = list[i]
		d.Visible = b ~= nil
		if b then
			d.Position = radarPos(b[1], b[2])
			d.BackgroundColor3 = if b[3] == "home" then C.Yellow else C.Bad
		end
	end
	local h = hrp()
	if h then
		ui.meDot.Position = radarPos(h.Position.X, h.Position.Z)
	end
	local bp = Ball.Position()
	ui.ballDot.Position = radarPos(bp.X, bp.Z)
end

local function confetti(z: number)
	local burst = Instance.new("Part")
	burst.Anchored = true
	burst.CanCollide = false
	burst.Transparency = 1
	burst.Size = Vector3.new(P.GoalHalfWidth * 2, 1, 1)
	burst.CFrame = CFrame.new(0, P.GoalHeight + 2, z)
	burst.Parent = Workspace
	for _, col in ipairs({ C.Yellow, C.Navy, C.White }) do
		local e = Instance.new("ParticleEmitter")
		e.Enabled = false
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(col)
		e.Size = NumberSequence.new(0.7)
		e.Lifetime = NumberRange.new(1.4, 2.6)
		e.Speed = NumberRange.new(16, 34)
		e.SpreadAngle = Vector2.new(75, 75)
		e.Acceleration = Vector3.new(0, -26, 0)
		e.RotSpeed = NumberRange.new(-200, 200)
		e.EmissionDirection = Enum.NormalId.Top
		e.Parent = burst
		e:Emit(60)
	end
	task.delay(3.5, function()
		burst:Destroy()
	end)
	local pitch = Workspace:FindFirstChild("FK_MatchPitch")
	if pitch then
		for _, d in ipairs(pitch:GetChildren()) do
			if d.Name == "Net" and d:IsA("BasePart") and math.abs(d.Position.Z - z) < 8 then
				d.Transparency = 0.15
				TweenService:Create(d, TweenInfo.new(0.8), { Transparency = 0.6 }):Play()
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Yeniden başlatmalar
--------------------------------------------------------------------------------
local function kickoff(team: string)
	MatchAI.ResetPositions()
	local start = MatchAI.HumanStart()
	teleport(start, Vector3.new(start.X, 0, P.MaxZ))
	Ball.Reset(Vector3.new(0, 0, MID_Z + (if team == "home" then -2 else 2)))
	Ball.LastTeam = team
	MatchAI.Freeze(MC.RestartPause)
	M.phase = "play"
	Referee.Whistle("short")
end

-- Top dışarı çıktı
local function onDead(kind: string, pos: Vector3)
	if not M or M.phase ~= "play" then
		return
	end
	local last = Ball.LastTeam
	local other = if last == "home" then "away" else "home"
	M.phase = "restart"
	local label, action
	if kind == "side" then
		label = "Taç"
		local x = math.clamp(pos.X, P.MinX + 2, P.MaxX - 2)
		local z = math.clamp(pos.Z, P.MinZ + 4, P.MaxZ - 4)
		action = function()
			Ball.Reset(Vector3.new(x, 0, z))
			Ball.LastTeam = other
		end
	else
		local front = kind == "endFront" -- rakip kale çizgisi
		local attackers = if front then "home" else "away"
		if last == attackers then
			label = "Aut"
			action = function()
				-- kale vuruşu: kaleci uzun vurur
				local d = if front then -1 else 1
				Ball.Reset(Vector3.new(0, 0, (if front then P.MaxZ else P.MinZ) + d * 16))
				Ball.LastTeam = other
				Ball.Kick(Vector3.new((math.random() - 0.5) * 50, 34, d * 70), 0, "Clear")
			end
		else
			label = "Korner"
			action = function()
				-- korner: köşeden ceza sahasına orta
				local side = if pos.X >= 0 then 1 else -1
				local z = if front then P.MaxZ else P.MinZ
				local d = if front then -1 else 1
				local target = Vector3.new((math.random() - 0.5) * 20, 3, z + d * (22 + math.random() * 10))
				local h = hrp()
				if front and h and M.position ~= "Kaleci" then
					-- bizim kornerimiz: orta oyuncunun önüne gelir (kafa şansı)
					target = Vector3.new(math.clamp(h.Position.X, -40, 40), 3, math.clamp(h.Position.Z, z - 50, z - 14))
				end
				Ball.LastTeam = attackers
				Ball.Cross(Vector3.new(side * (P.MaxX - 1), 0, z + d * 1), target, 1.7)
			end
		end
	end
	big(label, C.White, 1)
	MatchAI.Freeze(MC.RestartPause)
	task.delay(MC.RestartPause * 0.75, function()
		if M and M.phase == "restart" then
			action()
			M.phase = "play"
		end
	end)
end

local function onGoal(kind: string, side: string)
	if not M or M.phase ~= "play" then
		return
	end
	M.phase = "goal"
	local scorer = Ball.LastTeam
	Stadium.Cheer()
	task.defer(function()
		if M then
			Stadium.Score(M.homeName, M.awayName, M.home, M.away, M.minute)
			Stadium.Screen(
				"GOL!",
				M.goalLine or ((if side == "front" then M.homeName else M.awayName) .. "  " .. tostring(M.minute) .. "'"),
				nil,
				6
			)
		end
	end)
	-- kendi kalemize giren top rakibin, rakip kaleye giren bizim golümüzdür
	local team = if side == "front" then "home" else "away"
	if team == "home" then
		M.home += 1
		if scorer == "home" and M.lastHumanKick and os.clock() - M.lastHumanKick < 6 then
			M.myGoals += 1
			if kind == "Header" or kind == "UcanKafa" then
				M.myHeaderGoals += 1
			end
			big(
				if kind == "Header" or kind == "UcanKafa" then "Kafa golü!" elseif kind == "Rovesata" then "Röveşata golü!" else "Gol!",
				C.Gold,
				2.4
			)
			PlayerController.PlayAction("DizKaymasi")
		else
			big("Gol!", C.Gold, 2.4)
			PlayerController.PlayAction("Sevinc")
		end
		UIMotion.Sound("RewardSound")
		confetti(P.GoalZ - 2)
	else
		M.away += 1
		big("Rakip gol attı", C.Bad, 2.2)
		UIMotion.Sound("ErrorSound")
		PlayerController.PlayAction("Uzulme")
	end
	setScore(true)
	-- gol kimin? (kendi kalesine atılan gol kimseye yazılmaz)
	local clubName = if team == "home" then M.homeName else M.awayName
	local line = M.minute .. "' Gol: " .. clubName
	local screenLine = clubName .. "  " .. M.minute .. "'"
	if scorer == team then
		local sInfo, aInfo = MatchAI.CreditGoal(team)
		if sInfo then
			line = string.format("%d' Gol: %d %s (%s)", M.minute, sInfo.number, sInfo.name, clubName)
			screenLine = string.format("%d %s  ·  %d'", sInfo.number, sInfo.name, M.minute)
			if aInfo then
				line ..= "  ·  asist " .. aInfo.name
				screenLine ..= "  ·  asist " .. aInfo.name
			end
		end
	else
		line ..= " (kendi kalesine)"
	end
	M.goalLine = screenLine
	Components.Toast(if team == "home" then "unlock" else "error", line)
	MatchAI.Freeze(MC.GoalPause)
	task.delay(MC.GoalPause, function()
		if M and M.phase == "goal" then
			UIMotion.Wipe(function()
				if M then
					kickoff(if team == "home" then "away" else "home")
				end
			end)
		end
	end)
end

--------------------------------------------------------------------------------
-- Maç sonu
--------------------------------------------------------------------------------
-- Maç sonu oyuncu puanları: maçın adamı ve iki takımın listesi
local function ratingColor(v: number): Color3
	return if v >= 8 then C.Gold elseif v >= 7 then C.Good elseif v >= 6 then C.Text else C.Bad
end

local function ratingsPanel(parent: Instance, report)
	local panel, content = Components.Panel({
		Name = "Ratings",
		Size = UDim2.fromOffset(632, 500),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 326, 0.5, 0),
		Title = "Oyuncu Puanları",
		Accent = false,
	})
	panel.ZIndex = 61
	panel.Parent = parent
	local best
	for _, r in ipairs(report) do
		if not best or r.rating > best.rating or (r.rating == best.rating and r.goals > best.goals) then
			best = r
		end
	end
	local function label(
		text: string,
		size: number,
		color: Color3,
		x: number,
		y: number,
		w: number,
		font: Font?,
		align: Enum.TextXAlignment?
	)
		local l = Components.Label({
			Text = text,
			Size = size,
			Color = color,
			Font = font or Theme.Font.Title,
			Frame = UDim2.fromOffset(w, size + 8),
			Align = align,
		})
		l.Position = UDim2.fromOffset(x, y)
		l.Parent = content
		return l
	end
	-- maçın adamı
	local box = Instance.new("Frame")
	box.Name = "Motm"
	box.Position = UDim2.fromOffset(0, 36)
	box.Size = UDim2.new(1, 0, 0, 58)
	box.BackgroundColor3 = C.Ground
	box.BackgroundTransparency = 0.3
	box.BorderSizePixel = 0
	local bu = Instance.new("UICorner")
	bu.CornerRadius = UDim.new(0, 8)
	bu.Parent = box
	local bs = Instance.new("UIStroke")
	bs.Color = C.Gold
	bs.Thickness = 1.5
	bs.Parent = box
	box.Parent = content
	label("MAÇIN ADAMI", 11, C.Gold, 12, 40, 200)
	label(
		string.format("%d  %s%s", best.number, best.name, if best.human then "  (SEN)" else ""),
		20,
		C.White,
		12,
		58,
		420,
		Theme.Font.Display
	)
	label(
		(if best.team == "home" then M.homeName else M.awayName)
			.. (if best.goals > 0 then "  ·  " .. best.goals .. " gol" else "")
			.. (if best.assists > 0 then "  ·  " .. best.assists .. " asist" else "")
			.. (if best.saves > 0 then "  ·  " .. best.saves .. " kurtarış" else ""),
		12,
		C.Muted,
		330,
		44,
		190,
		nil,
		Enum.TextXAlignment.Right
	)
	label(string.format("%.1f", best.rating), 34, C.Gold, 520, 44, 70, Theme.Font.Number, Enum.TextXAlignment.Right)

	-- iki takım yan yana (sahadan çıkanlar listenin sonunda)
	for col, team in ipairs({ "home", "away" }) do
		local x = (col - 1) * 304
		label(Theme.Upper(if team == "home" then M.homeName else M.awayName), 12, C.Yellow, x, 104, 290)
		local list = {}
		for _, r in ipairs(report) do
			if r.team == team then
				table.insert(list, r)
			end
		end
		table.sort(list, function(a, b)
			local ga, gb = (a.subbed or a.sentOff), (b.subbed or b.sentOff)
			if ga ~= gb then
				return not ga
			end
			return a.slot < b.slot
		end)
		for i, r in ipairs(list) do
			if i > 13 then
				break
			end
			local y = 124 + (i - 1) * 25
			local ink = if r.human then C.Yellow elseif r.subbed or r.sentOff then C.Muted else C.Text
			label(tostring(r.number), 12, C.Muted, x, y, 24, Theme.Font.Number, Enum.TextXAlignment.Right)
			label(
				r.name
					.. (if r.human then " (SEN)" else "")
					.. (if r.sentOff then " · kırmızı" elseif r.subbed then " · çıktı" else "")
					.. (if r.goals > 0 then "  " .. r.goals .. "G" else "")
					.. (if r.assists > 0 then "  " .. r.assists .. "A" else ""),
				13,
				ink,
				x + 30,
				y,
				210
			)
			label(string.format("%.1f", r.rating), 14, ratingColor(r.rating), x + 244, y, 46, Theme.Font.Number, Enum.TextXAlignment.Right)
		end
	end
	UIMotion.In(panel, Vector2.new(40, 0), 0.2)
end

local function resultScreen(gui: ScreenGui, result, onClose: () -> ())
	local s = MatchAI.Stats()
	local dim = Instance.new("Frame")
	dim.BackgroundColor3 = C.Ground
	dim.BackgroundTransparency = 1
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.ZIndex = 60
	dim.Parent = gui
	UIMotion.Tween(dim, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { BackgroundTransparency = 0.3 })
	local win, draw = M.home > M.away, M.home == M.away
	local panel, content = Components.Panel({
		Name = "Result",
		Size = UDim2.fromOffset(640, 500),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Gold = win,
	})
	panel.ZIndex = 61
	panel.Parent = dim
	-- sağda oyuncu puanları ve maçın adamı
	local okReport, report = pcall(MatchAI.Report, M.home, M.away, M.cards)
	if okReport and #report > 0 then
		panel.Position = UDim2.new(0.5, -326, 0.5, 0)
		ratingsPanel(dim, report)
	end
	local title = Components.Label({
		Text = if win then "Galibiyet" elseif draw then "Beraberlik" else "Mağlubiyet",
		Size = 46,
		Font = Theme.Font.Display,
		Color = if win then C.Gold elseif draw then C.White else C.Bad,
		Upper = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 52),
	})
	title.Parent = content
	local sc = Components.Label({
		Text = M.homeName .. "  " .. M.home .. " - " .. M.away .. "  " .. M.awayName,
		Size = 22,
		Font = Theme.Font.Title,
		Upper = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 28),
	})
	sc.Position = UDim2.fromOffset(0, 54)
	sc.Parent = content

	-- karşılaştırmalı istatistik çubukları (sırayla dolar)
	local totalPos = math.max(1, s.possession.home + s.possession.away)
	local rows = {
		{ "Şut", s.shots.home, s.shots.away },
		{ "Topa sahip olma %", math.floor(s.possession.home / totalPos * 100 + 0.5), math.floor(s.possession.away / totalPos * 100 + 0.5) },
		{ "Senin golün", M.myGoals, 0 },
	}
	for i, r in ipairs(rows) do
		local y = 100 + (i - 1) * 46
		local name = Components.Label({
			Text = r[1],
			Size = 14,
			Color = C.Muted,
			Upper = true,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.new(1, 0, 0, 18),
		})
		name.Position = UDim2.fromOffset(0, y)
		name.Parent = content
		local total = math.max(1, r[2] + r[3])
		local lv = Components.Label({
			Text = tostring(r[2]),
			Size = 20,
			Font = Theme.Font.Number,
			Color = C.Yellow,
			Frame = UDim2.fromOffset(60, 22),
		})
		lv.Position = UDim2.fromOffset(0, y + 16)
		lv.Parent = content
		local rv = Components.Label({
			Text = tostring(r[3]),
			Size = 20,
			Font = Theme.Font.Number,
			Color = C.Bad,
			Align = Enum.TextXAlignment.Right,
			Frame = UDim2.fromOffset(60, 22),
		})
		rv.AnchorPoint = Vector2.new(1, 0)
		rv.Position = UDim2.new(1, 0, 0, y + 16)
		rv.Parent = content
		local lb = Components.Bar({ Size = UDim2.new(0.5, -70, 0, 10), Color = C.Yellow })
		lb.Frame.Position = UDim2.new(0, 64, 0, y + 22)
		lb.Frame.Parent = content
		local rb = Components.Bar({ Size = UDim2.new(0.5, -70, 0, 10), Color = C.Bad })
		rb.Frame.Position = UDim2.new(0.5, 6, 0, y + 22)
		rb.Frame.Parent = content
		task.delay(0.5 + i * 0.18, function()
			lb.Set(r[2] / total)
			rb.Set(r[3] / total)
		end)
	end

	-- ödüller
	local rewardY = 250
	local line = Instance.new("Frame")
	line.BackgroundColor3 = C.Yellow
	line.BackgroundTransparency = 0.6
	line.BorderSizePixel = 0
	line.Position = UDim2.fromOffset(0, rewardY - 8)
	line.Size = UDim2.new(1, 0, 0, 1)
	line.Parent = content
	local function reward(label: string, value: number, x: number, color: Color3)
		local cap = Components.Label({
			Text = label,
			Size = 13,
			Color = C.Muted,
			Upper = true,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.new(1 / 3, 0, 0, 18),
		})
		cap.Position = UDim2.new(x, 0, 0, rewardY)
		cap.Parent = content
		local v = Components.Label({
			Text = "0",
			Size = 34,
			Font = Theme.Font.Number,
			Color = color,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.new(1 / 3, 0, 0, 40),
		})
		v.Position = UDim2.new(x, 0, 0, rewardY + 18)
		v.Parent = content
		task.delay(1.3, function()
			UIMotion.CountUp(v, 0, value, function(n)
				return "+" .. Theme.FormatNumber(n)
			end)
		end)
	end
	if result and result.ok then
		reward("Bakiye", result.coins, 0, C.Yellow)
		reward("XP", result.xp, 1 / 3, C.Good)
		reward("Kulüp kasası", result.income, 2 / 3, C.Gold)
		local season = if result.promoted
			then "Sezon bitti: LİG ATLADIN! Yeni lig: " .. Config.Tiers[result.tier].League
			elseif result.seasonOver then "Sezon bitti. Puan yetmedi, aynı ligde yeni sezon başlıyor."
			else "Sezon: "
				.. result.played
				.. " / "
				.. Config.Season.Matches
				.. " maç · "
				.. result.points
				.. " puan (lig atlamak için "
				.. MC.PromotePoints
				.. ")"
		local sl = Components.Label({
			Text = season,
			Size = 15,
			Color = if result.promoted then C.Gold else C.Text,
			Wrap = true,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.new(1, 0, 0, 40),
		})
		sl.Position = UDim2.fromOffset(0, rewardY + 68)
		sl.Parent = content
	else
		local sl = Components.Label({
			Text = "Maç tamamlanmadığı için ödül verilmedi.",
			Size = 16,
			Color = C.Muted,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.new(1, 0, 0, 40),
		})
		sl.Position = UDim2.fromOffset(0, rewardY + 20)
		sl.Parent = content
	end
	local btn = Components.Button({
		Text = "Lobiye dön",
		Style = "Primary",
		Size = UDim2.new(0.5, 0, 0, 56),
		OnClick = function()
			UIMotion.Wipe(function()
				dim:Destroy()
				onClose()
			end)
		end,
	})
	btn.AnchorPoint = Vector2.new(0.5, 1)
	btn.Position = UDim2.fromScale(0.5, 1)
	btn.Parent = content
	UIMotion.In(panel, Vector2.new(0, 40))
	UIMotion.Pop(panel, 0.92)
	if result and result.promoted then
		task.delay(1.6, function()
			Components.Toast("level", "Lig atladın! Yeni stadyum yakında.")
		end)
	end
end

local function finish(gui: ScreenGui, forfeit: boolean)
	if not M or M.phase == "over" then
		return
	end
	M.phase = "over"
	MatchAI.Freeze(999)
	big(if forfeit then "Maç bırakıldı" else "Maç bitti", C.White, 2)
	Referee.Whistle("long")
	local done = false
	local conn
	local function show(result)
		if done then
			return
		end
		done = true
		if conn then
			conn:Disconnect()
		end
		resultScreen(gui, result, function()
			local onDone = M.onDone
			PlayerController.SetMatch(nil, nil)
			PlayerController.SetHud(false)
			MatchAI.Clear()
			Referee.Clear()
			Stadium.Clear()
			Ball.SetPitch(Config.TestPitch)
			if ui.root then
				ui.root:Destroy()
			end
			ui = {}
			M = nil
			teleport(Vector3.new(0, 0, 4), Vector3.new(0, 0, 40))
			onDone()
		end)
	end
	conn = Remotes.Get("MatchResult").OnClientEvent:Connect(show)
	Remotes.Get("MatchEnd")
		:FireServer({ home = M.home, away = M.away, myGoals = M.myGoals, myHeaderGoals = M.myHeaderGoals, forfeit = forfeit })
	task.delay(4, function()
		show(nil) -- sunucu yanıt vermezse ekran yine açılır
	end)
end

--------------------------------------------------------------------------------
-- PlayerController kancaları
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Hakem kararları: faul, kart, serbest vuruş, penaltı
--------------------------------------------------------------------------------
local REASON = {
	careless = "Kontrolsüz müdahale",
	reckless = "Sert müdahale",
	violent = "Ciddi faullü oyun",
}

-- Ekranın üstünde karar kartı: kart rengi, oyuncu, sebep ve karar
local function decision(cardColor: Color3?, title: string, who: string, reason: string, verdict: string)
	if not ui.root then
		return
	end
	if ui.decision then
		ui.decision:Destroy()
	end
	local f = Instance.new("Frame")
	f.Name = "Decision"
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Position = UDim2.new(0.5, 0, 0, 150)
	f.Size = UDim2.fromOffset(560, 116)
	f.BackgroundColor3 = C.Navy
	f.BackgroundTransparency = 0.08
	f.BorderSizePixel = 0
	local u = Instance.new("UICorner")
	u.CornerRadius = UDim.new(0, 10)
	u.Parent = f
	local st = Instance.new("UIStroke")
	st.Color = cardColor or C.White
	st.Thickness = 2
	st.Parent = f
	local card = Instance.new("Frame")
	card.Size = UDim2.fromOffset(54, 76)
	card.Position = UDim2.fromOffset(22, 20)
	card.Rotation = -8
	card.BackgroundColor3 = cardColor or C.White
	card.BorderSizePixel = 0
	local cu = Instance.new("UICorner")
	cu.CornerRadius = UDim.new(0, 6)
	cu.Parent = card
	card.Parent = f
	if not cardColor then
		-- kartsız karar: başlığın baş harfi (Faul, Ofsayt, Oyuncu değişikliği)
		local mark = "F"
		for _, code in utf8.codes(Theme.Upper(title)) do
			mark = utf8.char(code)
			break
		end
		local l = Components.Label({
			Text = mark,
			Size = 40,
			Font = Theme.Font.Display,
			Color = C.Navy,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.fromScale(1, 1),
		})
		l.Parent = card
	end
	local function line(text: string, size: number, color: Color3, y: number, font: Font)
		local l = Components.Label({ Text = text, Size = size, Font = font, Color = color, Frame = UDim2.new(1, -110, 0, size + 6) })
		l.Position = UDim2.fromOffset(98, y)
		l.Parent = f
	end
	line(Theme.Upper(title), 24, cardColor or C.White, 10, Theme.Font.Display)
	line(who, 17, C.Text, 42, Theme.Font.Title)
	line(reason, 14, C.Muted, 66, Theme.Font.Body)
	if verdict ~= "" then
		line("KARAR: " .. Theme.Upper(verdict), 14, C.Yellow, 88, Theme.Font.Title)
	end
	f.Parent = ui.root
	ui.decision = f
	UIMotion.In(f, Vector2.new(0, -30))
	task.delay(3.4, function()
		if ui.decision == f then
			ui.decision = nil
			UIMotion.Out(f, Vector2.new(0, -20), true)
		end
	end)
end

--[[ Faul. by: faulü yapan takım, offender: { name, number, human?, bot? },
	severity: "careless" (kartsız) | "reckless" (sarı) | "violent" (kırmızı),
	victim: faul yapılan takım, pos: faulün yeri ]]
local function foul(by: string, offender, severity: string, victim: string, pos: Vector3, reason: string?, override: any?)
	if not M or M.phase ~= "play" then
		return
	end
	M.phase = "restart"
	MatchAI.Freeze(4)
	Referee.Whistle("short")

	local key = by .. ":" .. tostring(offender.number)
	local card: string? = nil
	local why = reason or REASON[severity]
	if severity == "violent" then
		card = "red"
	elseif severity == "reckless" then
		if M.cards[key] == "yellow" then
			card = "red"
			why = why .. " · ikinci sarı kart"
		else
			card = "yellow"
		end
	end
	if card then
		M.cards[key] = card
	end
	-- Faul, yapanın kendi ceza sahasındaysa penaltı
	local ownGoalZ = if by == "home" then P.MinZ else P.MaxZ
	local inBox = math.abs(pos.X) <= 66 and math.abs(pos.Z - ownGoalZ) <= 54 and not override
	local verdict = if override then override.verdict elseif inBox then "Penaltı" else "Serbest vuruş"
	local club = if by == "home" then M.homeName else M.awayName
	local who = string.format("%d  %s  ·  %s", offender.number, offender.name, club)
	local color = if card == "red" then C.Bad elseif card == "yellow" then C.Yellow else nil
	local title = if override
		then override.title
		elseif card == "red" then "Kırmızı kart"
		elseif card == "yellow" then "Sarı kart"
		else "Faul"
	decision(color, title, who, why, verdict)
	Stadium.Screen(Theme.Upper(title), who .. "  ·  " .. why .. "  ·  " .. verdict, color, 6)
	if color then
		task.delay(0.6, function()
			Referee.Card(color)
		end)
	end
	UIMotion.Sound("ErrorSound")

	task.delay(3, function()
		if not M or M.phase ~= "restart" then
			return
		end
		if card == "red" then
			if offender.human then
				-- oyuncu atıldı: maç onun için biter
				Components.Toast("error", "Kırmızı kart gördün, oyundan atıldın.")
				finish(M.gui, true)
				return
			elseif offender.bot then
				MatchAI.SendOff(offender.bot)
			end
		end
		local d = if victim == "home" then 1 else -1 -- vuruşu kullanan takımın hücum yönü
		local spot = if inBox
			then Vector3.new(0, 0, ownGoalZ + (if by == "home" then 36 else -36))
			else Vector3.new(math.clamp(pos.X, P.MinX + 4, P.MaxX - 4), 0, math.clamp(pos.Z, P.MinZ + 6, P.MaxZ - 6))
		Ball.Reset(spot)
		Ball.LastTeam = victim
		local humanTakes = victim == "home" and M.position ~= "Kaleci"
		MatchAI.SetPiece(spot, victim, inBox, humanTakes)
		local h = hrp()
		if humanTakes then
			-- vuruşu sen kullanırsın: topun arkasına geç
			teleport(Vector3.new(spot.X, 0, spot.Z - d * 4.5), Vector3.new(0, 0, if d > 0 then P.MaxZ else P.MinZ))
			big(if inBox then "Penaltı: vuruş senin" else "Serbest vuruş: senin", C.Yellow, 1.6)
		elseif h and M.position ~= "Kaleci" then
			-- rakibin vuruşu: baraj mesafesine açıl (9,15 m)
			local away = Vector3.new(h.Position.X - spot.X, 0, h.Position.Z - spot.Z)
			if inBox then
				teleport(Vector3.new(30, 0, spot.Z - d * 34), spot)
			elseif away.Magnitude < 28 then
				local dir = if away.Magnitude > 0.5 then away.Unit else Vector3.new(0, 0, -d)
				teleport(Vector3.new(spot.X + dir.X * 28, 0, spot.Z + dir.Z * 28), spot)
			end
			big(verdict, C.White, 1.2)
		end
		MatchAI.Freeze(if humanTakes then 1.8 else 1)
		Referee.Whistle("short")
		M.phase = "play"
	end)
end

-- Oyuncunun müdahalesi: sonucu yapay zeka verir, cezayı hakem
local function humanTackle(pos: Vector3, look: Vector3, sliding: boolean): string
	local result = MatchAI.Tackle(pos, look, sliding)
	local f = MatchAI.LastFoul
	if M and f and (result == "foul" or result == "card") then
		local severity = if f.sliding and f.fromBehind then "violent" elseif f.sliding or f.fromBehind then "reckless" else "careless"
		local reason = if f.sliding and f.fromBehind
			then "Arkadan kayarak müdahale: ciddi faullü oyun"
			elseif f.fromBehind then "Arkadan müdahale"
			elseif f.sliding then "Topa değil, rakibe kayarak müdahale"
			else "Kontrolsüz müdahale"
		foul("home", M.me, severity, "away", f.pos, reason)
	end
	MatchAI.LastFoul = nil
	return result
end

--------------------------------------------------------------------------------
-- Takım emirleri: Dengeli / Atak / Defans / Pres ve "pas ver"
--------------------------------------------------------------------------------
local ORDERS = { "Dengeli", "Atak", "Defans", "Pres" }
local ORDER_INFO = {
	Dengeli = "Normal diziliş",
	Atak = "Hat öne çıkar, kanatlar da koşu yapar",
	Defans = "Takım geri çekilir, top kapma artar",
	Pres = "Rakibe yüklenir, top kapma çok artar",
}

local function paintOrders()
	for name, b in pairs(ui.orderButtons or {}) do
		local on = M and M.order == name
		b.BackgroundColor3 = if on then C.Yellow else C.Navy
		b.BackgroundTransparency = if on then 0 else 0.25
		b.Label.TextColor3 = if on then C.Navy else C.Text
	end
end

local function setOrder(name: string)
	if not M or M.order == name then
		return
	end
	M.order = name
	MatchAI.SetOrder(name, if M.captain then 1 else 0.6)
	paintOrders()
	Components.Toast("info", "Takım emri: " .. name .. "  ·  " .. ORDER_INFO[name])
	UIMotion.Sound("ClickSound")
end

local function cycleOrder()
	if M then
		setOrder(ORDERS[(table.find(ORDERS, M.order) or 1) % #ORDERS + 1])
	end
end

-- "Pas ver!": kaptan her zaman dinlenir, diğerleri çoğu zaman
local function callPass(playerPos: Vector3): boolean
	if not M or M.phase ~= "play" then
		return false
	end
	if not M.captain and math.random() > 0.75 then
		return false
	end
	local ok = MatchAI.CallPass(playerPos)
	if ok then
		big("Pas geliyor", C.Good, 0.7)
	end
	return ok
end

local function buildOrders()
	if not ui.root then
		return
	end
	local panel = Instance.new("Frame")
	panel.Name = "Orders"
	panel.Position = UDim2.fromOffset(20, 380)
	panel.Size = UDim2.fromOffset(220, 98)
	panel.BackgroundColor3 = C.Ground
	panel.BackgroundTransparency = 0.35
	panel.BorderSizePixel = 0
	local u = Instance.new("UICorner")
	u.CornerRadius = UDim.new(0, 8)
	u.Parent = panel
	panel.Parent = ui.root
	local title = Components.Label({
		Text = if M.captain then "TAKIM EMRİ  ·  T  ·  KAPTAN" else "TAKIM EMRİ  ·  T",
		Size = 11,
		Font = Theme.Font.Title,
		Color = C.Muted,
		Frame = UDim2.new(1, -16, 0, 16),
	})
	title.Position = UDim2.fromOffset(8, 4)
	title.Parent = panel
	ui.orderButtons = {}
	for i, name in ipairs(ORDERS) do
		local b = Instance.new("TextButton")
		b.Name = name
		b.AutoButtonColor = false
		b.Text = ""
		b.Size = UDim2.fromOffset(100, 32)
		b.Position = UDim2.fromOffset(8 + ((i - 1) % 2) * 104, 24 + math.floor((i - 1) / 2) * 36)
		b.BorderSizePixel = 0
		local bu = Instance.new("UICorner")
		bu.CornerRadius = UDim.new(0, 6)
		bu.Parent = b
		local l = Components.Label({
			Text = name,
			Upper = true,
			Size = 13,
			Font = Theme.Font.Title,
			Align = Enum.TextXAlignment.Center,
			Frame = UDim2.fromScale(1, 1),
		})
		l.Name = "Label"
		l.Parent = b
		b.Activated:Connect(function()
			setOrder(name)
		end)
		b.Parent = panel
		ui.orderButtons[name] = b
	end
	paintOrders()
end

--------------------------------------------------------------------------------
-- Oyuncu değişiklikleri
--------------------------------------------------------------------------------
local function announceSub(club: string, incoming, outgoing)
	local who = string.format("Giren: %d %s", incoming.number, incoming.name)
	local out = string.format("Çıkan: %d %s  ·  %s", outgoing.number, outgoing.name, club)
	decision(nil, "Oyuncu değişikliği", who, out, "")
	Stadium.Screen("OYUNCU DEĞİŞİKLİĞİ", who .. "  ·  " .. out, nil, 6)
end

-- Rakip teknik direktör ikinci yarıda en zayıf oyuncusunu değiştirir
local function awaySubstitution()
	local worst
	for _, p in ipairs(MatchAI.Squad("away")) do
		if p.slot ~= 1 and p.info and (not worst or p.info.rating < worst.info.rating) then
			worst = p
		end
	end
	local pick
	for _, info in ipairs(M.fixture.away.bench) do
		if info.role ~= "KL" and (not pick or info.rating > pick.rating) then
			pick = info
		end
	end
	if worst and pick and MatchAI.Substitute("away", worst.slot, pick) then
		announceSub(M.awayName, pick, worst.info)
	end
end

local function halftimeContext()
	return {
		homeName = M.homeName,
		awayName = M.awayName,
		home = M.home,
		away = M.away,
		stats = MatchAI.Stats(),
		me = M.me,
		bench = M.bench,
		squad = function()
			return MatchAI.Squad("home")
		end,
		subsLeft = function()
			return M.subsLeft
		end,
		substitute = function(slot: number, benchIndex: number): boolean
			local incoming = M.bench[benchIndex]
			if not incoming or M.subsLeft <= 0 then
				return false
			end
			local outgoing
			for _, p in ipairs(MatchAI.Squad("home")) do
				if p.slot == slot then
					outgoing = p.info
				end
			end
			if not outgoing or not MatchAI.Substitute("home", slot, incoming) then
				return false
			end
			table.remove(M.bench, benchIndex)
			M.subsLeft -= 1
			announceSub(M.homeName, incoming, outgoing)
			return true
		end,
		order = function()
			return M.order
		end,
		setOrder = function(name: string)
			setOrder(name)
		end,
	}
end

local function update(dt: number, ctx)
	if not M then
		return
	end
	MatchAI.Update(dt, ctx)
	Referee.Update(dt, M.phase == "play")
	updateRadar()
	if M.phase == "play" then
		M.elapsed += dt
		local half = MC.HalfSeconds
		local total = math.min(M.elapsed, half) + (if M.half == 2 then half else 0)
		M.minute = math.min(90, math.floor(total / (half * 2) * 90))
		if ui.clock then
			ui.clock.Text = M.minute .. "'"
		end
		MatchAI.SetScore(M.home, M.away, M.minute) -- rakip, skora ve dakikaya göre oyununu ayarlar
		if M.half == 2 and M.fixture and not M.awaySubDone and M.minute >= 62 then
			M.awaySubDone = true
			awaySubstitution()
		end
		if M.elapsed >= half then
			if M.half == 1 then
				M.phase = "halftime"
				big("Devre arası", C.White, 2.2)
				Referee.Whistle("double")
				MatchAI.Freeze(3.2)
				task.delay(3, function()
					if M and M.phase == "halftime" then
						UIMotion.Wipe(function()
							if not M then
								return
							end
							local function secondHalf()
								if M then
									M.half = 2
									M.elapsed = 0
									kickoff("away")
									big("İkinci yarı", C.Yellow, 1.4)
								end
							end
							if M.fixture then
								-- devre arası: özet, takım emri ve oyuncu değişikliği
								MatchAI.Freeze(9999)
								Halftime.Show(M.gui, halftimeContext(), secondHalf)
							else
								secondHalf()
							end
						end)
					end
				end)
			else
				finish(M.gui, false)
			end
		end
	end
end

--[[
	Maçı başlatır.
	gui: ScreenGui, data: oyuncu verisi, onDone: lobiye dönüldüğünde çağrılır
]]
function MatchController.Start(gui: ScreenGui, data, onDone: () -> (), fixture: any?)
	if M then
		return
	end
	local tier = Config.Tiers[data.club.tier]
	local avg = (tier.BotPower[1] + tier.BotPower[2]) / 2
	M = {
		gui = gui,
		onDone = onDone,
		phase = "intro",
		half = 1,
		elapsed = 0,
		minute = 0,
		home = 0,
		away = 0,
		myGoals = 0,
		myHeaderGoals = 0,
		lastHumanKick = nil,
		position = data.position,
		cards = {}, -- cards["home:9"] = "yellow" | "red"
		fixture = fixture,
		subsLeft = 3,
		bench = if fixture then table.clone(fixture.home.bench) else {},
		order = "Dengeli",
		captain = (data.level or 1) >= Config.CaptainBandLevel,
		me = { name = data.name, number = data.number or 9, human = true },
		homeName = if fixture then fixture.home.club.Abbr elseif data.club.abbr ~= "" then data.club.abbr else "EV",
		awayName = if fixture then fixture.away.club.Abbr else "RKP",
	}
	Remotes.Get("MatchStart"):FireServer()
	Stadium.Build(if data.career and data.career.atFenerbahce then 6 else data.club.tier, {
		club = data.club.name,
		abbr = data.club.abbr,
		facilities = data.club.facilities,
	})
	Stadium.Score(M.homeName, M.awayName, 0, 0, 0)
	Ball.SetPitch(P)
	Ball.Init()
	MatchAI.Start({
		position = data.position,
		fixture = fixture,
		awaySkill = (avg - 28) / 70,
		homeSkill = (avg - 28) / 70 + 0.04 + ((data.power or 30) - avg) / 200,
	})
	PlayerController.SetMatch({
		Update = update,
		Feint = MatchAI.Feint,
		Tackle = humanTackle,
		CallPass = callPass,
		CycleOrder = cycleOrder,
		HumanSave = MatchAI.HumanSave,
		OnHumanKick = function()
			if M then
				M.lastHumanKick = os.clock()
			end
		end,
		Forfeit = function()
			finish(gui, true)
		end,
	}, P)
	Referee.Spawn()
	PlayerController.SetHud(true)
	buildHud(gui)
	buildOrders()
	setScore(false)
	kickoff("home")
	M.phase = "intro"
	MatchAI.Freeze(MC.IntroTime)
	big(M.homeName .. "  vs  " .. M.awayName, C.Yellow, MC.IntroTime - 0.6)
	Components.Toast("info", tier.League .. " · " .. tier.Stadium)
	task.delay(MC.IntroTime, function()
		if M and M.phase == "intro" then
			M.phase = "play"
			big("Başla!", C.Good, 0.9)
		end
	end)
end

-- Sınamalar için: süren maçın durumu ve hakem kararı
function MatchController.Debug()
	return { state = M, foul = foul, setOrder = setOrder }
end

-- Bir kez bağlanır
Ball.On("goal", function(kind, side)
	if M then
		onGoal(kind, side)
	end
end)
Ball.On("dead", function(kind, pos)
	if M then
		onDead(kind, pos)
	end
end)
MatchAI.On("foul", function(bot, severity, victim, pos)
	if M then
		local info = bot.info
		foul(
			bot.team,
			{ name = if info then info.name else "Oyuncu", number = if info then info.number else bot.slot, bot = bot },
			severity,
			victim,
			pos
		)
	end
end)
MatchAI.On("offside", function(who, pos)
	if M then
		local team = if who == "human" then "home" else who.team
		local info = if who == "human" then M.me else who.info
		foul(
			team,
			{ name = if info then info.name else "Oyuncu", number = if info then info.number else 0 },
			"careless",
			if team == "home" then "away" else "home",
			pos,
			"Pas anında son ikinci savunmacının ilerisinde",
			{ title = "Ofsayt", verdict = "Endirekt serbest vuruş" }
		)
	end
end)
MatchAI.On("steal", function()
	if M then
		Components.Toast("error", "Top kaptırdın")
	end
end)
MatchAI.On("save", function(team, kind)
	if M then
		big(
			if team == "home" then "Kalecimiz kurtardı" elseif kind == "fumble" then "Kaleci elinden kaçırdı!" else "Kaleci kurtardı",
			C.White,
			1
		)
	end
end)
MatchAI.On("telegraph", function()
	UIMotion.Sound("ClickSound")
end)

return MatchController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">Referee</string><ProtectedString name="Source"><![CDATA[--[[
	Referee
	Sahadaki hakem: oyunu çaprazdan takip eder, düdük çalar, kart gösterir.
	Kurallar ve cezalar MatchController'da uygulanır; burası hakemin sahadaki bedeni ve sesidir.

	Referee.Spawn()            hakemi orta sahaya koyar
	Referee.Update(dt, live)   her karede: topu takip eder (live = oyun oynanıyor mu)
	Referee.Whistle(kind)      "short" (faul, başlama) | "double" (devre) | "long" (maç sonu)
	Referee.Card(color)        kartı havaya kaldırır
	Referee.Clear()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Animator = require(script.Parent.Parent.Anim.Animator)
local Ball = require(script.Parent.Ball)

local P = Config.MatchPitch

local Referee = {}

local ref: any = nil

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function Referee.Clear()
	if ref then
		ref.animator:Destroy()
		ref.model:Destroy()
		ref = nil
	end
end

function Referee.Spawn()
	Referee.Clear()
	local folder = ReplicatedStorage:WaitForChild("FK_BotTemplates", 30)
	local tpl = folder and (folder:FindFirstChild("Referee") or folder:FindFirstChild("RivalKeeper"))
	if not tpl then
		return
	end
	local model = tpl:Clone()
	model.Name = "FK_Referee"
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local hum = model:FindFirstChildOfClass("Humanoid")
	hrp.Anchored = true
	local offsetY = 3
	if hum then
		offsetY = hum.HipHeight + hrp.Size.Y / 2
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		pcall(function()
			hum.EvaluateStateMachine = false
		end)
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
		elseif d:IsA("TextLabel") and tonumber(d.Text) then
			d.Text = "" -- hakemin forma numarası olmaz
		end
	end
	model.Parent = Workspace
	local midZ = (P.MinZ + P.MaxZ) / 2
	ref = {
		model = model,
		hrp = hrp,
		animator = Animator.new(model),
		pos = Vector3.new(26, P.GroundY, midZ - 10),
		dir = Vector3.new(-1, 0, 0),
		speed = 0,
		offsetY = offsetY,
	}
end

function Referee.Position(): Vector3?
	return ref and ref.pos
end

function Referee.Update(dt: number, live: boolean)
	if not ref then
		return
	end
	local ball = flat(Ball.Position())
	-- Topun çaprazında, oyunu önünde tutacak şekilde durur; oyunculara karışmaz
	local side = if ball.X > 0 then -1 else 1
	local target = Vector3.new(math.clamp(ball.X + side * 26, P.MinX + 8, P.MaxX - 8), 0, math.clamp(ball.Z - 16, P.MinZ + 14, P.MaxZ - 14))
	local to = flat(target - ref.pos)
	local dist = to.Magnitude
	local want = if live and dist > 6 then math.min(21, dist * 1.6) else 0
	ref.speed += (want - ref.speed) * math.min(1, dt * 5)
	if dist > 0.1 then
		ref.pos += to.Unit * ref.speed * dt
	end
	ref.pos = Vector3.new(ref.pos.X, P.GroundY, ref.pos.Z)
	local look = flat(ball - ref.pos)
	if look.Magnitude > 0.5 then
		local nd = ref.dir:Lerp(look.Unit, math.min(1, dt * 6))
		ref.dir = if nd.Magnitude > 0.01 then nd.Unit else look.Unit
	end
	local base = ref.pos + Vector3.new(0, ref.offsetY, 0)
	ref.hrp.CFrame = CFrame.lookAt(base, base + ref.dir)
	ref.animator:Update(dt, { speed = ref.speed, grounded = true, tired = false, turn = 0, vy = 0 })
end

-- Düdük. Config.Assets.Whistle doluysa o ses çalar; boşsa kısa, tiz bir yedek ses kullanılır.
local function beep(speed: number, volume: number)
	local custom = Config.Assets.Whistle
	local s = Instance.new("Sound")
	if custom and custom ~= "" then
		s.SoundId = custom
		s.PlaybackSpeed = 1
	else
		s.SoundId = "rbxasset://sounds/electronicpingshort.wav"
		s.PlaybackSpeed = speed
	end
	s.Volume = volume
	SoundService:PlayLocalSound(s)
	s:Destroy()
end

function Referee.Whistle(kind: string?)
	local custom = Config.Assets.Whistle
	local count = if kind == "long" then 3 elseif kind == "double" then 2 else 1
	if not custom or custom == "" then
		count *= 3 -- yedek ses kısa olduğu için art arda çalınarak düdük gibi uzatılır
	end
	for i = 0, count - 1 do
		task.delay(i * (if custom and custom ~= "" then 0.7 else 0.085), function()
			beep(2.7, 0.9)
		end)
	end
	if ref then
		ref.animator:Play("TopIste") -- kol havada
	end
end

-- Kart: hakemin başının üstünde, elinde tutuyormuş gibi görünür
function Referee.Card(color: Color3)
	if not ref then
		return
	end
	local head = ref.model:FindFirstChild("Head")
	if not head then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "Card"
	bb.Size = UDim2.fromScale(1.5, 2.1)
	bb.StudsOffset = Vector3.new(1.2, 2.6, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = head
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	local u = Instance.new("UICorner")
	u.CornerRadius = UDim.new(0.12, 0)
	u.Parent = f
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(20, 20, 24)
	st.Thickness = 2
	st.Parent = f
	f.Parent = bb
	bb.Parent = head
	ref.animator:Play("TopIste")
	task.delay(2.6, function()
		bb:Destroy()
	end)
end

return Referee
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">RemoteAnim</string><ProtectedString name="Source"><![CDATA[--[[
	RemoteAnim
	Aynı sunucudaki diğer oyuncuların karakterlerini de kodla canlandırır.
	Koşu döngüsü onların hızından üretilir; eylemler sunucudan gelen bildirimle oynar.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Animator = require(script.Parent.Parent.Anim.Animator)

local RemoteAnim = {}
local animators: { [Player]: any } = {}

local function get(plr: Player)
	local char = plr.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then
		animators[plr] = nil
		return nil
	end
	local an = animators[plr]
	local waist = an and an.Motors.Waist
	if not an or an.Character ~= char or not waist or not waist:IsDescendantOf(char) then
		an = Animator.new(char)
		animators[plr] = an
	end
	return an
end

function RemoteAnim.Start()
	local me = Players.LocalPlayer
	Remotes.Get("Anim").OnClientEvent:Connect(function(userId, action, mirror)
		local plr = Players:GetPlayerByUserId(userId)
		local an = plr and plr ~= me and get(plr)
		if an and type(action) == "string" then
			an:Play(action, { Mirror = mirror == true })
		end
	end)
	Players.PlayerRemoving:Connect(function(plr)
		animators[plr] = nil
	end)
	RunService.Stepped:Connect(function(_, dt)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= me then
				local an = get(plr)
				if an then
					local char = plr.Character :: Model
					local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart
					local hum = char:FindFirstChildOfClass("Humanoid")
					local v = hrp.AssemblyLinearVelocity
					an:Update(dt, {
						speed = Vector3.new(v.X, 0, v.Z).Magnitude,
						grounded = hum == nil or hum.FloorMaterial ~= Enum.Material.Air,
						tired = false,
						turn = 0,
						vy = v.Y,
					})
				end
			end
		end
	end)
end

return RemoteAnim
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">TimeScale</string><ProtectedString name="Source"><![CDATA[--[[
	TimeScale
	Oyunun kendi zaman çarpanı: yavaş çekim ve vuruş anı duraksaması (hit-stop).
	Animasyon, top ve oyuncu hızı bu çarpanla çalışır. Maç tek oyunculu ve istemcide
	benzetildiği için yavaş çekim kimseyi etkilemez.
]]

local TimeScale = { Value = 1 }

local token = 0

-- scale: 0-1, duration: gerçek saniye. Bitince 1'e döner.
function TimeScale.Set(scale: number, duration: number)
	token += 1
	local mine = token
	TimeScale.Value = scale
	task.delay(duration, function()
		if token == mine then
			TimeScale.Value = 1
		end
	end)
end

return TimeScale
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX40"><Properties><string name="Name">Screens</string></Properties><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">Creator</string><ProtectedString name="Source"><![CDATA[--[[
	Creator (karakter ve kulüp oluşturma ekranı)
	Solda sekmeli seçenek paneli, sağda stüdyo sahnesinde dönen gerçek karakter.
	Her seçim sunucuya önizleme isteği gönderir; sunucu doğrular ve karaktere uygular.
	İsim ve mevki onaydan sonra kalıcıdır.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)
local Components = require(ReplicatedStorage.UI.Components)
local Forms = require(ReplicatedStorage.UI.Forms)

local C = Theme.Color
local player = Players.LocalPlayer

local Creator = {}

local POSITION_INFO = {
	Kaleci = { "KL", "Kaleci", "Fizik ve defansla başlar. Özel zincir: plonjon, yumruk, bire bir." },
	Defans = { "DF", "Defans", "Defans ve fizikle başlar. Müdahale ve blokta güçlü." },
	OrtaSaha = { "OS", "Orta Saha", "Pas ve top kontrolüyle başlar. Oyunu yönetir." },
	Forvet = { "FV", "Forvet", "Hız ve şutla başlar. Gol yollarında etkili." },
}

local function hexToColor(list: { string }): { Color3 }
	local out = {}
	for i, h in ipairs(list) do
		out[i] = Color3.fromHex(h)
	end
	return out
end

function Creator.Open(gui: ScreenGui, onCreated: () -> ())
	local state = {
		name = "",
		number = 9,
		clubName = "",
		clubAbbr = "",
		position = "Forvet",
		kitPattern = "Cubuklu",
		crestShape = 1,
		appearance = {
			height = 180,
			build = "Atletik",
			skin = 2,
			face = 1,
			hairStyle = 2,
			hairColor = Config.HairColors[1],
			beard = 0,
			bootModel = 1,
			bootColor = Config.BootColors[1],
			accessories = {},
		},
	}
	local alive = true
	local conns = {}

	----------------------------------------------------------------------------
	-- Kamera: karakterin çevresinde döner, sürükleyerek çevrilir
	----------------------------------------------------------------------------
	local cam = Workspace.CurrentCamera
	local angle, targetAngle, dragging, lastX = 0.35, 0.35, false, 0
	local zoom = 0 -- 0 tam boy, 1 yüz
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 30
	RunService:BindToRenderStep("FK_CreatorCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		if not dragging then
			targetAngle += dt * 0.12
		end
		angle += (targetAngle - angle) * math.min(1, dt * 8)
		local focus = hrp.Position + Vector3.new(0, 0.2 + zoom * 1.9, 0)
		local dist = 13.5 - zoom * 8
		local pos = focus + Vector3.new(math.sin(angle) * dist, 0.6, math.cos(angle) * dist)
		-- karakter ekranın sağında dursun diye kamera sola kaydırılır
		cam.CFrame = CFrame.lookAt(pos, focus) * CFrame.new(-2.3 + zoom * 1.4, 0, 0)
	end)

	local dragArea = Instance.new("TextButton")
	dragArea.Name = "DragArea"
	dragArea.AutoButtonColor = false
	dragArea.Text = ""
	dragArea.BackgroundTransparency = 1
	dragArea.AnchorPoint = Vector2.new(1, 0)
	dragArea.Position = UDim2.fromScale(1, 0)
	dragArea.Size = UDim2.new(1, -620, 1, 0)
	dragArea.Parent = gui
	dragArea.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			lastX = input.Position.X
		end
	end)
	table.insert(
		conns,
		UserInputService.InputChanged:Connect(function(input)
			if
				dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
			then
				targetAngle -= (input.Position.X - lastX) * 0.01
				lastX = input.Position.X
			end
		end)
	)
	table.insert(
		conns,
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	)

	----------------------------------------------------------------------------
	-- Önizleme isteği (sık değişikliklerde en sonuncusu gönderilir)
	----------------------------------------------------------------------------
	local pending = false
	local function preview()
		if pending then
			return
		end
		pending = true
		task.delay(0.25, function()
			pending = false
			if alive then
				Remotes.Get("PreviewAppearance"):FireServer({
					appearance = state.appearance,
					position = state.position,
					kitPattern = state.kitPattern,
					number = state.number,
					clubAbbr = state.clubAbbr,
				})
			end
		end)
	end

	----------------------------------------------------------------------------
	-- Sol panel
	----------------------------------------------------------------------------
	local panel, content = Components.Panel({ Name = "Creator", Size = UDim2.new(0, 580, 1, -84), Position = UDim2.fromOffset(20, 64) })
	panel.Parent = gui

	local header = Components.Label({
		Text = "Kariyerini oluştur",
		Size = 26,
		Font = Theme.Font.Display,
		Color = C.Yellow,
		Upper = true,
		Frame = UDim2.new(1, 0, 0, 30),
	})
	header.Parent = content

	local pages: { [string]: CanvasGroup } = {}
	local current = "Kimlik"
	local function page(id: string): CanvasGroup
		local p = Instance.new("CanvasGroup")
		p.Name = id
		p.BackgroundTransparency = 1
		p.Position = UDim2.fromOffset(0, 88)
		p.Size = UDim2.new(1, 0, 1, -164)
		p.Visible = id == current
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 8)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = p
		p.Parent = content
		pages[id] = p
		return p
	end

	local tabs = Forms.Tabs({
		Tabs = {
			{ Id = "Kimlik", Text = "Kimlik" },
			{ Id = "Yuz", Text = "Yüz" },
			{ Id = "Sac", Text = "Saç" },
			{ Id = "Vucut", Text = "Vücut" },
			{ Id = "Forma", Text = "Forma" },
			{ Id = "Aksesuar", Text = "Aksesuar" },
		},
		Value = current,
		OnChange = function(id)
			pages[current].Visible = false
			current = id
			UIMotion.In(pages[id], Vector2.new(24, 0))
			zoom = if id == "Yuz" or id == "Sac" then 1 else 0
		end,
	})
	tabs.Frame.Position = UDim2.fromOffset(0, 40)
	tabs.Frame.Parent = content

	-- İsim plakası (sağ alt)
	local plate = Instance.new("CanvasGroup")
	plate.BackgroundTransparency = 1
	plate.AnchorPoint = Vector2.new(1, 1)
	plate.Position = UDim2.new(1, -30, 1, -30)
	plate.Size = UDim2.fromOffset(560, 90)
	plate.Parent = gui
	local plateName = Components.Label({
		Text = "FUTBOLCU",
		Size = 46,
		Font = Theme.Font.Display,
		Color = C.Yellow,
		Upper = true,
		Align = Enum.TextXAlignment.Right,
		Frame = UDim2.new(1, 0, 0, 52),
	})
	plateName.Parent = plate
	local plateSub = Components.Label({
		Text = "",
		Size = 17,
		Color = C.Text,
		Font = Theme.Font.Title,
		Upper = true,
		Align = Enum.TextXAlignment.Right,
		Frame = UDim2.new(1, 0, 0, 22),
	})
	plateSub.Position = UDim2.fromOffset(0, 56)
	plateSub.Parent = plate
	local function refreshPlate()
		plateName.Text = if state.name ~= "" then Theme.Upper(state.name) else "FUTBOLCU"
		plateSub.Text = Theme.Upper(
			POSITION_INFO[state.position][2] .. " · " .. state.number .. (if state.clubName ~= "" then " · " .. state.clubName else "")
		)
	end

	local hint = Components.Label({
		Text = "Çevirmek için sürükle",
		Size = 13,
		Color = C.Muted,
		Upper = true,
		Align = Enum.TextXAlignment.Right,
		Frame = UDim2.fromOffset(300, 18),
	})
	hint.AnchorPoint = Vector2.new(1, 0)
	hint.Position = UDim2.new(1, -30, 0, 26)
	hint.Parent = gui

	---------------------------------------------------------------- Kimlik
	do
		local p = page("Kimlik")
		Forms.Caption("Futbolcu adı (sonradan değişmez)", 1).Parent = p
		local r1 = Forms.Row(8, 40, 2)
		r1.Parent = p
		local nameBox = Forms.TextInput({
			Placeholder = "Adını yaz",
			MaxLength = Config.Name.Max,
			Size = UDim2.new(1, -146, 0, 40),
			Order = 1,
			OnChange = function(t)
				state.name = t
				refreshPlate()
			end,
		})
		nameBox.Parent = r1
		local num = Forms.Stepper({
			Min = 1,
			Max = 99,
			Value = 9,
			Order = 2,
			OnChange = function(v)
				state.number = v
				refreshPlate()
				preview()
			end,
		})
		num.Frame.Parent = r1

		Forms.Caption("Kulübünün adı ve kısaltması", 3).Parent = p
		local r2 = Forms.Row(8, 40, 4)
		r2.Parent = p
		local clubBox = Forms.TextInput({
			Placeholder = "Kulüp adı",
			MaxLength = Config.ClubName.Max,
			Size = UDim2.new(1, -146, 0, 40),
			Order = 1,
			OnChange = function(t)
				state.clubName = t
				refreshPlate()
			end,
		})
		clubBox.Parent = r2
		local abbrBox = Forms.TextInput({
			Placeholder = "KIS",
			MaxLength = 3,
			Upper = true,
			Pattern = "[^A-Z]",
			Size = UDim2.fromOffset(130, 40),
			Order = 2,
			OnChange = function(t)
				state.clubAbbr = t
				if #t >= 2 then
					preview()
				end
			end,
		})
		abbrBox.Parent = r2

		Forms.Caption("Mevki (bir kez seçilir, kariyer boyunca değişmez)", 5).Parent = p
		local cards = Instance.new("Frame")
		cards.BackgroundTransparency = 1
		cards.Size = UDim2.new(1, 0, 0, 92)
		cards.LayoutOrder = 6
		cards.Parent = p
		local info = Components.Label({
			Text = POSITION_INFO.Forvet[3],
			Size = 14,
			Color = C.Text,
			Wrap = true,
			Order = 7,
			Frame = UDim2.new(1, 0, 0, 40),
		})
		info.Parent = p
		local posCards = {}
		local function paintPos()
			for id, card in pairs(posCards) do
				local on = id == state.position
				card.Stroke.Color = if on then C.Yellow else C.White
				card.Stroke.Transparency = if on then 0 else 0.85
				card.Code.TextColor3 = if on then C.Yellow else C.Text
			end
		end
		for i, id in ipairs(Config.Positions) do
			local b = Instance.new("TextButton")
			b.AutoButtonColor = false
			b.Text = ""
			b.BackgroundColor3 = C.Ground
			b.BackgroundTransparency = 0.2
			b.BorderSizePixel = 0
			b.Size = UDim2.new(0.25, -6, 1, 0)
			b.Position = UDim2.new((i - 1) * 0.25, (i - 1) * 2, 0, 0)
			Components.Corner(b, Theme.Corner.Medium)
			Components.Stroke(b, C.White, 2, 0.85).Name = "Stroke"
			local code = Components.Label({
				Text = POSITION_INFO[id][1],
				Size = 30,
				Font = Theme.Font.Display,
				Align = Enum.TextXAlignment.Center,
				Frame = UDim2.new(1, 0, 0, 40),
			})
			code.Name = "Code"
			code.Position = UDim2.fromOffset(0, 14)
			code.Parent = b
			local nm = Components.Label({
				Text = POSITION_INFO[id][2],
				Size = 13,
				Color = C.Muted,
				Upper = true,
				Align = Enum.TextXAlignment.Center,
				Frame = UDim2.new(1, 0, 0, 18),
			})
			nm.Position = UDim2.fromOffset(0, 58)
			nm.Parent = b
			local sc = Instance.new("UIScale")
			sc.Parent = b
			b.Activated:Connect(function()
				UIMotion.Sound("ClickSound")
				state.position = id
				info.Text = POSITION_INFO[id][3]
				sc.Scale = 0.92
				UIMotion.Tween(sc, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })
				paintPos()
				refreshPlate()
				preview()
			end)
			b.Parent = cards
			posCards[id] = b
		end
		paintPos()
	end

	---------------------------------------------------------------- Yüz
	do
		local p = page("Yuz")
		Forms.Caption("Ten", 1).Parent = p
		Forms.Swatches({
			Colors = Config.SkinColors,
			Value = state.appearance.skin,
			Order = 2,
			OnChange = function(i)
				state.appearance.skin = i
				preview()
			end,
		}).Frame.Parent =
			p
		Forms.Caption("Yüz", 3).Parent = p
		local faces = {}
		for i = 1, Config.Appearance.Faces do
			faces[i] = { Id = i, Text = "Yüz " .. i }
		end
		Forms.Chips({
			Options = faces,
			Value = 1,
			Order = 4,
			OnChange = function(v)
				state.appearance.face = v
				preview()
			end,
		}).Frame.Parent =
			p
		Forms.Caption("Sakal", 5).Parent = p
		local beards = {}
		for i = 0, Config.Appearance.Beards do
			table.insert(beards, { Id = i, Text = Config.BeardNames[i] })
		end
		Forms.Chips({
			Options = beards,
			Value = 0,
			Order = 6,
			OnChange = function(v)
				state.appearance.beard = v
				preview()
			end,
		}).Frame.Parent =
			p
		Components.Label({
			Text = "Yüz ve sakal görselleri topluluk dosyaları yüklenince görünür; seçimin şimdiden kaydedilir.",
			Size = 13,
			Color = C.Muted,
			Wrap = true,
			Order = 7,
			Frame = UDim2.new(1, 0, 0, 36),
		}).Parent =
			p
	end

	---------------------------------------------------------------- Saç
	do
		local p = page("Sac")
		Forms.Caption("Saç modeli", 1).Parent = p
		local styles = {}
		for i, n in ipairs(Config.HairStyleNames) do
			styles[i] = { Id = i, Text = n }
		end
		Forms.Chips({
			Options = styles,
			Value = state.appearance.hairStyle,
			Order = 2,
			OnChange = function(v)
				state.appearance.hairStyle = v
				preview()
			end,
		}).Frame.Parent =
			p
		Forms.Caption("Saç rengi", 3).Parent = p
		Forms.Swatches({
			Colors = hexToColor(Config.HairColors),
			Value = 1,
			Order = 4,
			OnChange = function(i)
				state.appearance.hairColor = Config.HairColors[i]
				preview()
			end,
		}).Frame.Parent =
			p
	end

	---------------------------------------------------------------- Vücut
	do
		local p = page("Vucut")
		Forms.Caption("Boy", 1).Parent = p
		Forms.Slider({
			Min = Config.Appearance.HeightMin,
			Max = Config.Appearance.HeightMax,
			Value = state.appearance.height,
			Order = 2,
			Format = function(v)
				return v .. " cm"
			end,
			OnChange = function(v)
				state.appearance.height = v
				preview()
			end,
		}).Frame.Parent =
			p
		Forms.Caption("Yapı", 3).Parent = p
		local builds = {}
		for i, id in ipairs(Config.Appearance.Builds) do
			builds[i] = { Id = id, Text = Config.BuildNames[id] }
		end
		Forms.Chips({
			Options = builds,
			Value = state.appearance.build,
			ChipWidth = 120,
			Order = 4,
			OnChange = function(v)
				state.appearance.build = v
				preview()
			end,
		}).Frame.Parent =
			p
		Components.Label({
			Text = "Boy ve yapı yalnızca görünümdür; maçta herkesin isabet alanı aynıdır.",
			Size = 13,
			Color = C.Muted,
			Wrap = true,
			Order = 5,
			Frame = UDim2.new(1, 0, 0, 36),
		}).Parent =
			p
	end

	---------------------------------------------------------------- Forma
	do
		local p = page("Forma")
		Forms.Caption("Kulüp forma deseni", 1).Parent = p
		local pats = {}
		for i, id in ipairs(Config.Appearance.KitPatterns) do
			pats[i] = { Id = id, Text = Config.KitPatternNames[id] }
		end
		Forms.Chips({
			Options = pats,
			Value = state.kitPattern,
			ChipWidth = 120,
			Order = 2,
			OnChange = function(v)
				state.kitPattern = v
				preview()
			end,
		}).Frame.Parent =
			p
		Forms.Caption("Arma şekli", 3).Parent = p
		local shapes = {}
		for i = 1, Config.Appearance.CrestShapes do
			shapes[i] = { Id = i, Text = "Kalkan " .. i }
		end
		Forms.Chips({
			Options = shapes,
			Value = 1,
			Order = 4,
			OnChange = function(v)
				state.crestShape = v
			end,
		}).Frame.Parent =
			p
		Forms.Caption("Krampon", 5).Parent = p
		local boots = {}
		for i = 1, Config.Appearance.BootModels do
			boots[i] = { Id = i, Text = "Model " .. i }
		end
		Forms.Chips({
			Options = boots,
			Value = 1,
			Order = 6,
			OnChange = function(v)
				state.appearance.bootModel = v
			end,
		}).Frame.Parent =
			p
		Forms.Swatches({
			Colors = hexToColor(Config.BootColors),
			Value = 1,
			Order = 7,
			OnChange = function(i)
				state.appearance.bootColor = Config.BootColors[i]
				preview()
			end,
		}).Frame.Parent =
			p
		Components.Label({
			Text = "Kaleci seçersen forman yeşil olur. Renkler sarı-lacivert ailesiyle sınırlıdır.",
			Size = 13,
			Color = C.Muted,
			Wrap = true,
			Order = 8,
			Frame = UDim2.new(1, 0, 0, 36),
		}).Parent =
			p
	end

	---------------------------------------------------------------- Aksesuar
	do
		local p = page("Aksesuar")
		Forms.Caption("Aksesuarlar (birden fazla seçilebilir)", 1).Parent = p
		local opts = {}
		for i, id in ipairs(Config.Accessories) do
			opts[i] = { Id = id, Text = Config.AccessoryNames[id] }
		end
		table.insert(
			opts,
			{ Id = "Kaptan", Text = "Kaptan bandı", Locked = "Kaptan bandı seviye " .. Config.CaptainBandLevel .. " ödülüdür." }
		)
		Forms.Chips({
			Options = opts,
			Multi = true,
			Values = state.appearance.accessories,
			Order = 2,
			OnChange = function(values)
				values.Kaptan = nil
				state.appearance.accessories = values
				preview()
			end,
		}).Frame.Parent =
			p
	end

	----------------------------------------------------------------------------
	-- Alt butonlar
	----------------------------------------------------------------------------
	local startBtn
	startBtn = Components.Button({
		Text = "Kariyere başla",
		Style = "Primary",
		Size = UDim2.new(0.62, -6, 0, 56),
		OnClick = function()
			local nameLen = utf8.len(state.name) or 0
			local clubLen = utf8.len(state.clubName) or 0
			if nameLen < Config.Name.Min then
				UIMotion.Shake(startBtn)
				return Components.Toast("error", "Futbolcu adı en az " .. Config.Name.Min .. " harf olmalı.")
			end
			if clubLen < Config.ClubName.Min then
				UIMotion.Shake(startBtn)
				return Components.Toast("error", "Kulüp adı en az " .. Config.ClubName.Min .. " harf olmalı.")
			end
			if #state.clubAbbr < 2 then
				UIMotion.Shake(startBtn)
				return Components.Toast("error", "Kulüp kısaltması 2 ya da 3 harf olmalı.")
			end
			Forms.Modal({
				Parent = gui,
				Title = "Emin misin?",
				Text = "Mevkin "
					.. POSITION_INFO[state.position][2]
					.. " olarak kilitlenecek ve adın "
					.. state.name
					.. " olarak kalacak. Bu ikisi sonradan değiştirilemez. Görünümünü mağazadan değiştirebilirsin.",
				Confirm = "Kilitle ve başla",
				Cancel = "Geri dön",
				OnConfirm = function()
					Remotes.Get("CreateCareer"):FireServer({
						name = state.name,
						number = state.number,
						position = state.position,
						clubName = state.clubName,
						clubAbbr = state.clubAbbr,
						crestShape = state.crestShape,
						kitPattern = state.kitPattern,
						appearance = state.appearance,
					})
				end,
			})
		end,
	})
	startBtn.AnchorPoint = Vector2.new(1, 1)
	startBtn.Position = UDim2.fromScale(1, 1)
	startBtn.Parent = content

	local randomBtn = Components.Button({
		Text = "Rastgele",
		Style = "Ghost",
		Size = UDim2.new(0.38, -6, 0, 56),
		OnClick = function()
			local a = state.appearance
			a.height = math.random(Config.Appearance.HeightMin, Config.Appearance.HeightMax)
			a.build = Config.Appearance.Builds[math.random(1, 3)]
			a.skin = math.random(1, Config.Appearance.SkinTones)
			a.hairStyle = math.random(1, Config.Appearance.HairStyles)
			a.hairColor = Config.HairColors[math.random(1, #Config.HairColors)]
			a.bootColor = Config.BootColors[math.random(1, #Config.BootColors)]
			preview()
			Components.Toast("info", "Rastgele görünüm uygulandı. Sekmelerden ince ayar yapabilirsin.")
		end,
	})
	randomBtn.AnchorPoint = Vector2.new(0, 1)
	randomBtn.Position = UDim2.fromScale(0, 1)
	randomBtn.Parent = content

	-- Sahneye giriş
	UIMotion.In(panel, Vector2.new(-50, 0), 0.05)
	UIMotion.In(plate, Vector2.new(40, 0), 0.2)
	refreshPlate()
	preview()

	-- Sunucu kariyeri oluşturunca kapan
	table.insert(
		conns,
		Remotes.Get("DataChanged").OnClientEvent:Connect(function(data)
			if alive and data.created then
				alive = false
				UIMotion.Wipe(function()
					RunService:UnbindFromRenderStep("FK_CreatorCam")
					for _, c in ipairs(conns) do
						c:Disconnect()
					end
					panel:Destroy()
					plate:Destroy()
					hint:Destroy()
					dragArea:Destroy()
					cam.CameraType = Enum.CameraType.Custom
					cam.FieldOfView = 70
					onCreated()
				end)
			end
		end)
	)
end

return Creator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">CrestDesigner</string><ProtectedString name="Source"><![CDATA[--[[
	CrestDesigner
	Kulüp arması tasarım ekranı: biçim, desen, simge ve iki renk seçilir; sonuç anında önizlenir.
	Kaydedilen arma forma göğsünde, maç öncesi kadro ekranında ve takım arkadaşlarının formasında görünür.

	CrestDesigner.Open(gui, getData)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Crest = require(ReplicatedStorage.Shared.Crest)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Components = require(ReplicatedStorage.UI.Components)
local Forms = require(ReplicatedStorage.UI.Forms)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)

local CrestDesigner = {}

local C = Theme.Color
local open: Instance? = nil

local function options(names: { string })
	local out = {}
	for i, n in ipairs(names) do
		out[i] = { Id = i, Text = n }
	end
	return out
end

function CrestDesigner.Close()
	if open then
		local root = open
		open = nil
		UIMotion.Out(root :: any, Vector2.new(0, 20), true)
	end
end

function CrestDesigner.Open(gui: ScreenGui, getData: () -> any)
	if open then
		return
	end
	local data = getData()
	if not data then
		return
	end
	local abbr = if data.club.abbr ~= "" then data.club.abbr else "FK"
	local saved = data.club.crest or Crest.Default()
	local spec = { shape = saved.shape, pattern = saved.pattern, a = saved.a, b = saved.b, symbol = saved.symbol }

	local dim = Instance.new("TextButton")
	dim.Name = "CrestDesigner"
	dim.AutoButtonColor = false
	dim.Text = ""
	dim.BackgroundColor3 = C.Ground
	dim.BackgroundTransparency = 0.25
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.ZIndex = 120
	dim.Parent = gui
	open = dim
	local panel, content = Components.Panel({
		Name = "CrestPanel",
		Size = UDim2.fromOffset(1080, 660),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Title = "Kulüp Arması",
	})
	panel.ZIndex = 121
	panel.Parent = dim

	-- önizleme (sol)
	local left = Instance.new("Frame")
	left.BackgroundColor3 = C.Ground
	left.BackgroundTransparency = 0.3
	left.BorderSizePixel = 0
	left.Position = UDim2.fromOffset(0, 46)
	left.Size = UDim2.fromOffset(320, 500)
	local lc = Instance.new("UICorner")
	lc.CornerRadius = UDim.new(0, 10)
	lc.Parent = left
	left.Parent = content
	local name = Components.Label({
		Text = if data.club.name ~= "" then data.club.name else "Kulübüm",
		Upper = true,
		Size = 20,
		Font = Theme.Font.Display,
		Color = C.White,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, 0, 0, 28),
	})
	name.Position = UDim2.fromOffset(0, 300)
	name.Parent = left
	local note = Components.Label({
		Text = "Forma göğsünde, kadro ekranında ve takım arkadaşlarının formasında görünür.",
		Size = 12,
		Color = C.Muted,
		Wrap = true,
		Align = Enum.TextXAlignment.Center,
		Frame = UDim2.new(1, -30, 0, 40),
	})
	note.Position = UDim2.fromOffset(15, 440)
	note.Parent = left
	local holders = {}
	for _, h in ipairs({ { 230, 45, 40 }, { 86, 70, 340 }, { 52, 190, 356 } }) do
		local f = Instance.new("Frame")
		f.Name = "Preview"
		f.BackgroundTransparency = 1
		f.Size = UDim2.fromOffset(h[1], h[1])
		f.Position = UDim2.fromOffset(h[2], h[3])
		f.Parent = left
		table.insert(holders, f)
	end
	local function redraw()
		for i, f in ipairs(holders) do
			for _, child in ipairs(f:GetChildren()) do
				child:Destroy()
			end
			Crest.Fill(f, spec, abbr)
			if i == 1 then
				UIMotion.Pop(f, 0.94)
			end
		end
	end

	-- seçenekler (sağ)
	local right = Instance.new("Frame")
	right.BackgroundTransparency = 1
	right.Position = UDim2.fromOffset(344, 46)
	right.Size = UDim2.new(1, -344, 0, 500)
	right.Parent = content
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = right
	local controls = {}
	local function chips(caption: string, key: string, names: { string }, order: number)
		Forms.Caption(caption, order).Parent = right
		local api = Forms.Chips({
			Options = options(names),
			Value = spec[key],
			Order = order + 1,
			OnChange = function(v)
				spec[key] = v
				redraw()
			end,
		})
		api.Frame.Parent = right
		controls[key] = api
	end
	local function swatches(caption: string, key: string, order: number)
		Forms.Caption(caption, order).Parent = right
		local api = Forms.Swatches({
			Colors = Crest.Colors,
			Value = spec[key],
			Order = order + 1,
			OnChange = function(i)
				spec[key] = i
				redraw()
			end,
		})
		api.Frame.Parent = right
		controls[key] = api
	end
	chips("Biçim", "shape", Crest.Shapes, 1)
	chips("Desen", "pattern", Crest.Patterns, 3)
	chips("Simge", "symbol", Crest.Symbols, 5)
	swatches("Ana renk", "a", 7)
	swatches("İkinci renk (desen ve çerçeve)", "b", 9)

	-- düğmeler
	local save = Components.Button({
		Text = "Kaydet",
		Style = "Primary",
		Size = UDim2.fromOffset(240, 56),
		OnClick = function()
			if spec.a == spec.b then
				Components.Toast("error", "İki renk aynı olamaz; desen görünmez.")
				return
			end
			Remotes.Get("SetCrest"):FireServer(spec)
			UIMotion.Sound("ConfirmSound")
			CrestDesigner.Close()
		end,
	})
	save.AnchorPoint = Vector2.new(1, 1)
	save.Position = UDim2.fromScale(1, 1)
	save.Parent = content
	local random = Components.Button({
		Text = "Rastgele",
		Style = "Ghost",
		Size = UDim2.fromOffset(170, 56),
		OnClick = function()
			spec.shape = math.random(1, #Crest.Shapes)
			spec.pattern = math.random(1, #Crest.Patterns)
			spec.symbol = math.random(1, #Crest.Symbols)
			spec.a = math.random(1, #Crest.Colors)
			repeat
				spec.b = math.random(1, #Crest.Colors)
			until spec.b ~= spec.a
			redraw()
		end,
	})
	random.AnchorPoint = Vector2.new(1, 1)
	random.Position = UDim2.new(1, -252, 1, 0)
	random.Parent = content
	local close = Components.Button({ Text = "Vazgeç", Style = "Ghost", Size = UDim2.fromOffset(150, 56), OnClick = CrestDesigner.Close })
	close.AnchorPoint = Vector2.new(0, 1)
	close.Position = UDim2.fromScale(0, 1)
	close.Parent = content

	redraw()
	UIMotion.In(panel, Vector2.new(0, 30))
end

return CrestDesigner
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">Halftime</string><ProtectedString name="Source"><![CDATA[--[[
	Halftime
	Devre arası ekranı: ilk yarının özeti, takım emri ve oyuncu değişikliği.
	Sahadan bir oyuncu ve kulübeden bir yedek seçilip "Değiştir" denir (en çok 3 değişiklik).
	Oyuncunun kendisi değiştirilemez.

	Halftime.Show(gui, ctx, onContinue)
	ctx = {
		homeName, awayName, home, away,            skor
		stats = MatchAI.Stats(),                   şut ve topa sahip olma
		squad = () -> { {slot, info, tired} },     sahadaki takım arkadaşları (güncel)
		bench = { info, ... },                     yedekler (kullanılan çıkarılır)
		subsLeft = () -> number,
		substitute = (slot, benchIndex) -> boolean,
		order = () -> string, setOrder = (name) -> (),
		me = { name, number },
	}
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Components = require(ReplicatedStorage.UI.Components)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)

local Halftime = {}

local C = Theme.Color
local ORDERS = { "Dengeli", "Atak", "Defans", "Pres" }

local function text(
	parent: Instance,
	str: string,
	size: number,
	color: Color3,
	x: number,
	y: number,
	w: number,
	h: number,
	font: Font?,
	align: Enum.TextXAlignment?
)
	local l = Components.Label({
		Text = str,
		Size = size,
		Color = color,
		Font = font or Theme.Font.Title,
		Frame = UDim2.fromOffset(w, h),
		Align = align,
	})
	l.Position = UDim2.fromOffset(x, y)
	l.Parent = parent
	return l
end

local function ratingColor(v: number): Color3
	return if v >= 80 then C.Gold elseif v >= 65 then C.Good elseif v >= 45 then C.Yellow else C.Muted
end

function Halftime.Show(gui: ScreenGui, ctx, onContinue: () -> ())
	local root = Instance.new("Frame")
	root.Name = "Halftime"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color3.fromRGB(6, 11, 36)
	root.BackgroundTransparency = 0.08
	root.BorderSizePixel = 0
	root.ZIndex = 140
	root.Parent = gui
	local panel, content = Components.Panel({
		Name = "HalftimePanel",
		Size = UDim2.fromOffset(1180, 700),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Title = "Devre Arası",
	})
	panel.ZIndex = 141
	panel.Parent = root

	-- özet
	text(
		content,
		string.format("%s  %d - %d  %s", ctx.homeName, ctx.home, ctx.away, ctx.awayName),
		30,
		C.White,
		0,
		40,
		520,
		40,
		Theme.Font.Display
	)
	local st = ctx.stats
	local total = math.max(1, st.possession.home + st.possession.away)
	text(
		content,
		string.format(
			"Şut %d - %d   ·   Topa sahip olma %%%d - %%%d",
			st.shots.home,
			st.shots.away,
			math.floor(st.possession.home / total * 100 + 0.5),
			math.floor(st.possession.away / total * 100 + 0.5)
		),
		15,
		C.Muted,
		0,
		82,
		700,
		22
	)

	local selectedSlot: number? = nil
	local selectedBench: number? = nil
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(0, 118)
	body.Size = UDim2.new(1, 0, 1, -118)
	body.Parent = content

	local draw: () -> ()
	local function row(parent: Instance, y: number, w: number, selected: boolean, disabled: boolean, onClick: (() -> ())?): TextButton
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.Text = ""
		b.Size = UDim2.fromOffset(w, 36)
		b.Position = UDim2.fromOffset(0, y)
		b.BackgroundColor3 = if selected then C.Yellow elseif disabled then C.Ground else C.Blue
		b.BackgroundTransparency = if selected then 0 else 0.3
		b.BorderSizePixel = 0
		local u = Instance.new("UICorner")
		u.CornerRadius = UDim.new(0, 6)
		u.Parent = b
		b.Parent = parent
		if onClick and not disabled then
			b.Activated:Connect(onClick)
		end
		return b
	end

	draw = function()
		for _, child in ipairs(body:GetChildren()) do
			child:Destroy()
		end
		-- sahadakiler
		local left = Instance.new("Frame")
		left.BackgroundTransparency = 1
		left.Size = UDim2.fromOffset(470, 540)
		left.Parent = body
		text(left, "SAHADAKİLER", 13, C.Yellow, 0, 0, 300, 20)
		text(left, "GÜÇ", 11, C.Muted, 330, 2, 50, 18, nil, Enum.TextXAlignment.Center)
		text(left, "YORGUNLUK", 11, C.Muted, 384, 2, 86, 18, nil, Enum.TextXAlignment.Center)
		local list = ctx.squad()
		local y = 26
		for _, p in ipairs(list) do
			local on = selectedSlot == p.slot
			local b = row(left, y, 470, on, false, function()
				selectedSlot = if selectedSlot == p.slot then nil else p.slot
				draw()
			end)
			b.Name = "Starter"
			local ink = if on then C.Navy else C.Text
			text(
				b,
				tostring(p.info.number),
				15,
				if on then C.Navy else C.Yellow,
				8,
				0,
				34,
				36,
				Theme.Font.Number,
				Enum.TextXAlignment.Center
			)
			text(b, p.info.name, 15, ink, 50, 0, 200, 36)
			text(b, p.info.role, 12, if on then C.Navy else C.Muted, 258, 0, 60, 36)
			text(
				b,
				tostring(p.info.rating),
				17,
				if on then C.Navy else ratingColor(p.info.rating),
				330,
				0,
				50,
				36,
				Theme.Font.Number,
				Enum.TextXAlignment.Center
			)
			-- yorgunluk çubuğu
			local track = Instance.new("Frame")
			track.Size = UDim2.fromOffset(70, 8)
			track.Position = UDim2.fromOffset(392, 14)
			track.BackgroundColor3 = C.Ground
			track.BorderSizePixel = 0
			track.Parent = b
			local fill = Instance.new("Frame")
			fill.Size = UDim2.fromScale(math.clamp(p.tired, 0.04, 1), 1) -- devre arasında yarıya kadar dolar
			fill.BackgroundColor3 = if p.tired > 0.7 then C.Bad elseif p.tired > 0.35 then C.Gold else C.Good
			fill.BorderSizePixel = 0
			fill.Parent = track
			y += 40
		end
		local me = row(left, y, 470, false, true, nil)
		me.Name = "Me"
		text(me, tostring(ctx.me.number), 15, C.Yellow, 8, 0, 34, 36, Theme.Font.Number, Enum.TextXAlignment.Center)
		text(me, Theme.Upper(ctx.me.name) .. "  (SEN · değiştirilemez)", 14, C.Muted, 50, 0, 400, 36)

		-- yedekler
		local mid = Instance.new("Frame")
		mid.BackgroundTransparency = 1
		mid.Position = UDim2.fromOffset(500, 0)
		mid.Size = UDim2.fromOffset(330, 540)
		mid.Parent = body
		text(mid, "YEDEKLER", 13, C.Yellow, 0, 0, 200, 20)
		text(mid, "Kalan değişiklik: " .. ctx.subsLeft(), 12, C.Muted, 150, 0, 180, 20, nil, Enum.TextXAlignment.Right)
		local by = 26
		for i, info in ipairs(ctx.bench) do
			local on = selectedBench == i
			local b = row(mid, by, 330, on, false, function()
				selectedBench = if selectedBench == i then nil else i
				draw()
			end)
			b.Name = "Sub"
			local ink = if on then C.Navy else C.Text
			text(b, tostring(info.number), 15, if on then C.Navy else C.Yellow, 8, 0, 34, 36, Theme.Font.Number, Enum.TextXAlignment.Center)
			text(b, info.name, 15, ink, 50, 0, 170, 36)
			text(b, info.role, 12, if on then C.Navy else C.Muted, 222, 0, 50, 36)
			text(
				b,
				tostring(info.rating),
				17,
				if on then C.Navy else ratingColor(info.rating),
				276,
				0,
				46,
				36,
				Theme.Font.Number,
				Enum.TextXAlignment.Center
			)
			by += 40
		end
		if #ctx.bench == 0 then
			text(mid, "Kulübede oyuncu kalmadı.", 13, C.Muted, 0, 30, 330, 20)
		end
		local can = selectedSlot ~= nil and selectedBench ~= nil and ctx.subsLeft() > 0
		local swap = Components.Button({
			Text = "Değiştir",
			Style = if can then "Primary" else "Secondary",
			Sub = if ctx.subsLeft() <= 0
				then "Değişiklik hakkın bitti"
				elseif can then "Seçilen ikiliyi değiştir"
				else "Bir sahadan, bir kulübeden seç",
			Size = UDim2.fromOffset(330, 60),
			OnClick = function()
				if not can then
					Components.Toast(
						"info",
						if ctx.subsLeft() <= 0 then "Değişiklik hakkın bitti." else "Sahadan bir oyuncu ve kulübeden bir yedek seç."
					)
					return
				end
				if ctx.substitute(selectedSlot :: number, selectedBench :: number) then
					UIMotion.Sound("ConfirmSound")
					selectedSlot, selectedBench = nil, nil
					draw()
				end
			end,
		})
		swap.Name = "Swap"
		swap.Position = UDim2.fromOffset(0, by + 14)
		swap.Parent = mid

		-- takım emri
		local right = Instance.new("Frame")
		right.BackgroundTransparency = 1
		right.Position = UDim2.fromOffset(860, 0)
		right.Size = UDim2.fromOffset(288, 540)
		right.Parent = body
		text(right, "İKİNCİ YARI EMRİ", 13, C.Yellow, 0, 0, 288, 20)
		for i, name in ipairs(ORDERS) do
			local on = ctx.order() == name
			local b = row(right, 26 + (i - 1) * 44, 288, on, false, function()
				ctx.setOrder(name)
				draw()
			end)
			b.Size = UDim2.fromOffset(288, 40)
			b.Name = "Order"
			text(b, Theme.Upper(name), 15, if on then C.Navy else C.Text, 0, 0, 288, 40, nil, Enum.TextXAlignment.Center)
		end
	end
	draw()

	local go = Components.Button({
		Text = "İkinci yarı",
		Style = "Primary",
		Sub = "Rakibin santrasıyla başlar",
		Size = UDim2.fromOffset(288, 64),
		OnClick = function()
			UIMotion.Wipe(function()
				root:Destroy()
				onContinue()
			end)
		end,
	})
	go.Name = "Continue"
	go.AnchorPoint = Vector2.new(1, 1)
	go.Position = UDim2.fromScale(1, 1)
	go.Parent = content
	UIMotion.In(panel, Vector2.new(0, 30))
	return root
end

return Halftime
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">League</string><ProtectedString name="Source"><![CDATA[--[[
	League
	Puan durumu ekranı: ligdeki altı kulüp, oynanan maç, galibiyet/beraberlik/mağlubiyet ve puan.
	Oyuncunun kulübü sarı satırdadır. Lig atlama çizgisi tabloda gösterilir.

	League.Open(gui, getData)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Crest = require(ReplicatedStorage.Shared.Crest)
local Squads = require(ReplicatedStorage.Shared.Squads)
local Components = require(ReplicatedStorage.UI.Components)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)

local League = {}

local C = Theme.Color
local open: Instance? = nil

local function text(
	parent: Instance,
	str: string,
	size: number,
	color: Color3,
	x: number,
	w: number,
	font: Font?,
	align: Enum.TextXAlignment?
)
	local l = Components.Label({
		Text = str,
		Size = size,
		Color = color,
		Font = font or Theme.Font.Title,
		Frame = UDim2.new(0, w, 1, 0),
		Align = align,
	})
	l.Position = UDim2.fromOffset(x, 0)
	l.Parent = parent
	return l
end

function League.Close()
	if open then
		local root = open
		open = nil
		UIMotion.Out(root :: any, Vector2.new(0, 20), true)
	end
end

function League.Open(gui: ScreenGui, getData: () -> any)
	if open then
		return
	end
	local data = getData()
	if not data then
		return
	end
	local rows, league, seasonNo = Squads.Table(data)
	local dim = Instance.new("TextButton")
	dim.Name = "League"
	dim.AutoButtonColor = false
	dim.Text = ""
	dim.BackgroundColor3 = C.Ground
	dim.BackgroundTransparency = 0.25
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.ZIndex = 120
	dim.Parent = gui
	open = dim
	local panel, content = Components.Panel({
		Name = "LeaguePanel",
		Size = UDim2.fromOffset(820, 600),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Title = "Puan Durumu",
	})
	panel.ZIndex = 121
	panel.Parent = dim
	local sub = Components.Label({
		Text = string.format("%s  ·  %d. sezon  ·  %d / %d maç", league, seasonNo, rows[1].played, Config.Season.Matches),
		Upper = true,
		Size = 13,
		Color = C.Muted,
		Font = Theme.Font.Title,
		Frame = UDim2.new(1, -160, 0, 18),
	})
	sub.Position = UDim2.fromOffset(0, 34)
	sub.Parent = content

	local COL = { rank = 8, crest = 50, name = 96, o = 440, g = 500, b = 556, m = 612, p = 680 }
	local head = Instance.new("Frame")
	head.BackgroundTransparency = 1
	head.Size = UDim2.new(1, 0, 0, 22)
	head.Position = UDim2.fromOffset(0, 66)
	head.Parent = content
	text(head, "#", 11, C.Muted, COL.rank, 30)
	text(head, "KULÜP", 11, C.Muted, COL.name, 300)
	for key, label in pairs({ o = "O", g = "G", b = "B", m = "M", p = "PUAN" }) do
		text(head, label, 11, C.Muted, COL[key], if key == "p" then 80 else 50, nil, Enum.TextXAlignment.Center)
	end

	local list = {}
	for i, row in ipairs(rows) do
		local f = Instance.new("Frame")
		f.Name = if row.mine then "Mine" else "Row"
		f.Size = UDim2.new(1, 0, 0, 54)
		f.Position = UDim2.fromOffset(0, 92 + (i - 1) * 60)
		f.BackgroundColor3 = if row.mine then C.Yellow else (if i % 2 == 0 then C.Blue else C.Navy)
		f.BackgroundTransparency = if row.mine then 0 else 0.35
		f.BorderSizePixel = 0
		local u = Instance.new("UICorner")
		u.CornerRadius = UDim.new(0, 8)
		u.Parent = f
		f.Parent = content
		local ink = if row.mine then C.Navy else C.Text
		text(f, tostring(i), 20, if row.mine then C.Navy elseif i == 1 then C.Gold else C.Muted, COL.rank, 30, Theme.Font.Number)
		local spec, abbr = Crest.FromClub(row.club)
		local crest = Crest.Build(spec, abbr, 42)
		crest.Position = UDim2.fromOffset(COL.crest - 6, 6)
		crest.Parent = f
		text(f, if row.mine then Theme.Upper(row.club.Name) else row.club.Name, 17, ink, COL.name, 330)
		text(f, tostring(row.played), 16, ink, COL.o, 50, Theme.Font.Number, Enum.TextXAlignment.Center)
		-- oyuncunun kulübü için galibiyet dökümü tutulmuyor; yalnızca puanı gerçektir
		text(f, if row.won then tostring(row.won) else "–", 16, ink, COL.g, 50, Theme.Font.Number, Enum.TextXAlignment.Center)
		text(f, if row.drawn then tostring(row.drawn) else "–", 16, ink, COL.b, 50, Theme.Font.Number, Enum.TextXAlignment.Center)
		text(f, if row.lost then tostring(row.lost) else "–", 16, ink, COL.m, 50, Theme.Font.Number, Enum.TextXAlignment.Center)
		text(f, tostring(row.points), 24, if row.mine then C.Navy else C.Yellow, COL.p, 80, Theme.Font.Number, Enum.TextXAlignment.Center)
		table.insert(list, f)
	end

	local need = Config.Match.PromotePoints
	local mine = 0
	for _, row in ipairs(rows) do
		if row.mine then
			mine = row.points
		end
	end
	local note = Components.Label({
		Text = if mine >= need
			then "Lig atlama puanına ulaştın. Sezon bitince üst lige çıkarsın."
			else string.format("Lig atlamak için sezon sonunda en az %d puan gerekir. Kalan: %d puan.", need, need - mine),
		Size = 14,
		Color = if mine >= need then C.Good else C.Text,
		Frame = UDim2.new(1, -170, 0, 40),
		Wrap = true,
	})
	note.AnchorPoint = Vector2.new(0, 1)
	note.Position = UDim2.fromScale(0, 1)
	note.Parent = content
	local close = Components.Button({ Text = "Kapat", Style = "Ghost", Size = UDim2.fromOffset(150, 52), OnClick = League.Close })
	close.AnchorPoint = Vector2.new(1, 1)
	close.Position = UDim2.fromScale(1, 1)
	close.Parent = content
	UIMotion.In(panel, Vector2.new(0, 30))
	UIMotion.Stagger(list, Vector2.new(-24, 0), 0.15)
end

return League
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">Lineup</string><ProtectedString name="Source"><![CDATA[--[[
	Lineup
	Maç öncesi tanıtım: iki kulüp, armalar, teknik direktörler, diziliş ve 11'ler.
	Her futbolcunun genel gücü ve altı özelliği görünür. "Maça çık" ile santraya geçilir.

	Lineup.Show(gui, fixture, onStart, onCancel)   fixture: Squads.Fixture(data)
	Lineup.Crest(club, size) -> Frame               kulüp arması (başka ekranlar da kullanır)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Crest = require(ReplicatedStorage.Shared.Crest)
local Squads = require(ReplicatedStorage.Shared.Squads)
local Components = require(ReplicatedStorage.UI.Components)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)

local Lineup = {}

local C = Theme.Color

local function corner(o: Instance, r: number)
	local u = Instance.new("UICorner")
	u.CornerRadius = UDim.new(r, 0)
	u.Parent = o
end

local function text(
	parent: Instance,
	str: string,
	size: number,
	color: Color3,
	pos: UDim2,
	frame: UDim2,
	font: Font?,
	align: Enum.TextXAlignment?
)
	local l = Components.Label({ Text = str, Size = size, Color = color, Font = font or Theme.Font.Body, Frame = frame, Align = align })
	l.Position = pos
	l.Parent = parent
	return l
end

-- Arma: kulübün tasarımı (oyuncununki) ya da hazır arması (rakipler)
function Lineup.Crest(club, size: number): Frame
	local spec, abbr = Crest.FromClub(club)
	return Crest.Build(spec, abbr, size)
end

local function average(players): number
	local sum = 0
	for _, p in ipairs(players) do
		sum += p.rating
	end
	return math.floor(sum / #players + 0.5)
end

local function ratingColor(v: number): Color3
	return if v >= 80 then C.Gold elseif v >= 65 then C.Good elseif v >= 45 then C.Yellow else C.Muted
end

local function side(parent: Instance, team, x: number, home: boolean)
	local W = 700
	local col = Instance.new("Frame")
	col.BackgroundTransparency = 1
	col.Size = UDim2.fromOffset(W, 720)
	col.Position = UDim2.fromOffset(x, 96)
	col.Parent = parent

	-- başlık: arma, kulüp, teknik direktör, takım gücü
	local crest = Lineup.Crest(team.club, 104)
	crest.Position = UDim2.fromOffset(0, 0)
	crest.Parent = col
	text(col, Theme.Upper(team.club.Name), 30, C.White, UDim2.fromOffset(120, 6), UDim2.fromOffset(W - 240, 36), Theme.Font.Display)
	text(col, "TEKNİK DİREKTÖR", 12, C.Muted, UDim2.fromOffset(120, 48), UDim2.fromOffset(300, 16), Theme.Font.Title)
	text(col, team.club.Coach, 18, C.Text, UDim2.fromOffset(120, 64), UDim2.fromOffset(300, 24), Theme.Font.Title)
	text(col, "DİZİLİŞ 4-4-2", 12, C.Muted, UDim2.fromOffset(120, 90), UDim2.fromOffset(300, 16), Theme.Font.Title)
	local avg = average(team.players)
	local badge = Instance.new("Frame")
	badge.Size = UDim2.fromOffset(96, 96)
	badge.Position = UDim2.fromOffset(W - 100, 4)
	badge.BackgroundColor3 = C.Navy
	badge.BorderSizePixel = 0
	corner(badge, 0.16)
	local bs = Instance.new("UIStroke")
	bs.Color = ratingColor(avg)
	bs.Thickness = 2
	bs.Parent = badge
	badge.Parent = col
	text(
		badge,
		tostring(avg),
		44,
		ratingColor(avg),
		UDim2.fromOffset(0, 10),
		UDim2.new(1, 0, 0, 50),
		Theme.Font.Number,
		Enum.TextXAlignment.Center
	)
	text(badge, "TAKIM GÜCÜ", 10, C.Muted, UDim2.fromOffset(0, 66), UDim2.new(1, 0, 0, 16), Theme.Font.Title, Enum.TextXAlignment.Center)

	-- sütun başlıkları
	local head = Instance.new("Frame")
	head.BackgroundTransparency = 1
	head.Size = UDim2.fromOffset(W, 22)
	head.Position = UDim2.fromOffset(0, 124)
	head.Parent = col
	text(head, "#", 11, C.Muted, UDim2.fromOffset(10, 0), UDim2.fromOffset(30, 22), Theme.Font.Title)
	text(head, "OYUNCU", 11, C.Muted, UDim2.fromOffset(50, 0), UDim2.fromOffset(200, 22), Theme.Font.Title)
	text(head, "MEVKİ", 11, C.Muted, UDim2.fromOffset(262, 0), UDim2.fromOffset(60, 22), Theme.Font.Title)
	text(head, "GEN", 11, C.Muted, UDim2.fromOffset(326, 0), UDim2.fromOffset(44, 22), Theme.Font.Title, Enum.TextXAlignment.Center)
	for i, name in ipairs(Squads.StatOrder) do
		text(
			head,
			Theme.Upper(name),
			11,
			C.Muted,
			UDim2.fromOffset(384 + (i - 1) * 52, 0),
			UDim2.fromOffset(48, 22),
			Theme.Font.Title,
			Enum.TextXAlignment.Center
		)
	end

	local rows = {}
	for i, p in ipairs(team.players) do
		local row = Instance.new("Frame")
		row.Size = UDim2.fromOffset(W, 40)
		row.Position = UDim2.fromOffset(0, 148 + (i - 1) * 44)
		row.BackgroundColor3 = if p.human then C.Yellow else (if i % 2 == 0 then C.Blue else C.Navy)
		row.BackgroundTransparency = if p.human then 0 else 0.35
		row.BorderSizePixel = 0
		corner(row, 0.18)
		row.Parent = col
		local ink = if p.human then C.Navy else C.Text
		-- forma numarası rozeti (kulüp renginde)
		local num = Instance.new("Frame")
		num.Size = UDim2.fromOffset(32, 28)
		num.Position = UDim2.fromOffset(6, 6)
		num.BackgroundColor3 = team.club.A
		num.BorderSizePixel = 0
		corner(num, 0.25)
		local ns = Instance.new("UIStroke")
		ns.Color = team.club.B
		ns.Thickness = 1.5
		ns.Parent = num
		num.Parent = row
		local nl = text(
			num,
			tostring(p.number),
			15,
			Color3.new(1, 1, 1),
			UDim2.new(),
			UDim2.fromScale(1, 1),
			Theme.Font.Number,
			Enum.TextXAlignment.Center
		)
		local nst = Instance.new("UIStroke")
		nst.Color = Color3.fromRGB(10, 12, 30)
		nst.Thickness = 1.5
		nst.Parent = nl
		text(
			row,
			if p.human then Theme.Upper(p.name) .. "  (SEN)" else p.name,
			16,
			ink,
			UDim2.fromOffset(50, 0),
			UDim2.fromOffset(208, 40),
			Theme.Font.Title
		)
		text(row, p.role, 13, if p.human then C.Navy else C.Muted, UDim2.fromOffset(262, 0), UDim2.fromOffset(60, 40), Theme.Font.Title)
		text(
			row,
			tostring(p.rating),
			20,
			if p.human then C.Navy else ratingColor(p.rating),
			UDim2.fromOffset(326, 0),
			UDim2.fromOffset(44, 40),
			Theme.Font.Number,
			Enum.TextXAlignment.Center
		)
		for k = 1, 6 do
			text(
				row,
				tostring(p.stats[k]),
				14,
				if p.human then C.Navy else C.Text,
				UDim2.fromOffset(384 + (k - 1) * 52, 0),
				UDim2.fromOffset(48, 40),
				Theme.Font.Number,
				Enum.TextXAlignment.Center
			)
		end
		table.insert(rows, row)
	end
	UIMotion.In(crest, Vector2.new(if home then -60 else 60, 0), 0.1)
	UIMotion.Stagger(rows, Vector2.new(if home then -30 else 30, 0), 0.35)
end

function Lineup.Show(gui: ScreenGui, fixture, onStart: () -> (), onCancel: (() -> ())?)
	local root = Instance.new("Frame")
	root.Name = "Lineup"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color3.fromRGB(6, 11, 36)
	root.BorderSizePixel = 0
	root.ZIndex = 150
	root.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.fromRGB(34, 52, 150), Color3.fromRGB(8, 12, 40))
	grad.Parent = root
	-- tasarım 1600x900; ortalanır
	local stage = Instance.new("Frame")
	stage.BackgroundTransparency = 1
	stage.AnchorPoint = Vector2.new(0.5, 0.5)
	stage.Position = UDim2.fromScale(0.5, 0.5)
	stage.Size = UDim2.fromOffset(1560, 860)
	stage.Parent = root

	local top = text(
		stage,
		Theme.Upper(string.format("%s  ·  %d. MAÇ  ·  %s", fixture.league, fixture.matchNo, fixture.stadium)),
		16,
		C.Yellow,
		UDim2.fromOffset(0, 8),
		UDim2.new(1, 0, 0, 24),
		Theme.Font.Title,
		Enum.TextXAlignment.Center
	)
	local title = text(
		stage,
		"MAÇ ÖNCESİ",
		34,
		C.White,
		UDim2.fromOffset(0, 34),
		UDim2.new(1, 0, 0, 44),
		Theme.Font.Display,
		Enum.TextXAlignment.Center
	)
	UIMotion.In(top, Vector2.new(0, -20))
	UIMotion.In(title, Vector2.new(0, -20), 0.05)

	side(stage, fixture.home, 20, true)
	side(stage, fixture.away, 840, false)

	local vs = text(
		stage,
		"VS",
		54,
		C.Yellow,
		UDim2.new(0.5, -60, 0, 116),
		UDim2.fromOffset(120, 70),
		Theme.Font.Display,
		Enum.TextXAlignment.Center
	)
	UIMotion.Pop(vs, 1.8)

	local function close(fn: (() -> ())?)
		UIMotion.Wipe(function()
			root:Destroy()
			if fn then
				fn()
			end
		end)
	end
	local go = Components.Button({
		Text = "Maça çık",
		Style = "Primary",
		Sub = "Santra ile başlar",
		Size = UDim2.fromOffset(320, 64),
		OnClick = function()
			close(onStart)
		end,
	})
	go.AnchorPoint = Vector2.new(0.5, 1)
	go.Position = UDim2.new(0.5, 90, 1, -6)
	go.Parent = stage
	local back = Components.Button({
		Text = "Geri",
		Style = "Ghost",
		Size = UDim2.fromOffset(160, 64),
		OnClick = function()
			close(onCancel)
		end,
	})
	back.AnchorPoint = Vector2.new(0.5, 1)
	back.Position = UDim2.new(0.5, -164, 1, -6)
	back.Parent = stage
	UIMotion.In(go, Vector2.new(0, 30), 0.9)
	UIMotion.In(back, Vector2.new(0, 30), 0.95)
	return root
end

return Lineup
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">SkillTree</string><ProtectedString name="Source"><![CDATA[--[[
	SkillTree
	Yetenek ağacı sayfası. Solda zincirler (Şut, Çalım, Hava, Defans, kaleciyse Kaleci): her zincirde
	hareketler sırayla açılır ve aynı tuş, açılan en üst hareketi oynatır. Sağda özellikler
	(hız, top kontrolü, pas, şut, defans, fizik) bakiye ile yükseltilir.

	SkillTree.Open(gui, getData)   sayfayı açar
	SkillTree.Refresh()            veri değişince yeniden çizer (açıksa)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Components = require(ReplicatedStorage.UI.Components)
local Theme = require(ReplicatedStorage.UI.Theme)
local UIMotion = require(ReplicatedStorage.UI.UIMotion)

local SkillTree = {}

local C = Theme.Color
local open: { root: Frame, body: Frame, getData: () -> any, coins: TextLabel, level: TextLabel }? = nil

local function corner(o: Instance, r: number)
	local u = Instance.new("UICorner")
	u.CornerRadius = UDim.new(0, r)
	u.Parent = o
end

local function stroke(o: Instance, color: Color3, thickness: number, tr: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = o
	return s
end

local function text(
	parent: Instance,
	str: string,
	size: number,
	color: Color3,
	pos: UDim2,
	frame: UDim2,
	font: Font?,
	align: Enum.TextXAlignment?
)
	local l = Components.Label({ Text = str, Size = size, Color = color, Font = font or Theme.Font.Body, Frame = frame, Align = align })
	l.Position = pos
	l.Parent = parent
	return l
end

local DARK = Color3.fromRGB(16, 24, 70)
local STAT_INFO = {
	Hiz = "Koşu ve sprint hızı",
	TopKontrolu = "Top sürme, ilk dokunuş",
	Pas = "Pas isabeti ve sertliği",
	Sut = "Şut isabeti",
	Defans = "Müdahale başarısı",
	Fizik = "Dayanıklılık, kafa gücü",
}

local function draw()
	if not open then
		return
	end
	local data = open.getData()
	if not data then
		return
	end
	local body = open.body
	for _, child in ipairs(body:GetChildren()) do
		child:Destroy()
	end
	open.coins.Text = Theme.FormatNumber(data.coins or 0)
	open.level.Text = "SEVİYE " .. tostring(data.level or 1)

	-- zincirler
	local chains = {}
	for _, id in ipairs(Config.SkillChainOrder) do
		local chain = Config.SkillChains[id]
		if chain and (not chain.OnlyPosition or chain.OnlyPosition == data.position) then
			table.insert(chains, id)
		end
	end
	local areaW = 900
	local colW = math.floor(areaW / #chains) - 12
	local nodeH, gap = 84, 12
	for ci, id in ipairs(chains) do
		local chain = Config.SkillChains[id]
		local level = Config.SkillLevel(data.skills, id)
		local x = (ci - 1) * (colW + 12)
		text(body, Theme.Upper(chain.Name), 20, C.Yellow, UDim2.fromOffset(x, 0), UDim2.fromOffset(colW, 26), Theme.Font.Display)
		text(body, chain.Hint or "", 11, C.Muted, UDim2.fromOffset(x, 26), UDim2.fromOffset(colW, 16))
		text(
			body,
			string.format("%d / %d", level, #chain.Skills),
			14,
			C.Text,
			UDim2.fromOffset(x, 0),
			UDim2.fromOffset(colW, 26),
			Theme.Font.Number,
			Enum.TextXAlignment.Right
		)
		-- bağlantı çizgisi
		local line = Instance.new("Frame")
		line.BorderSizePixel = 0
		line.BackgroundColor3 = C.Blue
		line.Size = UDim2.fromOffset(4, (#chain.Skills - 1) * (nodeH + gap))
		line.Position = UDim2.fromOffset(x + 24, 52 + nodeH / 2)
		line.Parent = body
		local fill = Instance.new("Frame")
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = C.Yellow
		fill.Size = UDim2.fromOffset(4, math.max(0, level - 1) * (nodeH + gap))
		fill.Parent = line
		for i, sk in ipairs(chain.Skills) do
			local unlocked = i <= level
			local isNext = i == level + 1
			local node = Instance.new("TextButton")
			node.AutoButtonColor = false
			node.Text = ""
			node.Size = UDim2.fromOffset(colW, nodeH)
			node.Position = UDim2.fromOffset(x, 52 + (i - 1) * (nodeH + gap))
			node.BackgroundColor3 = if unlocked then C.Blue elseif isNext then DARK else C.Ground
			node.BackgroundTransparency = if unlocked or isNext then 0 else 0.35
			node.BorderSizePixel = 0
			corner(node, 10)
			local st = stroke(
				node,
				if unlocked then C.Yellow elseif isNext then C.Gold else C.Blue,
				if isNext then 2 else 1.5,
				if unlocked or isNext then 0 else 0.5
			)
			node.Parent = body
			-- sıra rozeti
			local badge = Instance.new("Frame")
			badge.Size = UDim2.fromOffset(34, 34)
			badge.Position = UDim2.fromOffset(8, 8)
			badge.BackgroundColor3 = if unlocked then C.Yellow else DARK
			badge.BorderSizePixel = 0
			corner(badge, 17)
			stroke(badge, if unlocked then C.Navy else C.Blue, 1.5)
			badge.Parent = node
			text(
				badge,
				tostring(i),
				16,
				if unlocked then C.Navy else C.Muted,
				UDim2.new(),
				UDim2.fromScale(1, 1),
				Theme.Font.Number,
				Enum.TextXAlignment.Center
			)
			local ink = if unlocked then C.White elseif isNext then C.Text else C.Muted
			text(node, Theme.Upper(sk.Name), 15, ink, UDim2.fromOffset(50, 8), UDim2.fromOffset(colW - 58, 20), Theme.Font.Title)
			local info = text(
				node,
				sk.Info or "",
				11,
				if unlocked then C.Text else C.Muted,
				UDim2.fromOffset(50, 28),
				UDim2.fromOffset(colW - 58, 28)
			)
			info.TextWrapped = true
			info.TextYAlignment = Enum.TextYAlignment.Top
			local state = if unlocked
				then "AÇIK"
				elseif sk.Level > (data.level or 1) then "SEVİYE " .. sk.Level .. " GEREKLİ"
				else "AÇ  ·  " .. Theme.FormatNumber(sk.Cost)
			local canBuy = isNext and (data.level or 1) >= sk.Level and (data.coins or 0) >= sk.Cost
			local tag = text(
				node,
				state,
				12,
				if unlocked then C.Good elseif canBuy then C.Yellow elseif isNext then C.Gold else C.Muted,
				UDim2.fromOffset(50, nodeH - 24),
				UDim2.fromOffset(colW - 58, 18),
				Theme.Font.Title
			)
			if isNext then
				if canBuy then
					UIMotion.Glow(st, 0, 0.6, 0.9)
				end
				node.Activated:Connect(function()
					if (data.level or 1) < sk.Level then
						Components.Toast("error", sk.Name .. " için seviye " .. sk.Level .. " gerekli.")
						UIMotion.Shake(node)
					elseif (data.coins or 0) < sk.Cost then
						Components.Toast("error", "Bakiye yetersiz. Gereken: " .. Theme.FormatNumber(sk.Cost))
						UIMotion.Shake(node)
					else
						UIMotion.Flash(node)
						UIMotion.Sound("ConfirmSound")
						Remotes.Get("UnlockSkill"):FireServer(id)
					end
				end)
			elseif not unlocked then
				tag.Text = "KİLİTLİ  ·  SV " .. sk.Level
				node.Activated:Connect(function()
					Components.Toast("info", "Önce bir önceki hareketi aç.")
				end)
			end
		end
	end

	-- özellikler
	local sx = areaW + 24
	local sw = 1216 - sx
	text(body, "ÖZELLİKLER", 20, C.Yellow, UDim2.fromOffset(sx, 0), UDim2.fromOffset(sw, 26), Theme.Font.Display)
	text(body, "Bakiye ile yükselt (en çok " .. Config.StatMax .. ")", 11, C.Muted, UDim2.fromOffset(sx, 26), UDim2.fromOffset(sw, 16))
	for i, key in ipairs(Config.Stats) do
		local v = (data.stats and data.stats[key]) or 1
		local y = 52 + (i - 1) * 92
		local card = Instance.new("Frame")
		card.Size = UDim2.fromOffset(sw, 80)
		card.Position = UDim2.fromOffset(sx, y)
		card.BackgroundColor3 = DARK
		card.BorderSizePixel = 0
		corner(card, 10)
		stroke(card, C.Blue, 1.5)
		card.Parent = body
		text(
			card,
			Theme.Upper(Config.StatNames[key]),
			15,
			C.White,
			UDim2.fromOffset(12, 8),
			UDim2.fromOffset(sw - 120, 20),
			Theme.Font.Title
		)
		text(card, STAT_INFO[key] or "", 11, C.Muted, UDim2.fromOffset(12, 28), UDim2.fromOffset(sw - 120, 16))
		text(
			card,
			tostring(v),
			26,
			C.Yellow,
			UDim2.fromOffset(sw - 196, 6),
			UDim2.fromOffset(80, 30),
			Theme.Font.Number,
			Enum.TextXAlignment.Right
		)
		-- 10 bölmeli çubuk
		for k = 1, Config.StatMax do
			local seg = Instance.new("Frame")
			seg.Size = UDim2.fromOffset((sw - 124 - (Config.StatMax - 1) * 3) / Config.StatMax, 10)
			seg.Position = UDim2.fromOffset(12 + (k - 1) * ((sw - 124) / Config.StatMax), 56)
			seg.BackgroundColor3 = if k <= v then C.Yellow else C.Ground
			seg.BorderSizePixel = 0
			corner(seg, 3)
			seg.Parent = card
		end
		local maxed = v >= Config.StatMax
		local cost = if maxed then 0 else Config.StatCost(v)
		local b = Components.Button({
			Text = if maxed then "TAM" else "+ " .. Theme.FormatNumber(cost),
			Style = if maxed then "Ghost" elseif (data.coins or 0) >= cost then "Primary" else "Secondary",
			TextSize = 15,
			Size = UDim2.fromOffset(96, 44),
			OnClick = function()
				if maxed then
					return
				end
				if (data.coins or 0) < cost then
					Components.Toast("error", "Bakiye yetersiz. Gereken: " .. Theme.FormatNumber(cost))
					return
				end
				Remotes.Get("UpgradeStat"):FireServer(key)
			end,
		})
		b.Position = UDim2.fromOffset(sw - 106, 18)
		b.Parent = card
	end
end

function SkillTree.Refresh()
	if open then
		draw()
	end
end

function SkillTree.Close()
	if not open then
		return
	end
	local root = open.root
	open = nil
	UIMotion.Out(root, Vector2.new(0, 20), true)
end

function SkillTree.Open(gui: ScreenGui, getData: () -> any)
	if open then
		return
	end
	local dim = Instance.new("TextButton")
	dim.Name = "SkillTree"
	dim.AutoButtonColor = false
	dim.Text = ""
	dim.BackgroundColor3 = C.Ground
	dim.BackgroundTransparency = 0.25
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.ZIndex = 120
	dim.Parent = gui
	local panel, content = Components.Panel({
		Name = "SkillPanel",
		Size = UDim2.fromOffset(1280, 760),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Title = "Yetenek Ağacı",
	})
	panel.ZIndex = 121
	panel.Parent = dim
	local coinsCap = text(
		content,
		"BAKİYE",
		11,
		C.Muted,
		UDim2.new(1, -520, 0, 0),
		UDim2.fromOffset(120, 14),
		Theme.Font.Title,
		Enum.TextXAlignment.Right
	)
	coinsCap.Name = "CoinsCap"
	local coins =
		text(content, "0", 22, C.Yellow, UDim2.new(1, -520, 0, 12), UDim2.fromOffset(120, 24), Theme.Font.Number, Enum.TextXAlignment.Right)
	local level = text(
		content,
		"SEVİYE 1",
		16,
		C.Text,
		UDim2.new(1, -380, 0, 8),
		UDim2.fromOffset(140, 24),
		Theme.Font.Title,
		Enum.TextXAlignment.Right
	)
	local closeB =
		Components.Button({ Text = "Kapat", Style = "Ghost", TextSize = 15, Size = UDim2.fromOffset(120, 38), OnClick = SkillTree.Close })
	closeB.AnchorPoint = Vector2.new(1, 0)
	closeB.Position = UDim2.new(1, -80, 0, -2)
	closeB.Parent = content
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(0, 50)
	body.Size = UDim2.new(1, 0, 1, -50)
	body.Parent = content
	open = { root = dim, body = body, getData = getData, coins = coins, level = level }
	draw()
	UIMotion.In(panel, Vector2.new(0, 30))
end

return SkillTree
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="StarterCharacterScripts" referent="RBX44"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="LocalScript" referent="RBX43"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[--[[
	Animate (boş)
	Bu ad, Roblox'un varsayılan "Animate" betiğinin yerine geçer: hazır yürüme/koşma animasyonları
	hiç yüklenmez. Bütün hareketler Client/Anim/Animator tarafından eklemlere doğrudan yazılır.
]]
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterGui" referent="RBX46"><Properties><string name="Name">StarterGui</string><token name="ScreenOrientation">2</token></Properties></Item>
<Item class="Workspace" referent="RBX47"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item>
