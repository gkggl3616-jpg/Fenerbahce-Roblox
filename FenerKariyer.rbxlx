</Item>
<Item class="ServerScriptService" referent="RBX19"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX18"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">CharacterService</string><ProtectedString name="Source"><![CDATA[--[[
	CharacterService
	Karakterin görünümünü sunucuda uygular: gövde ölçüleri, ten, saç, forma, isim ve numara, aksesuarlar.
	Ayrıca karakter oluşturma ekranı için küçük bir stüdyo sahnesi kurar.
	Not: Gerçekçi gövde için Config.Body.Parts içine bir gövde paketi kimliği yazılmalıdır;
	boşsa oyuncunun kendi Roblox avatar gövdesi insan oranlarına ölçeklenir.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Kits = require(ReplicatedStorage.Shared.Kits)
local Crest = require(ReplicatedStorage.Shared.Crest)

local CharacterService = {}

local C = Config.Colors
local busy: { [Player]: boolean } = {}
local queued: { [Player]: any } = {}

local function hex(h: string): Color3
	local ok, c = pcall(Color3.fromHex, h)
	return if ok then c else Color3.new(0.1, 0.1, 0.1)
end

local function clear(character: Model, name: string)
	for _, d in ipairs(character:GetDescendants()) do
		if d.Name == name then
			d:Destroy()
		end
	end
end

local function weldPart(character: Model, to: BasePart, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?)
	local p = Instance.new("Part")
	p.Name = "FK_Extra"
	p.Size = size
	p.Shape = shape or Enum.PartType.Block
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = to.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = p
	w.Parent = p
	p.Parent = character
	return p
end

local function surface(part: BasePart, face: Enum.NormalId): SurfaceGui
	local sg = Instance.new("SurfaceGui")
	sg.Name = "FK_Kit"
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(200, 200)
	sg.LightInfluence = 1
	sg.Parent = part
	return sg
end

local function text(parent: Instance, str: string, size: UDim2, pos: UDim2, color: Color3, strokeColor: Color3)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Text = str
	l.TextScaled = true
	l.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy)
	l.TextColor3 = color
	local s = Instance.new("UIStroke")
	s.Color = strokeColor
	s.Thickness = 3
	s.Parent = l
	l.Parent = parent
	return l
end

-- Forma desenini gövdenin ön ve arka yüzüne çizer
local function paintTorso(torso: BasePart, kit, name: string, number: number, abbr: string, crest: any?)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = surface(torso, face)
		if kit.Pattern == "Cubuklu" then
			for i = 0, 4 do
				if i % 2 == 1 then
					local f = Instance.new("Frame")
					f.BorderSizePixel = 0
					f.BackgroundColor3 = kit.Stripe
					f.Size = UDim2.fromScale(0.2, 1)
					f.Position = UDim2.fromScale(i * 0.2, 0)
					f.Parent = sg
				end
			end
		elseif kit.Pattern == "Kusakli" then
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = kit.Stripe
			f.Size = UDim2.fromScale(1, 0.22)
			f.Position = UDim2.fromScale(0, 0.3)
			f.Parent = sg
			local t = Instance.new("Frame")
			t.BorderSizePixel = 0
			t.BackgroundColor3 = kit.Trim
			t.Size = UDim2.fromScale(1, 0.04)
			t.Position = UDim2.fromScale(0, 0.52)
			t.Parent = sg
		end
		-- yaka
		local collar = Instance.new("Frame")
		collar.BorderSizePixel = 0
		collar.BackgroundColor3 = kit.Trim
		collar.Size = UDim2.fromScale(0.36, 0.06)
		collar.Position = UDim2.fromScale(0.32, 0)
		collar.Parent = sg
		if face == Enum.NormalId.Back then
			if name ~= "" then
				text(sg, string.upper(name), UDim2.fromScale(0.9, 0.16), UDim2.fromScale(0.05, 0.1), kit.Ink, kit.InkStroke)
			end
			text(sg, tostring(number), UDim2.fromScale(0.7, 0.58), UDim2.fromScale(0.15, 0.28), kit.Ink, kit.InkStroke)
		else
			-- göğüs: arma (yüklenmişse) ya da kulüp kısaltmalı kalkan, karşı tarafta küçük numara
			if Config.Assets.Crest ~= "" and abbr == "" then
				local img = Instance.new("ImageLabel")
				img.BackgroundTransparency = 1
				img.Image = Config.Assets.Crest
				img.Size = UDim2.fromScale(0.24, 0.24)
				img.Position = UDim2.fromScale(0.12, 0.14)
				img.Parent = sg
			else
				-- kulüp arması (oyuncunun tasarımı ya da varsayılan); maçta istemci bunu kulübe göre yeniden çizer
				local holder = Instance.new("Frame")
				holder.Name = "FK_Crest"
				holder.BackgroundTransparency = 1
				holder.Size = UDim2.fromScale(0.24, 0.24)
				holder.Position = UDim2.fromScale(0.12, 0.13)
				holder.Parent = sg
				Crest.Fill(holder, crest or Crest.Default(), if abbr ~= "" then abbr else "FB")
			end
			text(sg, tostring(number), UDim2.fromScale(0.2, 0.2), UDim2.fromScale(0.66, 0.15), kit.Ink, kit.InkStroke)
		end
	end
end

local function color(character: Model, names: { string }, c: Color3)
	for _, n in ipairs(names) do
		local p = character:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			p.Color = c
			p.Material = Enum.Material.SmoothPlastic
		end
	end
end

-- Yuvarlak hacim: her ölçüde elips çizen küre ağı (saç, burun, kulak için)
local function blob(character: Model, to: BasePart, size: Vector3, offset: CFrame, c: Color3): BasePart
	local p = weldPart(character, to, size, offset, c)
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	return p
end

-- Saç: başın ölçüsüne göre birkaç yuvarlak hacimden kurulur (ön = -Z, yüzün olduğu taraf)
local function hair(character: Model, head: BasePart, style: number, c: Color3)
	local s = head.Size
	local w, h = math.max(s.X, s.Z), s.Y
	local function lock(sx: number, sy: number, sz: number, x: number, y: number, z: number): BasePart
		return blob(character, head, Vector3.new(w * sx, h * sy, w * sz), CFrame.new(w * x, h * y, w * z), c)
	end
	if style == 1 then
		lock(1.03, 0.62, 1.03, 0, 0.24, 0.03).Transparency = 0.2 -- sıfıra yakın
	elseif style == 2 then
		lock(1.08, 0.66, 1.1, 0, 0.27, 0.05) -- kısa
		lock(0.9, 0.3, 0.5, 0, 0.42, -0.3) -- perçem
	elseif style == 3 then
		lock(1.12, 0.8, 1.12, 0, 0.3, 0.05) -- hacimli
		lock(0.8, 0.5, 0.6, 0, 0.52, -0.26)
	elseif style == 4 then
		lock(1.1, 0.7, 1.12, 0, 0.27, 0.06) -- uzun: enseye iner
		lock(1.06, 1.0, 0.5, 0, -0.1, 0.38)
	elseif style == 5 then
		lock(1.1, 0.7, 1.1, 0, 0.28, 0.05) -- kıvırcık: çevrede bukleler
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			lock(0.42, 0.34, 0.42, math.sin(a) * 0.42, 0.44, 0.04 + math.cos(a) * 0.42)
		end
		lock(0.5, 0.36, 0.5, 0, 0.6, 0.02)
	elseif style == 6 then
		lock(1.08, 0.66, 1.1, 0, 0.27, 0.05) -- topuz
		lock(0.44, 0.4, 0.44, 0, 0.5, 0.44)
	elseif style == 7 then
		lock(1.03, 0.56, 1.03, 0, 0.2, 0.03).Transparency = 0.25 -- yanlar kısa
		lock(0.56, 0.5, 1.02, 0, 0.47, 0.0) -- üstte uzun şerit
	end
end

-- Yüz: gözler, kaşlar, ağız ve sakal başın ön yüzüne çizilir
local function paintFace(head: BasePart, face: number, beard: number, hairColor: Color3, skin: Color3)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "FK_Kit"
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(200, 200)
	sg.LightInfluence = 1
	sg.Parent = head
	local function shape(size: UDim2, pos: UDim2, c: Color3, round: number, rot: number?, tr: number?): Frame
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = size
		f.Position = pos
		f.BackgroundColor3 = c
		f.BackgroundTransparency = tr or 0
		f.BorderSizePixel = 0
		f.Rotation = rot or 0
		local u = Instance.new("UICorner")
		u.CornerRadius = UDim.new(round, 0)
		u.Parent = f
		f.Parent = sg
		return f
	end
	local dark = Color3.fromRGB(26, 22, 20)
	local v = (math.max(1, face) - 1) % 6
	-- sakal önce çizilir (ağız üstte kalsın)
	if beard >= 1 then
		local tr = if beard == 1 then 0.55 elseif beard == 2 then 0.25 else 0.05
		shape(UDim2.fromScale(0.74, 0.34), UDim2.fromScale(0.5, 0.84), hairColor, 0.45, 0, tr)
		if beard >= 2 then
			shape(UDim2.fromScale(0.36, 0.07), UDim2.fromScale(0.5, 0.63), hairColor, 0.5, 0, tr) -- bıyık
		end
	end
	local browTilt = ({ 0, 8, -6, 12, 4, -10 })[v + 1]
	local eyeH = ({ 0.1, 0.085, 0.11, 0.075, 0.095, 0.1 })[v + 1]
	for _, sx in ipairs({ -1, 1 }) do
		local x = 0.5 + sx * 0.17
		shape(UDim2.fromScale(0.17, eyeH), UDim2.fromScale(x, 0.43), Color3.fromRGB(246, 246, 240), 0.5)
		shape(UDim2.fromScale(0.075, eyeH * 0.92), UDim2.fromScale(x + sx * 0.005, 0.43), dark, 0.5)
		shape(UDim2.fromScale(0.2, 0.035), UDim2.fromScale(x, 0.43 - eyeH * 0.5 - 0.04), hairColor:Lerp(dark, 0.5), 0.5, sx * browTilt)
	end
	-- burun gölgesi ve ağız
	shape(UDim2.fromScale(0.05, 0.12), UDim2.fromScale(0.5, 0.53), skin:Lerp(dark, 0.22), 0.5)
	local mouthW = ({ 0.24, 0.2, 0.28, 0.18, 0.26, 0.22 })[v + 1]
	shape(UDim2.fromScale(mouthW, 0.03), UDim2.fromScale(0.5, 0.71), Color3.fromRGB(120, 60, 52), 0.5)
end

--[[
	look = {
		appearance = {...}, position, kitPattern, number, name, abbr, atFenerbahce, level
	}
]]
local function dress(character: Model?, look)
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not hum or not character:IsDescendantOf(Workspace) then
		return
	end
	local a = look.appearance
	local B = Config.Body
	local skin = Config.SkinColors[a.skin] or Config.SkinColors[2]

	-- Herkes aynı varsayılan gövdeyle başlar: oyuncunun kendi Roblox avatarı (paket gövdeler,
	-- şapkalar, kıyafetler) kullanılmaz. Boş tanım, standart R15 gövdesini verir.
	local desc = Instance.new("HumanoidDescription")
	for key, id in pairs(B.Parts) do
		if id ~= 0 then
			(desc :: any)[key] = id
		end
	end
	local h = math.clamp((a.height - Config.Appearance.HeightMin) / (Config.Appearance.HeightMax - Config.Appearance.HeightMin), 0, 1)
	desc.HeightScale = B.HeightScaleMin + (B.HeightScaleMax - B.HeightScaleMin) * h
	desc.BodyTypeScale = B.BodyTypeScale
	desc.ProportionScale = B.ProportionScale
	desc.HeadScale = B.HeadScale
	desc.WidthScale = B.Width[a.build] or B.Width.Atletik
	desc.DepthScale = B.Width[a.build] or B.Width.Atletik
	desc.HeadColor = skin
	desc.TorsoColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.LeftLegColor = skin
	desc.RightLegColor = skin
	local ok = pcall(function()
		hum:ApplyDescription(desc)
	end)
	if not ok then
		-- gövde paketi yüklenemedi: standart gövdeyle yeniden dene
		for key in pairs(B.Parts) do
			(desc :: any)[key] = 0
		end
		ok = pcall(function()
			hum:ApplyDescription(desc)
		end)
	end
	if not ok or not character.Parent then
		return
	end

	clear(character, "FK_Extra")
	clear(character, "FK_Kit")
	-- avatardan kalan her şeyi temizle
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("CharacterMesh") then
			d:Destroy()
		elseif d:IsA("Decal") and d.Parent and d.Parent.Name == "Head" then
			d:Destroy() -- hazır yüz çıkartması; yüzü kendimiz çiziyoruz
		end
	end

	local kit = look.kit or Kits.For(look.position, look.kitPattern, look.atFenerbahce)
	local acc = a.accessories or {}
	color(character, { "UpperTorso" }, kit.Shirt)
	color(character, { "LowerTorso", "LeftUpperLeg", "RightUpperLeg" }, kit.Shorts)
	color(character, { "LeftUpperArm", "RightUpperArm" }, kit.Sleeve)
	local keeper = look.position == "Kaleci"
	local long = acc.UzunKol or keeper
	color(character, { "LeftLowerArm", "RightLowerArm" }, if long then kit.Sleeve else skin)
	color(character, { "LeftHand", "RightHand" }, if keeper then Color3.fromRGB(242, 242, 242) else skin)
	color(character, { "LeftLowerLeg", "RightLowerLeg" }, kit.Sock)
	color(character, { "LeftFoot", "RightFoot" }, hex(a.bootColor))
	color(character, { "Head" }, skin)

	local torso = character:FindFirstChild("UpperTorso")
	if torso and torso:IsA("BasePart") then
		paintTorso(torso, kit, look.name or "", look.number or 9, if look.atFenerbahce then "" else (look.abbr or ""), look.crest)
	end

	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		paintFace(head, a.face or 1, a.beard or 0, hex(a.hairColor), skin)
		-- burun ve kulaklar (yüze derinlik verir)
		local hs = head.Size
		local hw = math.max(hs.X, hs.Z)
		blob(
			character,
			head,
			Vector3.new(hw * 0.15, hs.Y * 0.2, hw * 0.16),
			CFrame.new(0, -hs.Y * 0.04, -hw * 0.5),
			skin:Lerp(Color3.new(0, 0, 0), 0.06)
		)
		for _, sx in ipairs({ -1, 1 }) do
			blob(character, head, Vector3.new(hw * 0.1, hs.Y * 0.22, hw * 0.18), CFrame.new(sx * hw * 0.51, hs.Y * 0.02, hw * 0.02), skin)
		end
		hair(character, head, a.hairStyle, hex(a.hairColor))
		if acc.SacBandi then
			local s = head.Size
			weldPart(
				character,
				head,
				Vector3.new(0.14, s.Z * 1.06, s.X * 1.06),
				CFrame.new(0, s.Y * 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
				C.Yellow,
				Enum.PartType.Cylinder
			)
		end
	end
	-- tozluk üst bandı
	for _, n in ipairs({ "LeftLowerLeg", "RightLowerLeg" }) do
		local leg = character:FindFirstChild(n)
		if leg and leg:IsA("BasePart") then
			local y = if acc.KisaTozluk then 0 else leg.Size.Y * 0.38
			weldPart(character, leg, Vector3.new(leg.Size.X * 1.06, leg.Size.Y * 0.14, leg.Size.Z * 1.06), CFrame.new(0, y, 0), kit.Trim)
			if acc.KisaTozluk then
				weldPart(
					character,
					leg,
					Vector3.new(leg.Size.X * 1.03, leg.Size.Y * 0.46, leg.Size.Z * 1.03),
					CFrame.new(0, leg.Size.Y * 0.28, 0),
					skin
				)
			end
		end
	end
	-- kol ağzı bandı
	for _, n in ipairs({ "LeftUpperArm", "RightUpperArm" }) do
		local arm = character:FindFirstChild(n)
		if arm and arm:IsA("BasePart") then
			weldPart(
				character,
				arm,
				Vector3.new(arm.Size.X * 1.08, arm.Size.Y * 0.12, arm.Size.Z * 1.08),
				CFrame.new(0, -arm.Size.Y * 0.42, 0),
				kit.Trim
			)
		end
	end
	if acc.Bileklik then
		local la = character:FindFirstChild("RightLowerArm")
		if la and la:IsA("BasePart") then
			weldPart(
				character,
				la,
				Vector3.new(la.Size.X * 1.1, la.Size.Y * 0.16, la.Size.Z * 1.1),
				CFrame.new(0, -la.Size.Y * 0.36, 0),
				C.Yellow
			)
		end
	end
	if (look.level or 1) >= Config.CaptainBandLevel then
		local ua = character:FindFirstChild("LeftUpperArm")
		if ua and ua:IsA("BasePart") then
			weldPart(
				character,
				ua,
				Vector3.new(ua.Size.X * 1.12, ua.Size.Y * 0.2, ua.Size.Z * 1.12),
				CFrame.new(0, -ua.Size.Y * 0.1, 0),
				C.Gold
			)
		end
	end
	-- yaka ve krampon tabanı
	if torso and torso:IsA("BasePart") then
		local ts = torso.Size
		weldPart(character, torso, Vector3.new(ts.X * 0.46, ts.Y * 0.08, ts.Z * 1.04), CFrame.new(0, ts.Y * 0.47, 0), kit.Trim)
	end
	for _, n in ipairs({ "LeftFoot", "RightFoot" }) do
		local foot = character:FindFirstChild(n)
		if foot and foot:IsA("BasePart") then
			local fs = foot.Size
			weldPart(
				character,
				foot,
				Vector3.new(fs.X * 1.04, fs.Y * 0.22, fs.Z * 1.06),
				CFrame.new(0, -fs.Y * 0.42, 0),
				Color3.fromRGB(240, 240, 240)
			)
			weldPart(character, foot, Vector3.new(fs.X * 0.3, fs.Y * 0.2, fs.Z * 0.7), CFrame.new(0, fs.Y * 0.42, -fs.Z * 0.1), C.Yellow)
		end
	end
	-- şort kenar şeridi
	for _, n in ipairs({ "LeftUpperLeg", "RightUpperLeg" }) do
		local leg = character:FindFirstChild(n)
		if leg and leg:IsA("BasePart") then
			weldPart(
				character,
				leg,
				Vector3.new(leg.Size.X * 1.07, leg.Size.Y * 0.1, leg.Size.Z * 1.07),
				CFrame.new(0, -leg.Size.Y * 0.36, 0),
				kit.Trim
			)
		end
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
end

local function applyNow(player: Player, look)
	dress(player.Character, look)
end

-- Bot şablonları: rakip, rakip kaleci ve takım arkadaşı. Sunucu bir kez kurar, istemci kopyalayıp sahada kullanır.
function CharacterService.BuildBotTemplates()
	local ReplicatedStorageRef = game:GetService("ReplicatedStorage")
	local Players = game:GetService("Players")
	if ReplicatedStorageRef:FindFirstChild("FK_BotTemplates") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "FK_BotTemplates"
	local defs = {
		{ Name = "Rival", Kit = Kits.Rival, Position = "Defans", Number = 4, Skin = 3, Hair = 2 },
		{ Name = "Rival2", Kit = Kits.Rival, Position = "Defans", Number = 5, Skin = 1, Hair = 3 },
		{ Name = "RivalAttacker", Kit = Kits.Rival, Position = "Forvet", Number = 9, Skin = 5, Hair = 1 },
		{ Name = "RivalKeeper", Kit = Kits.RivalKeeper, Position = "Kaleci", Number = 1, Skin = 2, Hair = 2 },
		{ Name = "Mate", Kit = Kits.Club.Cubuklu, Position = "OrtaSaha", Number = 10, Skin = 4, Hair = 3 },
		{ Name = "Mate2", Kit = Kits.Club.Cubuklu, Position = "OrtaSaha", Number = 8, Skin = 2, Hair = 2 },
		{ Name = "MateKeeper", Kit = Kits.Keeper, Position = "Kaleci", Number = 1, Skin = 3, Hair = 1 },
		{ Name = "Referee", Kit = Kits.Referee, Position = "OrtaSaha", Number = 0, Skin = 2, Hair = 2 },
	}
	for i, d in ipairs(defs) do
		local ok, rig = pcall(function()
			return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
		end)
		if ok and rig then
			rig.Name = d.Name
			local hrp = rig:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") then
				hrp.Anchored = true
			end
			rig:PivotTo(CFrame.new(i * 12, -150, 0))
			rig.Parent = Workspace
			local okDress, err = pcall(dress, rig, {
				appearance = {
					height = 176 + i * 3,
					build = "Atletik",
					skin = d.Skin,
					face = 1,
					hairStyle = d.Hair,
					hairColor = Config.HairColors[(i % #Config.HairColors) + 1],
					beard = 0,
					bootModel = 1,
					bootColor = "1A1A1A",
					accessories = {},
				},
				position = d.Position,
				kit = d.Kit,
				number = d.Number,
				name = if d.Name == "Referee" then "HAKEM" elseif d.Name == "Mate" then "TAKIM" else "RAKIP",
				abbr = "RK",
				level = 1,
			})
			if not okDress then
				warn("[CharacterService] bot giydirilemedi: " .. tostring(err))
			end
			for _, sc in ipairs(rig:GetDescendants()) do
				if sc:IsA("LuaSourceContainer") then
					sc:Destroy()
				end
			end
			rig.Parent = folder
		else
			warn("[CharacterService] bot şablonu oluşturulamadı: " .. tostring(rig))
		end
	end
	folder.Parent = ReplicatedStorageRef
end

-- Art arda gelen istekleri sıraya koyar: aynı anda tek uygulama, en son istek kazanır
function CharacterService.Apply(player: Player, look)
	queued[player] = look
	if busy[player] then
		return
	end
	busy[player] = true
	task.spawn(function()
		while queued[player] do
			local l = queued[player]
			queued[player] = nil
			local ok, err = pcall(applyNow, player, l)
			if not ok then
				warn("[CharacterService] " .. tostring(err))
			end
		end
		busy[player] = nil
	end)
end

function CharacterService.LookFromData(data)
	return {
		appearance = data.appearance,
		position = data.position,
		kitPattern = data.club.kitPattern,
		number = data.number,
		name = data.name,
		abbr = data.club.abbr,
		crest = data.club.crest,
		atFenerbahce = data.career.atFenerbahce,
		level = data.level,
	}
end

-- Karakter oluşturma ekranı ve ilk doğma için stüdyo sahnesi
function CharacterService.BuildStudio()
	if Workspace:FindFirstChild("FK_Studio") then
		return
	end
	local m = Instance.new("Model")
	m.Name = "FK_Studio"
	local function part(size: Vector3, cf: CFrame, c: Color3, material: Enum.Material?)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = c
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.Parent = m
		return p
	end
	part(Vector3.new(80, 1, 80), CFrame.new(0, -0.5, 0), Color3.fromRGB(14, 26, 85))
	-- Stüdyonun önünde deneme çimi (hareket ve animasyonları sınamak için)
	local grass = part(Vector3.new(240, 1, 160), CFrame.new(0, -0.52, 120), Color3.fromRGB(47, 143, 67), Enum.Material.Grass)
	grass.Name = "TestPitch"
	for i = -5, 5 do
		if i % 2 == 0 then
			part(Vector3.new(21.8, 0.02, 160), CFrame.new(i * 21.8, -0.01, 120), Color3.fromRGB(56, 158, 78), Enum.Material.Grass).CanCollide =
				false
		end
	end
	local disc = part(Vector3.new(0.2, 14, 14), CFrame.new(0, 0.02, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Navy)
	disc.Shape = Enum.PartType.Cylinder
	local ring = part(Vector3.new(0.22, 14.6, 14.6), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Yellow, Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	-- arka duvar: lacivert zemin üstünde ince sarı çubuklar
	part(Vector3.new(80, 30, 1), CFrame.new(0, 15, -22), Color3.fromRGB(10, 18, 56))
	for i = -9, 9 do
		part(Vector3.new(0.5, 30, 0.2), CFrame.new(i * 4, 15, -21.4), if i % 2 == 0 then C.Yellow else C.Blue).Transparency = 0.55
	end
	-- Deneme sahası: kale, çizgiler, pas mankenleri
	local T = Config.TestPitch
	local white = Color3.fromRGB(245, 245, 245)
	local function post(size: Vector3, cf: CFrame)
		local p = part(size, cf, white)
		p.Shape = Enum.PartType.Cylinder
		p.Material = Enum.Material.Metal
		return p
	end
	local gw, gh, gz = T.GoalHalfWidth, T.GoalHeight, T.GoalZ
	post(Vector3.new(gh, 0.5, 0.5), CFrame.new(-gw, gh / 2, gz) * CFrame.Angles(0, 0, math.rad(90)))
	post(Vector3.new(gh, 0.5, 0.5), CFrame.new(gw, gh / 2, gz) * CFrame.Angles(0, 0, math.rad(90)))
	post(Vector3.new(gw * 2 + 0.5, 0.5, 0.5), CFrame.new(0, gh, gz))
	local function net(size: Vector3, cf: CFrame)
		local p = part(size, cf, white, Enum.Material.ForceField)
		p.Name = "Net"
		p.Transparency = 0.6
		p.CanCollide = false
		return p
	end
	net(Vector3.new(gw * 2, gh, 0.1), CFrame.new(0, gh / 2, gz + 5))
	net(Vector3.new(0.1, gh, 5), CFrame.new(-gw, gh / 2, gz + 2.5))
	net(Vector3.new(0.1, gh, 5), CFrame.new(gw, gh / 2, gz + 2.5))
	net(Vector3.new(gw * 2, 0.1, 5), CFrame.new(0, gh, gz + 2.5))
	local function line(size: Vector3, pos: Vector3)
		local p = part(size, CFrame.new(pos), white)
		p.CanCollide = false
		p.Material = Enum.Material.SmoothPlastic
		return p
	end
	line(Vector3.new(236, 0.04, 0.4), Vector3.new(0, 0, gz)) -- kale çizgisi
	line(Vector3.new(132, 0.04, 0.4), Vector3.new(0, 0, gz - 54)) -- ceza sahası
	line(Vector3.new(0.4, 0.04, 54), Vector3.new(-66, 0, gz - 27))
	line(Vector3.new(0.4, 0.04, 54), Vector3.new(66, 0, gz - 27))
	line(Vector3.new(60, 0.04, 0.4), Vector3.new(0, 0, gz - 18)) -- altı pas
	line(Vector3.new(0.4, 0.04, 18), Vector3.new(-30, 0, gz - 9))
	line(Vector3.new(0.4, 0.04, 18), Vector3.new(30, 0, gz - 9))
	line(Vector3.new(1, 0.05, 1), Vector3.new(0, 0, gz - 36)) -- penaltı noktası
	for i, x in ipairs({ -34, 0, 34 }) do
		local d = part(Vector3.new(2, 5.6, 0.5), CFrame.new(x, 2.8, gz - 62 - (i % 2) * 14), C.Yellow)
		d.Name = "PassTarget"
		d.CanCollide = false
		part(Vector3.new(1.3, 1.3, 0.5), CFrame.new(x, 6.2, gz - 62 - (i % 2) * 14), C.Navy).CanCollide = false
	end

	local function light(pos: Vector3, c: Color3, brightness: number)
		local p = part(Vector3.new(1, 1, 1), CFrame.new(pos), c)
		p.Transparency = 1
		p.CanCollide = false
		local l = Instance.new("PointLight")
		l.Color = c
		l.Brightness = brightness
		l.Range = 40
		l.Parent = p
	end
	light(Vector3.new(6, 9, 9), Color3.fromRGB(255, 244, 226), 2.2)
	light(Vector3.new(-9, 7, -6), Color3.fromRGB(143, 176, 255), 1.6)
	light(Vector3.new(9, 4, -7), C.Yellow, 0.7)
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(4, 1, 4)
	spawn.CFrame = CFrame.new(0, -0.45, 0) * CFrame.Angles(0, math.pi, 0) -- karakter +Z'ye (kameraya) baksın
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = m
	m.Parent = Workspace
end

-- İki kaleli maç sahası
function CharacterService.BuildMatchPitch()
	if Workspace:FindFirstChild("FK_MatchPitch") then
		return
	end
	local P = Config.MatchPitch
	local m = Instance.new("Model")
	m.Name = "FK_MatchPitch"
	local white = Color3.fromRGB(245, 245, 245)
	local function part(size: Vector3, cf: CFrame, c: Color3, material: Enum.Material?, collide: boolean?)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = c
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.CanCollide = collide ~= false
		p.Parent = m
		return p
	end
	local midZ, len, wid = (P.MinZ + P.MaxZ) / 2, P.MaxZ - P.MinZ, P.MaxX - P.MinX
	part(Vector3.new(wid + 60, 1, len + 70), CFrame.new(0, P.GroundY - 0.5, midZ), Color3.fromRGB(47, 143, 67), Enum.Material.Grass)
	for i = 0, 15 do
		if i % 2 == 0 then
			part(
				Vector3.new(wid, 0.02, len / 16),
				CFrame.new(0, P.GroundY + 0.01, P.MinZ + (i + 0.5) * len / 16),
				Color3.fromRGB(56, 158, 78),
				Enum.Material.Grass,
				false
			)
		end
	end
	local y = P.GroundY + 0.03
	local function line(sx: number, sz: number, x: number, z: number)
		part(Vector3.new(sx, 0.04, sz), CFrame.new(x, y, z), white, nil, false)
	end
	line(wid, 0.4, 0, P.MinZ)
	line(wid, 0.4, 0, P.MaxZ)
	line(0.4, len, P.MinX, midZ)
	line(0.4, len, P.MaxX, midZ)
	line(wid, 0.4, 0, midZ)
	-- orta daire (24 parçalı çokgen)
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		part(
			Vector3.new(7.9, 0.04, 0.4),
			CFrame.new(math.cos(a) * 30, y, midZ + math.sin(a) * 30) * CFrame.Angles(0, -a + math.pi / 2, 0),
			white,
			nil,
			false
		)
	end
	line(1.2, 1.2, 0, midZ)
	local gw, gh = P.GoalHalfWidth, P.GoalHeight
	for _, e in ipairs({ { P.MinZ, 1 }, { P.MaxZ, -1 } }) do
		local gz, d = e[1], e[2] -- d: sahanın içine doğru yön
		line(132, 0.4, 0, gz + d * 54)
		line(0.4, 54, -66, gz + d * 27)
		line(0.4, 54, 66, gz + d * 27)
		line(60, 0.4, 0, gz + d * 18)
		line(0.4, 18, -30, gz + d * 9)
		line(0.4, 18, 30, gz + d * 9)
		line(1, 1, 0, gz + d * 36)
		for _, x in ipairs({ -gw, gw }) do
			local p =
				part(Vector3.new(gh, 0.5, 0.5), CFrame.new(x, gh / 2, gz) * CFrame.Angles(0, 0, math.rad(90)), white, Enum.Material.Metal)
			p.Shape = Enum.PartType.Cylinder
		end
		local bar = part(Vector3.new(gw * 2 + 0.5, 0.5, 0.5), CFrame.new(0, gh, gz), white, Enum.Material.Metal)
		bar.Shape = Enum.PartType.Cylinder
		local function net(size: Vector3, cf: CFrame)
			local n = part(size, cf, white, Enum.Material.ForceField, false)
			n.Name = "Net"
			n.Transparency = 0.6
		end
		net(Vector3.new(gw * 2, gh, 0.1), CFrame.new(0, gh / 2, gz - d * 5))
		net(Vector3.new(0.1, gh, 5), CFrame.new(-gw, gh / 2, gz - d * 2.5))
		net(Vector3.new(0.1, gh, 5), CFrame.new(gw, gh / 2, gz - d * 2.5))
		net(Vector3.new(gw * 2, 0.1, 5), CFrame.new(0, gh, gz - d * 2.5))
	end
	-- saha kenarı reklam panoları (sarı-lacivert)
	for i = -4, 4 do
		for _, sx in ipairs({ -1, 1 }) do
			part(
				Vector3.new(0.6, 3, 30),
				CFrame.new(sx * (P.MaxX + 12), 1.5, midZ + i * 34),
				if (i + (if sx > 0 then 1 else 0)) % 2 == 0 then C.Yellow else C.Navy,
				nil,
				false
			)
		end
	end
	m.Parent = Workspace
end

return CharacterService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService
	Oyuncu verisini DataStore'dan yükler ve kaydeder.
	- Oturum kilidi: aynı hesap iki sunucuda aynı anda açılamaz.
	- Her çağrı pcall içinde, hata olursa artan bekleme ile yeniden denenir.
	- Studio'da API erişimi kapalıysa bellekte çalışır (veri kalıcı olmaz).
	- Sıralama için OrderedDataStore'a genel güç yazılır.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store, board
local memoryMode = false
local cache: { [number]: any } = {}

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = deepCopy(v)
	end
	return c
end

-- Yeni oyuncunun verisi
function DataService.Default()
	return {
		version = Config.Version,
		created = false,
		name = "",
		number = 9,
		position = "",
		level = 1,
		xp = 0,
		coins = Config.Economy.StartCoins,
		stats = { Hiz = 1, TopKontrolu = 1, Pas = 1, Sut = 1, Defans = 1, Fizik = 1 },
		skills = {}, -- skills[zincir] = açılan son yeteneğin sırası
		appearance = {
			height = 180,
			build = "Atletik",
			skin = 2,
			face = 1,
			hairStyle = 1,
			hairColor = "1B1410",
			beard = 0,
			bootModel = 1,
			bootColor = "101216",
			accessories = { UzunKol = false, Bileklik = false, SacBandi = false, KisaTozluk = false },
		},
		club = {
			name = "",
			abbr = "",
			crestShape = 1,
			kitPattern = "Cubuklu",
			tier = 1,
			funds = Config.Economy.StartClubFunds,
			facilities = { Cim = 0, TribunEki = 0, Aydinlatma = 0, Soyunma = 0, Antrenman = 0, Saglik = 0 },
			season = { number = 1, played = 0, points = 0 },
		},
		career = { goals = 0, matches = 0, wins = 0, headerGoals = 0, atFenerbahce = false },
		claimedRewards = {},
		session = nil,
	}
end

-- Eksik alanları varsayılanla tamamlar (yeni sürümde alan eklenince eski kayıt bozulmaz)
local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = deepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
	return data
end

local function retry(fn)
	local lastErr
	for attempt = 1, Config.Data.Retries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(0.5 * 2 ^ (attempt - 1))
	end
	return false, lastErr
end

function DataService.Init()
	local ok = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
		board = DataStoreService:GetOrderedDataStore(Config.LeaderboardName)
		-- Erişim sınaması: Studio'da API kapalıysa burada hata verir
		store:GetAsync("__ping")
	end)
	if not ok then
		memoryMode = true
		warn("[DataService] DataStore erişimi yok, bellekte çalışılıyor. Veri kalıcı olmayacak.")
	end
end

-- Yükler ve oturum kilidini alır. Başarısızsa nil döner.
function DataService.Load(player: Player)
	local userId = player.UserId
	if memoryMode then
		cache[userId] = cache[userId] or DataService.Default()
		return cache[userId]
	end
	local locked = false
	local ok, result = retry(function()
		return store:UpdateAsync("p_" .. userId, function(old)
			local data = old or DataService.Default()
			local s = data.session
			if s and s.jobId ~= game.JobId and os.time() - (s.t or 0) < Config.Data.LockTimeout then
				locked = true
				return nil -- başka sunucuda açık, dokunma
			end
			locked = false
			data.session = { jobId = game.JobId, t = os.time() }
			return data
		end)
	end)
	if not ok or locked or not result then
		return nil
	end
	local data = reconcile(result, DataService.Default())
	cache[userId] = data
	return data
end

function DataService.Get(player: Player)
	return cache[player.UserId]
end

function DataService.Save(player: Player, release: boolean?)
	local userId = player.UserId
	local data = cache[userId]
	if not data or memoryMode then
		if release then
			-- bellek modunda veriyi oturum boyunca tut
			return true
		end
		return data ~= nil
	end
	local ok = retry(function()
		return store:UpdateAsync("p_" .. userId, function(old)
			if old and old.session and old.session.jobId ~= game.JobId then
				return nil -- kilit bizde değil, üzerine yazma
			end
			local copy = deepCopy(data)
			copy.session = if release then nil else { jobId = game.JobId, t = os.time() }
			return copy
		end)
	end)
	if ok and data.created then
		pcall(function()
			board:SetAsync(tostring(userId), Config.Power(data.stats, data.level))
		end)
	end
	if release then
		cache[userId] = nil
	end
	return ok
end

-- İlk N oyuncu: { {userId, power}, ... }
function DataService.Top(count: number)
	if memoryMode then
		return {}
	end
	local ok, pages = pcall(function()
		return board:GetSortedAsync(false, math.clamp(count, 1, 100))
	end)
	if not ok then
		return {}
	end
	local out = {}
	for _, entry in ipairs(pages:GetCurrentPage()) do
		table.insert(out, { userId = tonumber(entry.key), power = entry.value })
	end
	return out
end

function DataService.StartAutoSave()
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutoSave)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX16"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	Main (sunucu)
	Servisleri sırayla başlatır.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PlayerService = require(script.Parent.PlayerService)
local CharacterService = require(script.Parent.CharacterService)

-- Herkes varsayılan gövdeyle doğar; kendi Roblox avatarı yüklenmez
game:GetService("StarterPlayer").LoadCharacterAppearance = false

CharacterService.BuildStudio()
CharacterService.BuildMatchPitch()
DataService.Init()
PlayerService.Init()
DataService.StartAutoSave()

task.spawn(CharacterService.BuildBotTemplates)

print("[FenerKariyer] Sunucu hazır")
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[--[[
	PlayerService
	İstemciden gelen bütün istekleri doğrular ve veriyi yalnızca sunucuda değiştirir.
	- Kariyer oluşturma: isim filtresi, mevki kilidi, görünüm aralık kontrolü
	- Özellik yükseltme, yetenek açma (sıralı kilit), tesis geliştirme
	- İstek sıklığı sınırı
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage.Shared.Config)
local Crest = require(ReplicatedStorage.Shared.Crest)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local CharacterService = require(script.Parent.CharacterService)

local PlayerService = {}

local lastCall: { [number]: { [string]: number } } = {}

local function allowed(player: Player, key: string): boolean
	local now = os.clock()
	local t = lastCall[player.UserId]
	if not t then
		t = {}
		lastCall[player.UserId] = t
	end
	if t[key] and now - t[key] < Config.Remote.MinInterval then
		return false
	end
	t[key] = now
	return true
end

local function isInt(v, min: number, max: number): boolean
	return type(v) == "number" and v == math.floor(v) and v >= min and v <= max
end

local function isText(v, min: number, max: number): boolean
	return type(v) == "string" and utf8.len(v) ~= nil and utf8.len(v) >= min and utf8.len(v) <= max
end

local function inList(v, list): boolean
	return type(v) == "string" and table.find(list, v) ~= nil
end

local function isHex(v): boolean
	return type(v) == "string" and string.match(v, "^%x%x%x%x%x%x$") ~= nil
end

local function filter(text: string, userId: number): string?
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, userId):GetNonChatStringForBroadcastAsync()
	end)
	if not ok or string.find(result, "#", 1, true) then
		return nil
	end
	return result
end

-- Görünüm tablosunu doğrular ve temiz bir kopya döndürür (geçersizse nil)
local function cleanAppearance(a)
	local A = Config.Appearance
	local valid = type(a) == "table"
		and isInt(a.height, A.HeightMin, A.HeightMax)
		and inList(a.build, A.Builds)
		and isInt(a.skin, 1, A.SkinTones)
		and isInt(a.face, 1, A.Faces)
		and isInt(a.hairStyle, 1, A.HairStyles)
		and isHex(a.hairColor)
		and isInt(a.beard, 0, A.Beards)
		and isInt(a.bootModel, 1, A.BootModels)
		and isHex(a.bootColor)
	if not valid then
		return nil
	end
	local acc = {}
	if type(a.accessories) == "table" then
		for _, key in ipairs(Config.Accessories) do
			acc[key] = a.accessories[key] == true
		end
	end
	return {
		height = a.height,
		build = a.build,
		skin = a.skin,
		face = a.face,
		hairStyle = a.hairStyle,
		hairColor = a.hairColor,
		beard = a.beard,
		bootModel = a.bootModel,
		bootColor = a.bootColor,
		accessories = acc,
	}
end

-- İstemciye gidecek kopya (oturum bilgisi gönderilmez)
local function publicData(data)
	local copy = table.clone(data)
	copy.session = nil
	copy.power = Config.Power(data.stats, data.level)
	return copy
end

local function push(player: Player)
	local data = DataService.Get(player)
	if data then
		Remotes.Get("DataChanged"):FireClient(player, publicData(data))
	end
end

local function notify(player: Player, kind: string, text: string)
	Remotes.Get("Notify"):FireClient(player, kind, text)
end

-- XP ekler, seviye atlatır. Başka servisler de (maç, antrenman) bunu kullanır.
function PlayerService.AddXp(player: Player, amount: number)
	local data = DataService.Get(player)
	if not data or amount <= 0 then
		return
	end
	data.xp += amount
	while data.level < Config.MaxLevel and data.xp >= Config.XpForLevel(data.level) do
		data.xp -= Config.XpForLevel(data.level)
		data.level += 1
		notify(player, "level", "Seviye " .. data.level)
	end
	push(player)
end

function PlayerService.AddCoins(player: Player, amount: number)
	local data = DataService.Get(player)
	if data and amount > 0 then
		data.coins += math.floor(amount)
		push(player)
	end
end

local function onCreateCareer(player: Player, p)
	local data = DataService.Get(player)
	if not data or not allowed(player, "create") then
		return
	end
	if data.created then
		return notify(player, "error", "Kariyerin zaten var. İsim ve mevki değiştirilemez.")
	end
	if type(p) ~= "table" then
		return
	end
	local A = Config.Appearance
	local appearance = cleanAppearance(p.appearance)
	local valid = appearance ~= nil
		and isText(p.name, Config.Name.Min, Config.Name.Max)
		and inList(p.position, Config.Positions)
		and isInt(p.number, 1, 99)
		and isText(p.clubName, Config.ClubName.Min, Config.ClubName.Max)
		and type(p.clubAbbr) == "string"
		and string.match(p.clubAbbr, "^%u%u%u?$") ~= nil
		and isInt(p.crestShape, 1, A.CrestShapes)
		and inList(p.kitPattern, A.KitPatterns)
	if not valid then
		return notify(player, "error", "Bilgilerde hata var. Lütfen kontrol et.")
	end
	local name = filter(p.name, player.UserId)
	local clubName = filter(p.clubName, player.UserId)
	if not name or not clubName then
		return notify(player, "error", "Bu isim kullanılamıyor. Başka bir isim dene.")
	end
	data.name = name
	data.number = p.number
	data.position = p.position -- KİLİT: bundan sonra hiçbir istek bunu değiştirmez
	data.stats = table.clone(Config.StartStats[p.position])
	data.appearance = appearance
	data.club.name = clubName
	data.club.abbr = p.clubAbbr
	data.club.crestShape = p.crestShape
	data.club.kitPattern = p.kitPattern
	-- Her zincirin ilk ücretsiz yeteneği açık başlar
	for chainId, chain in pairs(Config.SkillChains) do
		if not chain.OnlyPosition or chain.OnlyPosition == p.position then
			local first = chain.Skills[1]
			data.skills[chainId] = if first.Cost == 0 and first.Level <= 1 then 1 else 0
		end
	end
	data.created = true
	push(player)
	CharacterService.Apply(player, CharacterService.LookFromData(data))
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 16
	end
	notify(player, "success", "Hoş geldin " .. name .. ". Kariyerin başladı.")
	task.spawn(DataService.Save, player, false)
end

local function onUpgradeStat(player: Player, stat)
	local data = DataService.Get(player)
	if not data or not data.created or not allowed(player, "stat") then
		return
	end
	if not inList(stat, Config.Stats) then
		return
	end
	local level = data.stats[stat]
	if level >= Config.StatMax then
		return notify(player, "error", Config.StatNames[stat] .. " en üst seviyede.")
	end
	local cost = Config.StatCost(level)
	if data.coins < cost then
		return notify(player, "error", "Bakiye yetersiz. Gereken: " .. cost)
	end
	data.coins -= cost
	data.stats[stat] = level + 1
	push(player)
	notify(player, "success", Config.StatNames[stat] .. " " .. (level + 1) .. " oldu.")
end

local function onUnlockSkill(player: Player, chainId)
	local data = DataService.Get(player)
	if not data or not data.created or not allowed(player, "skill") then
		return
	end
	local chain = type(chainId) == "string" and Config.SkillChains[chainId]
	if not chain then
		return
	end
	if chain.OnlyPosition and chain.OnlyPosition ~= data.position then
		return notify(player, "error", "Bu zincir senin mevkine ait değil.")
	end
	-- Sıralı kilit: yalnızca sıradaki yetenek açılabilir
	local nextIndex = Config.SkillLevel(data.skills, chainId) + 1
	local skill = chain.Skills[nextIndex]
	if not skill then
		return notify(player, "error", "Bu zincirdeki bütün yetenekler açık.")
	end
	if data.level < skill.Level then
		return notify(player, "error", skill.Name .. " için seviye " .. skill.Level .. " gerekli.")
	end
	if data.coins < skill.Cost then
		return notify(player, "error", "Bakiye yetersiz. Gereken: " .. skill.Cost)
	end
	data.coins -= skill.Cost
	data.skills[chainId] = nextIndex
	push(player)
	notify(player, "unlock", skill.Name .. " açıldı")
end

-- Kulüp arması tasarımı
local function onSetCrest(player: Player, spec)
	local data = DataService.Get(player)
	if not data or not data.created or not allowed(player, "crest") then
		return
	end
	local clean = Crest.Clean(spec)
	if not clean then
		return notify(player, "error", "Arma kaydedilemedi: iki farklı renk seç.")
	end
	data.club.crest = clean
	data.club.crestShape = clean.shape
	push(player)
	CharacterService.Apply(player, CharacterService.LookFromData(data))
	notify(player, "success", "Kulüp arması kaydedildi.")
end

local function onUpgradeFacility(player: Player, id)
	local data = DataService.Get(player)
	if not data or not data.created or not allowed(player, "facility") then
		return
	end
	local f = type(id) == "string" and Config.Facilities[id]
	if not f then
		return
	end
	local level = data.club.facilities[id] or 0
	if level >= f.Max then
		return notify(player, "error", f.Name .. " en üst seviyede.")
	end
	local cost = f.Cost[level + 1]
	if data.club.funds < cost then
		return notify(player, "error", "Kulüp kasası yetersiz. Gereken: " .. cost)
	end
	data.club.funds -= cost
	data.club.facilities[id] = level + 1
	push(player)
	notify(player, "success", f.Name .. " geliştirildi.")
end

-- Karakter oluşturma ekranında canlı önizleme. Hiçbir şey kaydedilmez; isim gösterilmez.
local function onPreview(player: Player, p)
	local data = DataService.Get(player)
	if not data or data.created or not allowed(player, "preview") or type(p) ~= "table" then
		return
	end
	local appearance = cleanAppearance(p.appearance)
	if
		not appearance
		or not inList(p.position, Config.Positions)
		or not inList(p.kitPattern, Config.Appearance.KitPatterns)
		or not isInt(p.number, 1, 99)
	then
		return
	end
	local abbr = if type(p.clubAbbr) == "string" and string.match(p.clubAbbr, "^%u%u%u?$") then p.clubAbbr else "FK"
	CharacterService.Apply(
		player,
		{ appearance = appearance, position = p.position, kitPattern = p.kitPattern, number = p.number, name = "", abbr = abbr, level = 1 }
	)
end

-- Animasyon aktarımı: bir oyuncunun eylemi aynı sunucudaki diğer oyunculara bildirilir (onlar da görsün)
local function onAnim(player: Player, action, mirror)
	if type(action) ~= "string" or #action > 24 or not allowed(player, "anim") then
		return
	end
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			Remotes.Get("Anim"):FireClient(other, player.UserId, action, mirror == true)
		end
	end
end

-- Deneme sahasında atılan gol: küçük ödül. Bekleme süresi sunucuda tutulur.
local lastTrainingGoal: { [number]: number } = {}
local function onTrainingGoal(player: Player, kind)
	local data = DataService.Get(player)
	local R = Config.TestPitch.Reward
	if not data or not data.created then
		return
	end
	local now = os.clock()
	if now - (lastTrainingGoal[player.UserId] or 0) < R.Cooldown then
		return
	end
	lastTrainingGoal[player.UserId] = now
	local bonus = if kind == "Header" or kind == "UcanKafa" or kind == "Rovesata" or kind == "Vole" then R.HeaderBonus else 0
	if kind == "Feint" or kind == "Tackle" then
		-- çalım ve top kapma: gol ödülünün yarısı
		data.coins += math.floor(R.Coins / 2)
		PlayerService.AddXp(player, math.floor(R.Xp / 2))
		return
	end
	data.coins += R.Coins + bonus
	PlayerService.AddXp(player, R.Xp + bonus)
end

-- MAÇ: istemci maçı oynatır, sunucu sonucu makullük sınamasından geçirip ödülü verir
local matchStart: { [number]: number } = {}
local function onMatchStart(player: Player)
	local data = DataService.Get(player)
	if data and data.created and allowed(player, "matchStart") then
		matchStart[player.UserId] = os.clock()
	end
end

local function onMatchEnd(player: Player, r)
	local data = DataService.Get(player)
	local MC = Config.Match
	local started = matchStart[player.UserId]
	matchStart[player.UserId] = nil
	if not data or not data.created or not started or type(r) ~= "table" then
		return
	end
	local valid = isInt(r.home, 0, MC.MaxGoals)
		and isInt(r.away, 0, MC.MaxGoals)
		and isInt(r.myGoals, 0, MC.MaxGoals)
		and isInt(r.myHeaderGoals, 0, MC.MaxGoals)
		and r.myGoals <= r.home
		and r.myHeaderGoals <= r.myGoals
	-- maç en az iki devrenin %80'i kadar sürmüş olmalı; yarıda bırakılan maç ödül vermez
	local long = os.clock() - started >= MC.HalfSeconds * 2 * 0.8
	if not valid or not long or r.forfeit == true then
		Remotes.Get("MatchResult"):FireClient(player, { ok = false })
		return
	end
	local outcome = if r.home > r.away then "Win" elseif r.home == r.away then "Draw" else "Loss"
	local tier = Config.Tiers[data.club.tier]
	local coins = MC.Reward[outcome] + (r.myGoals - r.myHeaderGoals) * MC.Reward.Goal + r.myHeaderGoals * MC.Reward.HeaderGoal
	local xp = MC.Reward.Xp[outcome] + r.myGoals * MC.Reward.Xp.Goal
	data.coins += coins
	data.club.funds += tier.MatchIncome
	data.career.matches += 1
	data.career.goals += r.myGoals
	data.career.headerGoals += r.myHeaderGoals
	if outcome == "Win" then
		data.career.wins += 1
	end
	local season = data.club.season
	season.played += 1
	season.points += MC.Points[outcome]
	local promoted, seasonOver = false, false
	if season.played >= Config.Season.Matches then
		seasonOver = true
		if season.points >= MC.PromotePoints and data.club.tier < 5 then
			data.club.tier += 1
			promoted = true
		end
		season.number += 1
		season.played = 0
		season.points = 0
	end
	PlayerService.AddXp(player, xp) -- veriyi de istemciye yollar
	Remotes.Get("MatchResult"):FireClient(player, {
		ok = true,
		outcome = outcome,
		coins = coins,
		xp = xp,
		income = tier.MatchIncome,
		played = season.played,
		points = season.points,
		seasonOver = seasonOver,
		promoted = promoted,
		tier = data.club.tier,
	})
	task.spawn(DataService.Save, player, false)
end

function PlayerService.Init()
	Remotes.Get("MatchStart").OnServerEvent:Connect(onMatchStart)
	Remotes.Get("MatchEnd").OnServerEvent:Connect(onMatchEnd)
	Remotes.Get("Anim").OnServerEvent:Connect(onAnim)
	Remotes.Get("TrainingGoal").OnServerEvent:Connect(onTrainingGoal)
	Remotes.Get("PreviewAppearance").OnServerEvent:Connect(onPreview)
	Remotes.Get("CreateCareer").OnServerEvent:Connect(onCreateCareer)
	Remotes.Get("UpgradeStat").OnServerEvent:Connect(onUpgradeStat)
	Remotes.Get("UnlockSkill").OnServerEvent:Connect(onUnlockSkill)
	Remotes.Get("UpgradeFacility").OnServerEvent:Connect(onUpgradeFacility)
	Remotes.Get("SetCrest").OnServerEvent:Connect(onSetCrest)
	Remotes.Get("GetData").OnServerInvoke = function(player)
		local t0 = os.clock()
		while not DataService.Get(player) and os.clock() - t0 < 10 do
			task.wait(0.1)
		end
		local data = DataService.Get(player)
		return data and publicData(data) or nil
	end

	local function onJoin(player: Player)
		local data = DataService.Load(player)
		if not data then
			player:Kick("Verin yüklenemedi ya da başka bir sunucuda açık. Biraz sonra tekrar dene.")
			return
		end
		push(player)
		local function onCharacter(character: Model)
			local hum = character:WaitForChild("Humanoid", 10)
			if not hum then
				return
			end
			if not character:IsDescendantOf(workspace) then
				character.AncestryChanged:Wait()
			end
			task.wait(0.2)
			local d = DataService.Get(player)
			if not d then
				return
			end
			if d.created then
				CharacterService.Apply(player, CharacterService.LookFromData(d))
			else
				(hum :: Humanoid).WalkSpeed = 0 -- oluşturma ekranında yerinde dursun
				local look = CharacterService.LookFromData(d)
				look.position = "Forvet"
				look.name = ""
				look.abbr = "FK"
				CharacterService.Apply(player, look)
			end
		end
		player.CharacterAdded:Connect(onCharacter)
		if player.Character then
			task.spawn(onCharacter, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onJoin, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastCall[player.UserId] = nil
		lastTrainingGoal[player.UserId] = nil
		matchStart[player.UserId] = nil
		DataService.Save(player, true)
	end)
end

return PlayerService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX45"><Properties><string name="Name">StarterPlayer</string><bool name="LoadCharacterAppearance">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX42"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX41"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX22"><Properties><string name="Name">Anim</string></Properties><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Animator</string><ProtectedString name="Source"><![CDATA[--[[
	Animator
	Kodla çalışan katmanlı animasyon motoru (R15).
	- Alt katman: duruş ve koşu döngüsü hızdan üretilir (yürüyüşten sprinte kesintisiz).
	- Üst katman: eylemler (şut, kafa, çalım, müdahale...) anahtar karelerden okunur ve yumuşak geçişle karışır.
	- "Upper" maskeli eylemler koşarken oynar; bacaklar koşmaya devam eder.
	- Olaylar (strike, jump, land, footstep...) tam zamanında bildirilir; top fiziği ve efektler buna bağlanır.
	- Toparlanma süresinde basılan tuş tamponda tutulur ve ilk fırsatta oynar.
	Varsayılan Roblox Animate betiği kapatılır.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Poses = require(script.Parent.Poses)

local Animator = {}
Animator.__index = Animator

local ZERO = Vector3.zero
local BLEND_IN, BLEND_OUT = 0.1, 0.16
local BUFFER_TIME = 0.35

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

local MIRROR = {}
for _, j in ipairs(Poses.Joints) do
	if string.sub(j, 1, 4) == "Left" then
		MIRROR[j] = "Right" .. string.sub(j, 5)
	elseif string.sub(j, 1, 5) == "Right" then
		MIRROR[j] = "Left" .. string.sub(j, 6)
	else
		MIRROR[j] = j
	end
end

function Animator.new(character: Model)
	local self = setmetatable({}, Animator)
	self.Character = character
	self.Motors = {}
	self.Rest = {}
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Motor6D") and table.find(Poses.Joints, d.Name) then
			self.Motors[d.Name] = d
		end
	end
	self.Phase = 0
	self.Time = 0
	self.Action = nil -- { def, name, t, mirror, fired = {} }
	self.Weight = 0
	self.LastPose = {} -- eylem bittikten sonra geçiş için son poz
	self.LastMask = "Full"
	self.Buffered = nil
	self.Listeners = {}
	self.LeanSmooth = 0
	self.SpeedSmooth = 0
	self.LastStep = 0

	-- Varsayılan animasyonları kapat
	local animate = character:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local an = hum and hum:FindFirstChildOfClass("Animator")
	if an then
		for _, track in ipairs(an:GetPlayingAnimationTracks()) do
			track:Stop(0)
		end
	end
	return self
end

function Animator:OnEvent(fn: (string, string) -> ())
	table.insert(self.Listeners, fn)
end

function Animator:_fire(event: string, action: string)
	for _, fn in ipairs(self.Listeners) do
		task.spawn(fn, event, action)
	end
end

function Animator:IsBusy(): boolean
	return self.Action ~= nil
end

-- Eylem sırasında hareket hızı çarpanı (1 = serbest)
function Animator:SpeedFactor(): number
	local a = self.Action
	return if a then (a.def.Speed or 1) else 1
end

function Animator:Current(): string?
	return self.Action and self.Action.name
end

-- Eylemi başlatır. Meşgulse ve toparlanma başlamadıysa tampona alır. Dönüş: hemen başladı mı
function Animator:Play(name: string, opts)
	local def = Poses.Actions[name]
	if not def then
		return false
	end
	local a = self.Action
	if a then
		if a.t < (a.def.Recover or a.def.Duration) then
			self.Buffered = { name = name, opts = opts, at = self.Time }
			return false
		end
		self.LastPose = self:_sample(a)
		self.LastMask = a.def.Mask
	end
	self.Action = { def = def, name = name, t = 0, mirror = opts and opts.Mirror == true, fired = {} }
	-- Bu eylem için yüklenmiş bir animasyon varsa o oynar; zamanlama olayları yine buradan tetiklenir
	local assetId = Config.Animations[name]
	if assetId and assetId ~= "" then
		local track = self:_track(name, assetId)
		if track then
			track:Play(0.1)
			self.Action.track = track
		end
	end
	self.Buffered = nil
	self:_fire("start", name)
	return true
end

function Animator:_track(name: string, assetId: string)
	self.Tracks = self.Tracks or {}
	if self.Tracks[name] then
		return self.Tracks[name]
	end
	local hum = self.Character:FindFirstChildOfClass("Humanoid")
	local an = hum and hum:FindFirstChildOfClass("Animator")
	if not an then
		return nil
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local ok, track = pcall(function()
		return an:LoadAnimation(anim)
	end)
	if ok then
		track.Priority = Enum.AnimationPriority.Action
		track:SetAttribute("FK", true)
		self.Tracks[name] = track
		return track
	end
	return nil
end

function Animator:Stop()
	if self.Action then
		self.LastPose = self:_sample(self.Action)
		self.LastMask = self.Action.def.Mask
		self.Action = nil
	end
end

-- Catmull-Rom: anahtar kareler arasında köşesiz, akıcı geçiş
local function spline(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local t2, t3 = t * t, t * t * t
	return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
end

function Animator:_sample(a)
	local keys = a.def.Keys
	local t = a.t
	local i0 = #keys - 1
	for i = 1, #keys - 1 do
		if t >= keys[i][1] and t <= keys[i + 1][1] then
			i0 = i
			break
		end
	end
	local k0, k1 = keys[i0], keys[i0 + 1]
	local kp, kn = keys[math.max(1, i0 - 1)], keys[math.min(#keys, i0 + 2)]
	local span = k1[1] - k0[1]
	local alpha = if span > 0 then math.clamp((t - k0[1]) / span, 0, 1) else 1
	local out = {}
	for _, j in ipairs(Poses.Joints) do
		local src = if a.mirror then MIRROR[j] else j
		local v = spline(kp[2][src] or ZERO, k0[2][src] or ZERO, k1[2][src] or ZERO, kn[2][src] or ZERO, alpha)
		if a.mirror then
			v = Vector3.new(v.X, -v.Y, -v.Z)
		end
		out[j] = v
	end
	local p = spline(kp[2].RootPos or ZERO, k0[2].RootPos or ZERO, k1[2].RootPos or ZERO, kn[2].RootPos or ZERO, alpha)
	out.RootPos = if a.mirror then Vector3.new(-p.X, p.Y, p.Z) else p
	return out
end

-- Duruş ve koşu: ctx = { speed, maxSpeed, sprinting, tired, grounded, turn (-1..1), vy }
function Animator:_locomotion(dt: number, ctx)
	local pose = {}
	local speed = ctx.speed
	self.SpeedSmooth += (speed - self.SpeedSmooth) * math.min(1, dt * 10)
	local s = self.SpeedSmooth
	local run = math.clamp(s / 17, 0, 1) -- 0 duruş, 1 koşu
	local sprint = math.clamp((s - 17) / 8, 0, 1)
	self.LeanSmooth += ((ctx.turn or 0) - self.LeanSmooth) * math.min(1, dt * 6)

	if not ctx.grounded then
		-- havada: bacaklar hafif toplanır, kollar açılır
		local up = math.clamp((ctx.vy or 0) / 30, -1, 1)
		pose.LeftHip = Vector3.new(20 + up * 10, 0, 0)
		pose.RightHip = Vector3.new(-6 + up * 10, 0, 0)
		pose.LeftKnee = Vector3.new(-45, 0, 0)
		pose.RightKnee = Vector3.new(-25, 0, 0)
		pose.LeftShoulder = Vector3.new(30, 0, -45)
		pose.RightShoulder = Vector3.new(30, 0, 45)
		pose.Root = Vector3.new(-4, 0, 0)
		return pose
	end

	if run < 0.05 then
		-- duruş: nefes ve ağırlık aktarma
		local b = math.sin(self.Time * (if ctx.tired then 5 else 1.8))
		local sway = math.sin(self.Time * 0.7)
		local amp = if ctx.tired then 2.2 else 1
		pose.Waist = Vector3.new(b * 1.5 * amp - (if ctx.tired then 14 else 0), 0, sway * 1.2)
		pose.Neck = Vector3.new(-b * 1 - (if ctx.tired then 10 else 0), sway * 3, 0)
		pose.LeftShoulder = Vector3.new(b * 2 + (if ctx.tired then 25 else 0), 0, -6 - b)
		pose.RightShoulder = Vector3.new(b * 2 + (if ctx.tired then 25 else 0), 0, 6 + b)
		pose.LeftElbow = Vector3.new(if ctx.tired then 40 else 8, 0, 0)
		pose.RightElbow = Vector3.new(if ctx.tired then 40 else 8, 0, 0)
		pose.LeftHip = Vector3.new(if ctx.tired then 14 else 0, 0, -3)
		pose.RightHip = Vector3.new(if ctx.tired then 14 else 0, 0, 3)
		pose.LeftKnee = Vector3.new(if ctx.tired then -22 else -2, 0, 0)
		pose.RightKnee = Vector3.new(if ctx.tired then -22 else -2, 0, 0)
		pose.RootPos = Vector3.new(0, b * 0.02 * amp - (if ctx.tired then 0.18 else 0), 0)
		return pose
	end

	-- koşu döngüsü: adım sıklığı hızla artar
	local cadence = 7 + run * 5 + sprint * 3.5
	local prev = self.Phase
	self.Phase += dt * cadence
	local ph = self.Phase
	local sn, cs = math.sin(ph), math.cos(ph)
	local legAmp = 26 + run * 22 + sprint * 14
	local armAmp = 22 + run * 30 + sprint * 22
	local lean = 4 + run * 6 + sprint * 9
	-- sol bacak öne giderken sağ kol öne gider
	pose.LeftHip = Vector3.new(sn * legAmp + 6, 0, 0)
	pose.RightHip = Vector3.new(-sn * legAmp + 6, 0, 0)
	-- diz: bacak geriden öne gelirken bükülür
	pose.LeftKnee = Vector3.new(-(14 + math.max(0, -cs) * (55 + sprint * 35) * run), 0, 0)
	pose.RightKnee = Vector3.new(-(14 + math.max(0, cs) * (55 + sprint * 35) * run), 0, 0)
	pose.LeftAnkle = Vector3.new(math.max(0, sn) * 14, 0, 0)
	pose.RightAnkle = Vector3.new(math.max(0, -sn) * 14, 0, 0)
	pose.RightShoulder = Vector3.new(sn * armAmp, 0, 6)
	pose.LeftShoulder = Vector3.new(-sn * armAmp, 0, -6)
	local elbow = 45 + run * 35
	pose.RightElbow = Vector3.new(elbow + sn * 12, 0, 0)
	pose.LeftElbow = Vector3.new(elbow - sn * 12, 0, 0)
	pose.Waist = Vector3.new(-lean * 0.5, -sn * (5 + run * 5), -self.LeanSmooth * 6)
	pose.Neck = Vector3.new(lean * 0.4, sn * 3, 0)
	pose.Root = Vector3.new(-lean * 0.5, 0, -self.LeanSmooth * (8 + sprint * 8))
	pose.RootPos = Vector3.new(0, math.abs(cs) * (0.06 + run * 0.1) - 0.08 * run, 0)
	if ctx.tired then
		pose.Waist += Vector3.new(-8, 0, 0)
		pose.Neck += Vector3.new(-8, 0, 0)
	end
	-- ayak yere basma olayı
	if math.floor(prev / math.pi) ~= math.floor(ph / math.pi) and self.Time - self.LastStep > 0.12 then
		self.LastStep = self.Time
		self:_fire(if math.floor(ph / math.pi) % 2 == 0 then "footL" else "footR", if sprint > 0.4 then "sprint" else "run")
	end
	return pose
end

function Animator:Update(dt: number, ctx)
	self.Time += dt
	local base = self:_locomotion(dt, ctx)
	local actPose, mask = nil, "Full"
	local a = self.Action
	if a then
		a.t += dt * (a.def.Rate or 1)
		for i, ev in ipairs(a.def.Events or {}) do
			if not a.fired[i] and a.t >= ev[1] then
				a.fired[i] = true
				self:_fire(ev[2], a.name)
			end
		end
		actPose = self:_sample(a)
		mask = a.def.Mask
		self.Weight = math.min(1, self.Weight + dt / BLEND_IN)
		if a.t >= a.def.Duration then
			self.LastPose = if a.def.Snap then {} else actPose
			self.LastMask = mask
			if a.def.Snap then
				self.Weight = 0
			end
			self.Action = nil
			self:_fire("end", a.name)
		elseif self.Buffered and a.t >= (a.def.Recover or a.def.Duration) then
			local b = self.Buffered
			if self.Time - b.at <= BUFFER_TIME then
				self:Play(b.name, b.opts)
			else
				self.Buffered = nil
			end
		end
	else
		self.Weight = math.max(0, self.Weight - dt / BLEND_OUT)
		actPose = self.LastPose
		mask = self.LastMask
		if self.Buffered then
			local b = self.Buffered
			self.Buffered = nil
			if self.Time - b.at <= BUFFER_TIME then
				self:Play(b.name, b.opts)
			end
		end
	end

	local w = smooth(self.Weight)
	for _, j in ipairs(Poses.Joints) do
		local motor = self.Motors[j]
		if motor then
			local v = base[j] or ZERO
			if a and a.track then
				continue -- yüklenmiş animasyon oynarken eklemlere dokunma
			end
			if actPose and w > 0 and (mask == "Full" or Poses.Upper[j]) then
				v = v:Lerp(actPose[j] or ZERO, w)
			end
			local cf = CFrame.fromEulerAnglesYXZ(math.rad(v.X), math.rad(v.Y), math.rad(v.Z))
			if j == "Root" then
				local p = base.RootPos or ZERO
				if actPose and w > 0 and mask == "Full" then
					p = p:Lerp(actPose.RootPos or ZERO, w)
				end
				cf = CFrame.new(p) * cf
			end
			motor.Transform = cf
		end
	end
end

function Animator:Destroy()
	self.Listeners = {}
	self.Action = nil
end

return Animator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Poses</string><ProtectedString name="Source"><![CDATA[--[[
	Poses
	Kodla tanımlanan animasyonlar. Hiçbir animasyon dosyası yüklenmez.
	Her eylem anahtar karelerden oluşur; açılar derece cinsindendir.

	Eklem eksenleri (R15, karakter -Z'ye bakar):
	  X: öne/arkaya salınım. Aşağı sarkan uzuv için + öne. Gövde için - öne eğilme.
	  Y: kendi ekseninde dönme.
	  Z: yana açılma. Sağ uzuv için + dışa, sol uzuv için - dışa.
	  Diz geriye bükülür: Knee X negatif. Dirsek öne bükülür: Elbow X pozitif.
	Root: bütün gövde. RootPos: gövdenin kayması (stud).

	Eylem alanları:
	  Duration: toplam süre (sn)
	  Mask: "Full" (tüm gövde) ya da "Upper" (yalnız üst gövde; koşu devam eder)
	  Keys: { {t, pose}, ... }
	  Events: { {t, ad}, ... }  -> topa temas, ayak basma gibi anlar tam bu zamanda tetiklenir
	  Recover: bu andan sonra yeni eylem kabul edilir (girdi tamponu)
	  Speed: eylem boyunca hareket hızı çarpanı
]]

local V = Vector3.new

local Poses = {}

Poses.Joints = {
	"Root",
	"Waist",
	"Neck",
	"LeftShoulder",
	"LeftElbow",
	"LeftWrist",
	"RightShoulder",
	"RightElbow",
	"RightWrist",
	"LeftHip",
	"LeftKnee",
	"LeftAnkle",
	"RightHip",
	"RightKnee",
	"RightAnkle",
}
Poses.Upper = {
	Waist = true,
	Neck = true,
	LeftShoulder = true,
	LeftElbow = true,
	LeftWrist = true,
	RightShoulder = true,
	RightElbow = true,
	RightWrist = true,
}

local REST = {}

Poses.Actions = {
	-- ŞUTLAR ---------------------------------------------------------------
	Shoot = {
		Rate = 1.3, -- oynatma hızı: tuşa basış ile temas arasını kısaltır
		Duration = 0.62,
		Mask = "Full",
		Recover = 0.42,
		Speed = 0.35,
		Events = { { 0.3, "strike" } },
		Keys = {
			{ 0, REST },
			{
				0.18,
				{
					Root = V(-5, -10, 0),
					Waist = V(-8, -14, 0),
					RightHip = V(-48, 0, 6),
					RightKnee = V(-85, 0, 0),
					LeftHip = V(16, 0, 0),
					LeftKnee = V(-18, 0, 0),
					LeftShoulder = V(45, 0, -40),
					LeftElbow = V(20, 0, 0),
					RightShoulder = V(-45, 0, 12),
					RightElbow = V(30, 0, 0),
				},
			},
			{
				0.3,
				{
					Root = V(2, 8, 0),
					Waist = V(8, 14, 0),
					RightHip = V(58, 0, 0),
					RightKnee = V(-12, 0, 0),
					RightAnkle = V(25, 0, 0),
					LeftHip = V(-6, 0, 0),
					LeftKnee = V(-22, 0, 0),
					LeftShoulder = V(-35, 0, -55),
					RightShoulder = V(35, 0, 20),
					RightElbow = V(40, 0, 0),
				},
			},
			{
				0.44,
				{
					Root = V(6, 12, 0),
					RootPos = V(0, 0.18, 0),
					Waist = V(10, 10, 0),
					RightHip = V(84, 0, 0),
					RightKnee = V(-6, 0, 0),
					LeftKnee = V(-8, 0, 0),
					LeftShoulder = V(-45, 0, -40),
					RightShoulder = V(50, 0, 15),
				},
			},
			{ 0.62, REST },
		},
	},
	Plase = {
		Rate = 1.2, -- oynatma hızı: tuşa basış ile temas arasını kısaltır
		Duration = 0.52,
		Mask = "Full",
		Recover = 0.36,
		Speed = 0.4,
		Events = { { 0.24, "strike" } },
		Keys = {
			{ 0, REST },
			{
				0.14,
				{
					Waist = V(-4, -8, 0),
					RightHip = V(-28, 40, 10),
					RightKnee = V(-55, 0, 0),
					LeftKnee = V(-16, 0, 0),
					LeftShoulder = V(30, 0, -45),
					RightShoulder = V(-25, 0, 20),
				},
			},
			{
				0.24,
				{
					Waist = V(4, 10, 0),
