<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity KURULU OLMADAN Runtime katmanının C# derleme hatalarını yakalamak için yaklaşık kontrol.
    Gerçek doğrulama = Unity Editor/GameCI derlemesi (android-apk.yml). Bu proje onun yerine geçmez.
    Kullanım:  dotnet build tools/compile-check/UnityCompileCheck.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);NU1701;CS0618;CS0649;CS0414;CS0067;CS0108;CS0114</NoWarn>
    <!-- UNITY_ANDROID bilinçli tanımlı DEĞİL: Handheld (AndroidJNIModule) bu NuGet paketinde yok; Android bloğu gerçek Unity derlemesinde doğrulanır. -->
    <DefineConstants>$(DefineConstants);UNITY_2022_3</DefineConstants>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/_Game/Core/**/*.cs" />
    <Compile Include="../../unity/Assets/_Game/Runtime/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <!-- uGUI başvuru derlemesi (2018.3): kullandığımız Image/Text/Button/EventSystem API'leri 2022.3 ile aynıdır. -->
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2018.3.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
